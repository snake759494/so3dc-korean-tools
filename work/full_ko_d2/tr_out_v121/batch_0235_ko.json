{
 "batch_id": "batch_0235",
 "translations": [
  {
   "key": "6e69c3853fee",
   "speaker_korean": null,
   "korean": "시련의 유적 1하층"
  },
  {
   "key": "839c1d6b1b2d",
   "speaker_korean": null,
   "korean": "⟦1⟧블러드 스큘러⟦2⟧를 손에 넣었다."
  },
  {
   "key": "a1f7c2796a28",
   "speaker_korean": null,
   "korean": "⟦1⟧리플렉스⟦2⟧를 손에 넣었다."
  },
  {
   "key": "a8211af527fe",
   "speaker_korean": "페이트",
   "korean": "「안 되겠어.\n문이 굳게 닫혀 있어."
  },
  {
   "key": "aabe873777ec",
   "speaker_korean": null,
   "korean": "⟦1⟧・2하층 이동"
  },
  {
   "key": "e1f196ed8fe7",
   "speaker_korean": null,
   "korean": "⟦1⟧・3하층 이동"
  },
  {
   "key": "6414f3ee0c35",
   "speaker_korean": null,
   "korean": "⟦1⟧・4하층 이동"
  },
  {
   "key": "15c183f3b3b7",
   "speaker_korean": null,
   "korean": "⟦1⟧・엘리베이터 안 타기"
  },
  {
   "key": "b6e8551238ce",
   "speaker_korean": null,
   "korean": "⟦1⟧섀도우 불릿⟦2⟧을 손에 넣었다."
  },
  {
   "key": "4d9f68cf4c1f",
   "speaker_korean": null,
   "korean": "⟦1⟧60000폴⟦2⟧을 얻었다."
  },
  {
   "key": "eb2e9e5927b4",
   "speaker_korean": null,
   "korean": "⟦1⟧다크아이 헬름⟦2⟧을 얻었다."
  },
  {
   "key": "9ffe2a040b35",
   "speaker_korean": "빅풋",
   "korean": "「여긴 시련의 유적 첫 구역인 거다!\n또한 최초의 시련 장소인 거다!\n우선 이 몸부터 쓰러뜨리고 가는 거다!!"
  },
  {
   "key": "b4df3dc4c5e1",
   "speaker_korean": "빅풋",
   "korean": "「구후후….\n드디어 여기까지 왔구나!"
  },
  {
   "key": "3c1ec3cb20a0",
   "speaker_korean": "빅풋",
   "korean": "「구후후!\n과, 과연 여기까지\n올 만한 실력은 있는 거다…\n하지만 아직 시작일 뿐인 거다.\n여기서부터는 지옥과\n이어져 있는 거다.\n그럼, 맘대로 지나가 보는 거다!!"
  },
  {
   "key": "ebea69d528f4",
   "speaker_korean": null,
   "korean": "⟦1⟧성장 펌프킨레이스⟦2⟧를 손에 넣었다."
  },
  {
   "key": "af7da8a86071",
   "speaker_korean": null,
   "korean": "시련의 유적 2하층"
  },
  {
   "key": "fbeaa793ad9f",
   "speaker_korean": "페이트",
   "korean": "「이제 스위치를 바꿀\n필요는 없을 것 같아."
  },
  {
   "key": "d7286744ac09",
   "speaker_korean": null,
   "korean": "⟦1⟧트라이・퍼널⟦2⟧을 손에 넣었다."
  },
  {
   "key": "f06af6f51018",
   "speaker_korean": null,
   "korean": "⟦1⟧만능 해독제 시제품⟦2⟧을 얻었다."
  },
  {
   "key": "622f18be4eaf",
   "speaker_korean": null,
   "korean": "⟦1⟧요력천의 철갑⟦2⟧을 얻었다."
  },
  {
   "key": "901bd387bfb0",
   "speaker_korean": null,
   "korean": "⟦1⟧미라쥬 로브⟦2⟧를 손에 넣었다."
  },
  {
   "key": "e99e5ec49c86",
   "speaker_korean": "페이트",
   "korean": "「굳게 닫혀 있어서\n열릴 것 같지 않아."
  },
  {
   "key": "df86bda08578",
   "speaker_korean": "페이트",
   "korean": "「문은 굳게 닫혀 있어서\n열릴 것 같지 않군.\n…그런데, 다른 문에는 없는\n특수한 장치 같은 것이\n박혀 있어."
  },
  {
   "key": "ff0a04fe2154",
   "speaker_korean": "페이트",
   "korean": "「아."
  },
  {
   "key": "6f73dc3db954",
   "speaker_korean": "서큐버스",
   "korean": "「아하♥\n드디어 와 줬구나~\n언니가 기다리다 지쳐버렸잖아~"
  },
  {
   "key": "26eca479d64a",
   "speaker_korean": "서큐버스",
   "korean": "「그런 이유로 여기가\n두 번째 시련, 이 언니가\n놀아줄게♥"
  },
  {
   "key": "c42125bcc0b8",
   "speaker_korean": "서큐버스",
   "korean": "「참고로 너에게\n거부권은 없으니까, 그리 알아둬."
  },
  {
   "key": "e9db679c85fd",
   "speaker_korean": "서큐버스",
   "korean": "「그럼 시작해볼까♥"
  },
  {
   "key": "cafd9edbc9e5",
   "speaker_korean": "서큐버스",
   "korean": "「칫, 져버렸네.\n재미없어.\n뭐, 열심히 해보든가.\n갈 길은 아직 머니까."
  },
  {
   "key": "f73556b37f4a",
   "speaker_korean": null,
   "korean": "⟦1⟧・1하층 이동"
  },
  {
   "key": "cf252e7ab424",
   "speaker_korean": null,
   "korean": "⟦1⟧74000폴⟦2⟧을 얻었다."
  },
  {
   "key": "15369f2cd8c6",
   "speaker_korean": null,
   "korean": "⟦1⟧엘리멘탈 엣지⟦2⟧를 손에 넣었다."
  },
  {
   "key": "798ecf117d69",
   "speaker_korean": null,
   "korean": "⟦1⟧・뛰어내리기"
  },
  {
   "key": "4fac24744b98",
   "speaker_korean": null,
   "korean": "⟦1⟧・방을 북쪽으로 이동시키기"
  },
  {
   "key": "64e7caa42f33",
   "speaker_korean": null,
   "korean": "⟦1⟧・방을 동쪽으로 이동시키기"
  },
  {
   "key": "62769f30d9a1",
   "speaker_korean": null,
   "korean": "⟦1⟧・방을 남쪽으로 이동시키기"
  },
  {
   "key": "116d1c197d98",
   "speaker_korean": null,
   "korean": "⟦1⟧・방을 서쪽으로 이동시키기"
  },
  {
   "key": "629ed9313330",
   "speaker_korean": "페이트",
   "korean": "「…아무런 반응도 없군."
  },
  {
   "key": "ab9d00d096e1",
   "speaker_korean": null,
   "korean": "시련의 유적 3하층"
  },
  {
   "key": "ba5a51adac0b",
   "speaker_korean": null,
   "korean": "⟦1⟧버스트・에미션⟦2⟧을 손에 넣었다."
  }
 ]
}