{
 "batch_id": "batch_0103",
 "translations": [
  {
   "key": "1cac22bf3d70",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「큰일났다!\n어딘가에 숨어야 하는데…\n⟦P⟧"
  },
  {
   "key": "23c0b5105166",
   "speaker_korean": null,
   "korean": "시랜드 성 1층"
  },
  {
   "key": "a46ade341603",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「얌전히 따라오는 것도\n못 하는 거야?\n⟦P⟧"
  },
  {
   "key": "47dae6d64651",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「그럼, 얼른\n위로 가자.\n⟦P⟧"
  },
  {
   "key": "52aae5a3968d",
   "speaker_korean": null,
   "korean": "뭐, 좋아.\n아무튼 위로 가볼까.\n⟦P⟧"
  },
  {
   "key": "9c9a940a5192",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「너 말이야…\n순순히 남 뒤를 따라오는 것도\n못 하는 거야!?\n⟦P⟧"
  },
  {
   "key": "51a0542f3e82",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「무슨 일이야, ⟦2⟧페이트⟦3⟧?\n익숙지 않은 긴 여행으로 지친 거겠지.\n오늘 정도는 푹 쉬도록 해.\n⟦P⟧"
  },
  {
   "key": "ab984032886e",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「네가 싫다고 한다면\n딱히 협력을 강요하진 않을게.\n⟦P⟧그러니까 그렇게, 무리해서\n도망치려 하지 않아도 되잖아?\n⟦P⟧"
  },
  {
   "key": "dba21b2308c7",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「우힛\n여긴 예쁜 누나들이\n넘쳐나잖아!\n이거 완전 대박인데~~♪\n⟦P⟧"
  },
  {
   "key": "9661c6694582",
   "speaker_korean": "타이네브",
   "korean": "⟦1⟧「저기, 저…\n⟦2⟧베크렐 광산⟦3⟧에서 ⟦4⟧시랜드 성⟦5⟧까지라니,\n아무리 그래도 후퇴가 심하지 않습니까?\n⟦P⟧"
  },
  {
   "key": "571965a1e505",
   "speaker_korean": "파린",
   "korean": "⟦1⟧「음, 그게요…\n여러모로 준비는 완벽해요.\n⟦P⟧상대는 그 유명한 ⟦2⟧질풍⟦3⟧이니까요,\n배급 신청도 수월하게 통과했어요.\n⟦P⟧"
  },
  {
   "key": "fcf736313206",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「⟦2⟧전투함⟦3⟧이랑 맞짱을 뜨겠다니\n무모함의 극치라고\n해야겠지.\n⟦P⟧보통이라면 말이야, 제정신으론\n못 할 짓이라고.\n⟦P⟧"
  },
  {
   "key": "f1d66c664f68",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「걱정 붙들어 매.\n네 일은 말이야, 이 몸이\n확실히 지켜줄 테니까.\n⟦P⟧설사 상대가 ⟦2⟧전투함⟦3⟧이라 해도,\n그리 쉽게는\n당하게 두지 않아.\n⟦P⟧"
  },
  {
   "key": "8e91703d6140",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「우리도 할 만큼 했잖아?\n그럼 더 이상 신경 써봤자\n어쩔 수 없다고!\n⟦P⟧누구든 다 죽는 거야.\n⟦P⟧"
  },
  {
   "key": "8b873a97e160",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「이렇게까지 해놓고\n이제 와서 사이좋게 지내잔 것도 우습지.\n⟦P⟧타이밍 어긋난 평화 교섭 따위가\n무슨 의미가 있다는 건지…\n⟦P⟧"
  },
  {
   "key": "266965c50c83",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「⟦2⟧세피라⟦3⟧를 가지러 간다고 했으니\n대성당 지하통로로 가는 거지?\n⟦P⟧설마 말이야, 벌써 잊어버린 건\n아니겠지?\n⟦P⟧"
  },
  {
   "key": "03261c134abf",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「오랜만이네, ⟦2⟧넬⟦3⟧.\n또 한 번 잘 부탁한다.\n⟦P⟧"
  },
  {
   "key": "1dbbf5c0d780",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「드디어 마지막 싸움이군.\n정신 바짝 차리고 덤비자고.\n⟦P⟧여기까지 와서\n쓸데없이 다치기라도 하면\n시시하잖아.\n⟦P⟧"
  },
  {
   "key": "5a896940e793",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「⟦2⟧클레어⟦3⟧의 방에서 차를 마시고 있었더니\n느닷없이 호통을 치며 쫓아내지\n뭐란 말인가.\n⟦P⟧뭘 그리 부끄러워하는 게야?\n숨길 만한 것이 있는 것도\n아닐 텐데 말이야.\n⟦P⟧"
  },
  {
   "key": "a3cdec2b4012",
   "speaker_korean": "넬",
   "korean": "「이 위층에 있는\n알현실로 갈 거야."
  },
  {
   "key": "4110d81b8f4e",
   "speaker_korean": "넬",
   "korean": "「그곳은 예배당이야.\n⟦1⟧아페리스교⟦2⟧의 성지, ⟦3⟧가나안⟦4⟧으로의 순례는\n멀고 험난한 여정이니까.\n보통은 이 성 안에 있는 예배당에서\n참배하는 거지."
  },
  {
   "key": "492a0205f3c5",
   "speaker_korean": "페이트",
   "korean": "「예배당……"
  },
  {
   "key": "686493bbf57b",
   "speaker_korean": "넬",
   "korean": "「뭐, 관심이 있다면\n나중에 들여다보면 될 거야."
  },
  {
   "key": "8c35fe7589e5",
   "speaker_korean": "페이트",
   "korean": "「예, 그렇게 할게요."
  },
  {
   "key": "28bcdc18fde7",
   "speaker_korean": "넬",
   "korean": "「알현실은 이쪽이야.\n…따라와."
  },
  {
   "key": "e7ad38228d17",
   "speaker_korean": "클리프",
   "korean": "「저 안쪽은 뭐지?"
  },
  {
   "key": "a5b0dff28980",
   "speaker_korean": null,
   "korean": "이런 곳에서 뭘 하는 거지?\n여긴 관계자 외의 출입은\n금지되어 있을 텐데?\n⟦P⟧"
  },
  {
   "key": "cf0fbb474496",
   "speaker_korean": null,
   "korean": "죄송합니다.\n금방 나가겠습니다.\n용서해 주세요.\n⟦P⟧"
  },
  {
   "key": "d2af91bf4e26",
   "speaker_korean": "안절부절못하는 남자",
   "korean": "⟦1⟧「그, 그렇게 화내지\n말아 주세요오…\n⟦P⟧"
  },
  {
   "key": "695642784f0e",
   "speaker_korean": null,
   "korean": "그 녀석에게 맡길까.\n⟦P⟧"
  },
  {
   "key": "4087d707bdc9",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「예배라… 그렇군.\n⟦P⟧"
  },
  {
   "key": "30ed46f7830c",
   "speaker_korean": "안절부절못하는 남자",
   "korean": "⟦1⟧「그, 그런 거니까요.\n그럼, 저는 이만…\n⟦P⟧"
  },
  {
   "key": "d59741e174c7",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어라!?\n당신은 분명…\n⟦P⟧"
  },
  {
   "key": "61d7a2cd195a",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「거기 있는 건 누구야!?\n얌전히 나와.\n⟦P⟧"
  },
  {
   "key": "26951faa5905",
   "speaker_korean": null,
   "korean": "시랜드 성 2층"
  },
  {
   "key": "12b31e9e63fe",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「이쪽이야.\n⟦P⟧"
  },
  {
   "key": "0c489128b647",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「너, 폐하 앞에서\n정말 얌전히\n있을 수 있는 거지?\n⟦P⟧"
  },
  {
   "key": "ec562f273338",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「그럼, 지금부터 여왕 폐하와\n알현이 있을 텐데, 부디\n실례되는 일이 없도록 해.\n⟦P⟧"
  },
  {
   "key": "ef5213d7993c",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「너 말이야, 적당히 좀 해!\n애도 아니고, 따라오는 것 정도는\n할 수 있잖아!?\n⟦P⟧정말이지…\n⟦P⟧"
  },
  {
   "key": "ff832c856d25",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「이번에야말로 제대로 따라\n와야 해.\n⟦P⟧"
  },
  {
   "key": "95843557ddf9",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「부탁이니까, 폐하 앞에서만이라도\n얌전히 있어 줄래?\n⟦P⟧"
  },
  {
   "key": "2973d0b1c76d",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「이곳 여왕님이 말이 통하는 사람이라\n다행이었어.\n⟦P⟧괜히 억지를 부렸다면\n강경한 수단을 쓸 수밖에\n없었을 테니까.\n⟦P⟧"
  },
  {
   "key": "74b3cc640c39",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「그럼, ⟦2⟧루시퍼⟦3⟧의\n소재도 알아냈으니\n⟦P⟧자기 껍데기 속에 틀어박힌\n멍청한 신을 후려치러\n가볼까.\n⟦P⟧"
  },
  {
   "key": "62a08d22e682",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「오랜만이네, ⟦2⟧넬⟦3⟧.\n네가 힘을 보태준다면\n백 명 몫은 하겠어.\n⟦P⟧"
  },
  {
   "key": "1ec5f76ee256",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「누군가를 붙여두는 편이\n좋을 것 같네.\n⟦P⟧"
  },
  {
   "key": "021fcabfe062",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「어디 갔었던 거야!?\n⟦P⟧자, 가자.\n폐하를 기다리시게\n할 수는 없으니까.\n⟦P⟧"
  },
  {
   "key": "c71043dc3015",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「멈춰…\n⟦P⟧"
  },
  {
   "key": "9ffe2e263f7a",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「성 아래 마을에 살던 사람이네.\n⟦P⟧"
  },
  {
   "key": "c2793602718f",
   "speaker_korean": "안절부절못하는 남자",
   "korean": "⟦1⟧「저기…\n부끄러운 얘기지만요,\n⟦P⟧아까 예배를 드리러 왔다가\n길을 잃어버린\n것 같더라고요.\n⟦P⟧돌아가려 해도 돌아갈 수가 없어서\n계속 곤란해하던 참이었어요.\n⟦P⟧"
  },
  {
   "key": "b15214586eac",
   "speaker_korean": null,
   "korean": "그러고 보니, ⟦1⟧파린⟦2⟧이\n그런 거 잘하는 녀석이\n있다고 했었지.\n⟦P⟧"
  },
  {
   "key": "af03be919f17",
   "speaker_korean": "넬",
   "korean": "「접니다.\n기술자를 데려왔습니다."
  },
  {
   "key": "f88719f84ae3",
   "speaker_korean": "에레나",
   "korean": "「들라."
  },
  {
   "key": "11ded0c888c7",
   "speaker_korean": "넬",
   "korean": "「여기야."
  }
 ]
}