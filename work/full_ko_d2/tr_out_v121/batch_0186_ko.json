{
 "batch_id": "batch_0186",
 "translations": [
  {
   "key": "dfacc5aa3f87",
   "speaker_korean": "페이트",
   "korean": "「다들……."
  },
  {
   "key": "1a8d6864d1aa",
   "speaker_korean": "페이트",
   "korean": "「아, 다들 무사했구나.\n다행이야."
  },
  {
   "key": "6ab95e2a4206",
   "speaker_korean": "넬",
   "korean": "「결국 어떻게 된 거야?\n우리는 사라져 버린 거잖아?"
  },
  {
   "key": "1486427cb48e",
   "speaker_korean": "페이트",
   "korean": "「그러게.\n루시퍼가 뭐라고 하든\n그것만은 분명 있었던 거야."
  },
  {
   "key": "a96f42adc04d",
   "speaker_korean": "마리아",
   "korean": "「그러니까 말이야.\n그러니까 그 루시퍼라 해도\n우리의 의식을 지울 수는 없었던 거야.\n루시퍼는 말이지\n그곳에 존재하는 것처럼 보이게 했던 것을\n다시 무로 되돌리려 했을 뿐이야.\n그걸로는 실제로 그곳에 있는 것을\n지울 수는 없는 거야."
  },
  {
   "key": "02e98574f07d",
   "speaker_korean": "소피아",
   "korean": "「그러니까, 이런 거려나?\n그 루시퍼는 끝까지 우리의 존재를\n인정하지 않았던 거야.\n그래서 오히려 우리는 지금\n이렇게 여기 존재하고 있는 거라고…"
  },
  {
   "key": "325ec1eb2258",
   "speaker_korean": "페이트",
   "korean": "「아마도…\n우리 세계는, 엄밀히 말하면\n지금은 이미 존재하지 않을지도 몰라.\n하지만 우리는 우리 자신의 마음으로\n우리 세계가 있다고 느낄 수 있어."
  },
  {
   "key": "bc9293e98543",
   "speaker_korean": "스프레",
   "korean": "「걱정했단 말이야~!"
  },
  {
   "key": "a8ecd08d4bff",
   "speaker_korean": "넬",
   "korean": "「드디어 돌아왔네.\n늦었잖아."
  },
  {
   "key": "568822317c95",
   "speaker_korean": "마리아",
   "korean": "「어서 와, 페이트."
  },
  {
   "key": "7e065e82e50a",
   "speaker_korean": "클리프",
   "korean": "「의외로 늦었잖아."
  },
  {
   "key": "2d65c6343634",
   "speaker_korean": "스프레",
   "korean": "「결국 어떻게 된 거였을까?\n우리들… 사라져 버린 거지?"
  },
  {
   "key": "437742e61aa0",
   "speaker_korean": "마리아",
   "korean": "「하지만 말이야\n설령 우리 세계에 있던\n모든 것이 허구였다 해도\n그 세계가 실재한다고 믿었던 우리의\n마음 그 자체는 분명 존재했던 거야."
  },
  {
   "key": "7f83b399bcfe",
   "speaker_korean": "마리아",
   "korean": "「그 세계에 있는 모든 사람들이\n다 같이 세계의 존재를 느낄 수\n있다면, 그 세계는\n역시 존재하는 셈이 되는 거야."
  },
  {
   "key": "da5e660d79d6",
   "speaker_korean": "소피아",
   "korean": "「설령 실제로는\n어땠다 하더라도…"
  },
  {
   "key": "6d1c8d020ca9",
   "speaker_korean": "클리프",
   "korean": "「뭐, 좋잖냐.\n이걸로 다 끝난 거잖아?\n그럼 그걸로 됐다고 치자고."
  },
  {
   "key": "36c0dd8e5716",
   "speaker_korean": "스프레",
   "korean": "「으~… 나는~\n그런 어려운 얘기는 좀 패스."
  },
  {
   "key": "78504f7679e9",
   "speaker_korean": "넬",
   "korean": "「꽤나 철학적인 얘기네… 참."
  },
  {
   "key": "e489ebe23c3f",
   "speaker_korean": "페이트",
   "korean": "「그렇네.\n우린 여기 있고, 세계도 여기 있어.\n그것만으로도 충분해……\n돌아가자. 우리가 있어야 할 세계로."
  },
  {
   "key": "df969320a715",
   "speaker_korean": "로저",
   "korean": "「늦었잖아!"
  },
  {
   "key": "3ec65d073eef",
   "speaker_korean": "로저",
   "korean": "「근데, 음… 결국 어떻게 된 거야?\n우리들은 세계랑 같이\n사라져 버린 거 아니냐?"
  },
  {
   "key": "57ff7826de9d",
   "speaker_korean": "페이트",
   "korean": "「근데, 결국 어떻게 된 걸까?"
  },
  {
   "key": "a657f280f636",
   "speaker_korean": "알벨",
   "korean": "「나한테 묻지 마, 멍청아.\n알 리가 없잖아."
  },
  {
   "key": "10a0a723d64d",
   "speaker_korean": "알벨",
   "korean": "「흥, 늦었잖아, 멍청아."
  },
  {
   "key": "2aa8a4bdc263",
   "speaker_korean": "로저",
   "korean": "「응? …응? 응? 응? 응?\n그러니까… 결국 어떻게 된 거냐고!?"
  },
  {
   "key": "fc2a58b1854e",
   "speaker_korean": "알벨",
   "korean": "「어쨌든 우리가 이겼다는 거군."
  },
  {
   "key": "144488140636",
   "speaker_korean": "소피아",
   "korean": "「응, 돌아가자, 페이트.\n우리들의… 모두의 세계로!"
  },
  {
   "key": "2603bc4d333f",
   "speaker_korean": "마리아",
   "korean": "「그래, 돌아가자.\n우리들의… 모두의 세계로!"
  },
  {
   "key": "89c301f36152",
   "speaker_korean": "클리프",
   "korean": "「그렇지."
  },
  {
   "key": "0c5ebd025859",
   "speaker_korean": "넬",
   "korean": "「그러네… 같이 돌아가자.\n우리 세계로."
  },
  {
   "key": "9e653d29e85d",
   "speaker_korean": "로저",
   "korean": "「돌아갈까… 우리들의 세계로!"
  },
  {
   "key": "860c5d42f5ba",
   "speaker_korean": "스프레",
   "korean": "「응, 돌아가자.\n우리들의… 모두의 세계로!"
  },
  {
   "key": "d60cf13210be",
   "speaker_korean": "마리아",
   "korean": "「우리 세계에서 눈에 보이는 것\n만질 수 있는 것…\n분명, 그것들은 모두\n그렇게 인식되도록 만들어졌을 뿐인\n가짜였는지도 몰라.\n그래서였을까, 루시퍼에 의해\n그것들을 더는 인식할 수 없게\n되어 버렸을 때\n모든 것이 사라져 버린 거야."
  },
  {
   "key": "4935a3f8ce37",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어때?\n마을로 가는 길은 찾았어?\n⟦P⟧"
  },
  {
   "key": "69e461a3d0d0",
   "speaker_korean": "알벨",
   "korean": "⟦1⟧「아니.\n마을이나 촌락은커녕, 말 상대할 인간은\n한 명도 없어.\n⟦P⟧"
  },
  {
   "key": "1c19b5615904",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어쩔 수 없네.\n이대로 못 찾으면\n오늘은 노숙하는 수밖에 없나.\n⟦P⟧"
  },
  {
   "key": "6cb4ad6bf85f",
   "speaker_korean": "알벨",
   "korean": "⟦1⟧「농담하지 마. 난 사양이다.\n또 저번처럼 걷어차여서\n한밤중에 두들겨 깨는 꼴 당할까 보냐.\n⟦P⟧"
  },
  {
   "key": "15a51d973463",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그렇게 말하는 알벨도\n맨날 한밤중에 잠꼬대하면서\n시끄럽잖아.\n⟦P⟧남 일에 트집 잡기 전에\n네 일이나 먼저 어떻게 좀 해.\n⟦P⟧"
  },
  {
   "key": "4c203dc1a28b",
   "speaker_korean": "알벨",
   "korean": "⟦1⟧「시끄러워!\n쓸데없는 참견이다.\n하고 싶은 말은 그게 다냐?\n죽고 싶지 않으면 더 이상\n입 놀리는 걸 그만두는 게 좋을 거다.\n⟦P⟧"
  },
  {
   "key": "b4c1f283213b",
   "speaker_korean": null,
   "korean": "따지고 보면 지금 헤매는 것도\n원래는\n알벨 탓이잖아.\n⟦P⟧"
  },
  {
   "key": "fe17dd75149d",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「무슨 꿈을 꾸는지 모르겠지만\n한밤중에 끙끙대면서 시끄럽다고.\n⟦P⟧"
  },
  {
   "key": "da7968a7eabc",
   "speaker_korean": null,
   "korean": "알벨이 저번 마을에서\n영주랑 괜한 소동만 안 일으켰으면\n다음 마을까지 가는 길 지도를\n제대로 사 왔을 거 아니야?\n⟦P⟧"
  },
  {
   "key": "900f158d7a6d",
   "speaker_korean": "알벨",
   "korean": "⟦1⟧「쳇!\n제대로 된 인간은 하나도 없나.\n⟦P⟧"
  },
  {
   "key": "280fa526e004",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「전부 6명…\n그걸로 괜찮았던 걸까?\n⟦P⟧"
  },
  {
   "key": "adaa67989621",
   "speaker_korean": "알벨",
   "korean": "⟦1⟧「아니, 5명이다.\n⟦P⟧"
  },
  {
   "key": "cd0d2dee5c5f",
   "speaker_korean": null,
   "korean": "그건 그렇고, 아무리\n나쁜 영주 밑 놈들이라도\n너무 심하게 하진 마.\n⟦P⟧"
  },
  {
   "key": "73da5ba6526e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「제대로 과거형으로 말했잖아?\n⟦P⟧"
  },
  {
   "key": "793042605dda",
   "speaker_korean": "알벨",
   "korean": "⟦1⟧「딱히 죽이진 않았어.\n강한 놈한테 빌붙어서 자기가 강해진\n줄 아는 멍청이들한텐\n그 정도가 딱 좋은 약이지.\n⟦P⟧"
  },
  {
   "key": "1f11cbbdf34d",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어휴.\n나와 싸울 3명 빼고는 안됐네…\n⟦P⟧"
  },
  {
   "key": "2483f40719ee",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「진짜…\n적당히 좀 봐주라고\n말했잖아?\n⟦P⟧"
  },
  {
   "key": "bd5e0d1bc3db",
   "speaker_korean": "양아치",
   "korean": "⟦1⟧「히익!\n사, 살려줘~!!\n⟦P⟧"
  },
  {
   "key": "c8e8e7d17dce",
   "speaker_korean": "알벨",
   "korean": "⟦1⟧「그 정도는 필요해.\n저런 놈들은 일주일은 재워두지 않으면\n반성 따위 하지도 않아.\n⟦P⟧"
  },
  {
   "key": "272d26b13b6c",
   "speaker_korean": "알벨",
   "korean": "⟦1⟧「후우…\n⟦P⟧"
  }
 ]
}