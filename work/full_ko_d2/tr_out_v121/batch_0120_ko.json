  },
  {
   "key": "879f72a5546b",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(따끈따끈한 플립북이네….\n이래도 되나, 이거?\n⟦P⟧"
  },
  {
   "key": "25e8d41ff29c",
   "speaker_korean": null,
   "korean": "『작전명은 A의 3호』\n『일도양단 이도분단』\n『버닝 ⟦1⟧버니⟦2⟧』…\n⟦P⟧"
  },
  {
   "key": "8f1b466f9960",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(잠입 공작물에, 역사 위인물,\n동물과의 교감 우정물, 그리고….\n통일감이 있는 듯 없는 듯.\n⟦P⟧"
  },
  {
   "key": "277e75261b9d",
   "speaker_korean": null,
   "korean": "손을 가까이 대보니 따뜻하다.\n아무래도 난방 같은 듯하다.\n⟦P⟧"
  },
  {
   "key": "f5588c80a935",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(밀봉되어 있다는 건\n단순히 뭔가가 타고 있는\n건 아니겠지….\n⟦P⟧역시 이것도 ⟦2⟧시술⟦3⟧…\n⟦4⟧문장⟦5⟧의 힘을 쓰는 걸까?\n⟦P⟧"
  },
  {
   "key": "a88fd089aa6c",
   "speaker_korean": null,
   "korean": "읽던 책이 바닥 위에\n놓여 있다.\n『마법소녀 각오의 권유』…\n⟦P⟧"
  },
  {
   "key": "086f9687ff3c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(마법소녀라고 할 거면\n읽은 책 정도는 확실히\n치우라고….\n⟦P⟧"
  },
  {
   "key": "77728b30b9af",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(코멘트는\n굳이 피하자….\n⟦P⟧"
  },
  {
   "key": "83bd6a024b15",
   "speaker_korean": null,
   "korean": "『마도사 살리에리』\n『비밀왕당파 아크코사인』\n『궁정의 파니』\n『돈 사냥 벚꽃』…\n⟦P⟧"
  },
  {
   "key": "e0a1dea1f776",
   "speaker_korean": null,
   "korean": "읽은 책이 아무렇게나 쌓여 있다.\n보기에 그다지 기분 좋은\n광경은 아니다.\n⟦P⟧"
  },
  {
   "key": "fc2910d909a0",
   "speaker_korean": "엘리자의 마법소녀 일기",
   "korean": "⟦1⟧「악의 제국 ⟦2⟧아리그리프⟦3⟧ 타도 위해\n오늘도 밤새 열심히 일해.\n힘내라, 엘리자!\n⟦P⟧다음화, 마법소녀 엘리자A⟦4⟧.\n『봄 새벽, 스모 료고쿠』에\n트랜스포트♪\n⟦P⟧"
  },
  {
   "key": "aa40639bd5dc",
   "speaker_korean": "엘리자의 마법소녀 일기",
   "korean": "⟦1⟧「악의 제국 ⟦2⟧아리그리프⟦3⟧와 싸우던 중에\n더 나쁜 군단, ⟦4⟧별의 배⟦5⟧가 쳐들어\n왔어.\n힘내라, 엘리자.\n⟦P⟧다음 회, 마법소녀 엘리자A⟦6⟧.\n『거짓말~! 공파참이 안 통해?』에\n트랜스포트♪\n⟦P⟧"
  },
  {
   "key": "b5c38ce4bb47",
   "speaker_korean": "엘리자의 마법소녀 일기",
   "korean": "⟦1⟧「⟦2⟧별의 배⟦3⟧의 어마어마한 강함에 놀란\n⟦4⟧아리그리프⟦5⟧ 사람들이 동료가 되자고\n말을 걸어왔어.\n근데, 믿어도 될까?\n⟦P⟧다음 회, 마법소녀 엘리자A⟦6⟧.\n『알곤・골곤・⟦7⟧에어드래곤⟦8⟧』에\n트랜스포트♪\n⟦P⟧"
  },
  {
   "key": "24596111724a",
   "speaker_korean": "엘리자의 마법소녀 일기",
   "korean": "⟦1⟧「그 ⟦2⟧아리그리프⟦3⟧와 함께 싸우게\n된 건 좋은데….\n지금 엘리자의 힘으론 ⟦4⟧별의 배⟦5⟧를 못 이겨.\n좋아, 이렇게 된 이상 특훈이야!\n⟦P⟧다음 회, 마법소녀 엘리자A⟦6⟧.\n『비밀 특훈. 터져라 필살 엘리자 킥』에\n트랜스포트♪\n⟦P⟧"
  },
  {
   "key": "0bf3f02f378f",
   "speaker_korean": "엘리자의 마법소녀 일기",
   "korean": "⟦1⟧「자, 다들.\n드디어 마지막 대결전이야.\n엘리자에게 다들 힘을 빌려줘!\n⟦P⟧다음 회, 마법소녀 엘리자A⟦2⟧ 최종회!\n『잘 가, 엘리자.\n 이게 내 마지막 마법』에\n트랜스포트♪\n⟦P⟧"
  },
  {
   "key": "24dbab4801a4",
   "speaker_korean": "엘리자의 마법소녀 일기",
   "korean": "⟦1⟧「다들, 오랜만♪\n위대하신 마녀왕 펠미나 님의 명으로\n다들의 엘리자가 다시 인간계로\n돌아왔어!\n⟦P⟧신연재, 마법소녀 엘리자A⟦2⟧.\n『처음 뵙겠습니다, 그리고 오랜만입니다』에\n트랜스포트♪\n⟦P⟧"
  },
  {
   "key": "a2fceb570f6a",
   "speaker_korean": "엘리자의 마법소녀 일기",
   "korean": "⟦1⟧「마녀왕 펠미나 님이 봉인했을 터인\n나~쁜 마물들이 어쩐 일인지\n모르게 깨어나 버렸어.\n이렇게 된 이상, 싸울 수밖에 없네!\n⟦P⟧다음 회, 마법소녀 엘리자A⟦2⟧.\n『왜~!?\n 갑자기 봉후파가 안 통해』에\n트랜스포트♪\n⟦P⟧"
  },
  {
   "key": "629a93b103f2",
   "speaker_korean": "엘리자의 마법소녀 일기",
   "korean": "⟦1⟧「큰일, 큰일이야!\n나쁜 마법의 영향으로 숲의 동물들이랑 마을 사람들이\n차례차례 마물이 되어가고 있어.\n아~앙, 이러다간 끝이 없어~!\n⟦P⟧다음 회, 마법소녀 엘리자A⟦2⟧.\n『싫어~!\n 이제 마법소녀 따위 그만둘래~』에\n트랜스포트♪\n⟦P⟧"
  },
  {
   "key": "60093445c30e",
   "speaker_korean": null,
   "korean": "마치 얼어붙은 듯한 냉기가\n흘러넘치고 있다.\n⟦P⟧"
  },
  {
   "key": "6a4e2125520e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(어지간한\n쿨러라는 건가….\n⟦P⟧"
  }
 ]
