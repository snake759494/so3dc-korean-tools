{
 "batch_id": "batch_0231",
 "translations": [
  {
   "key": "7b1998ae04cc",
   "speaker_korean": "클리프",
   "korean": "「그렇게 편리한 게 있으면\n진작 좀 써먹으면 되잖아"
  },
  {
   "key": "54b74dc6f2df",
   "speaker_korean": "블레어",
   "korean": "「그건 그런데 말이지\n이 ⟦1⟧언인스톨러⟦2⟧에도 문제가 있어서\n⟦3⟧에터널 스피어⟦4⟧ 내부에서 작동시키지 않으면\n효과가 없거든\n엑스큐셔너 프로젝트는\n그 특수한 성질 때문에 이쪽에서\n간섭할 수 없게 설정돼 있어"
  },
  {
   "key": "6e90a76e382e",
   "speaker_korean": "연구원",
   "korean": "「그래, 이미 그자들을 지우기 위한\n⟦1⟧언인스톨러⟦2⟧를 준비해 뒀네"
  },
  {
   "key": "253f5c8879cf",
   "speaker_korean": "소피아",
   "korean": "「그게 문제인가요?\n그냥 저쪽에 가면 되잖아요―――"
  },
  {
   "key": "b9eebf24b8bf",
   "speaker_korean": "소피아",
   "korean": "「어, 하지만…"
  },
  {
   "key": "fdf9e9f23f29",
   "speaker_korean": "페이트",
   "korean": "「응\n우리는 ⟦1⟧제미티 시⟦2⟧에서 대형 단말을\n통해 ⟦3⟧에터널 스피어⟦4⟧에\n갈 수 있었지만…"
  },
  {
   "key": "9b0d6138df96",
   "speaker_korean": "연구원",
   "korean": "「그래, 자네들은 특별한 존재인 것 같네\n어떤 구조로 되어 있는지는\n구체적으로는 모르겠지만\n자네들에게는 이쪽과 ⟦1⟧에터널 스피어⟦2⟧를\n가로막는 장벽을 뚫을 수 있는 힘이 있는 모양이야\n이해는 안 되지만\n사실이 그러니 어쩔 수 없지"
  },
  {
   "key": "ecb31061c995",
   "speaker_korean": "마리아",
   "korean": "「흐음… 그런 거군"
  },
  {
   "key": "0c1a76c0a9f4",
   "speaker_korean": "클리프",
   "korean": "「뭐가 그런 건데?"
  },
  {
   "key": "56a0eadefaca",
   "speaker_korean": "마리아",
   "korean": "「둔하네\n요컨대 우리한테 ⟦1⟧언인스톨러⟦2⟧를 들고\n⟦3⟧에터널 스피어⟦4⟧에 가라는 말이잖아\n지금은 우리 말고는 저쪽에\n갈 수 없으니까"
  },
  {
   "key": "22078d9b41ec",
   "speaker_korean": "블레어",
   "korean": "「그런 거지\n너희 목적도 같은 거니까\n불만은 없을 거라고 보는데?"
  },
  {
   "key": "a9ee57b8f613",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧언인스톨러⟦2⟧를 쓰면\n확실하게 ⟦3⟧엑스큐셔너⟦4⟧를\n소멸시킬 수 있는 거죠?"
  },
  {
   "key": "3f7e09a009bb",
   "speaker_korean": "연구원",
   "korean": "「그래\n믿어도 좋다고 생각하네"
  },
  {
   "key": "7ee8175a32df",
   "speaker_korean": "페이트",
   "korean": "「알겠습니다\n믿겠습니다"
  },
  {
   "key": "1c630dd2b091",
   "speaker_korean": "블레어",
   "korean": "「최고인지는 모르겠지만\n내 나름대로 최선을 다해 만들었어"
  },
  {
   "key": "62f426b844d3",
   "speaker_korean": "블레어",
   "korean": "「고마워"
  },
  {
   "key": "76b647dc6b07",
   "speaker_korean": "클리프",
   "korean": "「그래서 우리는 어떻게\n저쪽으로 가면 되는 거야?\n⟦1⟧제미티 시⟦2⟧까지 돌아가야 하나?"
  },
  {
   "key": "eb09d3a39b2f",
   "speaker_korean": "연구원",
   "korean": "「지금은 이 빌딩에서 ⟦1⟧제미티 시⟦2⟧로\n이동할 수 없네\n이미 ⟦3⟧스테이션⟦4⟧으로 가는 경로는\n차단·봉쇄됐어\n아마 자네들을 놓치지 않으려는\n속셈이겠지만 말이야"
  },
  {
   "key": "b0b004bac69c",
   "speaker_korean": "블레어",
   "korean": "「그렇다면 이 빌딩 안에 있는\n단말을 써야 한다는 거네"
  },
  {
   "key": "8d8052bba1ae",
   "speaker_korean": "마리아",
   "korean": "「이 빌딩에도\n단말이 있다는 거네?"
  },
  {
   "key": "3ecc1726980a",
   "speaker_korean": "블레어",
   "korean": "「응\n있긴 있는데…"
  },
  {
   "key": "c0c919726b1e",
   "speaker_korean": "소피아",
   "korean": "「무슨 문제라도 있나요?"
  },
  {
   "key": "bf6e635d6e48",
   "speaker_korean": "블레어",
   "korean": "「장소가 말이지…"
  },
  {
   "key": "79ea6e8a3f65",
   "speaker_korean": "페이트",
   "korean": "「장소요?"
  },
  {
   "key": "419c36a390f8",
   "speaker_korean": "연구원",
   "korean": "「그래… 단말이 있는 곳은\n가장 보안이\n삼엄한 구역이라네"
  },
  {
   "key": "aa2720c52bb8",
   "speaker_korean": "마리아",
   "korean": "「그게 다야?\n단말 자체에는 문제없고?"
  },
  {
   "key": "b947bdab228a",
   "speaker_korean": "블레어",
   "korean": "「그건 괜찮을 거야\n새로 보안을\n강화했다는 얘긴 못 들었고\n애초에 아무도 은하계에는 접속\n못 하게 되어 있었거든\n그런데도 너희는\n은하계에 갈 수 있으니까…"
  },
  {
   "key": "3ffd67e53eb4",
   "speaker_korean": "클리프",
   "korean": "「그럼 고민할 거 없잖아\n그냥 가면 되는 거다"
  },
  {
   "key": "a7b3d062f8fa",
   "speaker_korean": "페이트",
   "korean": "「아, ⟦1⟧블레어 씨⟦2⟧\n그 단말까지는 어떻게\n가면 되나요?"
  },
  {
   "key": "dd501c5f8f3f",
   "speaker_korean": "블레어",
   "korean": "「단말은 오너실이 있는\n최상층에 있어"
  },
  {
   "key": "258219a632c2",
   "speaker_korean": "페이트",
   "korean": "「알겠습니다\n다들… 가자!!"
  },
  {
   "key": "fa53a10f9cb4",
   "speaker_korean": "블레어",
   "korean": "「잠깐 기다려\n나도 같이 갈게"
  },
  {
   "key": "0421e744ff9e",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧블레어 씨⟦2⟧?"
  },
  {
   "key": "de3f3ba84038",
   "speaker_korean": "연구원",
   "korean": "「⟦1⟧블레어⟦2⟧, 무슨 소리야!?"
  },
  {
   "key": "47fd3e91c8d8",
   "speaker_korean": "블레어",
   "korean": "「너희만으로는 최상층까지\n못 갈 수도 있어\n단말까지 가는 길에 무슨 보안이\n걸려 있지 않다고도 할 수 없고\n⟦1⟧에터널 스피어⟦2⟧에서는 너희에게\n도움이 못 될지도 모르지만\n여기서는 아직 내가 도움이 될 수 있어\n뭐, 전투에서는 쓸모없겠지만"
  },
  {
   "key": "98314755fa32",
   "speaker_korean": "페이트",
   "korean": "「하지만…"
  },
  {
   "key": "0637bc095804",
   "speaker_korean": "마리아",
   "korean": "「좋잖아\n여기선 도움을 받자"
  },
  {
   "key": "e3e1f205e21c",
   "speaker_korean": "클리프",
   "korean": "「그렇지\n우리가 모르는 게 너무 많아\n도와주겠다는 걸\n굳이 마다할 것까진 없잖아"
  },
  {
   "key": "0ee75a1b6080",
   "speaker_korean": "페이트",
   "korean": "「알겠습니다\n부탁드립니다"
  },
  {
   "key": "a3c4616fdba1",
   "speaker_korean": "블레어",
   "korean": "「이 문 너머에 있는 대형\n엘리베이터를 이용하자\n최상층에 에터널 스피어 단말이\n있어"
  },
  {
   "key": "6a800ce1535e",
   "speaker_korean": "블레어",
   "korean": "「맡겨 둬\n이쪽이야"
  },
  {
   "key": "33e3ce2c3373",
   "speaker_korean": "연구원",
   "korean": "「어쨌든 ⟦1⟧스피어사⟦2⟧에서도\n손꼽히는 실력자인\n그녀가 만든 거니까요"
  },
  {
   "key": "20b961bc1674",
   "speaker_korean": "연구원",
   "korean": "「그러기 위해서 ⟦1⟧엑스큐셔너⟦2⟧를\n어떻게 할지 고민하고 있었어\n세상을 파괴하는 악마 같은 존재를\n방치해 둘 수는 없으니까"
  },
  {
   "key": "56ab290eb0a1",
   "speaker_korean": "연구원",
   "korean": "「아마 보안부도 그곳 경비에\n많은 인원을 투입했을 거야"
  },
  {
   "key": "23cc922f08e5",
   "speaker_korean": "연구원",
   "korean": "「지금 현재 ⟦1⟧에터널 스피어⟦2⟧ 내\n은하계 구역에는 침입할 수 없어\n처리가 끝날 때까지는 일반 단말로는\n접속할 수가 없거든"
  },
  {
   "key": "9637bf2553ae",
   "speaker_korean": null,
   "korean": "⟦1⟧언인스톨러⟦2⟧를 손에 넣었다"
  }
 ]
}