{
 "batch_id": "batch_0057",
 "translations": [
  {
   "key": "af7f477f1814",
   "speaker_korean": null,
   "korean": "예의 그 물건, 있습니다.\n부담 없이 상담하세요.\n\n⟦1⟧딜나의 숨결 점왕\n⟦P⟧"
  },
  {
   "key": "d5e3aff769ed",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n찬찬히 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "cd9db52c2493",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n천천히 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "44bc56e9e540",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n실컷 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "4d21f2b77c40",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n흠뻑 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "5b75b7d5f813",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n또렷이 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "da2ca69a0760",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n곰곰이 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "1bc8e3ed7f95",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n빈틈없이 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "8a15550e3f1f",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n분명히 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "e9de207c98e6",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어서 오세요.\n꼼꼼히 보고 가세요.\n⟦P⟧"
  },
  {
   "key": "f5704d3cba25",
   "speaker_korean": null,
   "korean": "도구점 딜나의 숨결"
  },
  {
   "key": "7f2cb0b74ce4",
   "speaker_korean": null,
   "korean": "도둑질 금지.\n위병 말고 딴 데 넘깁니다.\n\n⟦1⟧딜나의 숨결 점왕\n⟦P⟧"
  },
  {
   "key": "cca48a02aa5b",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「활활, 불타오르기 시작했어!\n저 등신들한테는, 이 몸이\n싸우는 법을 가르쳐 주지.\n⟦P⟧"
  },
  {
   "key": "762a2152347b",
   "speaker_korean": "매서운 눈매의 아가씨",
   "korean": "⟦1⟧「뭐야 여기!\n술집이 없다니 이게 무슨 소리야.\n⟦P⟧이런 데서 살다간,\n숨이 막혀 죽어버리겠잖아.\n여기 사람들, 진짜 이상하다니까.\n⟦P⟧"
  },
  {
   "key": "b089f0aee536",
   "speaker_korean": null,
   "korean": "아마추어 판단으로 섞는 조합은\n매우 위험합니다.\n그 길의 프로에게 맡기세요.\n⟦P⟧"
  },
  {
   "key": "cc9ba12daae0",
   "speaker_korean": null,
   "korean": "종업원 외 출입 금지.\n\n\n⟦1⟧솔론의 인도정 점왕\n⟦P⟧"
  },
  {
   "key": "d22f0f311d4b",
   "speaker_korean": null,
   "korean": "여관 솔론의 인도정"
  },
  {
   "key": "72fee819aa18",
   "speaker_korean": null,
   "korean": "야간 음주 등 민폐 행위는\n금지하고 있습니다.\n\n⟦1⟧솔론의 인도정 점왕\n⟦P⟧"
  },
  {
   "key": "3e31eefa183f",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「알고 있겠지만…\n지금은 ⟦2⟧이글⟦3⟧로 돌아갈 순 없다고.\n⟦P⟧우린 신도 뭣도 아니야.\n눈앞의 1을 구하자고\n다른 10을 죽이러 갈 수는\n없는 노릇이라고.\n⟦P⟧"
  },
  {
   "key": "d50b69829229",
   "speaker_korean": "약간 마른 남자",
   "korean": "⟦1⟧「어서 오세요, 묵으시겠습니까?\n그러시면 ⟦2⟧500폴⟦3⟧이 되겠습니다.\n⟦P⟧"
  },
  {
   "key": "5af044af6e1f",
   "speaker_korean": null,
   "korean": "⟦1⟧・예, 묵겠습니다."
  },
  {
   "key": "1a155e6c27ba",
   "speaker_korean": null,
   "korean": "⟦1⟧・아뇨, 아닙니다."
  },
  {
   "key": "df57ec6d8614",
   "speaker_korean": "약간 마른 남자",
   "korean": "⟦1⟧「그러십니까…\n죄송합니다.\n⟦P⟧"
  },
  {
   "key": "f49492a1dd3e",
   "speaker_korean": "약간 마른 남자",
   "korean": "⟦1⟧「혹시 돈이 부족하신 게\n아닌가요?\n⟦P⟧"
  },
  {
   "key": "dcdc730d96f6",
   "speaker_korean": "약간 마른 남자",
   "korean": "⟦1⟧「감사합니다.\n또 들러 주세요.\n⟦P⟧"
  },
  {
   "key": "cf6b4d6eb93e",
   "speaker_korean": null,
   "korean": "제목『시대의 여명』\n⟦P⟧"
  },
  {
   "key": "cc48a353fdd6",
   "speaker_korean": null,
   "korean": "피난 사다리 사용법.\n⟦P⟧"
  },
  {
   "key": "a6447fedb24c",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「⟦2⟧아미나 씨⟦3⟧는\n저에게 맡겨 주세요.\n⟦P⟧의학은 조금 아는 게\n있으니까요.\n⟦P⟧"
  },
  {
   "key": "a1af311cc2dc",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「벌써 움직여도 괜찮은가요?\n전쟁 중에 쓰러졌다고\n들었습니다만.\n⟦P⟧"
  },
  {
   "key": "8d9df418f341",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「감사합니다.\n⟦2⟧페이트 씨⟦3⟧.\n⟦P⟧정말…,\n뭐라고 감사를 드려야\n할지….\n⟦P⟧"
  },
  {
   "key": "e180d9033a63",
   "speaker_korean": null,
   "korean": "지금은 잠들어 있는 것 같다.\n⟦P⟧"
  },
  {
   "key": "a090228dc748",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「그렇게까지 분위기 띄워 놓고\n갑자기 a턴이라니….\n⟦P⟧형은 말이야, 그 자리 분위기란 걸\n전혀 모른다니까!\n⟦P⟧"
  },
  {
   "key": "eda538db8794",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「아리따운 ⟦2⟧넬 누나⟦3⟧랑\n또다시 함께할 수 있다니,\n이 몸은 정말 운이 좋구나.\n⟦P⟧"
  },
  {
   "key": "05dffda93812",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「이 몸들은 ⟦2⟧ＦＤ인⟦3⟧의\n인형 따위가 아니라고!\n⟦P⟧그렇지, 안 그래 형!?\n그렇다니까!\n⟦P⟧"
  },
  {
   "key": "c2a99db11379",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「그 ⟦2⟧루시퍼⟦3⟧란 놈이 뭘 하든,\n무슨 일이 있어도 계속 살아남을 거야.\n이 몸 나름의 저항으로서 말이야.\n⟦P⟧"
  },
  {
   "key": "9c1218399f03",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「본인인 ⟦2⟧아미나 씨⟦3⟧의 뜻은\n존중하겠지만, 그녀가 위험한 상태인\n것에는 변함이 없습니다.\n⟦P⟧절대로, 무리한 일만은\n시키지 말아 주세요.\n⟦P⟧"
  },
  {
   "key": "8bb0e3011463",
   "speaker_korean": null,
   "korean": "제목『초원』\n⟦P⟧"
  },
  {
   "key": "0ca5ba78c10a",
   "speaker_korean": null,
   "korean": "제목『탁상의 꽃』\n⟦P⟧"
  },
  {
   "key": "7bd9e09d44d1",
   "speaker_korean": null,
   "korean": "제목 단지\n⟦P⟧"
  },
  {
   "key": "f4d610748d71",
   "speaker_korean": null,
   "korean": "제목『춤추는 꽃』\n⟦P⟧"
  },
  {
   "key": "897bfa9d374a",
   "speaker_korean": null,
   "korean": "제목『약동의 정적』\n⟦P⟧"
  },
  {
   "key": "aa832f55ce61",
   "speaker_korean": null,
   "korean": "룸서비스는\n아침 6:00 ~ 밤 24:00 까지\n받고 있습니다.\n⟦P⟧"
  },
  {
   "key": "54d5cae09b8a",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「죄송해요.\n저, ⟦2⟧페이트 씨⟦3⟧에게는\n폐만 끼치고….\n⟦P⟧"
  },
  {
   "key": "78385b7ef9e8",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「괜찮아요.\n이제, 완전히 나았어요….\n⟦P⟧"
  },
  {
   "key": "a793429f5ae4",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어때, 몸 상태는?\n⟦P⟧"
  },
  {
   "key": "5242bf80691d",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「정말로, 괜찮은데요….\n어라?\n이상하네….\n⟦P⟧"
  },
  {
   "key": "9594e73ef093",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「무리하지 않아도 돼.\n⟦P⟧"
  },
  {
   "key": "2236f482b500",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「죄송해요.\n평소에는, 좀 더 편한데….\n⟦P⟧"
  },
  {
   "key": "a9819e044820",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「진짜 참….\n이 몸들의 가능성을,\n쥐꼬리만 한 자기만족 때문에\n짓밟히게 둘 것 같으냐고.\n⟦P⟧"
  },
  {
   "key": "9f85ea58e10c",
   "speaker_korean": "의사",
   "korean": "「지금은 안정되어 있습니다만,\n위험한 상태인 건 변함없습니다.\n일단은, 무리시키지 않도록\n해 주세요."
  },
  {
   "key": "d592b81fd149",
   "speaker_korean": "페이트",
   "korean": "「젠장,\n왜 이렇게 무리를 한 거야!!"
  },
  {
   "key": "21e1db05d8ea",
   "speaker_korean": "클리프",
   "korean": "「뭐, 그렇게 열 내지 마라.\n그러다 그녀가 깨겠다고."
  },
  {
   "key": "13d2bad1297a",
   "speaker_korean": "페이트",
   "korean": "「하지만―――!!"
  },
  {
   "key": "c9ebed6f6c94",
   "speaker_korean": "클리프",
   "korean": "「네가 흥분해 봤자,\n그녀가 나아지는 건 아니라고."
  },
  {
   "key": "37e30147931b",
   "speaker_korean": "미라쥬",
   "korean": "「그녀는 아무래도 폐에\n병이 있는 것 같군요.\n⟦1⟧이글⟦2⟧이 무사했다면\n어떻게든 됐을 텐데요…."
  }
 ]
}