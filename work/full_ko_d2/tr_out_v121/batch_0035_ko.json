{
 "batch_id": "batch_0035",
 "translations": [
  {
   "key": "989788cf5293",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「저기, ⟦2⟧페이트⟦3⟧.\n혹시 게임 하고 싶은 거야?\n⟦P⟧아까까지 실컷 놀았잖아.\n다른 데로 가자.\n⟦P⟧"
  },
  {
   "key": "64379d184a49",
   "speaker_korean": null,
   "korean": "⟦1⟧・소피아 설득"
  },
  {
   "key": "9cad586882aa",
   "speaker_korean": null,
   "korean": "⟦1⟧・일단 지금은 포기하자"
  },
  {
   "key": "f746f0e0e00e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그렇네.\n좀 더 산책이나 할까.\n⟦P⟧"
  },
  {
   "key": "ea872ca8bc8c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「하지만….\n나중에 또 하러 올지도\n모르겠는걸.\n⟦P⟧"
  },
  {
   "key": "8e6597b3f4a3",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「괜찮잖아? 응!\n가끔은 대학 밖 녀석들하고도\n놀아 보고 싶었단 말이야.\n⟦P⟧"
  },
  {
   "key": "79b3c0b98099",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(이 방은 최신형 홀로그래피를\n사용한 오락용 플레이룸이다.\n⟦P⟧이 방을 쓰고 싶으면\n문 옆에 있는 디스플레이에 자기\nAD 번호를 등록하고, 뭘 할 건지\n입력해야 하는데….\n⟦P⟧"
  },
  {
   "key": "8e3874c12254",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭣하면 ⟦2⟧소피아⟦3⟧도\n같이 해 보는 게 어때?\n분명 재미있다니까.\n⟦P⟧"
  },
  {
   "key": "c5675b925a75",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「괜찮아.\n내가 지켜 줄 테니까.\n⟦P⟧"
  },
  {
   "key": "638de0cb852c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「좋아, 그럼 결정이다.\n⟦P⟧"
  },
  {
   "key": "eff3bae05115",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「그, 그런 거 아니야.\n딱히 싫다는 건 아니고….\n⟦P⟧"
  },
  {
   "key": "104693b56422",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「좋아.\n그럼, 같이 해 볼까.\n⟦P⟧"
  },
  {
   "key": "3b4c2ee01932",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧소피아⟦3⟧는 초보자니까,\n쉬운 클래스로 시작하자.\n⟦P⟧그리고 앞에서 싸우는 캐릭터보다는,\n뒤에서 ⟦4⟧문장술⟦5⟧을 쓰는\n캐릭터 쪽이 낫겠지?\n⟦P⟧"
  },
  {
   "key": "4e007344d436",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「괜찮아.\n초급 클래스면 따끔한\n정도니까.\n⟦P⟧"
  },
  {
   "key": "84e1f06d62b0",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「알았어….\n그럼, 해 볼게.\n⟦P⟧"
  },
  {
   "key": "9fb7221737c2",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「자, 등록 완료.\n⟦P⟧"
  },
  {
   "key": "d80578be3cf0",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(음~ 어디 보자….\n어떻게 하지.\n⟦P⟧"
  },
  {
   "key": "a28637851ca5",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「괜찮아.\n딱히 무리하지 않아도….\n⟦P⟧"
  },
  {
   "key": "e5d16be1213b",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「무리 같은 거,\n안 하고 있다니까!\n⟦P⟧"
  },
  {
   "key": "5411e2c5f74c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「정말로?\n⟦P⟧"
  },
  {
   "key": "b595a013dae8",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「저기, 또 게임하는 거야.\n방금 전까지 했었잖아?\n⟦P⟧그렇게 게임만 하면서\n공부를 소홀히 하다간\n언젠가 근육 바보가 돼 버릴 거야.\n⟦P⟧"
  },
  {
   "key": "e659d1a5761f",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「그렇지.\n게임만 하고 있어 봐야\n소용없는걸.\n⟦P⟧"
  },
  {
   "key": "198a437a2320",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「에~!?\n아직도 더 할 생각이야?\n⟦P⟧"
  },
  {
   "key": "31eff44494ce",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아, 맞다!\n뭣하면 너도 같이 할래?\n⟦P⟧한 번 해 보면 ⟦2⟧소피아⟦3⟧도\n재미를 알게 될 거야.\n⟦P⟧"
  },
  {
   "key": "8d2a6519d38f",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「으~음.\n긍정적으로 검토해 볼게….\n⟦P⟧"
  },
  {
   "key": "d9d2fbc5bfd4",
   "speaker_korean": null,
   "korean": "무리야….\n나, 그런 거 잘 못하는걸.\n⟦P⟧"
  },
  {
   "key": "e51de1e6f152",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「어….\n⟦P⟧"
  },
  {
   "key": "5dca342719b3",
   "speaker_korean": null,
   "korean": "그럼 괜찮잖아?\n⟦P⟧"
  },
  {
   "key": "737889a3d99d",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「으… 응.\n⟦P⟧"
  },
  {
   "key": "7ddebae91afb",
   "speaker_korean": null,
   "korean": "⟦1⟧페이트⟦2⟧가\n그렇게까지 말한다면,\n해 봐도 괜찮으려나….\n⟦P⟧"
  },
  {
   "key": "b11f8155a77c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그렇구나, ⟦2⟧소피아⟦3⟧는\n나랑 노는 게 싫은 거구나.\n⟦P⟧"
  },
  {
   "key": "cd7302a05d43",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「으, 응.\n정말이야.\n⟦P⟧"
  },
  {
   "key": "c8e4803c3c85",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「아~!!\n정말, 치사하다니까!\n⟦P⟧"
  },
  {
   "key": "471435dc6b03",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「모르는 일이야.\n⟦P⟧"
  },
  {
   "key": "1efc79734874",
   "speaker_korean": null,
   "korean": "⟦1⟧・괜찮아. 내가 지켜 줄 테니까."
  },
  {
   "key": "7e60b6b3d5e0",
   "speaker_korean": null,
   "korean": "⟦1⟧・그렇구나, 나랑 노는 게 싫구나."
  },
  {
   "key": "ee934647cf83",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「그래도 하는 건 퍽퍽 때리는\n전투 시뮬레이터잖아?\n⟦P⟧"
  },
  {
   "key": "81deefdea1b7",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「응…. 뭐….\n그래도, 아프거나 하진 않아?\n⟦P⟧"
  },
  {
   "key": "1b760de7304c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧소피아⟦3⟧를 위험한 일에는\n절대 휘말리게 하지 않아.\n약속할게.\n⟦P⟧"
  },
  {
   "key": "40db6d4635ee",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「이런 간단한 수법에,\n속는 쪽이 나쁜 거야.\n⟦P⟧"
  },
  {
   "key": "81eb92185bfc",
   "speaker_korean": null,
   "korean": "그래도 여기 들어 있는 건\n바로 얼마 전에 버전 업된\n신형이란 말이지.\n나중에 또 하러 와야겠는데….\n⟦P⟧"
  },
  {
   "key": "e51bb8e26405",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(게임은 방금 전에 막 했으니까,\n좀 더 ⟦2⟧소피아⟦3⟧랑 어울려\n줘야겠는데….\n⟦P⟧"
  },
  {
   "key": "63b36d430ebf",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(당장 놀고 싶은 마음은 굴뚝같지만,\n⟦2⟧소피아⟦3⟧ 녀석은 게임을\n별로 안 하니까 말이야….\n⟦P⟧"
  },
  {
   "key": "d1b40d9019b2",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(이 라운지를 나가서\n동쪽에 있는 ⟦2⟧트랜스포터⟦3⟧를 쓰면\n방으로 돌아갈 수 있겠네.\n⟦P⟧해변으로 나가고 싶으면\n서쪽에 있는 ⟦4⟧트랜스포터⟦5⟧를\n쓰면 돼.\n⟦P⟧"
  },
  {
   "key": "8cc612889e6b",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(흐~음.\n그렇구나.\n⟦P⟧"
  },
  {
   "key": "eef184d5887c",
   "speaker_korean": null,
   "korean": "⟦1⟧셰이크⟦2⟧를 손에 넣었다."
  },
  {
   "key": "026429f1a08b",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(그러고 보니 이 호텔에는\n신작 시뮬레이터 배틀 게임이\n들어와 있었지.\n⟦P⟧"
  },
  {
   "key": "58dbce42bdab",
   "speaker_korean": null,
   "korean": "시간도 남았고, ⟦1⟧소피아⟦2⟧를\n불러서 해 보는 것도 괜찮겠네.\n⟦P⟧"
  },
  {
   "key": "48aca1706a04",
   "speaker_korean": "페이트",
   "korean": "「뭔가 좀 마실까…."
  },
  {
   "key": "3da0f685e01e",
   "speaker_korean": "소피아",
   "korean": "「에엣!?\n방금 마셨잖아.\n주스만 그렇게 자꾸 사면\n아주머니한테 혼난다?"
  },
  {
   "key": "366afdf02fa0",
   "speaker_korean": "페이트",
   "korean": "「어쩔 수 없잖아.\n목이 말라 버린 걸 어떡해.\n게다가 ⟦1⟧소피아⟦2⟧가 가만있으면\n들킬 일도 없고……."
  },
  {
   "key": "1bdcac9d3aab",
   "speaker_korean": "페이트",
   "korean": "「괜찮잖아?\n다음에 ⟦1⟧소피아⟦2⟧ 쇼핑에\n같이 가 줄 테니까."
  },
  {
   "key": "7834bbabace5",
   "speaker_korean": "소피아",
   "korean": "「응.\n그럼 비밀로 해 줄게♪"
  },
  {
   "key": "56b303fdbc9b",
   "speaker_korean": "소피아",
   "korean": "「에~, 어떻게 할까?"
  }
 ]
}