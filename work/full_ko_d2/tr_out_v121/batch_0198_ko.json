{
 "batch_id": "batch_0198",
 "translations": [
  {
   "key": "3e766b78eed7",
   "speaker_korean": "마유",
   "korean": "⟦1⟧「그렇군요~\n좋겠다~, 저도 그런 인형을\n갖고 싶어요~\n⟦P⟧"
  },
  {
   "key": "7f31367a47a2",
   "speaker_korean": "마유",
   "korean": "⟦1⟧「어? 이걸 저한테 주시는 거예요?\n감사합니다~\n⟦P⟧그럼 저, 마음을 담아서\n⟦2⟧페이트⟦3⟧ 씨한테 도시락을\n만들어 드릴게요…!\n⟦P⟧"
  },
  {
   "key": "447623f42ff8",
   "speaker_korean": "험상궂은 아주머니의 딸",
   "korean": "⟦1⟧「계속 여기서 일하면서\n지루하게 한평생 보내는 걸까~…\n그런 생각을 했었는데\n⟦P⟧이런 곳에서도 이것저것 재밌는 일이\n일어나긴 하네요~\n⟦P⟧"
  },
  {
   "key": "41a85b007d5b",
   "speaker_korean": null,
   "korean": "⟦1⟧적동 열쇠⟦2⟧를 입수했다."
  },
  {
   "key": "4bce08b849b1",
   "speaker_korean": "마리아",
   "korean": "「상처 좀 보여줘."
  },
  {
   "key": "7aeb68a024a6",
   "speaker_korean": "소피아",
   "korean": "「어, 아, 네."
  },
  {
   "key": "96e4584f17c6",
   "speaker_korean": "마리아",
   "korean": "「그렇게 심한 상태는 아니네.\n⟦1⟧디플로⟦2⟧로 돌아가면 이 정도 상처는\n금방 고칠 수 있을 텐데…\n아프겠지만 잠깐만 참아."
  },
  {
   "key": "1e26d963126b",
   "speaker_korean": "소피아",
   "korean": "「죄송해요."
  },
  {
   "key": "b386e74d7f01",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧전송 방해 장치⟦2⟧의 효과 범위는\n반경 2km 정도였지?"
  },
  {
   "key": "fc9d410a6413",
   "speaker_korean": "로키시",
   "korean": "「연방 사양이라면 그렇지.\n하지만 ⟦1⟧반덴⟦2⟧ 쪽 물건은 신개발 장치다.\n적어도 그 이상이라고 생각하는 게\n틀림없을 거다."
  },
  {
   "key": "0194a3d731f5",
   "speaker_korean": "마리아",
   "korean": "「그럼 도망치는 건\n어렵겠네."
  },
  {
   "key": "612d09cbb2b1",
   "speaker_korean": "페이트",
   "korean": "「어차피 도망쳐도 쫓아올 거야.\n이렇게 된 이상 해볼 수밖에."
  },
  {
   "key": "fa5e67702de9",
   "speaker_korean": "로키시",
   "korean": "「강해졌구나…"
  },
  {
   "key": "c63147ec6523",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧클리프⟦2⟧가 돌아오면\n상의하자."
  },
  {
   "key": "f1573a23fb59",
   "speaker_korean": "페이트",
   "korean": "「그런데 아버지,\n여쭤보고 싶은 게 있어요…"
  },
  {
   "key": "90244bf3d1db",
   "speaker_korean": "로키시",
   "korean": "「알아버렸구나…"
  },
  {
   "key": "b999708e9b60",
   "speaker_korean": "로키시",
   "korean": "「하지만 이것만은 알아다오.\n나는 너를 실험 도구라고 생각한 적은\n단 한 번도 없다.\n너는 실험을 위해 태어난 게\n아니야."
  },
  {
   "key": "802e95a0bad9",
   "speaker_korean": "마리아",
   "korean": "「그럼 대체 왜 그런 거야!?\n친자식을 생체 실험 재료로\n삼은 거냐고!"
  },
  {
   "key": "c523185385bd",
   "speaker_korean": "로키시",
   "korean": "「그러고 보니,\n그녀는 누구냐?"
  },
  {
   "key": "3146c520a3d0",
   "speaker_korean": "페이트",
   "korean": "「반연방 조직 ⟦1⟧쿼크⟦2⟧의\n리더예요."
  },
  {
   "key": "a4a575c61e35",
   "speaker_korean": "페이트",
   "korean": "「그리고 저처럼 아버지한테\n유전자 조작을 당한 사람이에요."
  },
  {
   "key": "c18d8417f887",
   "speaker_korean": "소피아",
   "korean": "「유전자… 조작?\n아저씨가…?"
  },
  {
   "key": "e748cf5c3645",
   "speaker_korean": "로키시",
   "korean": "「뭐라고!? 그럼 넌!\n그런가, 그래서 트레이터…\n그런 거였군."
  },
  {
   "key": "4e9be1efc6bd",
   "speaker_korean": "마리아",
   "korean": "「그래, 맞아. ⟦1⟧로키시 라인갓 박사⟦2⟧.\n설명해…\n우리한텐 들을 권리가 있어."
  },
  {
   "key": "1b11b00a859d",
   "speaker_korean": "페이트",
   "korean": "「아버지, 이유를 말해줘요…\n우리한테 유전자 조작을 한 이유를요."
  },
  {
   "key": "b92a6a2bfe22",
   "speaker_korean": "로키시",
   "korean": "「그건…\n세상을 위해서다."
  },
  {
   "key": "7726ff0832d2",
   "speaker_korean": "마리아",
   "korean": "「세상?\n그거 참 스케일 큰 얘기네.\n우리가 유전자 개조를 당해서 대체 세상이\n어떻게 된다는 거야?"
  },
  {
   "key": "0efd8b0b747d",
   "speaker_korean": "로키시",
   "korean": "「하지만 사실이다.\n언젠가 이 세상에 닥쳐올 위협에\n대항하기 위해, 우리는 너희에게\n문장 유전자 조작을 한 거다."
  },
  {
   "key": "db8f56c8a051",
   "speaker_korean": "페이트",
   "korean": "「닥쳐올, 위협이요?"
  },
  {
   "key": "096b00a66be8",
   "speaker_korean": "로키시",
   "korean": "「그 얘기는, 지금 여기서 말해봤자\n믿어주지 않을 거다.\n아무튼 여기서 탈출하면 전부 얘기하마.\n그때까지 기다려다오."
  },
  {
   "key": "fe5637fdd3d3",
   "speaker_korean": "마리아",
   "korean": "「그런 설명으로…,\n그런 설명으로 납득할 수 있을 거라고\n생각하는 거야!?"
  },
  {
   "key": "9ef134e22192",
   "speaker_korean": "마리아",
   "korean": "「그런 대답을\n듣고 싶은 게 아니야…!"
  },
  {
   "key": "93aab92c5ef1",
   "speaker_korean": "로키시",
   "korean": "「미안하다."
  },
  {
   "key": "4d5cd6de53ce",
   "speaker_korean": "클리프",
   "korean": "「기다리게 했군.\n…무슨 일이야?"
  },
  {
   "key": "cbe9bbc7672a",
   "speaker_korean": "페이트",
   "korean": "「아니, 괜찮아."
  },
  {
   "key": "5e59ef4bc35d",
   "speaker_korean": "클리프",
   "korean": "「…그런가."
  },
  {
   "key": "1a6e6000a2e6",
   "speaker_korean": "클리프",
   "korean": "「일단 그 근처 잡졸들은 싹 다\n청소하고 왔다만,\n느긋하게 있을 순 없겠어.\n놈들이 무한정 증원을 불러대거든.\n아직도 여기저기 반덴 병사가 있다고.\n이대로면 끝이 없다고.\n아 진짜, 바퀴벌레냐고."
  },
  {
   "key": "ea8aad976a42",
   "speaker_korean": "페이트",
   "korean": "「방해 장치를 부수자.\n이대로면 소모전이 될 거야.\n그렇게 되면 우리한텐 승산이 없어."
  },
  {
   "key": "c1347a3e8ec3",
   "speaker_korean": "페이트",
   "korean": "「어떻게 생각해?\n네 의견을 듣고 싶어."
  },
  {
   "key": "c2115cfbf1e2",
   "speaker_korean": "마리아",
   "korean": "「…그렇네,\n그 방법밖에 없겠지."
  },
  {
   "key": "1442fafa81a0",
   "speaker_korean": "마리에타",
   "korean": "『네!"
  },
  {
   "key": "8e516b27831c",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧비위그⟦2⟧ 녀석이 신형 ⟦3⟧전송 방해 장치⟦4⟧를\n준비해뒀더라고.\n지금부터 그걸 부술 테니까,\n그와 동시에 우리를 수용해줘."
  },
  {
   "key": "8dd72ff319ec",
   "speaker_korean": "마리에타",
   "korean": "『무리예요!!"
  },
  {
   "key": "c7038476f425",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧마리아⟦2⟧,\n⟦3⟧마리아・트레이터⟦4⟧."
  },
  {
   "key": "6befd4e93f2b",
   "speaker_korean": "로키시",
   "korean": "「⟦1⟧마리아・트레이터⟦2⟧…\n트레이터라고…?"
  },
  {
   "key": "b857510b218d",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧마리아⟦2⟧다.\n⟦3⟧디플로⟦4⟧ 응답하라."
  },
  {
   "key": "38e533580e00",
   "speaker_korean": "페이트",
   "korean": "「하지만, ⟦1⟧디플로⟦2⟧가 전송할 수 없다면,\n전투 중인 ⟦3⟧반덴⟦4⟧ 쪽도\n전송을 못 하는 거 아닐까?"
  },
  {
   "key": "76e9ea1e3bea",
   "speaker_korean": "클리프",
   "korean": "「그래.\n그럴 가능성이 높겠는데."
  },
  {
   "key": "8e6859a39a8d",
   "speaker_korean": "마리아",
   "korean": "「그럼 지금보다 병사 수가\n늘어나는 일은 없겠네."
  },
  {
   "key": "21d436e916c4",
   "speaker_korean": "마리아",
   "korean": "「역시 강행 돌파로 방해 장치를 부수자.\n그때까지 ⟦1⟧아쿠아엘리⟦2⟧가 와서,\n어떻게든 해주길 바랄 수밖에 없겠네."
  },
  {
   "key": "1432e10e31c3",
   "speaker_korean": "클리프",
   "korean": "「연방한테 기대는 건\n왠지 마음에 안 들지만,\n뭐, 이번만큼은 어쩔 수 없지."
  },
  {
   "key": "08bca098665e",
   "speaker_korean": "페이트",
   "korean": "「둘 다,\n조금 힘들겠지만 참아줘."
  },
  {
   "key": "be3a684de2ec",
   "speaker_korean": "클리프",
   "korean": "「칫!"
  },
  {
   "key": "be3b04b0bd0a",
   "speaker_korean": "마리아",
   "korean": "「방심했어.\n상대 쪽이 더 철저히 준비했다는\n거네."
  }
 ]
}