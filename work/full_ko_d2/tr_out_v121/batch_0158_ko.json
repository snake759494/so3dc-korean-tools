{
 "batch_id": "batch_0158",
 "translations": [
  {
   "key": "35b9282eaa09",
   "speaker_korean": null,
   "korean": "당신에게 배정된\n침대가 있습니다.\n⟦P⟧하시겠습니까?\n⟦P⟧"
  },
  {
   "key": "b5c68763bd49",
   "speaker_korean": null,
   "korean": "⟦1⟧・만일을 위해 잠들어 둔다."
  },
  {
   "key": "d3cbdf027887",
   "speaker_korean": null,
   "korean": "⟦1⟧・정보를 더 모으기로 한다."
  },
  {
   "key": "51ddc1225cb3",
   "speaker_korean": null,
   "korean": "어지간히 지쳐 있었던 모양이다.\n곤히 잠들어 있다.\n⟦P⟧"
  },
  {
   "key": "18d3ff005cc8",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「정보를 좀 더 모아보자.\n⟦P⟧별로 기대는 못 하겠지만\n아무것도 안 하는 것보다는\n나을 테니까.\n⟦P⟧"
  },
  {
   "key": "c5956ae18fa4",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(여기가 506호실인가…\n⟦P⟧"
  },
  {
   "key": "ad53d79e5e27",
   "speaker_korean": null,
   "korean": "긴급 피난시설 506호실"
  },
  {
   "key": "9a9b45de3acf",
   "speaker_korean": "페이트",
   "korean": "「괜찮아,\n⟦1⟧소피아⟦2⟧?"
  },
  {
   "key": "3703f4f3ec7d",
   "speaker_korean": "소피아",
   "korean": "「응…괜찮아."
  },
  {
   "key": "77c3aed3b527",
   "speaker_korean": "페이트",
   "korean": "「피곤한 거야.\n좀 쉬는 게 좋겠어."
  },
  {
   "key": "c617c0ff24c1",
   "speaker_korean": "소피아",
   "korean": "「…응."
  },
  {
   "key": "a4afa704d60d",
   "speaker_korean": "소피아",
   "korean": "「미안해."
  },
  {
   "key": "fc10064be6c0",
   "speaker_korean": "페이트",
   "korean": "「괜찮아, 잘 자."
  },
  {
   "key": "e36ec9a8da64",
   "speaker_korean": "소피아",
   "korean": "「있잖아…⟦1⟧페이트⟦2⟧."
  },
  {
   "key": "616ed566e5c6",
   "speaker_korean": "소피아",
   "korean": "「내가 잠들 때까지, 여기 있어 줘.\n…어디 가면 싫어."
  },
  {
   "key": "78fb71da30ce",
   "speaker_korean": "페이트",
   "korean": "「잘 자…"
  },
  {
   "key": "61520cfd64bc",
   "speaker_korean": "페이트",
   "korean": "「그래, 여기 있을게.\n그러니까 안심하고 자."
  },
  {
   "key": "5ea2839a9df8",
   "speaker_korean": "페이트",
   "korean": "(여기는…?\n⟦P⟧…아, 그런가.\n⟦1⟧하이다⟦2⟧가 누군가의 공격을 받아서―――."
  },
  {
   "key": "dd5b8bf50b62",
   "speaker_korean": "페이트",
   "korean": "(…03:52인가.\n아직 이런 시간이었다니―――."
  },
  {
   "key": "49bbc3e68072",
   "speaker_korean": "페이트",
   "korean": "「뭐, 뭐야!?"
  },
  {
   "key": "6207696ffbca",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧페이트⟦2⟧…뭐야…이 소리?"
  },
  {
   "key": "b0afc2f16557",
   "speaker_korean": "페이트",
   "korean": "「뭔가 연락이 온 거\n같은데."
  },
  {
   "key": "1174eb27c25a",
   "speaker_korean": "안내 방송",
   "korean": "『피난 중이신 여러분께 현재\n상황에 대해 알려드립니다."
  },
  {
   "key": "d153cdfbf10f",
   "speaker_korean": "안내 방송",
   "korean": "『⟦1⟧휴양 행성 하이다⟦2⟧에 대한\n지난 공격은 ⟦3⟧반데인⟦4⟧에 의한\n기습 공격임이 밝혀졌습니다."
  },
  {
   "key": "2d74fa3971b5",
   "speaker_korean": "페이트",
   "korean": "(⟦1⟧반데인⟦2⟧?\n⟦3⟧알디온⟦4⟧과 교전 중인\n전투 국가가 아니었나!?\n⟦P⟧분명 예전에 연방의 지원을\n거절했다는 얘기는 있었지만,\n딱히 적대하고 있는 건\n아니었을 텐데…?"
  },
  {
   "key": "b5bdf2fca1e0",
   "speaker_korean": "안내 방송",
   "korean": "『⟦1⟧하이다 4호성⟦2⟧은 ⟦3⟧제7 심우주기지⟦4⟧가\n방위 임무를 맡고 있었으나,\n⟦5⟧반데인⟦6⟧의 기습 공격은 교묘하여,\n기지는 ⟦7⟧하이다 4호성⟦8⟧으로의 침입을\n허용하고 말았습니다.\n하지만 걱정하실 필요는 없습니다.\n그 후 은하연방정부는 주변 우주역에서\n긴급 출동으로 구원을 위한 함대를\n파견하고 있습니다.\n현재로서는 아직 반데인군을\n괴멸시키는 데에는 이르지 못했으나,\n사태가 급박하기에,\n⟦9⟧하이다 4호성⟦10⟧의 일반 시민 여러분께는\n구원선을 통해 ⟦11⟧제6 심우주기지⟦12⟧로\n순차적으로 피난을 시작하게\n되었습니다.\n피난민 여러분께서는 당황하지 마시고\n가까운 담당자 및 콘솔의 안내에\n따라 행동해 주십시오."
  },
  {
   "key": "2e9ceecae720",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧소피아⟦2⟧, 가자.\n……괜찮아?"
  },
  {
   "key": "053849b18604",
   "speaker_korean": "소피아",
   "korean": "「응…괜찮아.\n자고 나니 좀 진정됐으니까."
  },
  {
   "key": "664a3c91c4e6",
   "speaker_korean": "페이트",
   "korean": "「이제 조금만 참으면 돼.\n⟦1⟧제6 심우주기지⟦2⟧로 가면, 안전하니까."
  },
  {
   "key": "2701848de097",
   "speaker_korean": "페이트",
   "korean": "「컴퓨터,\n⟦1⟧록시・라인고드⟦2⟧,\n⟦3⟧료코・라인고드⟦4⟧의\n현재 위치를 알려줘."
  },
  {
   "key": "545419b41dc8",
   "speaker_korean": "COM",
   "korean": "『……지정하신 분의\n현재 위치를 특정할 수 없습니다."
  },
  {
   "key": "724dafff8dcd",
   "speaker_korean": "페이트",
   "korean": "「그건…무슨 의미지?"
  },
  {
   "key": "422fbbe7c3dd",
   "speaker_korean": "COM",
   "korean": "『…⟦1⟧록시・라인고드⟦2⟧,\n⟦3⟧료코・라인고드⟦4⟧ 두 분은\n우주력 772E12141923에\n위치를 상실했습니다."
  },
  {
   "key": "3abf987d5b3e",
   "speaker_korean": "페이트",
   "korean": "「상실이라니!? 그 후엔?"
  },
  {
   "key": "6483634ab77e",
   "speaker_korean": "COM",
   "korean": "『……불명입니다.\n현재 정보 계통이 혼란하여,\n불확정 정보가 대량으로 발생하고 있어,\n확정은 불가능한 상황입니다."
  },
  {
   "key": "4f5270ebbe3f",
   "speaker_korean": "페이트",
   "korean": "「그럴 수가……젠장!!"
  },
  {
   "key": "ad40137a3639",
   "speaker_korean": "거만한 지구인",
   "korean": "⟦1⟧「그놈들의 그 무장은……\n⟦P⟧설마, 쳐들어온 것이\n⟦2⟧반데인⟦3⟧이라고 말하려는 건가?\n허나, 대체 무엇 때문에 그런 짓을……\n⟦P⟧"
  },
  {
   "key": "ef5316f3a183",
   "speaker_korean": "거만한 지구인",
   "korean": "⟦1⟧「아니, 역시 그건 아닐 것이다.\n⟦P⟧⟦2⟧반데인⟦3⟧ 놈들은\n⟦4⟧알디온 제국⟦5⟧과의 싸움만으로도\n벅찰 터이니 말이다.\n⟦P⟧…허나, 그렇다면\n그놈들은 대체 누구란 말인가?\n⟦P⟧"
  },
  {
   "key": "6b9f9bb47515",
   "speaker_korean": "거만한 지구인",
   "korean": "⟦1⟧「⟦2⟧반데인⟦3⟧이 아니라면,\n그놈들은 대체 누구란 말인가?\n으음……\n⟦P⟧"
  },
  {
   "key": "e62d08796234",
   "speaker_korean": "거만한 지구인",
   "korean": "⟦1⟧「역시, 그놈들은 ⟦2⟧반데인⟦3⟧이라고?\n⟦P⟧하지만……,\n그놈들 대체 어디에 그만한 전력이\n있었단 말인가?\n⟦P⟧분명, ⟦4⟧반데인⟦5⟧ 부대의 대부분은\n⟦6⟧알디온 제국⟦7⟧과의 전선에\n묶여 있었을 텐데.\n⟦P⟧이 별에 대해, 그만한 대부대를\n투입할 여유 따위, 어디에도 없을 것\n같은데 말이다……\n⟦P⟧"
  },
  {
   "key": "50ae87b02391",
   "speaker_korean": "거만한 지구인",
   "korean": "⟦1⟧「그 강대한 ⟦2⟧알디온 제국⟦3⟧과 싸우면서\n배후의 ⟦4⟧은하연방⟦5⟧에까지 손을 대다니……\n⟦P⟧그런 무리한 짓을 하면서까지,\n어째서 그놈들은, 이런 휴양 행성을\n공격해 온 것일까……\n⟦P⟧"
  },
  {
   "key": "9d84bd33891a",
   "speaker_korean": "거만한 지구인",
   "korean": "⟦1⟧「어차피 여긴 그저 관광 행성일 뿐\n⟦P⟧⟦2⟧엑스펠⟦3⟧처럼 귀중한 자원을\n채굴할 수 있는 것도 아니고,\n중요한 ⟦4⟧우주기지⟦5⟧가 있는 것도\n아니라는데……\n⟦P⟧"
  },
  {
   "key": "b51e7fc95786",
   "speaker_korean": null,
   "korean": "긴급 피난시설 507호실"
  }
 ]
}