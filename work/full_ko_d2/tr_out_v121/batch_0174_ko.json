{
 "batch_id": "batch_0174",
 "translations": [
  {
   "key": "6ebba9b8e686",
   "speaker_korean": "비스콤 제독",
   "korean": "「늦었군.\n적은 괜찮았나?"
  },
  {
   "key": "65aad620246f",
   "speaker_korean": "페이트",
   "korean": "「보시다시피입니다."
  },
  {
   "key": "5e81b40cd6af",
   "speaker_korean": "비스콤 제독",
   "korean": "「그런가, 무사해서 다행이군.\n그보다 재촉해서 미안하네만,\n성과는 어땠나?"
  },
  {
   "key": "9830231c9b3a",
   "speaker_korean": "페이트",
   "korean": "「예.\n아버지의 데이터베이스 안에\n숨겨져 있던 파일을 발견했습니다."
  },
  {
   "key": "1df03b3944d0",
   "speaker_korean": "비스콤 제독",
   "korean": "「뭐라고?"
  },
  {
   "key": "b08d522884f4",
   "speaker_korean": "마리아",
   "korean": "「내 이름과 유전자 정보가\n키워드였어."
  },
  {
   "key": "284996556c7a",
   "speaker_korean": "비스콤 제독",
   "korean": "「그런가…….\n그렇다면 발견하기 어려웠겠군.\n그래서, 파일의 내용은?"
  },
  {
   "key": "5bcc9799878f",
   "speaker_korean": "페이트",
   "korean": "「아버지의 파일을 참조한 결과,\n지금 ⟦1⟧지구⟦2⟧, 아니 은하를 습격하는\n정체불명의 적의 정체가 밝혀졌습니다."
  },
  {
   "key": "4858e2eaf73d",
   "speaker_korean": "비스콤 제독",
   "korean": "「그건?"
  },
  {
   "key": "d8dbf3358df4",
   "speaker_korean": "페이트",
   "korean": "「적은… 창조왕의 사자입니다."
  },
  {
   "key": "49a2754143c0",
   "speaker_korean": "비스콤 제독",
   "korean": "「역시 창조왕이라고?\n그런 말도 안 되는……."
  },
  {
   "key": "98c42bab44f7",
   "speaker_korean": "페이트",
   "korean": "「그렇게 생각하시는 것도 무리는 아닙니다.\n하지만 아버지는 그렇게 말씀하셨습니다."
  },
  {
   "key": "c961a4560b72",
   "speaker_korean": "비스콤 제독",
   "korean": "「…아니, 확실히\n그 정도의 힘을 보여줬다면,\n그리고 그 모습을 봤다면 믿을 수밖에 없겠지."
  },
  {
   "key": "07da0f187b8d",
   "speaker_korean": "클리프",
   "korean": "「그 모습?"
  },
  {
   "key": "6d50d2cb53c2",
   "speaker_korean": "비스콤 제독",
   "korean": "「놈들은 그 크기임에도 불구하고,\n『공격력』『속도』『방어력』이 모든 면에서\n연방의 ⟦1⟧전투함⟦2⟧을 능가한다.\n그야말로 신의 힘… 이길 자신이 전혀 없군."
  },
  {
   "key": "99a9083b5dfd",
   "speaker_korean": "페이트",
   "korean": "「…제독님, 저희는 지금부터\n⟦1⟧행성 스트림⟦2⟧으로 가서, 창조왕의 세계,\n⟦3⟧FD 공간⟦4⟧으로 들어갑니다.\n아버지의 설명에 따르면,\n그곳은 저희 세계와는 다른 공간이라,\n시간이 흐르는 방식도 다를 겁니다.\n아니, 오히려 이 공간에는 시간이라는\n개념 자체가 통하지 않는 세계입니다.\n그래서, 창조왕을 쓰러뜨리는 것에\n저희가 살아남을 길을 걸고자\n합니다."
  },
  {
   "key": "249bd63366f0",
   "speaker_korean": "비스콤 제독",
   "korean": "「창조왕을 쓰러뜨려 버리면,\n이 세계 자체가 사라져 버릴\n가능성은 없는 건가?"
  },
  {
   "key": "867eb540df39",
   "speaker_korean": "마리아",
   "korean": "「그건 괜찮을 거야."
  },
  {
   "key": "c5aa219afc79",
   "speaker_korean": "마리아",
   "korean": "「창조왕을 쓰러뜨렸을 때,\n우리는 창조왕의 손에서 벗어나\n진정한 자유를 손에 넣을 수 있어."
  },
  {
   "key": "68fd6c83381c",
   "speaker_korean": "페이트",
   "korean": "「응… 그리고,\n그걸 위한 힘을 아버지들이\n우리에게 남겨 주신 거야."
  },
  {
   "key": "7bc6465df956",
   "speaker_korean": "비스콤 제독",
   "korean": "「그런가…… 알겠네.\n본함은 ⟦1⟧행성 스트림⟦2⟧으로 향하겠네.\n하지만, 그것도 쉽지는 않겠군―――――"
  },
  {
   "key": "4f1b123a4640",
   "speaker_korean": "페이트",
   "korean": "「그렇게 상황이\n심각한 겁니까?"
  },
  {
   "key": "8baef04a2207",
   "speaker_korean": "비스콤 제독",
   "korean": "「그래…… 이미 전선은\n최종 방어선까지 도달해 있다.\n돌파당하는 것도 시간문제겠지."
  },
  {
   "key": "f9ce84a8c1ce",
   "speaker_korean": "소피아",
   "korean": "「그럴 수가……."
  },
  {
   "key": "956b2344f074",
   "speaker_korean": "페이트",
   "korean": "「그럼 연방의 최신예함인\n⟦1⟧아쿠아엘리⟦2⟧는 움직일 수 없는 거 아닌가요…?\n저희는 ⟦3⟧디플로⟦4⟧로 향하겠습니다.\n그러니―――――――"
  },
  {
   "key": "a14cb4c105fb",
   "speaker_korean": "비스콤 제독",
   "korean": "「무리다.\n그런 함선으로 적의 공격을 피해가며\n⟦1⟧행성 스트림⟦2⟧까지 갈 수 있을 리가 없지 않은가?\n애초에 ⟦3⟧아쿠아엘리⟦4⟧ 한 척으로\n어떻게 할 수 있는 적이 아니다.\n그렇다면 너희가 위험을 무릅쓰고\n적의 본거지에 뛰어들 필요도 없는 거니까."
  },
  {
   "key": "eef115b46d0a",
   "speaker_korean": "페이트",
   "korean": "「제독님……."
  },
  {
   "key": "52f68470df1a",
   "speaker_korean": "프란 대위",
   "korean": "「적 ⟦1⟧엑스큐셔너⟦2⟧가\n최종 방어선에 돌입했습니다!!"
  },
  {
   "key": "a47a3855b349",
   "speaker_korean": "비스콤 제독",
   "korean": "「⟦1⟧엑스큐셔너⟦2⟧의 공격을\n피할 항로를 산출해라!!\n전투 우주역을 벗어나면 최대 워프로\n⟦3⟧행성 스트림⟦4⟧으로 향한다!"
  },
  {
   "key": "407d858e4a86",
   "speaker_korean": "프란 대위",
   "korean": "「알겠습니다!!"
  },
  {
   "key": "31fc04d874f4",
   "speaker_korean": "프란 대위",
   "korean": "「항로 나왔습니다!\n112654.774입니다!!"
  },
  {
   "key": "6a17ef06f14f",
   "speaker_korean": "비스콤 제독",
   "korean": "「좋아!\n최대 출력으로 전투 우주역을 벗어나라!!"
  },
  {
   "key": "dd1f6dfab76f",
   "speaker_korean": "프란 대위",
   "korean": "「현재, 주위에 적 반응은 없습니다."
  },
  {
   "key": "a097daae9451",
   "speaker_korean": "비스콤 제독",
   "korean": "「그런가… 일단은\n따돌린 것 같군."
  },
  {
   "key": "cb7561fd1ab6",
   "speaker_korean": "비스콤 제독",
   "korean": "「너희들도 잠시\n쉬어 두게."
  },
  {
   "key": "7fb8bd5f1447",
   "speaker_korean": "비스콤 제독",
   "korean": "「현재, ⟦1⟧제5우주기지⟦2⟧는 경계태세에 들어가 있다.\n이미 ⟦3⟧엑스큐셔너⟦4⟧의 공격은\n이 주변 구역까지 다가와 있다."
  },
  {
   "key": "57b7350f9d80",
   "speaker_korean": "비스콤 제독",
   "korean": "「박사의 연구실이 있는 구역으로의 전송은,\n기밀 방위를 위해 전송 방해를 받고 있어\n직접 실행할 수는 없게\n되어 있다.\n그러니 ⟦1⟧문베이스⟦2⟧ 내에서 연구소와\n가장 가까운 곳, 오락 구역으로 전송하겠다."
  },
  {
   "key": "e0d3ad39fefd",
   "speaker_korean": "비스콤 제독",
   "korean": "「너희는 너희 자신을 위해 행동하게.\n그것이 그대로 은하의 미래로\n이어질 것이다."
  },
  {
   "key": "cbe27388634b",
   "speaker_korean": "비스콤 제독",
   "korean": "「그럼, 다녀오게."
  },
  {
   "key": "3022aa4489fe",
   "speaker_korean": "세컨드 오퍼레이터",
   "korean": "「제독님!!"
  },
  {
   "key": "618202f34c7c",
   "speaker_korean": "비스콤 제독",
   "korean": "「무슨 일이냐!?"
  },
  {
   "key": "db00d66d8ce0",
   "speaker_korean": "세컨드 오퍼레이터",
   "korean": "「적, ⟦1⟧엑스큐셔너⟦2⟧ 확인.\n전선과 교전을 시작했습니다!!"
  },
  {
   "key": "381b82a69f03",
   "speaker_korean": "비스콤 제독",
   "korean": "「왔는가!!"
  },
  {
   "key": "95ef6f946195",
   "speaker_korean": "세컨드 오퍼레이터",
   "korean": "「그럴 수가・・・ ⟦1⟧전투함 위스콘신⟦2⟧, 격침!\n⟦3⟧전투함 뉴저지⟦4⟧,\n우현 ⟦5⟧중력 워프 코어⟦6⟧에 피탄!\n⟦7⟧인디펜던스⟦8⟧, 방어 ⟦9⟧실드⟦10⟧ 소멸!"
  },
  {
   "key": "e41245f8e7ec",
   "speaker_korean": "비스콤 제독",
   "korean": "「…강하군."
  },
  {
   "key": "e25ecb3f7028",
   "speaker_korean": "세컨드 오퍼레이터",
   "korean": "「적 ⟦1⟧엑스큐셔너⟦2⟧,\n영상 띄우겠습니다."
  },
  {
   "key": "81e67bfa250e",
   "speaker_korean": "비스콤 제독",
   "korean": "「띄워라."
  },
  {
   "key": "d37de5dd00d5",
   "speaker_korean": "오퍼레이터",
   "korean": "「뭐지? 저건・・・대체 뭐냔 말이다!?\n함선이 아니야・・・?\n⟦P⟧저건 생물인 건가!?"
  },
  {
   "key": "bd3df7e4282e",
   "speaker_korean": "세컨드 오퍼레이터",
   "korean": "「⟦1⟧익스프레스⟦2⟧, 격침되었습니다!!\n연방함, 이미 37척이 격침되었습니다!!\n적은 8개체만 전투불능에 빠졌습니다!\n남은 건 24!!\n이대로는 전멸하고 맙니다!!"
  },
  {
   "key": "9076f9e1e78a",
   "speaker_korean": "비스콤 제독",
   "korean": "「신인가・・・.\n영 농담은 아닐지도 모르겠군.\n부탁한다, 아이들아."
  },
  {
   "key": "45e058726a18",
   "speaker_korean": "세컨드 오퍼레이터",
   "korean": "「제독님,\n⟦1⟧행성 스트림⟦2⟧까지 앞으로 17분입니다만,\n주위에 강력한 에너지 반응이 있습니다."
  },
  {
   "key": "cd4be2750359",
   "speaker_korean": "비스콤 제독",
   "korean": "「⟦1⟧엑스큐셔너⟦2⟧인가……."
  },
  {
   "key": "2aec114b5224",
   "speaker_korean": "세컨드 오퍼레이터",
   "korean": "「유감스럽게도\n그런 것 같습니다."
  },
  {
   "key": "dfcbf2e1c0d8",
   "speaker_korean": "비스콤 제독",
   "korean": "「으음……."
  },
  {
   "key": "5b9d049ed9f3",
   "speaker_korean": "비스콤 제독",
   "korean": "「미안하지만 너희를\n⟦1⟧행성 스트림⟦2⟧으로 전송 강하시키는 것은\n불가능할 것 같다."
  },
  {
   "key": "3cade25d30fe",
   "speaker_korean": "비스콤 제독",
   "korean": "「그래, 정해져 있지.\n⟦1⟧엑스큐셔너⟦2⟧를 끌어들이는 거다.\n이 ⟦3⟧아쿠아엘리⟦4⟧로 말이야."
  },
  {
   "key": "5920eb329fb4",
   "speaker_korean": "클리프",
   "korean": "「아저씨 말이 맞아.\n나도 그 방법밖에 없다고 생각해."
  },
  {
   "key": "9c24c154a9a0",
   "speaker_korean": "마리아",
   "korean": "「아쉽지만……."
  },
  {
   "key": "52cb28fa753a",
   "speaker_korean": "로저",
   "korean": "「아저씨 눈을 보라고.\n뭔가 각오한 남자의 눈이잖아.\n남자로서 그 각오를\n짓밟을 수는\n없잖냐."
  },
  {
   "key": "cd2b1a32c511",
   "speaker_korean": "로저",
   "korean": "「완전 멋있잖아.\n사나이네!"
  },
  {
   "key": "5592a42e2e1e",
   "speaker_korean": "비스콤 제독",
   "korean": "「부탁한다…….\n그리고 살아남아라……."
  },
  {
   "key": "ca87a4beaed1",
   "speaker_korean": "마리아",
   "korean": "「포기하겠다는 거야!?"
  },
  {
   "key": "12b4e75a4974",
   "speaker_korean": "비스콤 제독",
   "korean": "「자, 기다리게.\n그렇게 말하지는 않았잖나?\n너희에게는 ⟦1⟧아쿠아엘리⟦2⟧가 궤도에 들어가기 전에\n셔틀로 ⟦3⟧행성 스트림⟦4⟧으로 향하게 하겠다."
  },
  {
   "key": "41e3bfd1cc3a",
   "speaker_korean": "페이트",
   "korean": "「제독님,\n당신들은요?"
  },
  {
   "key": "3546665e4163",
   "speaker_korean": "페이트",
   "korean": "「그런… 자살행위입니다!?"
  },
  {
   "key": "2c4fe30f5ac6",
   "speaker_korean": "비스콤 제독",
   "korean": "「하지만, 그 방법밖에 없다.\n너희를 무사히 보내주지\n못해서 아쉽지만,\n그것도 어쩔 수 없는 일이다."
  },
  {
   "key": "3417af369226",
   "speaker_korean": "비스콤 제독",
   "korean": "「뭐, 나도 순순히 당하지만은 않아.\n연방 최강인 이 함선의 힘을\n놈들에게 보여주겠다."
  },
  {
   "key": "3722f326ca12",
   "speaker_korean": "페이트",
   "korean": "「하지만!"
  },
  {
   "key": "ee5166d6fb99",
   "speaker_korean": "로저",
   "korean": "「형, 안 돼…….\n말릴 수 없다니까."
  },
  {
   "key": "124d5709cf3e",
   "speaker_korean": "비스콤 제독",
   "korean": "『전 함선 승무원에게 고한다."
  },
  {
   "key": "4ea494840ee6",
   "speaker_korean": "비스콤 제독",
   "korean": "『제군, 지금부터 벌일 전투는 인류의 명운을\n건 전투다. 이 ⟦1⟧아쿠아엘리⟦2⟧의\n승무원은 연방 제일, 아니 은하 제일의\n승무원임을 지금 이 자리에서 증명해 보이자."
  },
  {
   "key": "fb9ebddac109",
   "speaker_korean": "비스콤 제독",
