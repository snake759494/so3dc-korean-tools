{
 "batch_id": "batch_0245",
 "translations": [
  {
   "key": "b341db0b0e54",
   "speaker_korean": null,
   "korean": "⟦1⟧염마석⟦2⟧을 손에 넣었다."
  },
  {
   "key": "c887510f4fdb",
   "speaker_korean": "페이트",
   "korean": "「이쪽에서는\n밀 수 없는 것 같아."
  },
  {
   "key": "e7919fd4737d",
   "speaker_korean": null,
   "korean": "⟦1⟧・이 블록을 이동시킨다."
  },
  {
   "key": "69cb0d19dbf6",
   "speaker_korean": null,
   "korean": "⟦1⟧8200폴⟦2⟧을 손에 넣었다."
  },
  {
   "key": "631147b58675",
   "speaker_korean": null,
   "korean": "⟦1⟧홀리 소드⟦2⟧를 손에 넣었다."
  },
  {
   "key": "c926469feeed",
   "speaker_korean": null,
   "korean": "⟦1⟧땅의 부적⟦2⟧을 손에 넣었다."
  },
  {
   "key": "2de7a9b13ea5",
   "speaker_korean": null,
   "korean": "⟦1⟧인챈트 북(바람・흡수)⟦2⟧를 손에 넣었다."
  },
  {
   "key": "9161bc5c46f0",
   "speaker_korean": "클리프",
   "korean": "「아무래도 여기가\n최종 지점인가 보군."
  },
  {
   "key": "5327c3cb2261",
   "speaker_korean": "페이트",
   "korean": "「그런 것 같네."
  },
  {
   "key": "e9c6b281e4c4",
   "speaker_korean": "클리프",
   "korean": "「그러게, 어지간히 거창하군."
  },
  {
   "key": "d9f344fd00d2",
   "speaker_korean": "페이트",
   "korean": "「…온다!!"
  },
  {
   "key": "640e3b18746e",
   "speaker_korean": "넬",
   "korean": "「……그래서, 저게\n여기 우두머리라는 거네."
  },
  {
   "key": "c8a08c242ef4",
   "speaker_korean": "마리아",
   "korean": "「……그래서, 저게\n여기 우두머리라는 거군."
  },
  {
   "key": "b4e21e26409b",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「슬슬 시간이 됐군…\n⟦P⟧"
  },
  {
   "key": "a1158061d1dc",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「예, 그렇네요.\n⟦P⟧"
  },
  {
   "key": "46f8e711df19",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「사부님께 안부 전해줘.\n⟦P⟧그리고 너도 사부님한테\n대신 사과 좀 해줘.\n도장을 못 이어받아서 미안하다고.\n⟦P⟧"
  },
  {
   "key": "97dca6b1021c",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「예, 클리프.\n⟦P⟧"
  },
  {
   "key": "29b8bb804c66",
   "speaker_korean": null,
   "korean": "믿기지가 않는군.\n뭐랄까, 죽여도 안 죽을 것 같은\n인상밖에 없다고.\n⟦P⟧"
  },
  {
   "key": "2ba98502f703",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「조금 과장해서 말씀하시는 것뿐이에요.\n슬슬 저더러 돌아오라는 뜻이겠죠.\n⟦P⟧"
  },
  {
   "key": "557947e625b4",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「저기…\n사부님 상태, 그렇게 안 좋은 거냐?\n⟦P⟧"
  },
  {
   "key": "e2c407f6c9f1",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「그런가…\n그 사부님이, 또 어지간히\n약해지셨나 보군.\n이제 나이 드신 거 아니냐?\n⟦P⟧"
  },
  {
   "key": "bf019e3f06ed",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「그럴지도 모르겠네요.\n꽤 오랫동안, 떠나 있었으니까요.\n⟦P⟧"
  },
  {
   "key": "22556a87d3a0",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「그렇군…\n⟦P⟧"
  },
  {
   "key": "5f9074ab5639",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「슬슬 가지 않으면 늦겠네요.\n그럼, 클리프.\n⟦P⟧"
  },
  {
   "key": "45171ab202e4",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「미안하다.\n사실은, 나도 같이 돌아가고 싶었는데…\n아무래도 그럴 처지가 아닌 것 같아서 말이지.\n⟦P⟧"
  },
  {
   "key": "abca0f9b6536",
   "speaker_korean": null,
   "korean": "괜찮아요.\n클리프의 그런 점이,\n저는 좋으니까요.\n⟦P⟧"
  },
  {
   "key": "845ba8d1d345",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「또 제비를 잘못 뽑으셨네요.\n⟦P⟧"
  },
  {
   "key": "8e93bf1308f2",
   "speaker_korean": null,
   "korean": "잠시 후, 쿠라우스토로 성계행 수송선\n\"타레이아\"호가 출발합니다.\n\"타레이아\"호에 탑승하실 분은 3번 게이트로\n와 주시기 바랍니다.\n다시 안내합니다…\n⟦P⟧"
  },
  {
   "key": "ed38ad4b929e",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「그 콩나물 같은 팔로는\n벌써 한계인가?\n딱히 돌아가고 싶으면, 돌아가도\n괜찮다.\n⟦P⟧"
  },
  {
   "key": "ec3f3f3a9ac0",
   "speaker_korean": "시술사 A",
   "korean": "⟦1⟧「아, 아니요…\n아직 할 수 있습니닷!\n⟦P⟧"
  },
  {
   "key": "b22449147143",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「흥…\n⟦P⟧"
  },
  {
   "key": "fce5f46fd05e",
   "speaker_korean": null,
   "korean": "내 방식을 따라오지 못하겠다면\n그만두면 된다.\n그뿐인 이야기다.\n⟦P⟧"
  },
  {
   "key": "ef3f0f13cbe4",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「말해두겠는데, 나는 딱히 너희에게\n강요하고 있는 게 아니다.\n⟦P⟧"
  },
  {
   "key": "56acdffc49ff",
   "speaker_korean": "시술사 A・P・C・D…",
   "korean": "⟦1⟧「이…\n네…! 써…!\n⟦P⟧"
  },
  {
   "key": "69fa0405e6f8",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「아, 아버님.\n대체 무엇을 시키고 계신 건가요?\n⟦P⟧"
  },
  {
   "key": "ec92b31ca88b",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「네가 너무 한심하니까,\n내가 대신, 네 부하들을 단련시켜\n주고 있는 거 아니냐…\n⟦P⟧"
  },
  {
   "key": "4d4c6cd157c7",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「지금 이 부대를 지휘하고 있는 것은,\n아버님이 아니라 저예요.\n쓸데없는 참견은 하지 말아 주세요.\n⟦P⟧저들의 임무는, 주로 사무나 연구\n인 거예요.\n억지로 몸을 단련시킬 필요는\n없습니다.\n⟦P⟧"
  },
  {
   "key": "0ea24956aa7f",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「무슨 소리냐.\n이런 새파란 애송이들을, 나라의 방위를 맡은\n광아사단의 일원으로 인정받을 수 있겠느냐.\n⟦P⟧"
  },
  {
   "key": "1e61a7ee650c",
   "speaker_korean": null,
   "korean": "건전한 정신을 가진 자에게 건전한 육체가\n갖춰지면, 그야말로 무적이지.\n너는 너무 오냐오냐하는 게야.\n⟦P⟧"
  },
  {
   "key": "e0c62c548f6c",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「아버님의 방식으로는, 건전하지 못한\n정신을 가진 자들만 남을 거예요.\n⟦P⟧저에게는, 저만의 방식이 있어요.\n참견은 그만해 주세요.\n⟦P⟧"
  },
  {
   "key": "2562d0e0e50d",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「자, 다들 돌아갑시다.\n⟦P⟧"
  },
  {
   "key": "b4a716317678",
   "speaker_korean": "시술사 P",
   "korean": "⟦1⟧「아뇨. 클레어 님.\n저는 조금 더 계속하고 싶습니다.\n⟦P⟧"
  },
  {
   "key": "f122e2ec978d",
   "speaker_korean": "시술사 D",
   "korean": "⟦1⟧「지켜봐 주십시오.\n끝까지 해내는 걸 보여드리겠습니다.\n⟦P⟧"
  },
  {
   "key": "0798baaef68b",
   "speaker_korean": "시술사 C",
   "korean": "⟦1⟧「…예.\n모처럼 여기까지 했으니까요.\n⟦P⟧"
  },
  {
   "key": "33e35e061f6e",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「예엣!?\n⟦P⟧"
  },
  {
   "key": "0b2202fc4139",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「다들 이렇게 말하잖느냐.\n너야말로 물러나 있는 게 어떠냐?\n음!?\n⟦P⟧"
  },
  {
   "key": "d6ab229ba2be",
   "speaker_korean": "시술사 C",
   "korean": "⟦1⟧「아, 아직 멀었다~!\n⟦P⟧"
  },
  {
   "key": "564abb2c189c",
   "speaker_korean": "시술사 D",
   "korean": "⟦1⟧「112…\n클레어 님, 죄송합니다.\n⟦P⟧"
  },
  {
   "key": "e34c60631c87",
   "speaker_korean": "시술사 C",
   "korean": "⟦1⟧「아직이야…!\n배~ 백시~입…\n⟦P⟧"
  },
  {
   "key": "7307bf9cce95",
   "speaker_korean": "시술사 P",
   "korean": "⟦1⟧「젠장…\n여기까지인가.\n⟦P⟧"
  },
  {
   "key": "cc54b19cce90",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「아버님.\n대체 저들에게 무슨 말을 불어넣으신 거예요?\n⟦P⟧다들, 정신을 잃을 때까지 훈련을 계속하다니,\n정상이 아니에요.\n⟦P⟧"
  },
  {
   "key": "d2cadbcd8cfc",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「뭐~ 별거 아니다.\n내가 낸 훈련 메뉴를 끝까지 따라온 자를\n너와 결혼시켜 주겠다고 약속했을 뿐이다.\n⟦P⟧어차피 상대도 없을 것 아니냐?\n그러니 내가 골라 주겠다고 하는 것이다.\n⟦P⟧"
  },
  {
   "key": "da082cb659ec",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「쓸데없는 참견이에요!\n제 결혼 상대 정도는 제가 직접 찾겠어요.\n⟦P⟧"
  },
  {
   "key": "b61c075c87c7",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「그런 소리나 하니까 시집을 못 가는\n게 아니냐.\n네 나이에, 남자 친구 하나 없다는 건\n좀 문제로구나.\n⟦P⟧"
  },
  {
   "key": "a31544e1bf8f",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「그런 것까지 걱정해 주지 않으셔도\n괜찮습니닷!\n⟦P⟧"
  }
 ]
}