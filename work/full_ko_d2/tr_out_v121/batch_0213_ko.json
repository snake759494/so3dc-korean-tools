{
 "batch_id": "batch_0213",
 "translations": [
  {
   "key": "0a48bf56535d",
   "speaker_korean": "페이트",
   "korean": "「안 되나…\n문이 단단히 닫혀 있어서\n열릴 것 같지 않군"
  },
  {
   "key": "34d8a75c5bc3",
   "speaker_korean": "페이트",
   "korean": "「이제 반응이 없는 것 같군"
  },
  {
   "key": "a8667160bfb6",
   "speaker_korean": "페이트",
   "korean": "「버튼이 3개 있군.\n각각 『도적』『문장사』\n『전사』라고 쓰여 있다."
  },
  {
   "key": "51d22f33651c",
   "speaker_korean": null,
   "korean": "⟦1⟧・『도적』 버튼 누르기"
  },
  {
   "key": "53ca6e3ed842",
   "speaker_korean": null,
   "korean": "⟦1⟧・『문장사』 버튼 누르기"
  },
  {
   "key": "8cc93dcd0c55",
   "speaker_korean": null,
   "korean": "⟦1⟧・『전사』 버튼 누르기"
  },
  {
   "key": "0dd30a5bc774",
   "speaker_korean": null,
   "korean": "⟦1⟧・안 누름"
  },
  {
   "key": "3f8be36e120f",
   "speaker_korean": null,
   "korean": "⟦1⟧40000폴⟦2⟧을 손에 넣었다"
  },
  {
   "key": "a05a82f9bc4b",
   "speaker_korean": "아리그리프 13세",
   "korean": "「잘 왔네, ⟦1⟧로메리아⟦2⟧.\n…오랜만이군."
  },
  {
   "key": "460f33406fe8",
   "speaker_korean": "시하트 27세",
   "korean": "「예, 그대도요, ⟦1⟧알제이⟦2⟧.\n강건해 보이시니 다행입니다."
  },
  {
   "key": "43aca511c311",
   "speaker_korean": "아리그리프 13세",
   "korean": "「피차 마찬가지일세.\n그대도 여전히 아름답군."
  },
  {
   "key": "3d0659ef67b0",
   "speaker_korean": "시하트 27세",
   "korean": "「그대도 여전하시군요."
  },
  {
   "key": "484ccd7f84af",
   "speaker_korean": "아리그리프 13세",
   "korean": "「후후.\n그런데 그대의 도착이 늦어서 말이지.\n우리 강경파가 뭔가 저지른 건 아닌지\n걱정하던 참이었네."
  },
  {
   "key": "d9b38684c118",
   "speaker_korean": "넬",
   "korean": "「뻔뻔스럽게 잘도 그런 소리를!"
  },
  {
   "key": "46633d9cdc16",
   "speaker_korean": "아리그리프 13세",
   "korean": "「역시 뭔가 있었던 모양이군.\n그거 미안하게 됐네."
  },
  {
   "key": "8e3e1f6e27c2",
   "speaker_korean": "아리그리프 13세",
   "korean": "「그놈들이 말이지, 『적에게 대항하는 것뿐이라면\n⟦1⟧시하츠⟦2⟧와 손잡을 필요 따위 없다.』\n『⟦3⟧시하츠⟦4⟧를 제압하고,\n무력으로 신병기를 빼앗으면 그만이다.』\n라고 지껄였으니 말일세."
  },
  {
   "key": "ef4110402dda",
   "speaker_korean": "시하트 27세",
   "korean": "「알기 쉬운\n발상이시군요."
  },
  {
   "key": "a8c4dd6a4dd8",
   "speaker_korean": "아리그리프 13세",
   "korean": "「전적으로 그렇다. 적의 힘을 잘못 보면\n어떻게 되는지를\n전혀 모르고 있어.\n⟦P⟧이번 적은 강대하다.\n지금은 이쪽 전력을 소모시킬\n수는 없는데 말이지."
  },
  {
   "key": "750cbf6ddbd0",
   "speaker_korean": "시하트 27세",
   "korean": "「그렇다면, 이쪽의 제안을\n받아들여 주시는 건가요?"
  },
  {
   "key": "fad5799a0902",
   "speaker_korean": "아리그리프 13세",
   "korean": "「그래.\n이럴 땐 어쩔 수 없지."
  },
  {
   "key": "9263f5a5845b",
   "speaker_korean": "아리그리프 13세",
   "korean": "「지난번 공격으로 우리 나라 전력에도\n큰 피해가 났다. 아리그리프 3군도\n대장으로 남아 있는 건, 이 녀석 『⟦1⟧풍뢰⟦2⟧』의\n⟦3⟧월터⟦4⟧뿐인 상황이니 말일세."
  },
  {
   "key": "2e1dede60203",
   "speaker_korean": "아리그리프 13세",
   "korean": "「그건 그렇고 그 적은 대체 정체가 뭐지?\n지난번 그 첩자에게 설명을 들었다만,\n도무지 요령부득이야."
  },
  {
   "key": "aa0d7ff4f472",
   "speaker_korean": "시하트 27세",
   "korean": "「그건 저도 마찬가지랍니다.\n아마 그들이\n설명해 주겠지요."
  },
  {
   "key": "3e35f9f92a42",
   "speaker_korean": "아리그리프 13세",
   "korean": "「으음….\n참으로 황당무계한 이야기로군.\n그걸 믿으라는 건가?\n⟦1⟧로메리아⟦2⟧여."
  },
  {
   "key": "29b23ece50d9",
   "speaker_korean": "시하트 27세",
   "korean": "「예, ⟦1⟧알제이⟦2⟧.\n믿지 않으면 나라는…⟦3⟧시하츠⟦4⟧,\n⟦5⟧아리그리프⟦6⟧ 모두 멸망할 거예요."
  },
  {
   "key": "e697abf723ab",
   "speaker_korean": "아리그리프 13세",
   "korean": "「하지만, 적들에게 이 자들을\n넘겨준다는 선택지도\n있는 게 아닌가?"
  },
  {
   "key": "1ae5d3e1b75b",
   "speaker_korean": "시하트 27세",
   "korean": "「예전이었다면,\n가능했을지도 모르지요.\n하지만 이제 와서는\n그것도 불가능할 거예요."
  },
  {
   "key": "60a2dfce6ebe",
   "speaker_korean": "아리그리프 13세",
   "korean": "「어째서지?"
  },
  {
   "key": "0636924e87c1",
   "speaker_korean": "시하트 27세",
   "korean": "「⟦1⟧성전 카난⟦2⟧이 그들에게\n습격당했습니다."
  },
  {
   "key": "1097ae52f126",
   "speaker_korean": "아리그리프 13세",
   "korean": "「뭐라고!?"
  },
  {
   "key": "ed872277b2f3",
   "speaker_korean": "시하트 27세",
   "korean": "「이 자들과는 직접 관계없는 장소가\n공격당한 시점에서, 이미 우리가\n공격 목표로 인식되었다고 봐도\n틀림없을 거예요….\n그렇다면,\n우리에게 남은 수단은 단 하나예요."
  },
  {
   "key": "7230aebbfe20",
   "speaker_korean": "아리그리프 13세",
   "korean": "「전면 교전, 인가."
  },
  {
   "key": "f4c785f6274b",
   "speaker_korean": "시하트 27세",
   "korean": "「예. 그러기 위해 우리나라의 ⟦1⟧시술병기⟦2⟧와\n⟦3⟧아리그리프⟦4⟧의 ⟦5⟧에어드래곤⟦6⟧,\n이 둘이 힘을 합쳐야만 하거든요."
  },
  {
   "key": "528e53440a10",
   "speaker_korean": "아리그리프 13세",
   "korean": "「나라 체면을 신경 쓸\n때가 아니라는 거로군."
  },
  {
   "key": "341f41217072",
   "speaker_korean": "시하트 27세",
   "korean": "「그렇습니다."
  },
  {
   "key": "7d14c9114677",
   "speaker_korean": "시하트 27세",
   "korean": "「어째서죠?"
  },
  {
   "key": "1b8a0d85779d",
   "speaker_korean": "아리그리프 13세",
   "korean": "「크기가 너무 다르다.\n우리 쪽 첩자가 입수한 정보\n그대로라면, 그 병기는\n⟦1⟧에어드래곤⟦2⟧으로는 옮길 수 없을 거다."
  },
  {
   "key": "b7497ad95949",
   "speaker_korean": "마리아",
   "korean": "「여러 마리 ⟦1⟧드래곤⟦2⟧으로 옮기는\n건 어때?"
  },
  {
   "key": "0205fbfb9a54",
   "speaker_korean": "아리그리프 13세",
   "korean": "「그것도 어려울 거다."
  },
  {
   "key": "e9628c09cb31",
   "speaker_korean": "클리프",
   "korean": "「하지만 말이야, 그러면 모처럼\n손잡은 의미가 없잖냐?"
  },
  {
   "key": "1171a98fd28d",
   "speaker_korean": "월터",
   "korean": "「그리 서두르지 말게, 애송이.\n왕께서 방금 '지금 당장은'이라 하셨잖은가?"
  },
  {
   "key": "77f8c97c028d",
   "speaker_korean": "아리그리프 13세",
   "korean": "「음.\n지금 있는 ⟦1⟧에어드래곤⟦2⟧으로 안 된다면,\n그보다 큰 ⟦3⟧에어드래곤⟦4⟧을\n길들이면 될 일이다."
  },
  {
   "key": "970649ce8225",
   "speaker_korean": "넬",
   "korean": "「그런 녀석이\n어디 있다는 거야?"
  },
  {
   "key": "e6b29f125d42",
   "speaker_korean": "월터",
   "korean": "「그대들도 가본 적\n있는 곳 근처일세.\n⟦P⟧⟦1⟧베크렐 광산⟦2⟧ 근처에\n⟦3⟧우르자 용암 동굴⟦4⟧이라 불리는 동굴이\n있는데…. 그 안에\n거대한 ⟦5⟧에어드래곤⟦6⟧이 살고 있다네."
  },
  {
   "key": "0ac2b19ed154",
   "speaker_korean": "클리프",
   "korean": "「그 녀석을 잡아 오면\n되는 거냐?"
  },
  {
   "key": "3a9d0158e697",
   "speaker_korean": "아리그리프 13세",
   "korean": "「그런 얘기다."
  },
  {
   "key": "026e2168ac95",
   "speaker_korean": "아리그리프 13세",
   "korean": "「하지만 그놈을 그저 ⟦1⟧에어드래곤⟦2⟧이라\n얕봤다간 큰코다칠 거다. 상대는 고도의 지능과\n강대한 힘을 지닌 위대한 후작급 ⟦3⟧드래곤⟦4⟧이다.\n⟦P⟧그 ⟦5⟧복스⟦6⟧조차도\n길들이지 못했던 녀석이니 말이다."
  },
  {
   "key": "f197bbfe1514",
   "speaker_korean": "시하트 27세",
   "korean": "「괜찮을 거예요.\n이 사람들은, 믿을\n만한 사람들이니까요."
  },
  {
   "key": "701d83d0e3dd",
   "speaker_korean": "아리그리프 13세",
   "korean": "「그대에게는 그렇겠지.\n하지만 우리 쪽으로서는\n완전히 신용할 수는 없다."
  },
  {
   "key": "e3b3f08f3886",
   "speaker_korean": "시하트 27세",
   "korean": "「그럼 어떻게 하면 된다는 거죠?\n납득해 주신 게\n아니었나요?"
  },
  {
   "key": "7e8bee2f2b29",
   "speaker_korean": "아리그리프 13세",
   "korean": "「뭐, ⟦1⟧아리그리프⟦2⟧에서도 한 명,\n그쪽 멤버에 넣어주면 된다.\n그럼 불만은 없다."
  },
  {
   "key": "8913f3276a0b",
   "speaker_korean": "시하트 27세",
   "korean": "「그건 딱히 상관없지만….\n누구시죠?\n⟦1⟧월터 옹⟦2⟧이신가요?"
  },
  {
   "key": "6ff7b381a46e",
   "speaker_korean": "아리그리프 13세",
   "korean": "「아니, ⟦1⟧월터⟦2⟧도 이제 나이가 있다.\n⟦3⟧우르자 용암 동굴⟦4⟧까지 보내기는 안쓰럽다.\n다른 자다."
  },
  {
   "key": "3e0eb1ab9e41",
   "speaker_korean": "페이트",
   "korean": "「그게 대체 누구시죠?"
  },
  {
   "key": "f7ccb500919e",
   "speaker_korean": "아리그리프 13세",
   "korean": "「…⟦1⟧알벨⟦2⟧을\n생각하고 있다만."
  },
  {
   "key": "c9263f7bd2c2",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧알벨⟦2⟧이라고?"
  },
  {
   "key": "5e33db83c206",
   "speaker_korean": "아리그리프 13세",
   "korean": "「불만인가? 나는 그 녀석이\n꽤 마음에 드는데 말이지.\n어떠냐? 여왕이여?"
  },
  {
   "key": "b3a13aa2d7b7",
   "speaker_korean": "시하트 27세",
   "korean": "「알겠습니다.\n그 사람도 동행하게 하죠….\n괜찮으시죠?"
  },
  {
   "key": "24eda1b5de62",
   "speaker_korean": "페이트",
   "korean": "「아, 예.\n저는 딱히 상관없습니다만…."
  },
  {
   "key": "e75325a1f952",
   "speaker_korean": "클리프",
   "korean": "「우리야 그렇다 치고,\n저쪽이 어떻게 생각하느냐가 문제겠지."
  },
  {
   "key": "382db8e6c517",
   "speaker_korean": "아리그리프 13세",
   "korean": "「결정됐군. 그럼 수고스럽겠지만,\n⟦1⟧알벨⟦2⟧을 데리러\n⟦3⟧아리그리프⟦4⟧까지 와주게."
  },
  {
   "key": "ed106b7ef6c4",
   "speaker_korean": "아리그리프 13세",
   "korean": "「기다리고 있겠네."
  },
  {
   "key": "56324a6e148d",
   "speaker_korean": "시하트 27세",
   "korean": "「죄송하지만, 저를 ⟦1⟧페터니⟦2⟧까지는\n데려다주세요. 그 후에는 ⟦3⟧클레어⟦4⟧에게 호위를\n넘기도록 하겠습니다. 그대들은\n그 후 ⟦5⟧아리그리프⟦6⟧로 향해 주세요."
  },
  {
   "key": "9f60f380d069",
   "speaker_korean": "페이트",
   "korean": "(음?\n⟦1⟧알벨⟦2⟧은 어떻게 된 거지?\n설마 그대로―――?"
  },
  {
   "key": "b4d1cb0c777d",
   "speaker_korean": "아리그리프 13세",
   "korean": "「알았다. 협력하지.\n하지만, ⟦1⟧시술병기⟦2⟧의 운반에 관해서는,\n지금 당장은 어렵다고 할 수밖에 없군."
  }
 ]
}