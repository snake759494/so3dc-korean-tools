{
 "batch_id": "batch_0076",
 "translations": [
  {
   "key": "924dd4a859ce",
   "speaker_korean": "아미나",
   "korean": "「저 꽃다발이 그런 거예요……."
  },
  {
   "key": "cb9ca8f78c07",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧신의 산⟦2⟧에 피는 ⟦3⟧팔미라 꽃⟦4⟧을\n직접 몇 송이씩 꺾어 와서,\n한 송이 한 송이 마음 담아 묶어요."
  },
  {
   "key": "8e92e78d0540",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧팔미라 꽃⟦2⟧은\n좀처럼 찾기 힘든 꽃이에요."
  },
  {
   "key": "df8a21e7049b",
   "speaker_korean": "페이트",
   "korean": "「허, 그렇구나……."
  },
  {
   "key": "ff7a44414bce",
   "speaker_korean": "페이트",
   "korean": "(⟦1⟧소피아⟦2⟧가 어릴 때 좋아하며 캐던\n네잎클로버 같은 걸까?"
  },
  {
   "key": "fd491ba2696d",
   "speaker_korean": "아주머니",
   "korean": "「묶은 꽃이 천 송이에 이르면,\n소원이 이루어진다고 하더구나.\n달과 비의 ⟦1⟧여신 팔미라⟦2⟧께서 우리의\n마음을 받아주신다지.\n비처럼 흘린\n눈물만큼의 마음을 말이다."
  },
  {
   "key": "0bbc48488c49",
   "speaker_korean": "아미나",
   "korean": "「예. 맞아요."
  },
  {
   "key": "83b33c7db996",
   "speaker_korean": "페이트",
   "korean": "「소원이 이루어진다……."
  },
  {
   "key": "f77263ed1db7",
   "speaker_korean": "아주머니",
   "korean": "「요즘 같은 시절이니 말이야.\n하루빨리 전쟁이 끝나길 바라거든.\n이 거리 사람들 모두 그리 생각해서\n⟦1⟧천송이꽃⟦2⟧을 만드는 거란다.\n뭐, 아쉽게도, 아직까지는\n소원이 이루어진 사람은 없지만 말이야."
  },
  {
   "key": "8839cf7423b7",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧도 그래?"
  },
  {
   "key": "367012c9fde7",
   "speaker_korean": "아미나",
   "korean": "「저요?"
  },
  {
   "key": "0f58ab48e997",
   "speaker_korean": "아주머니",
   "korean": "「이 아이는 소꿉친구를\n만나고 싶은 게\n제일 큰 소원이란다.\n물론 전쟁에 대한 것도\n있기야 하겠지만 말이다."
  },
  {
   "key": "a4ad54d56f49",
   "speaker_korean": "아미나",
   "korean": "「정말, 아주머니!"
  },
  {
   "key": "a6bd2d5c27ca",
   "speaker_korean": "페이트",
   "korean": "「소꿉친구, 라……."
  },
  {
   "key": "189aa62bd6f9",
   "speaker_korean": "아미나",
   "korean": "「말씀드렸었죠?\n그 사람 만날 수 있으면 좋겠다고요.\n아, 근데 소원이라는 게\n그것만은 아니거든요."
  },
  {
   "key": "bb8b387938ef",
   "speaker_korean": "아미나",
   "korean": "「제 병이……."
  },
  {
   "key": "0511310bb4e2",
   "speaker_korean": "아미나",
   "korean": "「음… 저기……."
  },
  {
   "key": "a26eb094a161",
   "speaker_korean": "페이트",
   "korean": "「……병? 뭐?"
  },
  {
   "key": "530851566e22",
   "speaker_korean": "아미나",
   "korean": "「아, 아니, 아무것도 아니에요."
  },
  {
   "key": "9579b41752de",
   "speaker_korean": "페이트",
   "korean": "「그래… 그럼 됐어."
  },
  {
   "key": "dff34585230c",
   "speaker_korean": "페이트",
   "korean": "「소원, 이루어지면 좋겠다."
  },
  {
   "key": "017343873b5d",
   "speaker_korean": "아미나",
   "korean": "「괜찮아요.\n저, 믿고 있으니까요.\n소원은 언젠가 꼭 이루어지거든요.\n포기하면, 거기서 끝이니까요."
  },
  {
   "key": "0b0bc627a1ce",
   "speaker_korean": "페이트",
   "korean": "「그렇네… 나도 그렇게 생각해."
  },
  {
   "key": "de7862a22065",
   "speaker_korean": "아미나",
   "korean": "「그렇죠."
  },
  {
   "key": "3ade59cea1da",
   "speaker_korean": "페이트",
   "korean": "「그래.\n그럼, 난 이만 가볼게.\n잘 지내, ⟦1⟧아미나⟦2⟧."
  },
  {
   "key": "d297648b9499",
   "speaker_korean": "아미나",
   "korean": "「예… ⟦1⟧페이트 씨⟦2⟧도\n조심히 가세요.\n혹시, 또 ⟦3⟧페타니⟦4⟧에\n오실 일이 있으면\n저희 집에 들러 주세요."
  },
  {
   "key": "6accb1a0785d",
   "speaker_korean": "페이트",
   "korean": "「그래, 그렇게 할게."
  },
  {
   "key": "f6eeb61eda28",
   "speaker_korean": "아미나",
   "korean": "「당신의 여정에\n⟦1⟧아페리스⟦2⟧의 가호가\n함께하기를."
  },
  {
   "key": "5da5902e4fd4",
   "speaker_korean": "아주머니",
   "korean": "「조심해서 가거라.\n네 여정에\n⟦1⟧아페리스⟦2⟧의 가호가\n함께하기를."
  },
  {
   "key": "a6dfb99bd327",
   "speaker_korean": "페이트",
   "korean": "「그럼."
  },
  {
   "key": "8123620eaad8",
   "speaker_korean": "아미나",
   "korean": "「그런 건 아닌 것 같은데요."
  },
  {
   "key": "204f86b14cdc",
   "speaker_korean": "클리프",
   "korean": "「괜찮잖냐.\n너도 그 정도 뻔뻔함은\n있어야 한다고 보는데 말이야."
  },
  {
   "key": "39e4aabcc9a8",
   "speaker_korean": "페이트",
   "korean": "「그런가?"
  },
  {
   "key": "16dc9c66b31c",
   "speaker_korean": "클리프",
   "korean": "「그래, 적어도 그쪽이\n내 취향엔 맞으니까 말이야.\n자, 가자고…\n그 녀석이 밖에서 기다리잖아."
  },
  {
   "key": "d9703db546b7",
   "speaker_korean": "클리프",
   "korean": "「괜찮겠냐?"
  },
  {
   "key": "e6b3ba3c780a",
   "speaker_korean": "클리프",
   "korean": "「그나저나 ⟦1⟧미개행성 보호조약⟦2⟧은\n어쩔 거냐?\n그렇게 신경 쓰더니 말이야."
  },
  {
   "key": "81a6a39e2a6e",
   "speaker_korean": "페이트",
   "korean": "「응… 이미 결심했어."
  },
  {
   "key": "9ed9a779de4f",
   "speaker_korean": "페이트",
   "korean": "「전쟁을 끝내기 위해 필요한 일,\n할 수 있는 걸 할 뿐이야."
  },
  {
   "key": "568ab696f34b",
   "speaker_korean": "클리프",
   "korean": "「『남이 못해도 난 할 수 있어.\n그리고 그게 남을 돕는 거라면』…이라니.\n잘난 척은."
  },
  {
   "key": "0d2af32b5cda",
   "speaker_korean": "페이트",
   "korean": "「어차피 여기까지 발 들인 거야.\n이제 와서 별 차이 없잖아?\n게다가 살아서 이 별을 뜰 수 있을지조차\n모르는 거고……."
  },
  {
   "key": "5aafffd92005",
   "speaker_korean": "클리프",
   "korean": "「제법 뻔뻔해졌잖아, 이 녀석."
  },
  {
   "key": "c234ab20970a",
   "speaker_korean": "페이트",
   "korean": "「나쁜가? 아버지를 구하기 위해서라도\n이 상황은 바꿔야 하니까……."
  }
 ]
}