{
 "batch_id": "batch_0032",
 "translations": [
  {
   "key": "64ec034adec9",
   "speaker_korean": "전직 질풍 병사",
   "korean": "⟦1⟧「뭐냐 네놈?\n이 몸을 비웃으러 왔나?\n⟦P⟧내가, 이 나라를 위해 대체\n얼마나 많은 ⟦2⟧시하츠⟦3⟧의\n쓰레기들을 죽였다고 생각하나?\n⟦P⟧직접・간접 합쳐 십수 명….\n아니, 비전투원까지 더하면\n백 명은 넘을 것이다.\n⟦P⟧그만한 무공을 세운 내가\n어째서, 이런 처우를\n받아야 한단 말이냐!\n⟦P⟧빌어먹을!\n이것이 목숨 바쳐 나라에 헌신한\n충신에 대한 처사란 말인가!\n⟦P⟧"
  },
  {
   "key": "4cc3072712e5",
   "speaker_korean": "전직 질풍 병사",
   "korean": "⟦1⟧「이 ⟦2⟧아리그리프 왕국⟦3⟧의 역사 속에서\n최고의….\n⟦P⟧아니, 앞선 ⟦4⟧고대 왕국 시포트⟦5⟧의\n대부터 헤아려도 최강의 용사였던\n⟦6⟧복스 공작⟦7⟧만 살아 있었더라면\n⟦P⟧내가 이런 부당한 꼴을\n당하는 일도 없었을 텐데….\n빌어먹을!\n⟦P⟧"
  },
  {
   "key": "af0c0b31acb7",
   "speaker_korean": "전직 귀족",
   "korean": "⟦1⟧「지금, 세간이 믿는 ⟦2⟧아페리스교⟦3⟧는,\n⟦4⟧시하츠⟦5⟧의 무리가 제멋대로 해석해\n왜곡한 것.\n⟦P⟧이제 그것은, ⟦6⟧아페리스 님⟦7⟧의 가르침이라\n부를 만한 물건이 아니야.\n그런 저열한 사상에 사로잡힌 자들 따위\n살아 있을 가치가 없지 않은가.\n⟦P⟧그놈들은 모두, 정화되어 마땅한 존재\n인 게야!\n⟦P⟧진정 ⟦8⟧아페리스 님⟦9⟧의 가르침을 중히\n여긴다면, 지금 같은 때야말로\n정의를 위해 일어서야 한다고 생각지 않나?\n⟦P⟧"
  },
  {
   "key": "52a668d712b8",
   "speaker_korean": "전직 귀족",
   "korean": "⟦1⟧「고대부터, 저 ⟦2⟧시하츠⟦3⟧의 땅을\n다스린 것은 우리 ⟦4⟧아리그리프⟦5⟧의 백성이다.\n⟦P⟧⟦6⟧시하츠⟦7⟧라는 나라는, 우리 선조가\n⟦8⟧그리텐 왕국⟦9⟧과 전쟁을 벌이던 시기의\n혼란을 틈타 제멋대로 세운 나라.\n⟦P⟧그런 하등한 자들이, ⟦10⟧아페리스 신⟦11⟧의\n뜻을 이해할 리도 없지.\n⟦P⟧저 나라 자들 같은 하등한 민족은,\n우리 같은 우수한 자들이 올바른 길로\n이끌어 주어야 하거늘!\n⟦P⟧"
  },
  {
   "key": "cdfd2aa6b7cd",
   "speaker_korean": null,
   "korean": "감옥"
  },
  {
   "key": "2ca56c68a185",
   "speaker_korean": "붙잡힌 신부",
   "korean": "⟦1⟧「저희는 짐만 될 뿐일\n겁니다.\n신경 쓰지 마시고 도망치십시오.\n⟦P⟧"
  },
  {
   "key": "7b76aebae4b5",
   "speaker_korean": "심문관",
   "korean": "⟦1⟧「나, 난 잘못 없어.\n일이라 어쩔 수 없이….\n⟦P⟧임무에 충실했을 뿐이야.\n히, 히히히히….\n⟦P⟧"
  },
  {
   "key": "d722157b32c2",
   "speaker_korean": "심문관",
   "korean": "⟦1⟧「아아아, 집 대출은 어떻게 된 거야?\n아들 녀석, 괴롭힘당하고 있진 않으려나….\n⟦P⟧"
  },
  {
   "key": "7a4c41fa14a0",
   "speaker_korean": "미하엘 자작",
   "korean": "⟦1⟧「조심하세요.\n무장한 병사들이 당신들을\n매복해 기다리고 있습니다.\n⟦P⟧"
  },
  {
   "key": "e13a196409f4",
   "speaker_korean": "페이트",
   "korean": "「뭐, 그럭저럭.\n아야야야…."
  },
  {
   "key": "e6779a793c65",
   "speaker_korean": "페이트",
   "korean": "「너도 마찬가지잖아?"
  },
  {
   "key": "29c69f351135",
   "speaker_korean": "클리프",
   "korean": "「그렇지 뭐.\n게다가 난 너보다\n심문엔 익숙하다고."
  },
  {
   "key": "fd03b73437fb",
   "speaker_korean": "페이트",
   "korean": "「반은하연방 조직\n멤버니까 말이야."
  },
  {
   "key": "e6ec9451a31b",
   "speaker_korean": "클리프",
   "korean": "「그래, 겪은 수라장이 다르다고.\n근데 용케 입 다물고 버텼구만."
  },
  {
   "key": "c94724a65b7a",
   "speaker_korean": "페이트",
   "korean": "「어쩔 수 없잖아.\n『우리는 우주에서 왔습니다』\n라고 말할 순 없다고.\n애초에 말해도 믿어 줄 리 없잖아."
  },
  {
   "key": "25ddd16bcb86",
   "speaker_korean": "페이트",
   "korean": "「근데 말이야, 왜 순순히 잡힌 거야?\n너라면 어떻게든 도망칠 수 있었잖아?"
  },
  {
   "key": "f980406e32d5",
   "speaker_korean": "클리프",
   "korean": "「응?\n아아, 귀찮았으니까."
  },
  {
   "key": "f10a20b9f3be",
   "speaker_korean": "페이트",
   "korean": "「뭐야, 그게."
  },
  {
   "key": "cc1712a9e156",
   "speaker_korean": "클리프",
   "korean": "「말 그대로의 의미인데 말이지.\n게다가 널 두고 갈 순 없잖냐?\n뭐, 상황을 알고 싶었던 것도\n있긴 하다만…."
  },
  {
   "key": "b41732ecff8f",
   "speaker_korean": "페이트",
   "korean": "「뭔가 알아냈어?"
  },
  {
   "key": "ef00a59ee9bf",
   "speaker_korean": "클리프",
   "korean": "「그래, 하나만 말이지."
  },
  {
   "key": "4134b79035c2",
   "speaker_korean": "페이트",
   "korean": "「뭔데?"
  },
  {
   "key": "ba8073c10944",
   "speaker_korean": "클리프",
   "korean": "「여기서도 채찍은 아프다는 거다."
  },
  {
   "key": "4d4c43c213a8",
   "speaker_korean": "페이트",
   "korean": "「저기 말이야……."
  },
  {
   "key": "0ae418556a17",
   "speaker_korean": "페이트",
   "korean": "「그러고 보니 ⟦1⟧시하츠⟦2⟧라는 게\n뭘까?"
  },
  {
   "key": "dde46b0b83a4",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧시하츠⟦2⟧?"
  },
  {
   "key": "3a58532627ea",
   "speaker_korean": "페이트",
   "korean": "「심문관이 그런 말을 했었거든.\n⟦1⟧이글⟦2⟧을 가리키면서,\n⟦3⟧시하츠⟦4⟧의 신병기냐고."
  },
  {
   "key": "6fc9d09a7ac6",
   "speaker_korean": "클리프",
   "korean": "「필시, 적대 세력 이름이겠지."
  },
  {
   "key": "08e29746850f",
   "speaker_korean": "페이트",
   "korean": "「그럼, 우리가 스파이라고\n여겨질 가능성도 있는 건가?"
  },
  {
   "key": "7569242c0148",
   "speaker_korean": "클리프",
   "korean": "「이 구속구, 꽤나 튼튼하게 만들었잖아.\n젠장할…답답해서 못 해먹겠군."
  },
  {
   "key": "4f19829610b7",
   "speaker_korean": "페이트",
   "korean": "「그야 그렇지.\n헐렁한 구속구 따위, 쓸모없잖아?"
  },
  {
   "key": "f2950480df1e",
   "speaker_korean": "클리프",
   "korean": "「납득 못 하겠어….\n젠장, 이래선 도망칠 수도 없잖냐."
  },
  {
   "key": "f79ff3f62979",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧미라쥬 씨⟦2⟧,\n무사히 도망쳤으려나?"
  },
  {
   "key": "4fe94860844c",
   "speaker_korean": "클리프",
   "korean": "「괜찮을 거다.\n전에도 말했지만 그 녀석도 ⟦1⟧클라우스트로인⟦2⟧이다.\n진작에 성 아래에 잠복해 있겠지."
  },
  {
   "key": "9042847d97e7",
   "speaker_korean": "페이트",
   "korean": "「그렇다면 다행이지만.\n하아…이런 상태로 아버지를\n구해낼 수 있기나 한 걸까?\n⟦1⟧반딘⟦2⟧이 무슨 목적으로 아버지를 잡아뒀는지\n모르겠지만, 정중히 대접받고 있으리라곤\n도저히 생각할 수 없고…."
  },
  {
   "key": "3cfdf7b8f4e7",
   "speaker_korean": "클리프",
   "korean": "「뭐, 그렇게 침울해하지 말라고.\n조만간 누군가 불쑥 나타나서,\n여기서 꺼내 줄 거다.\n그러면 쓸 수 있는 수도 생기는 법이지."
  },
  {
   "key": "6eb7afe0b83e",
   "speaker_korean": "페이트",
   "korean": "「누군가라니 대체 누구야.\n이런 곳에 누가 온다는 거야? ⟦1⟧미라쥬 씨⟦2⟧한텐\n오지 않아도 된다고 말해 버렸고.\n다른 아는 사람도 없단 말이야.\n리더하고도\n그렇게 금방 연락되진 않잖아?"
  },
  {
   "key": "bafab5442d3b",
   "speaker_korean": "클리프",
   "korean": "「왔군."
  },
  {
   "key": "19aa27b018ed",
   "speaker_korean": "클리프",
   "korean": "「적인지 아군인지,\n모르겠다만 말이야."
  },
  {
   "key": "9ed2ee8dda41",
   "speaker_korean": "페이트",
   "korean": "「어? 뭐가?"
  },
  {
   "key": "104d96d310ec",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「너희에겐 두 가지 선택지가 있어.\n내 말을 받아들이고, 여기서 살아 나가느냐.\n내 말을 거절하고, 여기서 죽느냐.\n…자, 마음에 드는 쪽을 골라."
  },
  {
   "key": "fea37027c47e",
   "speaker_korean": "클리프",
   "korean": "「어이."
  },
  {
   "key": "2eb76a3edcba",
   "speaker_korean": "페이트",
   "korean": "「엣?"
  },
  {
   "key": "62cc84d940b4",
   "speaker_korean": "클리프",
   "korean": "「어지간히 폭 좁은 양자택일이구만,\n어이!?"
  },
  {
   "key": "e0fabc0d8790",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「고민할 일도 아니잖아?\n답은 하나뿐이라고 생각하는데?"
  },
  {
   "key": "aeafd58afe55",
   "speaker_korean": "클리프",
   "korean": "「…요구가 뭐냐? 말해 봐라."
  },
  {
   "key": "459d628175b1",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「너희 힘을 빌리고 싶은 거야."
  },
  {
   "key": "63c763228fab",
   "speaker_korean": "클리프",
   "korean": "「힘이라고?"
  },
  {
   "key": "98f6058d223b",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「그래. 너희는 이 거리에 떨어진\n금속 덩어리에 타고 있던 자들이지?\n우리는 너희가 아는 기술을\n손에 넣고 싶은 거야."
  },
  {
   "key": "c4c3cff8c791",
   "speaker_korean": "페이트",
   "korean": "「기술이라니…그런 걸\n가르쳐 줄 리 없잖아!?"
  },
  {
   "key": "6c4c7640ae46",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「어째서지?"
  },
  {
   "key": "1df1a72b4835",
   "speaker_korean": "페이트",
   "korean": "「어째서라니……."
  },
  {
   "key": "fa8ee7b20300",
   "speaker_korean": "클리프",
   "korean": "「기술을 손에 넣어서\n뭘 할 셈이냐?"
  },
  {
   "key": "f51c531bcb8d",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「지금, 이 나라와 우리 나라 사이에\n벌어지고 있는 전쟁을 끝낸다.\n물론, 우리의 승리라는 형태로 말이야."
  },
  {
   "key": "94e9492461a4",
   "speaker_korean": "페이트",
   "korean": "「잠깐만요…….\n지금, 이 나라와 우리 나라라고 하셨죠?\n그렇다는 건, 당신은 우릴 투옥한\n사람들과는 다르다는 뜻인가요?"
  },
  {
   "key": "c45a5077bad9",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「그래.\n난 ⟦1⟧아리그리프⟦2⟧의 인간이 아니야.\n⟦3⟧시하츠⟦4⟧의 인간이지."
  },
  {
   "key": "7b6a1f05797f",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧시하츠⟦2⟧라면…\n심문관이 말했던 이름이야."
  },
  {
   "key": "4a2ab5b5935d",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「보아하니, ⟦1⟧아리그리프⟦2⟧에\n환대받고 있는 모양새는 아닌 것 같고.\n나쁜 얘기는 아니라고 생각하는데?"
  },
  {
   "key": "378699986720",
   "speaker_korean": "클리프",
   "korean": "「알았다. 협력해 주지."
  },
  {
   "key": "ab7da4019ecf",
   "speaker_korean": "페이트",
   "korean": "「무, 무슨 소릴 하는 거야!!"
  },
  {
   "key": "190d0304ce1b",
   "speaker_korean": "클리프",
   "korean": "「잠깐, 미안하군."
  },
  {
   "key": "398ec0dd9421",
   "speaker_korean": "클리프",
   "korean": "「됐으니까 넌 입 다물고 있어."
  },
  {
   "key": "9c4679421fee",
   "speaker_korean": "페이트",
   "korean": "「그치만, 협력이라니.\n애초에, 기술을 손에 넣고 싶다고\n해도, 뭘 가르치라는 건지…."
  },
  {
   "key": "4b64266699b0",
   "speaker_korean": "클리프",
   "korean": "「적어도 이 별의 문명 수준 정도 과학은\n알잖냐?\n폼으로 대학 다닌 건 아닐 거 아냐.\n어차피 요구받아 봤자 그 정도겠지."
  },
  {
   "key": "6a2b9c19ce9d",
   "speaker_korean": "페이트",
   "korean": "「그건 그럴지도 모르지만….\n하지만 ⟦1⟧미개 행성 보호 조약⟦2⟧은 어쩔 건데?"
  },
  {
   "key": "9eef2be39dd6",
   "speaker_korean": "클리프",
   "korean": "「진짜 지독하게 고지식한 녀석이군.\n뭐, 그게 네 좋은 점이기도 하겠지만 말이다.\n융통성 없는 데가, 아주 빼닮았어. 정말이지…."
  },
  {
   "key": "492f1d141b64",
   "speaker_korean": "페이트",
   "korean": "「누구랑 뭐가 닮았다는 거야?"
  },
  {
   "key": "bdd784fecd9e",
   "speaker_korean": "클리프",
   "korean": "「들렸냐?\n뭐, 그런 건 아무래도 상관없다."
  },
  {
   "key": "bdfe62b21b64",
   "speaker_korean": "페이트",
   "korean": "「아무래도 좋을 리 없잖아."
  },
  {
   "key": "36e9d640fbab",
   "speaker_korean": "클리프",
   "korean": "「상관없다니까.\n그것보다 들으라고.\n잘 들어, 저 여자 얘기로 짐작하건대,\n우린 ⟦1⟧아리그리프⟦2⟧라는 나라에 있는 모양이다.\n그리고, 이 ⟦3⟧아리그리프⟦4⟧와,\n저 여자가 속한 ⟦5⟧시하츠⟦6⟧라는 곳은\n전쟁 중이다…여기까진 됐나?"
  },
  {
   "key": "4f2f2b12b02a",
   "speaker_korean": "페이트",
   "korean": "「그래."
  },
  {
   "key": "f81dc66cf31a",
   "speaker_korean": "클리프",
   "korean": "「게다가 우린, 양쪽 세력 모두에게\n미지의 기술을 지녔다고 여겨지고 있는 셈이다.\n뭐, 하늘 나는 금속 덩어리가 중세 수준 마을에\n떨어졌으니, 그것도 당연하겠지만 말이야."
  },
  {
   "key": "f0828f255c02",
   "speaker_korean": "페이트",
   "korean": "「그렇다고―――."
  },
  {
   "key": "317a85b97dfb",
   "speaker_korean": "클리프",
   "korean": "「뭐, 어차피 협력할 거라면\n미인 쪽에 붙는 게 몇 배는 즐겁잖냐?"
  },
  {
   "key": "d129e01d4d47",
   "speaker_korean": "페이트",
   "korean": "「뭐야, 그게.\n그런 말 하고 있을 때가 아니잖아."
  },
  {
   "key": "92b7212d9f80",
   "speaker_korean": "클리프",
   "korean": "「그건 농담이라 치더라도 말이다.\n어쨌든 여기서 나가기만 하면,\n나머진 어떻게든 된다.\n타이밍을 봐서 도망치면 되는 거다."
  }
 ]
}