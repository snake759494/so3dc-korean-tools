{
 "batch_id": "batch_0128",
 "translations": [
  {
   "key": "527cf125a0c0",
   "speaker_korean": "러셀 집정관",
   "korean": "수고했다.\n저자들이 그들인가?"
  },
  {
   "key": "7cb4be8d4352",
   "speaker_korean": "넬",
   "korean": "예, ⟦1⟧러셀 님⟦2⟧."
  },
  {
   "key": "385a915e6452",
   "speaker_korean": "러셀 집정관",
   "korean": "고개를 들라.\n폐하께서 말씀하신다… 명심하여 들으라."
  },
  {
   "key": "53d8dd50d8b3",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧성왕국 시하츠⟦2⟧에 오신 것을 환영합니다.\n⟦3⟧그리텐⟦4⟧의 기술자들이여……\n이 나라를 다스리는 시하츠의 여왕,\n⟦5⟧로메리아 진 에뮤리루⟦6⟧입니다."
  },
  {
   "key": "4db94ae178c1",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧페이트 라인갓⟦2⟧입니다."
  },
  {
   "key": "39e95f5e6a4f",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧클리프 피터⟦2⟧라고 합니다, 폐하.\n알현을 허락하시니 매우 영광입니다."
  },
  {
   "key": "7cf2236de274",
   "speaker_korean": "시하트 27세",
   "korean": "그대들을 우리 왕궁으로 부른 것은\n다른 이유가 아닙니다.\n그대들의 힘을 빌리고 싶어서입니다.\n이미 들어 알고 있으리라 생각하지만,\n지금 우리나라는 ⟦1⟧아리그리프⟦2⟧와\n전쟁 상태에 있습니다.\n그리고 전황은 우리나라에게\n불리한 상황입니다……\n저는 지금 상황에서 ⟦3⟧아페리스교⟦4⟧ 경전,\n⟦5⟧이케로스의 예언서⟦6⟧ 제15장을\n떠올리지 않을 수 없습니다."
  },
  {
   "key": "735bd0ed6d78",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧이케로스의 예언서⟦2⟧…… 말인가요?"
  },
  {
   "key": "7b2320a4c9a8",
   "speaker_korean": "시하트 27세",
   "korean": "그리텐인인 그대들에게는\n낯선 이야기일지도 모르겠군요.\n⟦1⟧아페리스교⟦2⟧의 창시자인 초대 시하츠 왕이\n기록한 예언서입니다.\n그중 제15장에 다음과 같은 구절이\n있습니다."
  },
  {
   "key": "b152bbba6089",
   "speaker_korean": "시하트 27세",
   "korean": "성지에 혼돈이 있으리니,\n혼돈은 크나큰 재앙을 흩뿌리고,\n재앙은 새로운 전란을 낳으리라……"
  },
  {
   "key": "c0f4b2d66865",
   "speaker_korean": "시하트 27세",
   "korean": "지금 우리나라는 ⟦1⟧아리그리프⟦2⟧로 인해\n전란의 소용돌이에 휘말려 있습니다.\n이대로 가면 죄 없는 백성들의 목숨이\n사라지고 말 것입니다……"
  },
  {
   "key": "3434c2302936",
   "speaker_korean": "시하트 27세",
   "korean": "저는 지금이 이 예언이 이루어지고\n있는 때가 아닌가 생각합니다.\n또한 그대들이 예언 속 화살이라고……"
  },
  {
   "key": "38d4d9c4c91a",
   "speaker_korean": "페이트",
   "korean": "그런, 그러지 마세요.\n폐하, 저희가 뭘 할 수 있을지는\n모르겠지만, 할 수 있는 데까지는\n하겠습니다.\n그럴 각오로 여기 왔으니까요."
  },
  {
   "key": "7ca214f6b834",
   "speaker_korean": "러셀 집정관",
   "korean": "누구 없느냐!"
  },
  {
   "key": "beb5c28cf9b5",
   "speaker_korean": "병사",
   "korean": "넷!"
  },
  {
   "key": "9dbfe4e88b8b",
   "speaker_korean": "러셀 집정관",
   "korean": "⟦1⟧그리텐⟦2⟧의 손님들을\n객실로 안내하라."
  },
  {
   "key": "9da10c2d48e0",
   "speaker_korean": "시하트 27세",
   "korean": "그런 사태를 피하기 위해서라도\n부디 그대들의 힘을\n우리나라를 위해 빌려주세요."
  },
  {
   "key": "b7a03031da83",
   "speaker_korean": "시하트 27세",
   "korean": "알아서 잘 처리해 주세요."
  },
  {
   "key": "fc07cb24ce0e",
   "speaker_korean": "시하트 27세",
   "korean": "이제 양측이 협력해서 ⟦1⟧반데인⟦2⟧을\n몰아내는 수밖에 없다는 것이군요."
  },
  {
   "key": "16cab8f70155",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧아리그리프⟦2⟧에 협력을 요청합시다."
  },
  {
   "key": "fe8a0f7a7450",
   "speaker_korean": "시하트 27세",
   "korean": "요컨대 무기를 공중까지\n옮길 수만 있으면 되겠죠?\n그들은 그 방법을 갖고 있어요.\n……그걸 빌리면 되는 겁니다."
  },
  {
   "key": "17f5014b34b4",
   "speaker_korean": "시하트 27세",
   "korean": "그렇습니다."
  },
  {
   "key": "e1175d388908",
   "speaker_korean": "넬",
   "korean": "폐하……"
  },
  {
   "key": "89c8d5ffb033",
   "speaker_korean": "시하트 27세",
   "korean": "그대들 두 사람은,\n잠시 대기해 주세요.\n그녀들이 돌아오는 대로,\n사람을 보내 부르도록 하겠습니다."
  },
  {
   "key": "f039ae20c713",
   "speaker_korean": "클리프",
   "korean": "그래서, 이제 어떡할 거야?\n놈들, 더 기를 쓰고 덤벼들 거라고."
  },
  {
   "key": "db59b0a68079",
   "speaker_korean": "넬",
   "korean": "아니요…… 그들의\n협력이 있었기에 가능한 겁니다."
  },
  {
   "key": "2f1cc1eeb059",
   "speaker_korean": "마리아",
   "korean": "게다가 ⟦1⟧카난⟦2⟧에서 놈들을 쓰러뜨린 것으로,\n널 내줘도 이 나라가 무사할\n가능성은 사라졌다고 봐야\n하겠지."
  },
  {
   "key": "28a37d7123e2",
   "speaker_korean": "마리아",
   "korean": "안타깝게도."
  },
  {
   "key": "02a566a8b424",
   "speaker_korean": "클리프",
   "korean": "근데 말이야, 어떻게 할 건데?\n유일하게 믿을 만한 무기는\n아직 미완성인 데다 사거리도 문제야.\n안 닿는 공격이 무슨 효과가 있겠냐."
  },
  {
   "key": "e894bc15e947",
   "speaker_korean": "페이트",
   "korean": "그렇단 말이지……\n서둘러 무기를 완성시킨다 해도,\n저걸 유효사거리까지 옮길 수단이 없어."
  },
  {
   "key": "e6c7edbb84b1",
   "speaker_korean": "러셀 집정관",
   "korean": "폐하!? 방금, 뭐라 하셨습니까!!"
  },
  {
   "key": "0aa446859760",
   "speaker_korean": "러셀 집정관",
   "korean": "하오나 놈들이 순순히\n협력하겠습니까.\n아니, 설령 좋은 대답을\n얻는다 해도, 그 후에\n배신하지 않는다고는 못 하옵니다."
  },
  {
   "key": "76097d66f285",
   "speaker_korean": "페이트",
   "korean": "그런가…… 그렇겠죠."
  },
  {
   "key": "f86ef00c3505",
   "speaker_korean": "시하트 27세",
   "korean": "아니요, 그렇다고도 할 수 없겠지요.\n앞서 ⟦1⟧반데인⟦2⟧의 공격은\n그 나라도 큰 피해를 입었을 겁니다.\n이제는 우리에게 신경 쓸 여유가\n없을 것입니다.\n게다가 그 나라의 전쟁을 강력히 주장하던\n강경파 ⟦3⟧복스⟦4⟧는 이미 세상을 떠났습니다.\n지금이라면…… 그도, ⟦5⟧아리그리프 왕⟦6⟧도\n이해해 줄 거라 생각합니다.\n지금은 한 나라의 이익을 우선할\n상황이 아니니까요."
  },
  {
   "key": "0772b1464a47",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧아리그리프⟦2⟧에 협력을 요청하지요.\n곧 친서를 준비해 사자를 보내겠습니다.\n……가 주시겠어요?"
  },
  {
   "key": "0a1e231d417b",
   "speaker_korean": "클리프",
   "korean": "그럼 나도 따라가지."
  },
  {
   "key": "ca528bbb05e5",
   "speaker_korean": "클리프",
   "korean": "여기선 내가 가는 게\n더 믿음직스럽지 않겠냐?\n게다가 ⟦1⟧시하츠⟦2⟧ 사람들만으론\n설명도 제대로 못 하겠지."
  },
  {
   "key": "2ba0977a4a22",
   "speaker_korean": "넬",
   "korean": "그건 그럴지도 모르지만\n……위험해."
  },
  {
   "key": "fb794ad109c1",
   "speaker_korean": "클리프",
   "korean": "위험이 뭐 어쨌다는 거야.\n그 정도야 별거 아니지."
  },
  {
   "key": "0b3ad0e002ee",
   "speaker_korean": "시하트 27세",
   "korean": "알겠습니다.\n그대도 동행해 주세요."
  },
  {
   "key": "63a22bb4aaa8",
   "speaker_korean": "넬",
   "korean": "옮기는…… 방법……\n⟦1⟧에어드래곤⟦2⟧ 말인가요!"
  },
  {
   "key": "69e225eab13e",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧에레나⟦2⟧, 그대는 ⟦3⟧선더 애로우⟦4⟧\n준비를 서두르게 하세요."
  },
  {
   "key": "cd717b99bc4c",
   "speaker_korean": "에레나",
   "korean": "예, 맡겨 주십시오."
  },
  {
   "key": "9ed88798a86b",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧미라쥬⟦2⟧,\n당신은 ⟦3⟧선더 애로우⟦4⟧\n준비를 도와줘."
  },
  {
   "key": "6dc92d26a931",
   "speaker_korean": "미라쥬",
   "korean": "알겠습니다."
  },
  {
   "key": "47c33b8a2bb3",
   "speaker_korean": "페이트",
   "korean": "저기, 저는……"
  },
  {
   "key": "9dccda9bebc5",
   "speaker_korean": "시하트 27세",
   "korean": "분명히 부탁했습니다."
  },
  {
   "key": "fff5f86c6345",
   "speaker_korean": "페이트",
   "korean": "예, 알겠습니다."
  },
  {
   "key": "a829bf0402fa",
   "speaker_korean": "마리아",
   "korean": "저기……"
  },
  {
   "key": "dff534b7dcbc",
   "speaker_korean": "마리아",
   "korean": "이따가 잠깐 시간 좀 내줄래?"
  },
  {
   "key": "0e169588d46a",
   "speaker_korean": "페이트",
   "korean": "어, 그래. 괜찮은데."
  },
  {
   "key": "dad4a9d777bb",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧카난⟦2⟧에 도적 침입을 허용해 유감이지만,\n⟦3⟧세피라⟦4⟧가 무사해 불행 중 다행입니다.\n모두들, 고마웠습니다.\n그대도 수고했어요."
  },
  {
   "key": "c0611b619297",
   "speaker_korean": "시하트 27세",
   "korean": "그럼, 그대가 애초의\n발단이라는 겁니까?"
  },
  {
   "key": "4efb1320ad2c",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧러셀⟦2⟧, 조용히 하라고 했습니다."
  },
  {
   "key": "193652f0ec36",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧선더 애로우⟦2⟧를 쓰면\n⟦3⟧반데인⟦4⟧이라는 자들에 대항할 수 있나요?"
  },
  {
   "key": "84326b1a1450",
   "speaker_korean": "넬",
   "korean": "그럼, 폐하!!"
  },
  {
   "key": "6248545bb541",
   "speaker_korean": "시하트 27세",
   "korean": "예. ⟦1⟧선더 애로우⟦2⟧를\n그대들에게 맡기지요."
  },
  {
   "key": "32851269a5fa",
   "speaker_korean": "시하트 27세",
   "korean": "……누구입니까?"
  },
  {
   "key": "37e9203e50e8",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧세피라⟦2⟧를 말입니까!?"
  },
  {
   "key": "9be3c9342475",
   "speaker_korean": "병사",
   "korean": "놈들은 기괴한 갑옷을 걸치고\n빛나는 무기를 장비하고 있습니다!!\n⟦1⟧시술사들⟦2⟧이 어떻게든 막아내고 있지만,\n빛나는 무기에는 전혀 못 당해냅니다!!\n이대로면 ⟦3⟧세피라⟦4⟧까지 도달당하는 것은\n시간문제로 보입니다!!"
  },
  {
   "key": "ea3388d188c3",
   "speaker_korean": "시하트 27세",
   "korean": "⟦1⟧시랜드⟦2⟧ 동쪽이 됩니다만……"
  },
  {
   "key": "2b9919aefb62",
   "speaker_korean": "클리프",
   "korean": "그게 무슨 소리야?"
  },
  {
   "key": "ffcb6021b8ea",
   "speaker_korean": "시하트 27세",
   "korean": "그대는 즉시 부대를 지휘하여\n⟦1⟧카난⟦2⟧으로 향하세요."
  },
  {
   "key": "a7bf3350b5b7",
   "speaker_korean": "페이트",
   "korean": "잠시만요, 폐하."
  },
  {
   "key": "cdda02e319c1",
   "speaker_korean": "페이트",
   "korean": "그 얘기입니다.\n아마 시하츠군의 장비로는\n그들에게 대항할 수 없습니다."
  },
  {
   "key": "3f3d62dd58ab",
   "speaker_korean": "시하트 27세",
   "korean": "그건 알고 있습니다만,\n그렇다고 방치해 둘 수도\n없습니다."
  },
  {
   "key": "65c2c51abf43",
   "speaker_korean": "시하트 27세",
   "korean": "알겠습니다.\n그대들에게 맡기지요."
  },
  {
   "key": "0de7439ea5a5",
   "speaker_korean": "시하트 27세",
   "korean": "예…… 그리하세요.\n⟦P⟧사태가 촌각을 다투는군요.\n⟦1⟧봉인 동굴⟦2⟧의 사용을 허가합니다.\n그들을 안내하세요."
  },
  {
   "key": "78a5927f8052",
   "speaker_korean": "넬",
   "korean": "⟦1⟧봉인 동굴⟦2⟧을 말씀이신가요?"
  },
  {
   "key": "f553a63e48b2",
   "speaker_korean": "시하트 27세",
   "korean": "예, 왕족만이 지날 수 있도록\n허락된 곳입니다만,\n지금은 비상시입니다. 어쩔 수 없지요.\n……부디 잘 부탁합니다."
  },
  {
   "key": "f524e8ab95a6",
   "speaker_korean": "넬",
   "korean": "옛!!"
  },
  {
   "key": "914709246299",
   "speaker_korean": "넬",
   "korean": "폐하, 저들이 사정을\n설명하겠다고 합니다."
  },
  {
   "key": "9d396fed4560",
   "speaker_korean": "시하트 27세",
   "korean": "이야기는 잘 알겠습니다."
  },
  {
   "key": "0bee86eadef0",
   "speaker_korean": "러셀 집정관",
   "korean": "네놈들이 이세계 사람이라고!?\n그런 헛소리를 믿으라는 거냐!?\n적당히 좀 해라!!"
  }
