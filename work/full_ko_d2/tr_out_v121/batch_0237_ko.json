{
 "batch_id": "batch_0237",
 "translations": [
  {
   "key": "70999f7da3da",
   "speaker_korean": "파피",
   "korean": "「윽, 괴로워…"
  },
  {
   "key": "526d6ec1e237",
   "speaker_korean": "파피",
   "korean": "「뭐, 뭘 멍하니 보고 있는 거야…!\n특A클래스 해독제는 없는 거야!?"
  },
  {
   "key": "f54727846a03",
   "speaker_korean": null,
   "korean": "⟦1⟧・만능 해독제 시제품을 준다"
  },
  {
   "key": "6c25b7960492",
   "speaker_korean": null,
   "korean": "⟦1⟧・내버려둔다"
  },
  {
   "key": "7a892728fd77",
   "speaker_korean": "파피",
   "korean": "「너… 악마야…"
  },
  {
   "key": "e1c3256969b5",
   "speaker_korean": "파피",
   "korean": "「크윽!\n한 번도 아니고 두 번씩이나…\n이런 굴욕은 처음이야!!\n좋아, 특별히 조금만\n힘을 빌려주겠어\n하지만 조금만이야!!"
  },
  {
   "key": "ee3443e4e7c4",
   "speaker_korean": null,
   "korean": "크리에이터 ⟦1⟧파피⟦2⟧와 계약했습니다"
  },
  {
   "key": "b43a1fad200c",
   "speaker_korean": "페이트",
   "korean": "「으음…\n특A클래스 해독제는 없구나…"
  },
  {
   "key": "68db24737016",
   "speaker_korean": "파피",
   "korean": "「그, 그럼\n찾아오란 말이야…!!"
  },
  {
   "key": "f33678dbab95",
   "speaker_korean": "파피",
   "korean": "「…"
  },
  {
   "key": "69cc98f692cb",
   "speaker_korean": "페이트",
   "korean": "「무슨 일이야?"
  },
  {
   "key": "03c5eaf7ea12",
   "speaker_korean": null,
   "korean": "⟦1⟧인피니티・아츠⟦2⟧를 손에 넣었다"
  },
  {
   "key": "c81cc0758dae",
   "speaker_korean": null,
   "korean": "⟦1⟧매지컬・댄스⟦2⟧를 손에 넣었다"
  },
  {
   "key": "b0458a2004c6",
   "speaker_korean": null,
   "korean": "⟦1⟧122000폴⟦2⟧을 손에 넣었다"
  },
  {
   "key": "cf68c4e28f61",
   "speaker_korean": null,
   "korean": "⟦1⟧이앵화 작광⟦2⟧을 손에 넣었다"
  },
  {
   "key": "f5779c94ed4c",
   "speaker_korean": "파피",
   "korean": "「꺄악!\n뭐 하는 거야!!"
  },
  {
   "key": "f67b4977d479",
   "speaker_korean": "파피",
   "korean": "「헉!"
  },
  {
   "key": "764d7b1013ef",
   "speaker_korean": "파피",
   "korean": "「아, 진짜!!\n왜 맨날 이렇게 되는 거야!!"
  },
  {
   "key": "1116f853844a",
   "speaker_korean": null,
   "korean": "⟦1⟧・돕는다"
  },
  {
   "key": "2ac7fb6f3611",
   "speaker_korean": null,
   "korean": "⟦1⟧・돕지않는다"
  },
  {
   "key": "3e614de9eb39",
   "speaker_korean": "파피",
   "korean": "「잠깐, 너희들!!\n기다리라고!!"
  },
  {
   "key": "95ac0a13cfea",
   "speaker_korean": "파피",
   "korean": "「뭐야\n이 정도로 나한테 생색내는 거야?\n우쭐대지 좀 말라고!"
  },
  {
   "key": "232ad9d258cf",
   "speaker_korean": "파피",
   "korean": "「너희들, 뭘 멍하니 보고만 있는 거야!\n나한테 몬스터가 다가오고 있잖아!?"
  },
  {
   "key": "2b80b4e56455",
   "speaker_korean": "파피",
   "korean": "「잠깐, 너희들, 언제까지 날\n이 꼴로 내버려 둘 셈이야!?\n빨리 좀 도와달란 말이야!!"
  },
  {
   "key": "957b1463cf34",
   "speaker_korean": null,
   "korean": "⟦1⟧비밀의 방 열쇠⟦2⟧를 손에 넣었다"
  },
  {
   "key": "79e5fa78243d",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX15⟦2⟧를 손에 넣었다"
  },
  {
   "key": "40e3f4da75db",
   "speaker_korean": null,
   "korean": "시련의 유적 제6하층"
  },
  {
   "key": "1434c0ec6079",
   "speaker_korean": null,
   "korean": "⟦1⟧무한・공파참⟦2⟧을 손에 넣었다"
  },
  {
   "key": "b5895b1ec608",
   "speaker_korean": "소피아",
   "korean": "「아이?"
  },
  {
   "key": "ed21067bfcf9",
   "speaker_korean": "클리프",
   "korean": "「꼬맹이잖아"
  },
  {
   "key": "c0a25f6c10fb",
   "speaker_korean": "넬",
   "korean": "「이런 곳에?\n수상한데"
  },
  {
   "key": "480b2ab2dfaf",
   "speaker_korean": "페이트",
   "korean": "「이런 곳에?"
  },
  {
   "key": "4ee0e4ad093f",
   "speaker_korean": "?레나스",
   "korean": "「나와 함께 살아갈 이는 냉엄한 용사\n나와라!!"
  },
  {
   "key": "8f3fae1ad67c",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧복스⟦2⟧!?"
  },
  {
   "key": "3afa5a2cca70",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧복스⟦2⟧라고!?"
  },
  {
   "key": "537add42fe90",
   "speaker_korean": "페이트",
   "korean": "「아직 살아있었나!!"
  },
  {
   "key": "6055dcbac159",
   "speaker_korean": "???",
   "korean": "「⟦1⟧복스⟦2⟧?\n후후후, 틀렸다. 내 이름은…"
  },
  {
   "key": "7ed77b6545c5",
   "speaker_korean": "클리프",
   "korean": "「…하?"
  },
  {
   "key": "8ba1078d88c3",
   "speaker_korean": "진심 복스",
   "korean": "「본편에서는 보여주지 못했던\n내 진심의 힘, 받아봐라!!"
  },
  {
   "key": "da735193f8d6",
   "speaker_korean": "클리프",
   "korean": "「이렇게 강했으면\n본편 클리어 못 했을 거 아니냐"
  },
  {
   "key": "e460638985e9",
   "speaker_korean": "?레나스",
   "korean": "「재미없네"
  },
  {
   "key": "f6799ad87836",
   "speaker_korean": "클리프",
   "korean": "「재미없다니…\n저 녀석, 뭔가 흉악한 캐릭터로\n변한 거 아니야?"
  },
  {
   "key": "d46f22fab4df",
   "speaker_korean": "페이트",
   "korean": "「확실히…"
  },
  {
   "key": "8b2e8628f71b",
   "speaker_korean": "클리프",
   "korean": "「먼저 나아가자\n신님의 장난에는 아직\n계속이 있을 것 같다"
  },
  {
   "key": "b42ce4eb012c",
   "speaker_korean": "???",
   "korean": "「진심 ⟦1⟧복스⟦2⟧다!!!"
  },
  {
   "key": "97038287903b",
   "speaker_korean": "페이트",
   "korean": "「넘어졌어…"
  },
  {
   "key": "0793204a4750",
   "speaker_korean": "클리프",
   "korean": "「아"
  }
 ]
}