{
 "batch_id": "batch_0240",
 "translations": [
  {
   "key": "d72af85b997b",
   "speaker_korean": "질풍",
   "korean": "「큭… 두고 보자!!"
  },
  {
   "key": "0e21fa3f266a",
   "speaker_korean": "클리프",
   "korean": "「쳇!!\n놓쳐버렸잖냐"
  },
  {
   "key": "7567f6f256f3",
   "speaker_korean": "넬",
   "korean": "「아마… 증원을 부르러 돌아간 거겠지\n놓친 건 실수였어"
  },
  {
   "key": "71ccd700286f",
   "speaker_korean": "페이트",
   "korean": "「서두르는 게 좋겠어"
  },
  {
   "key": "20abf33be41c",
   "speaker_korean": "타이네브",
   "korean": "「예!"
  },
  {
   "key": "191e1d3fde5a",
   "speaker_korean": "넬",
   "korean": "우리가 ⟦1⟧드래곤들⟦2⟧을\n처치하면서 길을 만들게\n너희는 우리 뒤를\n조금 뒤처져서 따라와"
  },
  {
   "key": "ec0df54b9b1a",
   "speaker_korean": "타이네브",
   "korean": "「알겠습니다"
  },
  {
   "key": "b17e5ee7cdef",
   "speaker_korean": "파린",
   "korean": "「조심해 주세요~"
  },
  {
   "key": "b3f568e7c9cc",
   "speaker_korean": "넬",
   "korean": "「너는 마차를 돌려놔"
  },
  {
   "key": "9551e62213dc",
   "speaker_korean": "전사",
   "korean": "「핫!"
  },
  {
   "key": "b854ff850500",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧타이네브⟦2⟧, ⟦3⟧파린⟦4⟧!!"
  },
  {
   "key": "3c376021eab5",
   "speaker_korean": "페이트",
   "korean": "「간다, ⟦1⟧클리프⟦2⟧!!\n⟦3⟧넬 씨⟦4⟧!!"
  },
  {
   "key": "b62b8cab4bd6",
   "speaker_korean": "타이네브",
   "korean": "「다 실었습니다!"
  },
  {
   "key": "0a11e139f8b0",
   "speaker_korean": "데메트리오",
   "korean": "거기 두 사람, ⟦1⟧페이트⟦2⟧랑\n⟦3⟧클리프⟦4⟧라고 했던가\n너희는 제법 재목이군\n지금이라도 안 늦었다, 동료가 되어라"
  },
  {
   "key": "ea5a43c6b388",
   "speaker_korean": "페이트",
   "korean": "「증원!?"
  },
  {
   "key": "df8016452347",
   "speaker_korean": "넬",
   "korean": "「시간을 너무 끈\n모양이네…"
  },
  {
   "key": "514ca503152b",
   "speaker_korean": "클리프",
   "korean": "「쳇!\n너희는, 빨리 ⟦1⟧구리⟦2⟧를 실어 날라!\n여긴 우리한테 맡겨!"
  },
  {
   "key": "c32e9d91c073",
   "speaker_korean": "파린",
   "korean": "「다들!\n얼른 좀 실어 주세요~!"
  },
  {
   "key": "fa48dd88b8de",
   "speaker_korean": "데메트리오",
   "korean": "「짓밟아라!"
  },
  {
   "key": "b45f08a7a822",
   "speaker_korean": "클리프",
   "korean": "「그렇게 두고 볼 것 같냐!"
  },
  {
   "key": "fd9d4babc2be",
   "speaker_korean": "파린",
   "korean": "「빨리 타 주세요~!"
  },
  {
   "key": "7fb3e80e1b7f",
   "speaker_korean": "넬",
   "korean": "「안 돼!\n이놈들을 그대로 두고 도망칠 수\n있을 리 없잖아, 우리가 막을 테니,\n너희는 먼저 가!"
  },
  {
   "key": "fc92cb772f8c",
   "speaker_korean": "파린",
   "korean": "「에~, 그래도요!"
  },
  {
   "key": "8f92203a2edb",
   "speaker_korean": "클리프",
   "korean": "「됐으니까 가!"
  },
  {
   "key": "8646a68e612f",
   "speaker_korean": "페이트",
   "korean": "괜찮아요, 나중에 꼭 따라갈게요!\n⟦1⟧구리⟦2⟧를 ⟦3⟧디온⟦4⟧에게… 부탁해요!"
  },
  {
   "key": "0f08b457253a",
   "speaker_korean": "타이네브",
   "korean": "「…무운을 빕니다!\n가자, ⟦1⟧파린⟦2⟧!"
  },
  {
   "key": "f6509d7ad2ff",
   "speaker_korean": "클리프",
   "korean": "「방해 못 하게 해주마!"
  },
  {
   "key": "df8ab6ebba2b",
   "speaker_korean": "넬",
   "korean": "「이걸로… 최악의 사태는\n피할 수 있는 거네"
  },
  {
   "key": "abad26241b72",
   "speaker_korean": "데메트리오",
   "korean": "「흥, 고작 ⟦1⟧구리⟦2⟧를 빼앗은 정도로\n무엇을 할 수 있다는 거지\n지금 개발 중이라는\n신형 병기인지 뭔지에 쓰려는 건가?"
  },
  {
   "key": "781a1db1f017",
   "speaker_korean": "넬",
   "korean": "「어떻게 그걸\n알고 있는 거지!?"
  },
  {
   "key": "8866d6e4332b",
   "speaker_korean": "데메트리오",
   "korean": "「너무 얕보지 말아라\n그 정도 정보는, 진작에 입수했다\n은밀행동은 너희만의 전매특허가 아니다"
  },
  {
   "key": "0312832f6cf3",
   "speaker_korean": "넬",
   "korean": "「큭…"
  },
  {
   "key": "22e0d892318c",
   "speaker_korean": "데메트리오",
   "korean": "대충 ⟦1⟧시술 병기⟦2⟧인지 뭔지 모르겠으나,\n그런 게 있다 한들, 너희에게\n만에 하나 승산 따위 없다\n⟦P⟧쓸데없는 발버둥은 그만두어라\n결국, 약자는 강자를\n이길 수 없는 법이니까"
  },
  {
   "key": "e0d01466994b",
   "speaker_korean": "넬",
   "korean": "「말은 잘하는군"
  },
  {
   "key": "3cddf45c4a6b",
   "speaker_korean": "데메트리오",
   "korean": "「만약 거부한다면…,\n지금 여기서 죽게 될 것이다"
  },
  {
   "key": "862cc6062cd0",
   "speaker_korean": "클리프",
   "korean": "「퉤, 누가 너희들\n동료 따위가 될까 보냐\n농담하지 마라"
  },
  {
   "key": "fe66fb85ccc7",
   "speaker_korean": "페이트",
   "korean": "「그래, 우리는 너희들\n동료 같은 건 되지 않아\n물론 이런 곳에서 죽지도 않을 거야!"
  },
  {
   "key": "6f9822b22096",
   "speaker_korean": "데메트리오",
   "korean": "「좀 더 영리한 줄 알았다만\n유감이군"
  },
  {
   "key": "60cc228d0b40",
   "speaker_korean": "데메트리오",
   "korean": "「크윽, 설마…,\n이 정도일 줄이야!?"
  },
  {
   "key": "addaa16995bc",
   "speaker_korean": "데메트리오",
   "korean": "「후후, 하지만…\n너희의 명운도…"
  },
  {
   "key": "646a5f826412",
   "speaker_korean": "넬",
   "korean": "서둘러 ⟦1⟧시랜드⟦2⟧로 돌아가자\n신형 병기 일이 놈들에게 들통난 이상,\n서둘러 완성시켜야겠어…"
  },
  {
   "key": "13d5ae531a13",
   "speaker_korean": "데메트리오",
   "korean": "「크아악!!"
  },
  {
   "key": "bdbe4885c32d",
   "speaker_korean": "파린",
   "korean": "「네, 네엣!"
  },
  {
   "key": "dba6570f73db",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧질풍⟦2⟧이냐!?"
  },
  {
   "key": "410e8eb3bdc6",
   "speaker_korean": "데메트리오",
   "korean": "「이런 곳까지\n수고가 많았군\n하지만 그것도 헛수고로 끝날 것이다"
  }
 ]
}