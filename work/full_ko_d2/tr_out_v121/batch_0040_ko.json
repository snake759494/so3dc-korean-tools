{
 "batch_id": "batch_0040",
 "translations": [
  {
   "key": "2101de764f41",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「화 안 났다니까!\n⟦P⟧"
  },
  {
   "key": "4fcccb27ce05",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「거짓말 마.\n엄청나게 화났잖아.\n⟦P⟧"
  },
  {
   "key": "0f0dcaf35ccd",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭐야.\n불만 있으면, 확실하게 말하면\n되잖아?\n⟦P⟧"
  },
  {
   "key": "6e388de643a9",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「애 같아서,\n미안하게 됐네!\n⟦P⟧"
  },
  {
   "key": "9f61eac4965f",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아무도 그런 말\n안 했잖아.\n⟦P⟧"
  },
  {
   "key": "239ffa79e608",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「어? 어? 어? 어?\n어~!!!\n⟦P⟧"
  },
  {
   "key": "60c01d100276",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「엇!? 뭐가?\n⟦P⟧"
  },
  {
   "key": "45fe63c24cd4",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아니…\n얼떨결이었다지만,\n그런 말을 해 버려서 말이야.\n⟦P⟧그렇게라도 말 안 하면\n물러나 줄 것 같지\n않았잖아?\n그래서…\n⟦P⟧"
  },
  {
   "key": "dfae1cf9b974",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「맘대로 말해.\n⟦P⟧우리 아버지나 어머니가\n아무리 훌륭한 사람이든\n⟦P⟧그건 어디까지나,\n우리 부모님에 관한 얘기지,\n나 개인의 얘긴 아니잖아.\n⟦P⟧아버지는 아버지.\n나는 나야.\n그게 뭐 문제라도 돼?\n⟦P⟧"
  },
  {
   "key": "efbf9dcb953f",
   "speaker_korean": null,
   "korean": "조금은 말이야….\n언젠가 아버지를 뛰어넘겠다!\n그런 생각 안 해?\n⟦P⟧"
  },
  {
   "key": "7a600629aebc",
   "speaker_korean": "가벼워 보이는 여성",
   "korean": "⟦1⟧「그렇네.\n꼬마야, 꽤 귀여우니까 조금쯤이라면\n어울려 줘도 괜찮아.\n⟦P⟧"
  },
  {
   "key": "54a02e6d6538",
   "speaker_korean": "가벼워 보이는 여성",
   "korean": "⟦1⟧「사・실・은, 이런 데 있었더니\n나 목이 말라 버렸거든~.\n⟦P⟧괜찮으면….\n당신, 이제부터 내 방에서\n같이 한잔 안 할래?\n⟦P⟧"
  },
  {
   "key": "1a8ca0627efe",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어~ 그게….\n글쎄.\n⟦P⟧"
  },
  {
   "key": "9e6d3c930a59",
   "speaker_korean": "가벼워 보이는 여성",
   "korean": "⟦1⟧「비켜 주시겠어!?\n⟦P⟧"
  },
  {
   "key": "63a18dd0471e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아니?\n본 적도 없는 애인데.\n⟦P⟧"
  },
  {
   "key": "725686c6b473",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭐, 그런 거야.\n너무 신경 쓰지 마.\n⟦P⟧"
  },
  {
   "key": "925a6707db34",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「난 몰라,\n그런 거.\n⟦P⟧"
  },
  {
   "key": "8fac8038b1ec",
   "speaker_korean": "폭스테일의 여성",
   "korean": "⟦1⟧「역시 휴양 행성에 왔으면,\n실컷 꼬리를 뻗어 줘야지~.\n⟦P⟧내 친구, 좋은 남자 낚겠다고\n잔뜩 벼르고 있었는데~.\n⟦P⟧왜 ⟦2⟧하이다⟦3⟧까지 와서\n그런 짓을 해야 하는 건지….\n조~금 이해가 안 된단 말이지.\n⟦P⟧"
  },
  {
   "key": "ea37071140e0",
   "speaker_korean": "폭스테일의 여성",
   "korean": "⟦1⟧「바닷바람 말인데….\n역시 공기에 소금 같은 게\n섞여 있는 거겠지?\n⟦P⟧나중에 폐 세척 같은 거 안 해도\n정말 괜찮은 걸까?\n⟦P⟧그야, 여행사는\n괜찮다고 했지만,\n좀 걱정돼.\n⟦P⟧"
  },
  {
   "key": "94bad2f85ed0",
   "speaker_korean": "폭스테일의 여성",
   "korean": "⟦1⟧「아까 당신, 내 친구가\n말 걸었었지~?\n⟦P⟧미안해~.\n걔가 말이야, 뭔~가 조급해하는\n것 같아서 말이지~.\n⟦P⟧"
  },
  {
   "key": "6d23c89ee146",
   "speaker_korean": "폭스테일의 여성",
   "korean": "⟦1⟧「이런 말 하는 것도\n뭣하지만….\n⟦P⟧걔 말이야, 꽤 무리해서\n여기 온 거거든~.\n⟦P⟧좋은 남자 잡아서,\n본전은 꼭 뽑겠다고\n벼르고 있었는데….\n⟦P⟧그래서는 오히려,\n아무도 안 붙는다니까.\n그치?\n⟦P⟧"
  },
  {
   "key": "df7d20385da6",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「쳇, 놓쳐 버린\n모양이네.\n⟦P⟧"
  },
  {
   "key": "1f8454428ecb",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「그런 건,\n자업자득이지!\n⟦P⟧"
  },
  {
   "key": "91cb9ea6e65d",
   "speaker_korean": null,
   "korean": "프라이빗 비치"
  },
  {
   "key": "f6529026c9c0",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「귀엽지?\n내 애인이야.\n⟦P⟧"
  },
  {
   "key": "c8aa8bad91a6",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「됐으니까, 말 좀 맞춰 줘.\n⟦P⟧"
  },
  {
   "key": "eb633e9ce015",
   "speaker_korean": "가벼워 보이는 여성",
   "korean": "⟦1⟧「고마워.\n⟦P⟧"
  },
  {
   "key": "8c20d85e2edf",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「쳇.\n놓쳐 버렸나….\n네 탓이야.\n⟦P⟧"
  },
  {
   "key": "bc1e593950db",
   "speaker_korean": null,
   "korean": "아니….\n말한 게 되는 건가?\n⟦P⟧"
  },
  {
   "key": "1b70d962453a",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭐, 그런 사정이라서 말이야.\n모처럼의 초대지만\n사양할게.\n⟦P⟧"
  },
  {
   "key": "fdfe56c6998a",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「으, 응.\n⟦P⟧"
  },
  {
   "key": "234af3499800",
   "speaker_korean": "가벼워 보이는 여성",
   "korean": "⟦1⟧(……….\n⟦P⟧"
  },
  {
   "key": "14ceaf398a86",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「…그런 말 하면,\n너도 마찬가지잖아!\n⟦P⟧"
  },
  {
   "key": "631102f2e470",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「뭐야!\n⟦P⟧"
  },
  {
   "key": "404f084a6266",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭔데!\n⟦P⟧"
  },
  {
   "key": "71557ec1604e",
   "speaker_korean": null,
   "korean": "잠시 기다려 주십시오."
  },
  {
   "key": "878a39f34014",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「하지만, 사실이 그러니까\n부정은 못 하잖아?\n⟦P⟧"
  },
  {
   "key": "ae03c2750985",
   "speaker_korean": "가벼워 보이는 여성",
   "korean": "⟦1⟧「네네.\n알았어요.\n⟦P⟧"
  },
  {
   "key": "28323158888a",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「⟦2⟧페이트⟦3⟧.\n아무한테나 말 걸지 좀 마.\n⟦P⟧창피하잖아, 정말.\n⟦P⟧"
  },
  {
   "key": "00fc487b7d0d",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아, ⟦2⟧소피아⟦3⟧.\n⟦P⟧"
  },
  {
   "key": "6a55667b2c39",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「아, ⟦2⟧소피아⟦3⟧가\n아니잖아~!\n무슨 생각 하는 거야, 정말.\n⟦P⟧"
  },
  {
   "key": "389526a79708",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「누가 동생이야!\n나랑 ⟦2⟧페이트⟦3⟧는, 언제부터\n남매가 됐다는 거야!?\n⟦P⟧"
  },
  {
   "key": "91ecd65c3abe",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「흥이다.\n⟦2⟧페이트⟦3⟧ 바~보.\n⟦P⟧"
  },
  {
   "key": "26efb063860e",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「아, 그래!\n그럼, 나도 할 말 좀 하겠는데.\n⟦P⟧애초에 ⟦2⟧페이트⟦3⟧는 말이야,\n맨날 맨날, 언~제나….\n⟦P⟧"
  },
  {
   "key": "c83b464ffab5",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「뭐야!\n⟦2⟧페이트⟦3⟧ 바보!\n⟦P⟧"
  },
  {
   "key": "e33052825290",
   "speaker_korean": null,
   "korean": "열 번 죽어 버려!\n⟦P⟧"
  },
  {
   "key": "06cacb1590c8",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「미안하게 됐다,\n⟦2⟧소피아⟦3⟧.\n⟦P⟧"
  },
  {
   "key": "abbb9172db2c",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「뭐야, 깜짝 놀랐잖아.\n아까 그거, 내가 ⟦2⟧페이트⟦3⟧의\n애인이라던 얘기?\n⟦P⟧난 딱히 괜찮은데.\n그야….\n그렇게 싫지도 않고 말이야.\n⟦P⟧"
  }
 ]
}