{
 "batch_id": "batch_0077",
 "translations": [
  {
   "key": "7d63e1adb0aa",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「죄송…했습니다\n정말로…\n⟦P⟧"
  },
  {
   "key": "1bd1cb1d4390",
   "speaker_korean": "아주머니",
   "korean": "⟦1⟧「자네들한테 폐를 끼쳤구먼…\n정말 고맙네\n⟦P⟧"
  },
  {
   "key": "301f227c207a",
   "speaker_korean": "아주머니",
   "korean": "⟦1⟧「이런 시대에도, 자네들처럼\n착한 사람들이 있어주는구먼\n⟦P⟧"
  },
  {
   "key": "9b19941cd711",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「이런 것밖에 못 해드리지만\n⟦2⟧페이트씨 일행⟦3⟧의\n여행이 무사하기를 빌게요\n⟦P⟧"
  },
  {
   "key": "ad7d15921645",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「다음에 또 이 근처에 오시면\n꼭 들러주세요\n계속, 기다리고 있을게요\n⟦P⟧"
  },
  {
   "key": "ba4dbeaf9ef6",
   "speaker_korean": null,
   "korean": "『꽃 기르는 법』・『방충 재배법』\n『유전법칙1.3.3.1』・『개화 조건』\n『원예 매뉴얼』…\n⟦P⟧"
  },
  {
   "key": "0a4e4a9e6eb8",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「음~\n이 냄새 남은 걸 보니\n한참 안 돌아온 모양인데\n⟦P⟧"
  },
  {
   "key": "e4ed8ef13bf6",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「침대에 들어가 보니 차갑던데,\n박복한 누나는, 대체 어디로\n가버린 걸까?\n⟦P⟧"
  },
  {
   "key": "26c3e5f4ffee",
   "speaker_korean": null,
   "korean": "『⟦1⟧성자 로날드 다인⟦2⟧의 개선』\n⟦P⟧"
  },
  {
   "key": "36f43200adac",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(이 근처 지도인가 보네\n⟦P⟧"
  },
  {
   "key": "11c58f9d2f62",
   "speaker_korean": "아주머니",
   "korean": "「아무튼 무사해서 다행이야\n다 자네들 덕분이지"
  },
  {
   "key": "8583a0745dc9",
   "speaker_korean": "클리프",
   "korean": "「뭘, 신경 쓸 거 없다고"
  },
  {
   "key": "6c6f586c338a",
   "speaker_korean": "아주머니",
   "korean": "「아니아니, 의사 선생님도 그랬잖아?\n조금만 늦었어도 위험했을 거라고"
  },
  {
   "key": "2f4a4cc4b848",
   "speaker_korean": "아주머니",
   "korean": "「⟦1⟧아미나⟦2⟧도 참 딱한 아이야\n부모님을 일찍 여의고,\n자기는 병까지 걸리고…"
  },
  {
   "key": "1c3d16ab6685",
   "speaker_korean": "페이트",
   "korean": "「아주머니…"
  },
  {
   "key": "e2524c4026e7",
   "speaker_korean": "아주머니",
   "korean": "「그것도 다 전쟁 탓이야\n전쟁만 없었다면, ⟦1⟧아미나⟦2⟧ 부모님도\n죽지 않았을 텐데\n그랬으면 이 아이도 좀 더 평온하게\n살 수 있었을 텐데……"
  },
  {
   "key": "669f79954c40",
   "speaker_korean": "넬",
   "korean": "「그렇기 때문에, 이 하찮은 전쟁을\n하루빨리 끝내야만 하는 거야"
  },
  {
   "key": "e7fc53648d3a",
   "speaker_korean": "아주머니",
   "korean": "「그래, 그렇지\n하지만, 우리가 할 수 있는 거라고\n뻔하잖아\n고작해야, ⟦1⟧천 송이 꽃⟦2⟧으로 ⟦3⟧아페리스 님⟦4⟧께\n전쟁이 끝나게 해달라고…\n비는 것밖에 없다고\n나한테 힘이 있었다면 좋았을 텐데\n그럼 단숨에 ⟦5⟧아리그리프⟦6⟧ 놈들을\n해치워 버렸을 텐데 말이야\n참…무력한 나 자신한테 화가 나, 정말"
  },
  {
   "key": "279bc80145ad",
   "speaker_korean": "페이트",
   "korean": "「…힘, 이라"
  },
  {
   "key": "ecab4d08c1a4",
   "speaker_korean": "아미나",
   "korean": "「으…음……"
  },
  {
   "key": "edc1396dbab7",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧!?"
  },
  {
   "key": "a724f6f1cd09",
   "speaker_korean": "아미나",
   "korean": "「왜 여기에…? 제가…"
  },
  {
   "key": "48b93458932d",
   "speaker_korean": "페이트",
   "korean": "「안 돼\n아직 더 자야지"
  },
  {
   "key": "0738a9175ec1",
   "speaker_korean": "아미나",
   "korean": "「어…라…?\n…⟦1⟧페이트씨⟦2⟧?"
  },
  {
   "key": "4ae3d1f7171f",
   "speaker_korean": "아미나",
   "korean": "「그런데, 어째서 ⟦1⟧페이트씨⟦2⟧가 여기에?\n오늘 아침에 ⟦3⟧시랜드⟦4⟧로 떠나신다고…"
  },
  {
   "key": "814ef7e5d282",
   "speaker_korean": "페이트",
   "korean": "「그건―――"
  },
  {
   "key": "67dadee445e5",
   "speaker_korean": "아주머니",
   "korean": "「이분들이, 쓰러진 너를\n여기까지 데려다준 거야"
  },
  {
   "key": "81ef653de965",
   "speaker_korean": "아주머니",
   "korean": "「⟦1⟧아미나⟦2⟧,\n산 위에서 쓰러졌었잖니?\n제아무리 나라도, 거기서 너를\n데리고 산을 내려갈 순 없어서 말이야\n도움을 청하러 마을까지 내려갔는데,\n마침 이 오라버니를, 보게 돼서\n손을 좀 빌려달라고 부탁한 거야"
  },
  {
   "key": "e212c2e6986f",
   "speaker_korean": "아미나",
   "korean": "「그러셨군요\n⟦1⟧페이트씨⟦2⟧, 여러분,\n정말 감사했습니다\n폐를 끼쳐드려서 죄송해요…"
  },
  {
   "key": "612208647cf5",
   "speaker_korean": "클리프",
   "korean": "「아니, 신경 쓸 거 없어"
  },
  {
   "key": "ca799269938c",
   "speaker_korean": "넬",
   "korean": "「그래…\n너는 그런 건 신경 쓰지 말고,\n푹 쉬면서 몸조리나 잘 해"
  },
  {
   "key": "30f2c9aca117",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧아미나⟦2⟧"
  },
  {
   "key": "984be5c58bc1",
   "speaker_korean": "아미나",
   "korean": "「네?"
  },
  {
   "key": "ad5376609a7d",
   "speaker_korean": "넬",
   "korean": "「아까 그 의사한테 네 얘기는\n부탁해뒀어\n몸이 안 좋아지면,\n바로 그 사람한테 가도록 해"
  },
  {
   "key": "8fdb7cacfa22",
   "speaker_korean": "아미나",
   "korean": "「하지만, 저, 그런 돈은…"
  },
  {
   "key": "f72229b819f6",
   "speaker_korean": "넬",
   "korean": "「그건 걱정 안 해도 돼\n진료비에 관해서는 이미 이야기가\n다 됐으니까\n네가 돈 걱정을 할\n필요는 없어"
  },
  {
   "key": "b35b2e382fe9",
   "speaker_korean": "아미나",
   "korean": "「그런, 그런 건 죄송해요"
  },
  {
   "key": "64e864a63a98",
   "speaker_korean": "넬",
   "korean": "「남의 호의는 순순히 받아두는 거야\n걱정 마. 뭘 꾸미는 게 아니니까\n게다가 그 사람은 나랑 잘 아는 사이야\n그러니까 말이 통한다는 거지"
  },
  {
   "key": "8127049d7d3f",
   "speaker_korean": "클리프",
   "korean": "「맞아\n이 녀석이 괜찮다잖아\n신경 쓰지 마"
  },
  {
   "key": "b1a3bf4ab3d6",
   "speaker_korean": "아미나",
   "korean": "「하지만…"
  },
  {
   "key": "b8261755373a",
   "speaker_korean": "넬",
   "korean": "「그럼\n⟦1⟧이리스의 무녀화⟦2⟧\n대금이라고 하면 어떻겠어?\n그거라면 상관없겠지?"
  },
  {
   "key": "047642dd0b3b",
   "speaker_korean": "아미나",
   "korean": "「그건…"
  },
  {
   "key": "82f382393c7d",
   "speaker_korean": "넬",
   "korean": "「뭘, 사양할 것 없어"
  },
  {
   "key": "d97451d7f772",
   "speaker_korean": "페이트",
   "korean": "「소꿉친구를 만나고 싶잖아?\n그럼 얼른 병을 고쳐야지…그렇지?"
  },
  {
   "key": "f73aeb358d35",
   "speaker_korean": "아미나",
   "korean": "「네…감사합니다"
  },
  {
   "key": "b6b629d629df",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧페이트⟦2⟧, 슬슬 갈까?"
  },
  {
   "key": "f85e5dfbd74f",
   "speaker_korean": "페이트",
   "korean": "「아, 응\n⟦1⟧아미나⟦2⟧, 난 이제 가야\n하거든"
  },
  {
   "key": "57a8d6083178",
   "speaker_korean": "아미나",
   "korean": "「…그런가요"
  },
  {
   "key": "6b1f293557f7",
   "speaker_korean": "페이트",
   "korean": "「네 병도 신경 쓰이지만,\n나한테는 해야만 하는 일이\n생겼으니까"
  },
  {
   "key": "8a222b5fdedf",
   "speaker_korean": "넬",
   "korean": "「…"
  },
  {
   "key": "45318369a407",
   "speaker_korean": "페이트",
   "korean": "「실컷 고민했고, 도망칠 생각도 했어\n하지만…알았어\n남은 못 해도, 내가 할 수 있는 일이 있어\n그리고 그게 누군가를 위한 일이 된다면…\n나는 하려고 해"
  },
  {
   "key": "bcf750fdbd05",
   "speaker_korean": "아미나",
   "korean": "「…네"
  },
  {
   "key": "ee2afa0eb540",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧페이트⟦2⟧,\n너…"
  },
  {
   "key": "29daef29e76f",
   "speaker_korean": "페이트",
   "korean": "「응. 너희에게 협력할게\n물론 내 의지로\n가자…내 마음이 바뀌기 전에"
  },
  {
   "key": "a9251cf8eb89",
   "speaker_korean": "넬",
   "korean": "「아…아!"
  },
  {
   "key": "335ee7f40f95",
   "speaker_korean": "클리프",
   "korean": "「단순한 녀석이라니까…쯧"
  },
  {
   "key": "7fede3bb6fae",
   "speaker_korean": "페이트",
   "korean": "「칭찬으로 받아들이지"
  },
  {
   "key": "185c8129dc61",
   "speaker_korean": "페이트",
   "korean": "「그럼, 우리는 이만 갈게\n죄송해요, 아주머니\n⟦1⟧아미나⟦2⟧를\n잘 부탁드립니다"
  },
  {
   "key": "e5f9053c3854",
   "speaker_korean": "아주머니",
   "korean": "「그래. 너는 네 할 일을\n확실히 하려무나\n뭐, 무슨 일인지는 모르겠다만\n⟦1⟧아미나⟦2⟧는 나한테 맡겨두렴"
  },
  {
   "key": "79a0859cf294",
   "speaker_korean": "페이트",
   "korean": "「부탁드립니다"
  },
  {
   "key": "b652e48733c0",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧페이트씨⟦2⟧"
  },
  {
   "key": "678eda5f1c4b",
   "speaker_korean": "페이트",
   "korean": "「응?"
  },
  {
   "key": "248b31d7032a",
   "speaker_korean": "아미나",
   "korean": "「다시, 만날 수 있는 거죠?"
  },
  {
   "key": "716510b464ac",
   "speaker_korean": "페이트",
   "korean": "「응, 꼭"
  },
  {
   "key": "0168d82f8046",
   "speaker_korean": "아미나",
   "korean": "「기대하고 있을게요"
  },
  {
   "key": "f8b9ed135578",
   "speaker_korean": "페이트",
   "korean": "「응, 나도…그럼, 또 보자"
  },
  {
   "key": "c3df46cfa4a6",
   "speaker_korean": "아미나",
   "korean": "「네"
  }
 ]
}