{
 "batch_id": "batch_0033",
 "translations": [
  {
   "key": "27827b2dbb55",
   "speaker_korean": "클리프",
   "korean": "「손이 묶인 데다 감옥 안인데\n어쩔 도리가 없잖냐?\n게다가 여기서 죽으면 누가 아버지를 구하냐?\n아버지랑 만나는 곳이 저승이면 싫잖냐"
  },
  {
   "key": "941d4645e798",
   "speaker_korean": "페이트",
   "korean": "「알았어.\n지금은 그런 걸로 납득할게."
  },
  {
   "key": "0e45c339b42f",
   "speaker_korean": "클리프",
   "korean": "「그래야 착하지."
  },
  {
   "key": "454e370485bc",
   "speaker_korean": "클리프",
   "korean": "「얘기는 끝났다.\n너희에게 협력하지.\n여기서 꺼내 줘."
  },
  {
   "key": "6b4245381a15",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「계약 성립이네.\n…쇠창살에서 떨어져."
  },
  {
   "key": "50d50dcbe6e9",
   "speaker_korean": "클리프",
   "korean": "「휘익♪"
  },
  {
   "key": "cb247ef6fea4",
   "speaker_korean": "페이트",
   "korean": "(지금, 무슨 짓을 한 거지!?"
  },
  {
   "key": "9e113521b524",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「나와."
  },
  {
   "key": "9a2fac1e72c4",
   "speaker_korean": "페이트",
   "korean": "「…감사합니다."
  },
  {
   "key": "c596601221a6",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「인사는 됐어.\n그게 내 임무니까."
  },
  {
   "key": "90d6cd28dbd6",
   "speaker_korean": "페이트",
   "korean": "「이봐… 들리잖아."
  },
  {
   "key": "2331cac71c82",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「뭐, 미인이라고 해 준 건\n솔직히 고맙지만 말이야."
  },
  {
   "key": "f02e6edf8f14",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「나는 ⟦1⟧넬 젤퍼⟦2⟧.\n⟦3⟧성왕국 시하츠⟦4⟧를 섬기는 첩보원이야."
  },
  {
   "key": "b0c525451106",
   "speaker_korean": "페이트",
   "korean": "「…어떻게 할래?"
  },
  {
   "key": "69b9b0713293",
   "speaker_korean": "페이트",
   "korean": "「아, 아아."
  },
  {
   "key": "d061a0de50a9",
   "speaker_korean": "넬",
   "korean": "「동방? ⟦1⟧그리텐 대륙⟦2⟧ 안의 한 나라?\n예전에 ⟦3⟧시하츠⟦4⟧를 침략했다는―――."
  },
  {
   "key": "be1c60ccda9b",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧그리텐⟦2⟧의 기술자가,\n왜 ⟦3⟧아리그리프⟦4⟧에 있지?"
  },
  {
   "key": "505039da85d1",
   "speaker_korean": "넬",
   "korean": "「…그런 거였군."
  },
  {
   "key": "3d3ba8b3583d",
   "speaker_korean": "페이트",
   "korean": "(참 말도 잘 지어내네…….\n전부 다 거짓말은 아니지만."
  },
  {
   "key": "2d413ae57b42",
   "speaker_korean": "넬",
   "korean": "「역시 ⟦1⟧그리텐⟦2⟧\n사람이었군."
  },
  {
   "key": "edcadc3fef12",
   "speaker_korean": "페이트",
   "korean": "「역시라니요?"
  },
  {
   "key": "3b78804f20f9",
   "speaker_korean": "넬",
   "korean": "「그만한 기술력을 가진 나라는,\n이 대륙엔 존재하지 않으니까.\n어차피 그런 거겠거니 싶었지."
  },
  {
   "key": "9e962127411c",
   "speaker_korean": "넬",
   "korean": "「뭐 그렇지.\n역시 ⟦1⟧아리그리프⟦2⟧에 너희를 넘길 순 없어.\n꼭 우리에게 협력해 줘야겠어."
  },
  {
   "key": "b8583a96cbae",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧넬 씨⟦2⟧…\n맞으시죠?"
  },
  {
   "key": "db733b174ce3",
   "speaker_korean": "넬",
   "korean": "「그래."
  },
  {
   "key": "3a88f8246cfa",
   "speaker_korean": "페이트",
   "korean": "「협력이라니, 대체 뭘 시키려는 거죠?\n기술이 필요하다니, 구체적으로 어떤 겁니까?"
  },
  {
   "key": "58a8f84109b0",
   "speaker_korean": "넬",
   "korean": "「그래. 그건――――――!?"
  },
  {
   "key": "103235085fcb",
   "speaker_korean": "???",
   "korean": "「뭐야? 너, 왜 그래, 어이!?\n설마……!?"
  },
  {
   "key": "9c77a55cb700",
   "speaker_korean": "넬",
   "korean": "「쳇! 벌써 교대 시간이야!?\n너희, 전투 경험은?"
  },
  {
   "key": "f9ee2b2a7ca8",
   "speaker_korean": "페이트",
   "korean": "「네? 어째서요?"
  },
  {
   "key": "23b31c7ec0aa",
   "speaker_korean": "넬",
   "korean": "「뻔하잖아.\n강행 돌파할 거니까."
  },
  {
   "key": "72971a59e65d",
   "speaker_korean": "페이트",
   "korean": "「하지만, 넌 맨손이라도\n괜찮을지 모르지만,\n난 무기가 없으면…"
  },
  {
   "key": "cd62ea7f7c82",
   "speaker_korean": "넬",
   "korean": "「그렇게 나올 줄 알았어.\n자."
  },
  {
   "key": "781cb812b3e0",
   "speaker_korean": "페이트",
   "korean": "「이건?"
  },
  {
   "key": "0faa74d5dfa1",
   "speaker_korean": "넬",
   "korean": "「너희 짐이야.\n아까 되찾아 뒀어."
  },
  {
   "key": "c2a9f6a6ded7",
   "speaker_korean": "페이트",
   "korean": "「가, 감사합니다."
  },
  {
   "key": "f744e909ad8f",
   "speaker_korean": null,
   "korean": "짐을 손에 넣었다."
  },
  {
   "key": "d8cecde16fdb",
   "speaker_korean": "클리프",
   "korean": "「십중팔구, 빙고겠지."
  },
  {
   "key": "1ff28fdb9e9a",
   "speaker_korean": "클리프",
   "korean": "「어이. 괜찮냐?"
  },
  {
   "key": "4d50d011d95d",
   "speaker_korean": "클리프",
   "korean": "「꼴이 아주 말이 아니군."
  },
  {
   "key": "89fc62d32f9b",
   "speaker_korean": "페이트",
   "korean": "「으… 응…."
  },
  {
   "key": "c9b37791e4c9",
   "speaker_korean": "클리프",
   "korean": "「땡큐."
  },
  {
   "key": "4d9a651aae7b",
   "speaker_korean": "클리프",
   "korean": "「…응?"
  },
  {
   "key": "3ff9da3eccb0",
   "speaker_korean": "클리프",
   "korean": "「헉."
  },
  {
   "key": "25e4c922f23a",
   "speaker_korean": "클리프",
   "korean": "「……무서운 여자로군."
  },
  {
   "key": "2a37f89309dc",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧클리프 피터⟦2⟧다."
  },
  {
   "key": "bbaef1427863",
   "speaker_korean": "클리프",
   "korean": "「…어쩔 수 없군. 말 맞춰라.\n내가 어떻게든 해 보지."
  },
  {
   "key": "1513bf055c2a",
   "speaker_korean": "클리프",
   "korean": "「여기보다 훨씬 동쪽 대륙에 있는 나라야.\n뭐, 이름도 안 알려진 자그마한 나라지만,\n기술력엔 자신 있다고."
  },
  {
   "key": "a2509d54c88b",
   "speaker_korean": "클리프",
   "korean": "「이쪽에선 그렇게 부르나?\n아무튼 거기다.\n거기서 기술자를 하고 있지."
  },
  {
   "key": "aa98de9e6492",
   "speaker_korean": "클리프",
   "korean": "「뭐, 자세히 얘기하자면 날이 저물 테니\n간단히 줄이겠다만.\n이 녀석 아버지가 적대 세력에 붙잡혀서 말이야.\n그걸 구하러 가려고, 이 녀석이랑 2명이서\n새로 개발한 탈것으로 적 세력 위치로\n향하던 참이었지.\n⟦P⟧그런데, 도중에 고장이 나서 말이야.\n그래서, 저 꼴이 된 거다."
  },
  {
   "key": "e3a31e3c1a7d",
   "speaker_korean": "클리프",
   "korean": "「납득했냐?"
  },
  {
   "key": "31acf7f485d9",
   "speaker_korean": "클리프",
   "korean": "「걱정 마라, 괜찮다.\n나도 이 녀석도 남들 이상으론 싸운다고."
  },
  {
   "key": "fa2b7fdf980a",
   "speaker_korean": "클리프",
   "korean": "「고맙게 됐군."
  },
  {
   "key": "47c997f99e42",
   "speaker_korean": "클리프",
   "korean": "「설령 저 녀석한테 협력 안 한다고 쳐도,\n⟦1⟧아리그리프⟦2⟧도 거의 같은 걸 요구하고 있다.\n자기들한테 협력하라고 말이지.\n어느 쪽이든 거절하면 죽는다는 거다."
  },
  {
   "key": "09dec373fd7b",
   "speaker_korean": "페이트",
   "korean": "「저는 ⟦1⟧페이트 라인갓⟦2⟧입니다.\n이쪽은―――."
  },
  {
   "key": "ff89ccaeb970",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧페이트⟦2⟧에 ⟦3⟧클리프⟦4⟧라….\n잘 부탁해.\n그래서, 너희는 대체 어디 사람이지?\n저 금속 덩어리는 뭐야?"
  },
  {
   "key": "c791f54f6273",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「우리에게 협력하는 얘기야.\n틈을 봐서 도망친다는 짓은,\n용납 안 해.\n만약 그런 짓을 하면―――죽일 거야."
  },
  {
   "key": "2f573558127c",
   "speaker_korean": "페이트",
   "korean": "「뭐… 뭐야!?"
  },
  {
   "key": "0f081d608671",
   "speaker_korean": "페이트",
   "korean": "(이 사람한테 ⟦1⟧미개 행성 보호 조약⟦2⟧\n얘기해 봤자 소용없고……\n뭐라고 설명하면 좋지?"
  },
  {
   "key": "de0a81ffb984",
   "speaker_korean": "클리프",
   "korean": "「살았다.\n이왕이면 그 이상한 술법으로 이 갑갑한 것도\n어떻게 좀 해 주지 않겠냐?"
  },
  {
   "key": "4bee3dcc7170",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「움직이지 마."
  },
  {
   "key": "c8d12e04020e",
   "speaker_korean": "붉은 머리 여성",
   "korean": "「그보다, 약속은 지켜 줘야겠어."
  },
  {
   "key": "fcd26e2611ef",
   "speaker_korean": "넬",
   "korean": "「다음은 너….\n⟦1⟧페이트⟦2⟧…였지.\n아무래도 그 차림새는 곤란하겠어.\n사이즈가 맞을지 어떨지는\n모르겠지만, 그걸로 갈아입어."
  },
  {
   "key": "7f920f6dd6e3",
   "speaker_korean": "넬",
   "korean": "「서두르자.\n곧 추격대가 올 테니까."
  },
  {
   "key": "62a1ef6240ba",
   "speaker_korean": "페이트",
   "korean": "「자, 잠깐만요…."
  },
  {
   "key": "8ea4d72d49fc",
   "speaker_korean": "페이트",
   "korean": "「어떻게 나가는 거죠?\n밖에는 병사가 잔뜩 있을 텐데…."
  },
  {
   "key": "87bcac5a8f76",
   "speaker_korean": "넬",
   "korean": "「그래, 거기로 밖으로 나가는 거야."
  },
  {
   "key": "5799ce137312",
   "speaker_korean": "페이트",
   "korean": "「통풍…구?"
  },
  {
   "key": "bb95b2cf53fa",
   "speaker_korean": "클리프",
   "korean": "「어지간히 좁은 데로\n가는구먼."
  },
  {
   "key": "9c525b373a3f",
   "speaker_korean": "넬",
   "korean": "「불평하지 마.\n거기만 빠져나가면\n길은 조금 넓어지니까,\n그때까지 참는 거야."
  },
  {
   "key": "a9741caed476",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧페이트⟦2⟧부터 먼저 가.\n내가 후미를 맡을게."
  },
  {
   "key": "4fe4525fc497",
   "speaker_korean": "넬",
   "korean": "「뭐지?"
  },
  {
   "key": "266fc5cd6e8d",
   "speaker_korean": "아리그리프 병사",
   "korean": "「크윽…읏!!"
  },
  {
   "key": "9804a9ae7d79",
   "speaker_korean": "월터",
   "korean": "「⟦1⟧알벨⟦2⟧은 여기 있네."
  },
  {
   "key": "f40822323856",
   "speaker_korean": "페이트",
   "korean": "「여기라니……."
  }
 ]
}