   "korean": "⟦1⟧・이대로 게임 계속하기"
  },
  {
   "key": "b0392bceaab7",
   "speaker_korean": null,
   "korean": "⟦1⟧・역시 게임 종료하기"
  },
  {
   "key": "21f32c637526",
   "speaker_korean": null,
   "korean": "⟦1⟧TO이 tXN토토"
  },
  {
   "key": "5784850d253b",
   "speaker_korean": null,
   "korean": "⟦1⟧TO이 NOJwiii"
  },
  {
   "key": "a2340f4f13c0",
   "speaker_korean": "페이트",
   "korean": "「이게 게이트인가?"
  },
  {
   "key": "0fd18bb9974f",
   "speaker_korean": "소피아",
   "korean": "「그런 걸까?\n⟦1⟧블레어 씨⟦2⟧가 말했던\n제단 같은 것도 있긴 한데…"
  },
  {
   "key": "1036698b4329",
   "speaker_korean": "마리아",
   "korean": "「생각해도 소용없어.\n해 보자."
  },
  {
   "key": "9bd053a327b7",
   "speaker_korean": "페이트",
   "korean": "「자…\n⟦1⟧소피아⟦2⟧…"
  },
  {
   "key": "c74b8399e1b6",
   "speaker_korean": "페이트",
   "korean": "「괜찮아…나도 같이 갈 테니까."
  },
  {
   "key": "7f1efbd5e8ad",
   "speaker_korean": "소피아",
   "korean": "「아……"
  },
  {
   "key": "9384ebb9595c",
   "speaker_korean": "마리아",
   "korean": "「이게…"
  },
  {
   "key": "3577f1dd031a",
   "speaker_korean": "페이트",
   "korean": "「가자…\n이 앞에 ⟦1⟧루시퍼⟦2⟧가 있다."
  }
