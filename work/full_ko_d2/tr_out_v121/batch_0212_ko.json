  {
   "key": "efd41221c62c",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX12⟦2⟧를 얻었다."
  },
  {
   "key": "7db27aec9f97",
   "speaker_korean": null,
   "korean": "⟦1⟧25500폴⟦2⟧을 얻었다."
  },
  {
   "key": "5c66da3cad3d",
   "speaker_korean": "페이트",
   "korean": "「안 되겠네.\n열릴 것 같지 않네."
  },
  {
   "key": "bb54d67ed5d0",
   "speaker_korean": "페이트",
   "korean": "「…뭔가 기척이…"
  },
  {
   "key": "9c1295874f90",
   "speaker_korean": "페이트",
   "korean": "「문 자물쇠가\n열리는 소리가 났군."
  },
  {
   "key": "1d599b169dfc",
   "speaker_korean": "페이트",
   "korean": "「그건 그렇고…\n방금 그건 뭐였을까?\n하얀 것과 검은 것이 대결해서…,\n뭔가의 승패라도 정해지는\n걸 나타내는 걸까?"
  },
  {
   "key": "ce99f096e9e8",
   "speaker_korean": null,
   "korean": "⟦1⟧・다시 보기"
  },
  {
   "key": "f4ba8f5904bf",
   "speaker_korean": null,
   "korean": "⟦1⟧・전체 보기"
  },
  {
   "key": "28442ba8f54f",
   "speaker_korean": null,
   "korean": "⟦1⟧・하얀 전사와 검은 문장술사 집중 보기"
  },
  {
   "key": "73882864759a",
   "speaker_korean": null,
   "korean": "⟦1⟧・하얀 도적과 검은 전사 집중 보기"
  },
  {
   "key": "d704f85c518a",
   "speaker_korean": null,
   "korean": "⟦1⟧・하얀 문장술사와 검은 도적 집중 보기"
  },
  {
   "key": "8213c24e8907",
   "speaker_korean": "페이트",
   "korean": "「이건…\n하얀 전사와 검은 문장술사."
  },
  {
   "key": "0dc359688b65",
   "speaker_korean": "페이트",
   "korean": "「하얀 도적과 검은 전사."
  },
  {
   "key": "c149bfeb4358",
   "speaker_korean": "페이트",
   "korean": "「하얀 문장술사와 검은 도적."
  },
  {
   "key": "13f050fe039d",
   "speaker_korean": "말을 배치할 장소를 선택해 주십시오.",
   "korean": "(캔슬로 한 단계 전으로 돌아갑니다\n또한, 적군 배치를\n확인할 수 있습니다)"
  },
  {
   "key": "68ce653324eb",
   "speaker_korean": "배치할 말을 선택해 주십시오.",
   "korean": "(캔슬로 한 단계 전으로 돌아갑니다)"
  },
  {
