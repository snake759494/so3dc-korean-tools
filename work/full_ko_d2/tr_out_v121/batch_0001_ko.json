 "batch_id": "batch_0001",
 "translations": [
  {
   "key": "9de782ba3371",
   "speaker_korean": "페이트",
   "korean": "「…그런데 짐이 가득 차서\n못 들 것 같네.\n원래대로 되돌려 놓자."
  },
  {
   "key": "526302eab5b2",
   "speaker_korean": "마리아",
   "korean": "「뭘 원해?"
  },
  {
   "key": "e90dc77bd013",
   "speaker_korean": null,
   "korean": "⟦1⟧오리하르콘⟦2⟧을 손에 넣었다."
  },
  {
   "key": "d94cf27c50cc",
   "speaker_korean": "마리에타",
   "korean": "「이건 테스트입니다.\n텍스처 애니메이션 입일 경우에\n입 움직임을 느리게 하려고요♥"
  },
  {
   "key": "124af1d10152",
