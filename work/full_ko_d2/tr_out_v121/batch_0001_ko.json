  },
  {
   "key": "0dbb49d0a71e",
   "speaker_korean": null,
   "korean": "⟦1⟧・반덴 함과의 공중전(ev_10C)"
  },
  {
   "key": "59af8c51ea3b",
   "speaker_korean": null,
