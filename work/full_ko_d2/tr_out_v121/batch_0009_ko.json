{
 "batch_id": "batch_0009",
 "translations": [
  {
   "key": "326b72fe9cb1",
   "speaker_korean": null,
   "korean": "만물상 만화당"
  },
  {
   "key": "7665fd7eb0f0",
   "speaker_korean": null,
   "korean": "조심하자!\n밤길의 검은 나그네.\n⟦P⟧"
  },
  {
   "key": "e97fb44aecd9",
   "speaker_korean": null,
   "korean": "일하지 않는 자 먹지도 말라.\n게으름뱅이는 당신 바로 뒤에 있다.\n⟦P⟧"
  },
  {
   "key": "91cf49257f40",
   "speaker_korean": null,
   "korean": "한 사람당 식량 등의 배급 예정과\n배급품 수령 여부가 체크되어 있다.\n⟦P⟧"
  },
  {
   "key": "e02815d9ab57",
   "speaker_korean": "아기를 업은 아줌마",
   "korean": "⟦1⟧「어서 오세요.\n뭘 찾으시나요?\n⟦P⟧"
  },
  {
   "key": "fb4f433a64fd",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(이건 게임이 아니야.\n무기도 없이 마을 밖에 나가다니\n자살 행위야.\n⟦P⟧"
  },
  {
   "key": "efa5a5ab8114",
   "speaker_korean": "페이트",
   "korean": "「겨우, 도착했다….\n⟦P⟧하하… 생각보다 멀었네.\n⟦1⟧스캐너⟦2⟧상으로는……\n바로 근처로 보였는데… 말이지…."
  },
  {
   "key": "4a90333b2a30",
   "speaker_korean": "단발머리 소녀",
   "korean": "「앗!!"
  },
  {
   "key": "4b8b4ad6931b",
   "speaker_korean": "단발머리 소녀",
   "korean": "「왜 그래?\n배라도 아픈 거야?"
  },
  {
   "key": "9c4a1bb8bf30",
   "speaker_korean": "단발머리 소녀",
   "korean": "「큰일 났어, 오빠!\n오빠아~!!"
  },
  {
   "key": "b55cdbef1971",
   "speaker_korean": "미나",
   "korean": "「⟦1⟧미나⟦2⟧는 이제 괜찮아.\n오르골 같은 건 안 고쳐져도 돼.\n그러니까 오빠가 없어져 버리는 건 싫어!!"
  },
  {
   "key": "ecff1403d771",
   "speaker_korean": "페이트",
   "korean": "「조금 자고 있을 뿐이야.\n⟦1⟧노키아⟦2⟧는, ⟦3⟧미나⟦4⟧를 두고\n없어지거나 하지 않을 거야."
  },
  {
   "key": "6ff7bfebb68e",
   "speaker_korean": "미나",
   "korean": "「정말?"
  },
  {
   "key": "fec19ea45a40",
   "speaker_korean": "미나",
   "korean": "「오빠! 오빠아~!!"
  },
  {
   "key": "d4f47a4fa251",
   "speaker_korean": "페이트",
   "korean": "「응."
  },
  {
   "key": "8f91ab13b9f7",
   "speaker_korean": null,
   "korean": "⟦1⟧인페리아 소드⟦2⟧를 손에 넣었다."
  },
  {
   "key": "2808c4bc07ee",
   "speaker_korean": "페이트",
   "korean": "「―――아아아앗!!\n하…아… 하아… 하아… 꿈인가……."
  },
  {
   "key": "5c0199639293",
   "speaker_korean": "단발머리 소녀",
   "korean": "「아……."
  },
  {
   "key": "18a3e8483f6a",
   "speaker_korean": "페이트",
   "korean": "「너는……?"
  },
  {
   "key": "9591bd92d45b",
   "speaker_korean": "단발머리 소녀",
   "korean": "「물, 여기에 놔둘게."
  },
  {
   "key": "089109cae068",
   "speaker_korean": "영리해 보이는 소년",
   "korean": "「괜찮으세요?\n몹시 가위에 눌리신 것 같던데요."
  },
  {
   "key": "f24093116e8d",
   "speaker_korean": "페이트",
   "korean": "「아, 괜찮은 것 같아.\n네가 구해 준 거니?"
  },
  {
   "key": "ca024ee1c8c8",
   "speaker_korean": "영리해 보이는 소년",
   "korean": "「아뇨, 저는 여기까지 옮겼을 뿐이에요.\n여동생이… ⟦1⟧미나⟦2⟧가 꼭 그러자고 해서요."
  },
  {
   "key": "a05aeab830d9",
   "speaker_korean": "페이트",
   "korean": "「그래, ⟦1⟧미나⟦2⟧가\n구해 준 거구나.\n고마워."
  },
  {
   "key": "e906b697c49b",
   "speaker_korean": "단발머리 소녀",
   "korean": "「오빠아~!"
  },
  {
   "key": "fc55d2f38375",
   "speaker_korean": "페이트",
   "korean": "「그러고 보니, 자기소개가 아직이었네.\n내 이름은 ⟦1⟧페이트⟦2⟧.\n⟦3⟧페이트 라인갓⟦4⟧이라고 해.\n너는?"
  },
  {
   "key": "e152f6e898c2",
   "speaker_korean": "영리해 보이는 소년",
   "korean": "「⟦1⟧노키아⟦2⟧예요.\n이 아이는 ⟦3⟧미나⟦4⟧라고 해요."
  },
  {
   "key": "44ee123495e4",
   "speaker_korean": "노키아",
   "korean": "「⟦1⟧페이트 씨⟦2⟧……\n라고 하셨죠.\n당신의 그 옷… 그 귀…\n혹시 ⟦3⟧노턴⟦4⟧의\n동료인가요?"
  },
  {
   "key": "f83af804ea02",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧노턴⟦2⟧?\n그거, 사람 이름이니?"
  },
  {
   "key": "3b1d4a68c07e",
   "speaker_korean": "노키아",
   "korean": "「맞아요."
  },
  {
   "key": "13f9c44c1891",
   "speaker_korean": "페이트",
   "korean": "「무슨 사정인지 잘\n모르겠는데?"
  },
  {
   "key": "9b66a6e7b0aa",
   "speaker_korean": "노키아",
   "korean": "「정말로…\n모르시는 건가요?"
  },
  {
   "key": "aa3179a4024c",
   "speaker_korean": "페이트",
   "korean": "「아… 응.\n들어 본 적은 없는데,\n누군데 그래?"
  },
  {
   "key": "eee7358e6150",
   "speaker_korean": "노키아",
   "korean": "「아뇨, 모르시면 된 거예요.\n죄송해요. 이상한 걸 물어봐서."
  },
  {
   "key": "0f9a1093c423",
   "speaker_korean": "노키아",
   "korean": "「아직 몸도 성치 않으실 텐데요.\n당분간 저희 집에서 쉬다 가세요.\n대단한 건 못 해 드리지만,\n밥 정도는 차려 드릴 수 있으니까요…."
  },
  {
   "key": "4564373b6bef",
   "speaker_korean": "페이트",
   "korean": "「아니, 괜찮… 윽!"
  },
  {
   "key": "0846ea683768",
   "speaker_korean": "미나",
   "korean": "「안 돼! 아직 일어나면 안 되는 거야!"
  },
  {
   "key": "210aaadbdfb7",
   "speaker_korean": "노키아",
   "korean": "「어려울 때는 서로 돕는 법이니까,\n신경 쓰지 마세요.\n지금은 몸을 회복하는 게 우선이에요."
  },
  {
   "key": "e61eb0d8e759",
   "speaker_korean": "페이트",
   "korean": "「신세를 지게 됐네."
  },
  {
   "key": "b8cf7130c6ac",
   "speaker_korean": "노키아",
   "korean": "「아뇨…… ⟦1⟧미나⟦2⟧,\n너무 방해하면 안 돼."
  },
  {
   "key": "7e87805029b6",
   "speaker_korean": "미나",
   "korean": "「응!"
  },
  {
   "key": "c2c8c843c8d9",
   "speaker_korean": "페이트",
   "korean": "「아직 어려 보이는데,\n꽤나 야무진 아이구나.\n마치 ⟦1⟧소피아⟦2⟧ 같아."
  },
  {
   "key": "b0ca9ecc4c9d",
   "speaker_korean": "미나",
   "korean": "「있지, 오빠는 어디서 온 거야?\n왜 귀가 동그란 거야?\n⟦1⟧소피아⟦2⟧는 누구야?\n응~? 응~? 응~?"
  },
  {
   "key": "59e233eb134d",
   "speaker_korean": "페이트",
   "korean": "(여긴?"
  },
  {
   "key": "3c49933811ba",
   "speaker_korean": "페이트",
   "korean": "(그렇지, 나는 변경 행성에….\n누군가가 구해 준 건가?"
  },
  {
   "key": "b035dfcaea44",
   "speaker_korean": "미나",
   "korean": "「에헤헤♪"
  },
  {
   "key": "7dfc5df8424e",
   "speaker_korean": "페이트",
   "korean": "「하핫."
  }
 ]
}