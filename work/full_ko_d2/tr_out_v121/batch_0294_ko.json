  },
  {
   "key": "0be792e60bb7",
   "speaker_korean": null,
   "korean": "트래핑 카드 EX30"
  },
  {
   "key": "a252fa60d059",
   "speaker_korean": null,
   "korean": "페이트의 손에\n쏙 들어오는 사이즈의 스캐너"
  },
  {
   "key": "c65cff491b4f",
   "speaker_korean": null,
   "korean": "아리그리프 왕이 시하츠의 엘레나 여사에게 보낸 편지"
  },
  {
   "key": "039bf4495913",
   "speaker_korean": null,
   "korean": "스프레가 준 티켓"
  },
  {
   "key": "47116ae80b37",
   "speaker_korean": null,
   "korean": "컬소어 수련장의 굳게 닫힌 문을\n여는 열쇠"
  },
  {
   "key": "a3402b1695e6",
   "speaker_korean": null,
   "korean": "신들의 산에서만 핀다는 특별한 꽃을\n한 송이씩 실로 엮은 것으로\n천송이를 모으면 소원이 이뤄진다고 전해진다"
  },
  {
   "key": "3216aded9385",
   "speaker_korean": null,
   "korean": "로저가\n도적단 '월영'과 승부해 빼앗은 물건"
  },
  {
   "key": "4e570ac53e9f",
   "speaker_korean": null,
   "korean": "은하 구획에 풀려난\n엑스큐셔너를 소멸시키기 위한\n프로그램"
  },
  {
   "key": "2971f3e45f85",
   "speaker_korean": null,
   "korean": "은하 연방의 표준 통신기로, 1천문단위의\n거리까지 중력 통신과, 미지 언어의\n번역이 가능하다"
  },
  {
   "key": "18cfcda453f3",
   "speaker_korean": null,
   "korean": "플러드가 페이트에게\n건넨 CD 사이즈의 디스크"
  },
  {
   "key": "42972a1336cc",
   "speaker_korean": null,
   "korean": "용의 공명강으로 만든 피리\n버튼을 누르는 길이와 강약으로\n4종류의 음색을 낼 수 있다"
  },
  {
   "key": "2f163116cbc4",
   "speaker_korean": null,
   "korean": "파피가 자빠지며(예상대로) 흘린 의문의 열쇠\n어디에 쓰는지는 불명"
  },
  {
   "key": "907cef79983b",
   "speaker_korean": null,
   "korean": "던전의 특정 지형이나 사물을 지울 수\n있게 되는 반지\n버튼으로 작동한다"
  },
  {
   "key": "87bc2e844918",
   "speaker_korean": null,
   "korean": "드래곤의 숨통에 해당하는 뼈"
  },
  {
   "key": "3b9ddf30a223",
   "speaker_korean": null,
   "korean": "드래곤의 두개골"
  },
  {
   "key": "b723d2ee121f",
   "speaker_korean": null,
   "korean": "고귀한 용의 거처에, 하늘서 쏟아지는 빛,\n이 구슬의 봉인을 풀어내니,\n그것이 곧 재앙의 열쇠가 되리라"
  },
  {
   "key": "5816c283351c",
   "speaker_korean": null,
   "korean": "성전 카난에 안치되어 있는 강대한 힘을\n품은 보주"
  },
  {
   "key": "481c5256f1cf",
   "speaker_korean": null,
   "korean": "모젤 사구의 맹렬한 열파를\n견딜 수 있게 해주는 특수한 아이템"
  },
  {
   "key": "b976933ba94c",
   "speaker_korean": null,
   "korean": "모젤 사구의 광활한 지형을 자세히 담은 지도"
  },
  {
   "key": "4d16b719e686",
   "speaker_korean": null,
   "korean": "토끼 귀를 본떠 만든 오브제\n아무래도 어딘가의 열쇠인 듯하다"
  },
  {
   "key": "8f9d88ac3d75",
   "speaker_korean": null,
   "korean": "오르골을 울리기 위해 필요한\n중요한 부품"
  },
  {
   "key": "17dc010e95fa",
   "speaker_korean": null,
   "korean": "장인 길드와 원거리에서 연락을 주고받기\n위한 필수품. 상당히 높은 수준의 기술로\n보이지만 자세한 내용은 불명"
  },
  {
   "key": "df29fa3ebb75",
   "speaker_korean": null,
   "korean": "하얗게 안개 서린\n무해에 숨은 은자의 샘\n지키는 부자는 무슨 생각을 할까…"
  },
  {
   "key": "91ec3a64e72e",
   "speaker_korean": null,
   "korean": "그윽하고 어두운 산굴\n다섯 속성이 서로 다투니\n비추는 빛은 무엇인가…"
  },
  {
   "key": "40b8835e29dc",
   "speaker_korean": null,
   "korean": "신들의 궁병이 지키는 낡아버린 회랑\n관 속에 잠든 것은 태양왕\n말없는 주검은 무엇을 말하는가…"
  },
  {
   "key": "82a419002ad2",
   "speaker_korean": null,
   "korean": "세 종류 병사가 모이는 곳의\n주인 없는 옥좌엔 누가 앉을까…"
  },
  {
   "key": "674a3dd05cf1",
   "speaker_korean": null,
   "korean": "날개 달린 신의 사자, 제물이\n바라보는 곳은 희망인가 절망인가…"
  },
  {
   "key": "113361e7c776",
   "speaker_korean": null,
   "korean": "붉은 구리가 잠든 동굴의 끝\n호숫가를 바라보는 최북단의 현자\n뿌리내린 지하에 봉인된 것은 태고의 힘인가…"
  },
  {
   "key": "d1b4a50e7b68",
   "speaker_korean": null,
   "korean": "작열지옥\n장이족 거인이 굽어보는 붉은 쌍둥이\n감춰진 힘을 풀어놓는 자는 누구인가…"
  },
  {
   "key": "376910aafd2d",
   "speaker_korean": null,
   "korean": "320년 전 종교전쟁 당시 시포트\n성왕국을 침공해 그 나라를 멸망시킨\n기술 국가 그리텐의 기공병 설계도"
  },
  {
   "key": "757a0626f34a",
   "speaker_korean": null,
   "korean": "기공병을 기동・작동시키는 데\n필요한 프로그램. 이것이 내장되지 않은\n기공병은 그저 고철이나 다름없다"
