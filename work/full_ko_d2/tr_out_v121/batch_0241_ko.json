{
 "batch_id": "batch_0241",
 "translations": [
  {
   "key": "17826653e484",
   "speaker_korean": null,
   "korean": "문베이스 플레이룸"
  },
  {
   "key": "567bb4b0c90f",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「어떤가?\n이곳 생활에는 이제 좀 익숙해졌나?\n⟦P⟧"
  },
  {
   "key": "0abd87cd48a5",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그렇네요, 이제 거의…\n이것도 아드레이 덕분이에요"
  },
  {
   "key": "997c8c44df26",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「그런가\n그거 다행이구먼\n⟦P⟧"
  },
  {
   "key": "5f883fbf16ce",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「그건 그렇고,\n자네는 그 네벨의 딸…\n넬과 사귀고 있는 겐가?"
  },
  {
   "key": "c42ac453414c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭐… 콜록콜록\n갑자기 무슨 말씀을?\n⟦P⟧"
  },
  {
   "key": "2ba99adfdf0a",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「일부러 여기 남았을 정도이니 말이다\n당연히 그런 줄 알았건만…\n아니었나?"
  },
  {
   "key": "2ec44e188a15",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아, 아니에요\n넬 씨와는\n그런 사이 아니에요"
  },
  {
   "key": "453bb530fbd6",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「이 별에서 처음 만나 함께 모험하고…\n뭐라고 해야 할까…\n그래요, 그녀와는 동료 같은 느낌이에요"
  },
  {
   "key": "7a971576e82f",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「그렇다면, 페이트 공.\n자네는 지금 사귀는 상대가\n없는 겐가?"
  },
  {
   "key": "6008211a46cb",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「딱히 없는데…\n왜 그러세요?"
  },
  {
   "key": "f88ea4682bf3",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「그런가, 그럼 마침 잘됐군\n내 딸과 결혼하지 않겠나?"
  },
  {
   "key": "916f925d2c46",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「네에!?\n클레어 씨와요?"
  },
  {
   "key": "7975a7e2ac9b",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「뭐냐, 그 녀석으로는 불만인가?"
  },
  {
   "key": "09222f952d67",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아뇨, 그런 건 아니지만\n그런 건 본인이 정할 일이잖아요?\n⟦P⟧설령 제가 좋다고 해도, 클레어 씨가\n뭐라고 할지…"
  },
  {
   "key": "06653dab0c46",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「무슨 소리를 하는 게냐\n나는 내 딸을 잘 알고 있다\n그 녀석이 고개를 저을 리 없어"
  },
  {
   "key": "bf2e904c2f38",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「좋아, 결정됐다!\n이걸로 라즈버드 가문도\n한시름 놓겠구먼"
  },
  {
   "key": "489bd4538af5",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「음, 클레어인가\n무슨 용건이냐?"
  },
  {
   "key": "f8b5f84b27fe",
   "speaker_korean": "클레어",
   "korean": "⟦1⟧「…… ……"
  },
  {
   "key": "cbfe23fbef7e",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「뭐!? 따라오라고?\n마침 잘됐군\n나도 너에게 할 말이 있었다…"
  },
  {
   "key": "cf92b26a99a3",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「클레어 씨가 싫은 건 아니지만요\n그렇게 되면, 저분이 장인어른이\n되는 거잖아요?\n아무리 그래도, 그건 좀…"
  },
  {
   "key": "69abefd7925a",
   "speaker_korean": null,
   "korean": "우르자 석굴사원 1층"
  },
  {
   "key": "d8fe4e003d0f",
   "speaker_korean": "페이트",
   "korean": "「석판에 뭔가 적혀 있다\n⟦P⟧『짝을 이루는 구슬을 대좌에 바쳐라\n그리하면 길이 열리리라\n⟦P⟧…다만 명심하라\n바쳐진 구슬과 동일한 자는\n부서지지 않는 벽을 그 몸에 두르리라"
  },
  {
   "key": "d3b064102282",
   "speaker_korean": null,
   "korean": "⟦1⟧불의 보주⟦2⟧를 얻었다"
  },
  {
   "key": "b6305b83cbb8",
   "speaker_korean": null,
   "korean": "⟦1⟧물의 보주⟦2⟧를 얻었다"
  },
  {
   "key": "e3be6b2e4f49",
   "speaker_korean": null,
   "korean": "⟦1⟧바람의 보주⟦2⟧를 얻었다"
  },
  {
   "key": "76eb4605e2cf",
   "speaker_korean": null,
   "korean": "⟦1⟧땅의 보주⟦2⟧를 얻었다"
  },
  {
   "key": "680c428c77b9",
   "speaker_korean": "페이트",
   "korean": "「제단에 바칠 것이\n없네"
  },
  {
   "key": "d17eb3ea8eee",
   "speaker_korean": null,
   "korean": "⟦1⟧・가져가기"
  },
  {
   "key": "d1a9860ecc5b",
   "speaker_korean": null,
   "korean": "⟦1⟧・불의 보주 놓기"
  },
  {
   "key": "79e1738c8dbc",
   "speaker_korean": null,
   "korean": "⟦1⟧・물의 보주 놓기"
  },
  {
   "key": "064bdab0b36b",
   "speaker_korean": null,
   "korean": "⟦1⟧・바람의 보주 놓기"
  },
  {
   "key": "fdf856672843",
   "speaker_korean": null,
   "korean": "⟦1⟧・땅의 보주 놓기"
  },
  {
   "key": "59cf14147dab",
   "speaker_korean": null,
   "korean": "⟦1⟧성검 『천총운검』⟦2⟧을 얻었다"
  },
  {
   "key": "fd455bf6d4db",
   "speaker_korean": "페이트",
   "korean": "「당신은!?\n⟦1⟧넬 씨⟦2⟧!?"
  },
  {
   "key": "9e95869f3746",
   "speaker_korean": "넬",
   "korean": "「…뭐야, 너. 내 얘길\n알고 있는 것 같은 말투네\n⟦P⟧뭐, 좋아. 아는 건 하나뿐이야.\n네가 내 적이라는 것뿐이지!"
  },
  {
   "key": "c03d9854a80d",
   "speaker_korean": "페이트",
   "korean": "「아니… 아니야\n⟦1⟧넬⟦2⟧ 씨가 아니야\n닮았지만… 뭔가 달라"
  },
  {
   "key": "52b5117d0d5a",
   "speaker_korean": "넬",
   "korean": "「각오하라구!!"
  },
  {
   "key": "e4d6abde70fd",
   "speaker_korean": "페이트",
   "korean": "「너는!?\n⟦1⟧알벨⟦2⟧!?"
  },
  {
   "key": "248818fc98f9",
   "speaker_korean": "알벨",
   "korean": "「흥, 짜증나는 멍청이랑\n꼭 닮은 놈이 있군…\n마침 잘됐다, 한판 붙어볼까, 버러지야"
  },
  {
   "key": "6153135382bd",
   "speaker_korean": "페이트",
   "korean": "「뭐야, 그게!?"
  },
  {
   "key": "50836a601abb",
   "speaker_korean": "페이트",
   "korean": "「음!? 뭐지?"
  },
  {
   "key": "5aae6821ab6f",
   "speaker_korean": "로저",
   "korean": "「그렇구나!?\n형아가 이번 남자 대결 상대구나?\n한판 제대로 붙어보자구!!"
  },
  {
   "key": "6f4f8ed95b5b",
   "speaker_korean": "로저",
   "korean": "「그런 거 내가\n알 턱이 있겠냐!\n⟦P⟧이유 같은 건 ⟦1⟧레자드⟦2⟧ 그놈한테\n물어보라고!!\n됐으니까 가자, 형아!!"
  },
  {
   "key": "c6f1cee481cb",
   "speaker_korean": "페이트",
   "korean": "「물거울?"
  },
  {
   "key": "f85e595dd494",
   "speaker_korean": "페이트",
   "korean": "「아니… 아니야\n⟦1⟧알벨⟦2⟧이 아니야\n닮았지만… 뭔가 달라"
  },
  {
   "key": "3c2c5f17f163",
   "speaker_korean": "페이트",
   "korean": "「아니… 아니야\n그녀가 아니야\n닮았지만… 뭔가 달라"
  },
  {
   "key": "d6c541b409f9",
   "speaker_korean": "스프레",
   "korean": "「…어라? 오빠,\n나 알아?\n⟦P⟧내 팬…인 건 아니겠지~\n데뷔 공연도 아직 멀었는데…\n⟦P⟧혹시………납치범!?"
  },
  {
   "key": "de9c9a0cd3e2",
   "speaker_korean": "페이트",
   "korean": "「에엣!? 아니야, 아니야!!\n내가 그런 짓을\n할 사람으로 보여?"
  },
  {
   "key": "ca16820c8669",
   "speaker_korean": "스프레",
   "korean": "「음~\n그렇게는 안 보이는데……\n⟦P⟧근데 그런 사람일수록\n위험한 사람이라고\n⟦1⟧바질⟦2⟧이도 그랬고……"
  },
  {
   "key": "387f4db320ff",
   "speaker_korean": "스프레",
   "korean": "「역시, 오빠는 나쁜 사람으로 결정!\n나쁜 사람은 혼내줘야지!"
  },
  {
   "key": "de8fb4e28f03",
   "speaker_korean": "페이트",
   "korean": "「그러니까, 아니라고 했잖아!?"
  },
  {
   "key": "0c524eff17fd",
   "speaker_korean": "스프레",
   "korean": "「문답무용이야~!!"
  },
  {
   "key": "377a454e0034",
   "speaker_korean": "로저",
   "korean": "「응? 누구야, 형아?\n어디서 본 것 같기도\n안 본 것 같기도 한데…"
  },
  {
   "key": "8e7cc85d3eb9",
   "speaker_korean": "페이트",
   "korean": "「이건… 대체…?"
  },
  {
   "key": "f3dc4dd20fd2",
   "speaker_korean": "페이트",
   "korean": "「남자 대결 상대?\n뭐야, 그게!?"
  },
  {
   "key": "d56a5c3055e9",
   "speaker_korean": "알벨",
   "korean": "「구시렁구시렁 시끄럽다, 멍청아!\n네놈 낯짝이 괜히 짜증나는군\n원망하려거든 그 자식 닮은\n네놈 낯짝을 원망해라!!"
  },
  {
   "key": "2c7fa641a507",
   "speaker_korean": "페이트",
   "korean": "「너는!?\n왜 이런 곳에!?"
  },
  {
   "key": "98ff70c489af",
   "speaker_korean": null,
   "korean": "멤버가 많습니다\n넬·알벨·로저·스프레 중\n3명 이상이 파티 멤버로\n존재합니다\n⟦P⟧"
  }
 ]
}