{
 "batch_id": "batch_0233",
 "translations": [
  {
   "key": "03bd01e77249",
   "speaker_korean": null,
   "korean": "스피어211 최상층"
  },
  {
   "key": "1a9cd2968f42",
   "speaker_korean": null,
   "korean": "⟦1⟧카운터 오라 습득서3⟦2⟧을 손에 넣었다"
  },
  {
   "key": "254ba7ead339",
   "speaker_korean": "이세리아 퀸",
   "korean": "「용케 여기까지\n찾아왔구나"
  },
  {
   "key": "b9266debf860",
   "speaker_korean": "마리아",
   "korean": "「역시…\n쌍의 나머지 반쪽, 다른 천사도\n존재하고 있었구나"
  },
  {
   "key": "d6ce3539d742",
   "speaker_korean": "페이트",
   "korean": "「…온다!!"
  },
  {
   "key": "d759fae4c2c3",
   "speaker_korean": "이세리아 퀸",
   "korean": "「여기는 좁군요\n자리를 옮기죠"
  },
  {
   "key": "aaf1328445c4",
   "speaker_korean": "이세리아 퀸",
   "korean": "「용케 저를 쓰러뜨리셨군요"
  },
  {
   "key": "ebb98638e839",
   "speaker_korean": "이세리아 퀸",
   "korean": "「이것은 궁극의 재앙을 봉인한\n악마의 보주예요, 함부로 다루면\n이 세상 자체가 한순간에 먼지로 변해요\n⟦P⟧조심하세요"
  },
  {
   "key": "511e508df11e",
   "speaker_korean": "이세리아 퀸",
   "korean": "「용케 저를 쓰러뜨리셨군요\n또 어딘가에서 만나요\n그럼 안녕히"
  },
  {
   "key": "9dddfc3f14bf",
   "speaker_korean": "페이트",
   "korean": "「또 왔네…"
  },
  {
   "key": "d8b53c969171",
   "speaker_korean": "클리프",
   "korean": "「지겹지도 않은 놈이라는 거군\n뭐, 와버린 이상 어쩔 수 없지"
  },
  {
   "key": "567b490cd318",
   "speaker_korean": "페이트",
   "korean": "「드디어 도착했네…"
  },
  {
   "key": "f54c16a6170e",
   "speaker_korean": "클리프",
   "korean": "「진짜 그렇다니까\n여태까지 싸워온 녀석들이\n죄다 어이없는 놈들뿐이었으니까\n⟦P⟧고생도 더 컸단 말이지"
  },
  {
   "key": "ff29d21d301a",
   "speaker_korean": "클리프",
   "korean": "「그래서\n그놈이 마지막 적이라는 거군"
  },
  {
   "key": "b83416150316",
   "speaker_korean": "페이트",
   "korean": "「그렇겠지"
  },
  {
   "key": "72198f6a29e7",
   "speaker_korean": "클리프",
   "korean": "「그래서\n그놈도 다시 등장이란 거군"
  },
  {
   "key": "5a589192223f",
   "speaker_korean": "이세리아 퀸",
   "korean": "「당신들도 제가 가지고 있는\n이 재앙 봉인 보주를 원하나요?\n하지만 안 돼요, 이건 제 장난감이에요\n당신들이 다루기엔 역부족이에요\n그릇이 부족해요\n이제 여기서 끝내죠"
  },
  {
   "key": "eefb8d1c544d",
   "speaker_korean": "이세리아 퀸",
   "korean": "「당신들은 역시 싸움을\n추구하는 존재인가요?\n어떤 의미론 헛된 싸움일지도 몰라요\n하지만 저는 당신들을 상대하는\n사명을 지닌 존재예요\n이제 여기서 끝내죠"
  },
  {
   "key": "7a6e37f93d4e",
   "speaker_korean": "페이트",
   "korean": "「또…!?"
  },
  {
   "key": "5515e2abe55d",
   "speaker_korean": "넬",
   "korean": "「이 은혜는 잊지 않을게…\n이제부터는 우리 일이야"
  },
  {
   "key": "823bb40d68c1",
   "speaker_korean": "알벨",
   "korean": "「…신세 좀 졌군"
  },
  {
   "key": "614ad4e5d446",
   "speaker_korean": "로저",
   "korean": "「…땡큐\n잘은 모르겠지만, 누나 덕분에\n우리 세계도 살아날 것 같다"
  },
  {
   "key": "353e6f394363",
   "speaker_korean": "스프레",
   "korean": "「저기, 고마워\n⟦1⟧블레어⟦2⟧한테는 폐 끼쳤네\n그러니까… 나 열심히 할게!"
  },
  {
   "key": "bad88ef5372e",
   "speaker_korean": "블레어",
   "korean": "「이쪽이야"
  },
  {
   "key": "10bce3ba1698",
   "speaker_korean": "블레어",
   "korean": "「이게 지금 사용 가능한, 이 빌딩에서\n유일하게 은하계 접속 가능한 단말기야\n자, 들어가. 설정은 내가 밖에서 할게"
  },
  {
   "key": "da1550238362",
   "speaker_korean": "마리아",
   "korean": "「고마워, ⟦1⟧블레어⟦2⟧\n반드시 ⟦3⟧에터널 스피어⟦4⟧를\n구해내고 말겠어"
  },
  {
   "key": "355e2376f0d9",
   "speaker_korean": "클리프",
   "korean": "「살았다\n네 덕분에 어떻게든 될 것 같은 느낌이다\n…그럼 이만"
  },
  {
   "key": "9269f54a913d",
   "speaker_korean": "소피아",
   "korean": "「저기, ⟦1⟧블레어 씨⟦2⟧…\n정말 신세 많이 졌습니다\n이 은혜는 평생 잊지 않겠습니다"
  },
  {
   "key": "91169938c4c5",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧블레어 씨⟦2⟧\n여러모로 감사했습니다"
  },
  {
   "key": "64b0fec34513",
   "speaker_korean": "블레어",
   "korean": "「힘내\n너희들의 세계는\n너희들만이 구할 수 있으니까"
  },
  {
   "key": "da7092abdd4f",
   "speaker_korean": "블레어",
   "korean": "「잘 가"
  },
  {
   "key": "141e52d7df14",
   "speaker_korean": "블레어",
   "korean": "「그럼…"
  },
  {
   "key": "be9da8b9976b",
   "speaker_korean": null,
   "korean": "LζePV LEvEL RnMPVαNKK\nSuEReLRVnSEun\nRvvEαα ⟦G:87f31c31⟧ζPVNKKK\nIeRLRvNPv αoαNEMI"
  },
  {
   "key": "41c964da49ca",
   "speaker_korean": null,
   "korean": "ζ④KKK\nαoαNEM αNK\nnζζu vLζαE"
  },
  {
   "key": "8b444652b5bf",
   "speaker_korean": "블레어",
   "korean": "「…힘내"
  },
  {
   "key": "5eb581ac4a09",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「자네들, 잠깐 기다리게"
  },
  {
   "key": "2c7bd48124b4",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「나는 여기서 ⟦1⟧모젤 사구⟦2⟧의\n관리를 하는 사람이라네\n관리라 해도 이 사구의 위험성을\n경고하고 있을 뿐이지만…\n이 앞은 ⟦3⟧모젤 사구⟦4⟧라 하여\n비가 거의 내리지 않는 뜨거운 사막이\n펼쳐져 있다네, 물이 없으면\n살아 돌아갈 보장은 없다네"
  },
  {
   "key": "93168f1ffdb0",
   "speaker_korean": "페이트",
   "korean": "「뭔가 앞으로 나아갈 방법은\n없는 건가요?"
  },
  {
   "key": "9ed0f9444dce",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「사구 곳곳에 샘이 있다네\n거기서 물을 보충하면서 나아가면\n될 걸세\n다만, 이 사구의 무서운 점은\n물 부족만이 아니라네\n가혹한 환경을 견뎌온 강력한\n몬스터가 많이 있다네\n조심하는 게 좋을 걸세"
  },
  {
   "key": "5414b3242d93",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「이 너머는 물이 없으면\n살아 돌아갈 보장은 없다네\n곳곳에 샘이 있으니\n거기서 물을 보충하면서\n나아가면 갈 수 있을 걸세\n조심하는 게 좋을 걸세"
  },
  {
   "key": "f41497e67abd",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「그건 그렇고…\n다름이 아니라 상의할 게 있는데\n지도를 사지 않겠나?"
  },
  {
   "key": "877b5b912d1c",
   "speaker_korean": "페이트",
   "korean": "「지도요?"
  },
  {
   "key": "448f8f165a6b",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「그렇다네\n내가 오랜 세월 조사한\n⟦1⟧모젤 사구⟦2⟧의 지도라네\n도움이 될 거라 생각하네만…"
  },
  {
   "key": "4288e8b84e4e",
   "speaker_korean": "페이트",
   "korean": "「…얼마인가요?"
  },
  {
   "key": "294f581b6493",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「⟦1⟧10000폴⟦2⟧이라네"
  },
  {
   "key": "2de990f0171e",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「그건 그렇고…\n지도를 살 생각은 없는가?"
  },
  {
   "key": "49e88c6fc0be",
   "speaker_korean": null,
   "korean": "⟦1⟧・⟦2⟧10000폴⟦3⟧로 지도를 산다"
  },
  {
   "key": "c4bb7d422eb0",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「안 사겠다는 겐가…\n아쉽구먼"
  },
  {
   "key": "3be9a353bfb5",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「오오, 사는 겐가!\n자네들은 운이 좋구먼\n지금은 90% 할인 세일 중이니까"
  },
  {
   "key": "84bd31f0388c",
   "speaker_korean": null,
   "korean": "⟦1⟧모젤 사구의 지도⟦2⟧를 손에 넣었다"
  },
  {
   "key": "aa06c2feb549",
   "speaker_korean": "사구에 정통한 노인",
   "korean": "「…돈이 부족하구먼\n다음에 다시 오게"
  }
 ]
}