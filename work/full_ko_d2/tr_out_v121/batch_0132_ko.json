{
 "batch_id": "batch_0132",
 "translations": [
  {
   "key": "8fe80161c55e",
   "speaker_korean": "넬",
   "korean": "「그런 거야."
  },
  {
   "key": "58c90720624c",
   "speaker_korean": "디온",
   "korean": "「용케 ⟦1⟧구리⟦2⟧를 손에 넣는다 해도,\n무사히 이곳으로 돌아올 수 있을지…."
  },
  {
   "key": "92f7e89b899c",
   "speaker_korean": "클리프",
   "korean": "「야생 ⟦1⟧에어드래곤⟦2⟧이랑 ⟦3⟧질풍⟦4⟧이 상대라면,\n보통내기로는 어떻게 안 되겠지."
  },
  {
   "key": "5305df46f9b8",
   "speaker_korean": "페이트",
   "korean": "「그렇구나.\n⟦1⟧구리⟦2⟧를 구할 수 있으면 했는데,\n어떡하지…."
  },
  {
   "key": "3d92b47c50ef",
   "speaker_korean": "클리프",
   "korean": "「뭔 소리 하는 거냐.\n가서 가져오면 그만이잖냐."
  },
  {
   "key": "a111f0bbdc4f",
   "speaker_korean": "페이트",
   "korean": "「할 수 있어?"
  },
  {
   "key": "b9c8e5a86584",
   "speaker_korean": "클리프",
   "korean": "「당연하지.\n난 보통내기가 아니라고 했잖냐."
  },
  {
   "key": "bb0dad963eac",
   "speaker_korean": "페이트",
   "korean": "「이럴 때는 네\n근거 없는 자신감도 고맙네."
  },
  {
   "key": "7fbeb9f81b69",
   "speaker_korean": "클리프",
   "korean": "「근거가 없다니 무례한 놈이군.\n적당히 좀, 너도 내 실력을 인정하라고."
  },
  {
   "key": "8b3ffa5ef681",
   "speaker_korean": "페이트",
   "korean": "「인정 안 하는 건 아니야.\n그냥 좀 자신감이 과한 거 아닌가 하고\n생각했을 뿐이야."
  },
  {
   "key": "bdb9642200e6",
   "speaker_korean": "디온",
   "korean": "「설마, 두 분이서 가시려는 겁니까?\n무모합니다!!"
  },
  {
   "key": "1d116f127243",
   "speaker_korean": "넬",
   "korean": "「너, 무슨 소리 하는 거야?\n둘이 아니야, 나도 갈 거야.\n당연한 거잖아."
  },
  {
   "key": "f35773d36ac5",
   "speaker_korean": "디온",
   "korean": "「당신⟦1⟧마저요!?\n아무리 그래도 무모한 건 무모한 겁니다!!"
  },
  {
   "key": "cce69a0859af",
   "speaker_korean": "넬",
   "korean": "「괜찮아. 저들은 기술자지만 실력자야.\n⟦1⟧칠흑⟦2⟧과도 대등하게 맞설 수 있을 정도니까."
  },
  {
   "key": "0b8f450ce9ed",
   "speaker_korean": "디온",
   "korean": "「그래도……."
  },
  {
   "key": "283a105161c8",
   "speaker_korean": "넬",
   "korean": "「걱정할 필요 없어.\n우리끼리는 ⟦1⟧구리⟦2⟧를 못 옮기니까,\n결국 운반책으로 몇 명 데려갈\n필요가 있을 것 같은데.\n⟦3⟧구리⟦4⟧는 어느 정도 있으면 되는 거야?"
  },
  {
   "key": "c436749faf7d",
   "speaker_korean": "페이트",
   "korean": "「수십 킬로 정도면 충분할 것 같아."
  },
  {
   "key": "dd7365b6c685",
   "speaker_korean": "넬",
   "korean": "「OK, 알았어.\n그럼 내 부하들만으로 충분하겠네.\n⟦1⟧타이네브⟦2⟧랑 ⟦3⟧파린 일행⟦4⟧을\n데려가야겠다."
  },
  {
   "key": "c999490bf897",
   "speaker_korean": "디온",
   "korean": "「어쩔 수 없네요.\n하지만 부디 무리는 하지 말아 주세요."
  },
  {
   "key": "cc44d683720a",
   "speaker_korean": "넬",
   "korean": "「알고 있어.\n너도 ⟦1⟧클레어⟦2⟧랑 똑같이 걱정이 많네."
  },
  {
   "key": "14bad5e2dce9",
   "speaker_korean": "페이트",
   "korean": "「그리고 ⟦1⟧디온⟦2⟧, 이거."
  },
  {
   "key": "fad3b2dc74c9",
   "speaker_korean": "페이트",
   "korean": "「우리가 ⟦1⟧구리⟦2⟧를 구해 오는 동안,\n너는 그 문제점을\n처리해 뒀으면 좋겠어."
  },
  {
   "key": "8c5398b00965",
   "speaker_korean": "디온",
   "korean": "「…과연!\n확실히 여기를 이렇게 하면\n스펙이 상당히 올라가겠네요!!\n역시 대단하시네요, 굉장해요!!"
  },
  {
   "key": "48f7e1e90aad",
   "speaker_korean": "페이트",
   "korean": "「뭘 그렇게 거창하게."
  },
  {
   "key": "75622c908513",
   "speaker_korean": "넬",
   "korean": "「그럼 부탁할게, ⟦1⟧디온⟦2⟧."
  },
  {
   "key": "917a0760815d",
   "speaker_korean": "디온",
   "korean": "「예, 알겠습니다.\n……부디 조심하세요."
  },
  {
   "key": "89bde0e1275d",
   "speaker_korean": "넬",
   "korean": "「나는 부하들 준비를 시키고 올게.\n⟦1⟧시랜드⟦2⟧ 입구에서 모이자.\n각자 준비가 끝나면 모여."
  },
  {
   "key": "8555f06d109d",
   "speaker_korean": "클리프",
   "korean": "「다른 놈이면 큰일이겠지만,\n나한테는 식은 죽 먹기지."
  },
  {
   "key": "af71fb2e84f9",
   "speaker_korean": "페이트",
   "korean": "「설계도를 대충 훑어보고 알아낸 문제점과\n그 해결책을 적어 놨어."
  },
  {
   "key": "f08935fe8c2a",
   "speaker_korean": "디온",
   "korean": "「이건 뭐죠?"
  },
  {
   "key": "fbd55096e424",
   "speaker_korean": "디온",
   "korean": "「알겠다.\n계속 작업을 진행해 줘."
  },
  {
   "key": "c062cd7bd11e",
   "speaker_korean": "디온",
   "korean": "「당신은 준비가 끝난\n⟦1⟧시술병기⟦2⟧를 ⟦3⟧아리아스⟦4⟧까지\n마차로 이송해 주세요."
  },
  {
   "key": "806f15f8e600",
   "speaker_korean": "디온",
   "korean": "「잘 부탁드립니다."
  },
  {
   "key": "d8a0e1e58e42",
   "speaker_korean": "디온",
   "korean": "「아, ⟦1⟧구리⟦2⟧는 무사히 받았습니다.\n감사합니다."
  },
  {
   "key": "5645d7871a5e",
   "speaker_korean": "디온",
   "korean": "「예, ⟦1⟧아리그리프⟦2⟧의\n움직임에 대해서는 들었습니다.\n모처럼 여러분께서 ⟦3⟧구리⟦4⟧를\n구해다 주셨는데,\n제때 맞추지 못해 유감입니다.\n하지만 그렇게만 말하고 있을 순 없죠.\n일단 지금 준비할 수 있는 만큼의\n⟦5⟧시술병기⟦6⟧를 가지고 ⟦7⟧아리아스⟦8⟧로―――."
  },
  {
   "key": "c34870a75531",
   "speaker_korean": "페이트",
   "korean": "「그게 아니야,\n그런 건 아무래도 상관없어!!"
  },
  {
   "key": "1c2a9aa2b8ef",
   "speaker_korean": "디온",
   "korean": "「네? 그게 무슨 소리예요?\n아무래도 상관없다니……."
  },
  {
   "key": "661aab956298",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧디온⟦2⟧… 너…\n⟦3⟧아미나⟦4⟧라는 이름 들어본 적 있어?"
  },
  {
   "key": "df6a1cf5417c",
   "speaker_korean": "디온",
   "korean": "「⟦1⟧아미나⟦2⟧요?\n어떻게 당신이 그 이름을\n알고 있는 거죠?\n누구한테 들으신 겁니까?\n거참……."
  },
  {
   "key": "42e2c7bd97a7",
   "speaker_korean": "디온",
   "korean": "「⟦1⟧아미나⟦2⟧는 제 소꿉친구 이름이에요.\n벌써 몇 년째 못 만났지만요.\n그립네요, 잘 지내고 있으려나…."
  },
  {
   "key": "bc75b5c1bd45",
   "speaker_korean": "페이트",
   "korean": "「알고 있었구나…?"
  },
  {
   "key": "ddd7ef53752e",
   "speaker_korean": "디온",
   "korean": "「자, 잠깐 왜 그러세요?\n지금 손을 뗄 수가 없어요.\n⟦P⟧그보다, 어째서 ⟦1⟧그녀⟦2⟧에 대해\n당신이 알고 있는 거죠?"
  },
  {
   "key": "6a1a2ca40e3d",
   "speaker_korean": "페이트",
   "korean": "「역시 네가 그랬구나.\n잠깐 따라와 줘!!"
  },
  {
   "key": "307cd6b22680",
   "speaker_korean": "페이트",
   "korean": "「네 소꿉친구인 ⟦1⟧아미나⟦2⟧는\n⟦3⟧시랜드⟦4⟧에 있어.\n너를 만나러 온 거야."
  },
  {
   "key": "ff48b8f9df0c",
   "speaker_korean": "디온",
   "korean": "「그럴…그녀는 전쟁으로 삼촌 부부를\n잃은 뒤, ⟦1⟧아리그리프⟦2⟧에 사는 친척에게\n맡겨졌을 텐데요.\n이런 곳에…… 하필 ⟦3⟧시랜드⟦4⟧에\n있을 리가……."
  },
  {
   "key": "f3483a90d486",
   "speaker_korean": "페이트",
   "korean": "「그래도 사실 여기 있어! 부탁이야!\n힘든 때라는 건 알아.\n그래도!!"
  },
  {
   "key": "2ad337c45bb4",
   "speaker_korean": "디온",
   "korean": "「⟦1⟧아미나⟦2⟧는 어디에 있습니까?"
  },
  {
   "key": "ceab90a3efbe",
   "speaker_korean": "페이트",
   "korean": "「여관인데… 만나줄 거야?"
  },
  {
   "key": "14eb07641129",
   "speaker_korean": "디온",
   "korean": "「당연하죠!\n저도, 만나고 싶었다고요!!"
  },
  {
   "key": "c21a70cbc4f8",
   "speaker_korean": "페이트",
   "korean": "「가자."
  },
  {
   "key": "2cb97a5ee259",
   "speaker_korean": "남성 병사",
   "korean": "「핫!"
  },
  {
   "key": "2669b3e063ff",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧디온⟦2⟧, 저기…."
  }
 ]
}