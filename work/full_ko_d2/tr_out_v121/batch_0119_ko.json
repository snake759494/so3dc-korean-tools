{
 "batch_id": "batch_0119",
 "translations": [
  {
   "key": "891ea16e15f5",
   "speaker_korean": "피부 트러블 필수 시술사",
   "korean": "⟦1⟧「거의 잠도 안 자고 작업은 하고\n있는데 말이야…゜\n⟦P⟧혹시나,\n개전엔 못 맞출지도 모르겠네゜\n⟦P⟧"
  },
  {
   "key": "62cd6c3ea194",
   "speaker_korean": "피부 트러블 필수 시술사",
   "korean": "⟦1⟧「무슨 일이야, ⟦2⟧디온⟦3⟧?\n고민이 있으면, 언니한테\n확 털어놔 보렴゜\n⟦P⟧"
  },
  {
   "key": "d0a99328e716",
   "speaker_korean": null,
   "korean": "⟦1⟧시술병기⟦2⟧의 설계도인 듯하다゜\n⟦P⟧"
  },
  {
   "key": "b8b594633467",
   "speaker_korean": null,
   "korean": "⟦1⟧썬더애로우⟦2⟧의 설계도인 듯하다゜\n⟦P⟧"
  },
  {
   "key": "8178cdb238dc",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(⟦2⟧시술⟦3⟧로 물을 끓여서…゜\n결국 증기를 동력으로 쓰는 거네゜\n⟦P⟧하지만, 이 별의 문명 수준으로,\n용케 이 정도⟦4⟧문장⟦5⟧을 해석해냈네…゜\n⟦P⟧"
  },
  {
   "key": "def50e6f903d",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(⟦2⟧시술⟦3⟧로 전기를 발생시켜서…゜\n결국 빔 병기라는 거네゜\n⟦P⟧대단하네, 이 부분만은 거의 최적의\n⟦4⟧문장⟦5⟧ 조합이 이루어져 있어서\n낭비되는 공간이 전혀 없어゜\n⟦6⟧엘레나씨⟦7⟧의 설계인가?\n⟦P⟧"
  },
  {
   "key": "e6122d10727d",
   "speaker_korean": null,
   "korean": "신형으로 보이는\n내부 구조 도면이 붙어 있다゜\n⟦P⟧"
  },
  {
   "key": "b1aae86af89e",
   "speaker_korean": "신난 시술사",
   "korean": "⟦1⟧「어멋, 또야!\n하와와와와와…゜\n⟦P⟧"
  },
  {
   "key": "89021a2c5863",
   "speaker_korean": "디온",
   "korean": "「이게 봐 주셨으면 하는 것입니다゜"
  },
  {
   "key": "cb5544176f83",
   "speaker_korean": "클리프",
   "korean": "「대체, 이 녀석이 뭐가 문제란 거냐?"
  },
  {
   "key": "bbaf9995e0a5",
   "speaker_korean": "디온",
   "korean": "「장치로서는,\n거의 완성되어 있습니다만,\n병기로 쓰기엔 위력이 조금…゜\n그렇다고 해서,\n지금보다 출력을 더 올리면,\n내구성 면에서 문제가\n발생해 버려서요…゜"
  },
  {
   "key": "e0d666e0caf9",
   "speaker_korean": "페이트",
   "korean": "(이건……゜난감하네…\n이런 병기가 이 문명 수준의 행성에\n있어도 되는 걸까?\n명백히 오버 테크놀로지잖아゜"
  },
  {
   "key": "d8ec091c1bd4",
   "speaker_korean": "디온",
   "korean": "「어떻습니까? 이해가 되십니까?\n궁금한 점 있으면 답해드리겠습니다만゜"
  },
  {
   "key": "afea13d01c6c",
   "speaker_korean": "페이트",
   "korean": "「그건 괜찮은데……゜"
  },
  {
   "key": "56da60ed11e7",
   "speaker_korean": "디온",
   "korean": "「예, 전혀 상관없습니다゜\n마음껏 조사해 보세요゜"
  },
  {
   "key": "ba4b824b44fa",
   "speaker_korean": "페이트",
   "korean": "「미안゜\n조금 더 조사해도 될까?"
  },
  {
   "key": "668e4d351efc",
   "speaker_korean": "페이트",
   "korean": "(하지만, 이런 걸\n완성시켜 버려도 되는 걸까?\n아무리 ⟦1⟧미개행성보호조약⟦2⟧을\n신경 안 쓴다고 해도,\n이건 너무 위험한 것 같은데…゜"
  },
  {
   "key": "7d095cbdfdd9",
   "speaker_korean": "클리프",
   "korean": "「어이, 잠깐 괜찮냐?"
  },
  {
   "key": "3184c70f00d3",
   "speaker_korean": "페이트",
   "korean": "「왜 그래?"
  },
  {
   "key": "77dd21a45024",
   "speaker_korean": "클리프",
   "korean": "「이거, 위험한 거 아니냐?\n문외한인 나도 어렴풋이 알겠다゜"
  },
  {
   "key": "607015be334f",
   "speaker_korean": "페이트",
   "korean": "「그래……\n확실히 오버 테크놀로지야゜"
  },
  {
   "key": "bd07cfed8bb8",
   "speaker_korean": "클리프",
   "korean": "「어떡할 거냐? 완성시킬 거냐?"
  },
  {
   "key": "b9270a255c04",
   "speaker_korean": "페이트",
   "korean": "「솔직히 망설여지네゜\n넌 어떻게 생각해?"
  },
  {
   "key": "f618158c84d7",
   "speaker_korean": "클리프",
   "korean": "「나 말이냐? …그렇군゜\n이 병기를 만들면, 많은 인간이 죽어゜\n그걸 괜찮다고 볼 건지 아닌지겠지゜\n그 점에 관해서만 말하자면,\n난 스스로 책임 못 질 일은\n안 하는 주의다゜\n내가 직접 손을 쓰는 거라면 괜찮아゜\n하지만 내가 만든 병기로\n내가 아닌 놈이 그걸 저지른다는 건\n아무래도…말이지゜"
  },
  {
   "key": "a2f5fc20fdcf",
   "speaker_korean": "페이트",
   "korean": "「하지만 지금 우리가 돕지 않아도,\n문장 기술이 있는 이 나라라면\n언젠가 완성시켜 버릴지도 몰라゜"
  },
  {
   "key": "5885d16c8d9a",
   "speaker_korean": "클리프",
   "korean": "「그럴지도…잖아?"
  },
  {
   "key": "debfd7244b97",
   "speaker_korean": "클리프",
   "korean": "「뭐 됐다゜전에도 말했지만…\n이 건에 관해서는, 네가 정해゜"
  },
  {
   "key": "b2b531532a73",
   "speaker_korean": "페이트",
   "korean": "(응゜"
  },
  {
   "key": "0ba33a62d012",
   "speaker_korean": "페이트",
   "korean": "「난 이걸 완성시킬 거야゜"
  },
  {
   "key": "c3760401901a",
   "speaker_korean": "페이트",
   "korean": "(어떡할까?"
  },
  {
   "key": "c90ccba80abf",
   "speaker_korean": "클리프",
   "korean": "「네 특기인 ⟦1⟧미개행성보호조약⟦2⟧은\n신경 안 써도 되는 거냐?"
  },
  {
   "key": "bb0824f816a7",
   "speaker_korean": "페이트",
   "korean": "「분명 내가 만든 병기가\n사람을 불행하게 만들지도 몰라゜\n하지만…만들면 행복해질지도…아니,\n더 이상 불행한 사람이 늘지 않도록\n할 수 있을지도 몰라゜"
  },
  {
   "key": "058864b85ecf",
   "speaker_korean": "클리프",
   "korean": "「그런가…알았다゜\n그럼, 난 뭘 하면 되냐?"
  },
  {
   "key": "22eb613d4171",
   "speaker_korean": "페이트",
   "korean": "「어? 하지만, 싫은 거 아니었어……゜"
  },
  {
   "key": "607ad86034b8",
   "speaker_korean": "클리프",
   "korean": "「바보 같은 소리 하지 마゜\n안 도와준다곤 안 했잖냐?\n네가 각오를 다졌잖냐゜\n보호자인 내가 각오 안 하고\n어쩌자는 거냐゜"
  },
  {
   "key": "735d58c84c1c",
   "speaker_korean": "클리프",
   "korean": "「뭐, 나도 이런 데서\n개죽음당하고 싶진 않으니까゜\n얼른 끝내고,\n⟦1⟧통신기⟦2⟧ 만들어서 튀자고゜\n…아저씨 일도 있고 하니까゜\n서두르는 게 낫겠지゜"
  },
  {
   "key": "d682042134da",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧디온 씨⟦2⟧!"
  },
  {
   "key": "fb176d7e02c3",
   "speaker_korean": "디온",
   "korean": "「⟦1⟧디온⟦2⟧이라고 부르셔도 됩니다゜"
  },
  {
   "key": "13a8b4ab167c",
   "speaker_korean": "페이트",
   "korean": "「그럼 ⟦1⟧디온⟦2⟧゜\n이 병기의 설계도를 보여줬으면 해゜"
  },
  {
   "key": "706e699a89eb",
   "speaker_korean": "디온",
   "korean": "「무슨 일이신가요?"
  },
  {
   "key": "31e0c0d84268",
   "speaker_korean": "디온",
   "korean": "「아, 예゜\n개발실로 와 주십시오゜"
  },
  {
   "key": "ba435a6f6af1",
   "speaker_korean": null,
   "korean": "이런 것이 이 문명 수준의 행성에\n존재하는 것 자체가 이상하다゜"
  }
 ]
}