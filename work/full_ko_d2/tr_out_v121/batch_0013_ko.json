{
 "batch_id": "batch_0013",
 "translations": [
  {
   "key": "13b3a9b9f384",
   "speaker_korean": "기운찬 소녀",
   "korean": "⟦1⟧「시끄러~워!\n얍! 타앗!\n⟦P⟧"
  },
  {
   "key": "93d095c09d3f",
   "speaker_korean": null,
   "korean": "광산 마을 컬소어"
  },
  {
   "key": "fa7b3b320e73",
   "speaker_korean": null,
   "korean": "이 문은 현재 폐쇄되어 있다.\n억지로 돌파하기는 어려울 것 같다.\n⟦P⟧"
  },
  {
   "key": "0708279fbc54",
   "speaker_korean": "불만스러운 병사",
   "korean": "⟦1⟧「⟦2⟧질풍⟦3⟧의 단장이신 ⟦4⟧복스 님⟦5⟧께서\n내리신 명령에 따라, 이 마을의 출입은\n일절 금지되어 있다.\n⟦P⟧미안하군.\n내일까지는 ⟦6⟧월터 님⟦7⟧께서\n어떻게든 해 주실 테니,\n그때까지 참아 주게.\n⟦P⟧"
  },
  {
   "key": "6c2833167289",
   "speaker_korean": "불만스러운 병사",
   "korean": "⟦1⟧「이 앞에 무슨 볼일이 있는지는\n모르겠지만\n⟦P⟧⟦2⟧복스 님⟦3⟧께서 칙령으로 내리신 이상,\n그 명령은 국왕 폐하께서 내리신 것과\n같은 것이다.\n⟦P⟧미안하지만, 지금은 통과시켜 줄 수 없네.\n⟦P⟧"
  },
  {
   "key": "4c22698eec51",
   "speaker_korean": null,
   "korean": "아앗!\n분명 ⟦1⟧시하츠⟦2⟧ 사람들에게 붙잡혀서\n죽임을 당하고 만 게 틀림없어요.\n⟦P⟧"
  },
  {
   "key": "8cd41dad2fe1",
   "speaker_korean": null,
   "korean": "이 앞은 사유지이므로\n무단출입을 금한다.\n\n⟦1⟧아스톨・울프리히\n⟦P⟧"
  },
  {
   "key": "55e3ad47727f",
   "speaker_korean": null,
   "korean": "이 앞은 폐쇄된 철광맥 터.\n위험!\n즉시 돌아가라, 접근 금지.\n⟦P⟧"
  },
  {
   "key": "5838cdeaf039",
   "speaker_korean": "병사",
   "korean": "⟦1⟧「⟦2⟧월터 님⟦3⟧이라면,\n국왕 폐하와 함께 ⟦4⟧시하츠⟦5⟧로\n떠나셨습니다.\n⟦P⟧"
  },
  {
   "key": "fdf54b5802d2",
   "speaker_korean": "수다스러운 병사",
   "korean": "⟦1⟧「이곳은 이 ⟦2⟧컬소어 마을⟦3⟧을\n다스리시는 ⟦4⟧월터 님⟦5⟧의\n저택이다.\n⟦P⟧허나 ⟦6⟧월터 님⟦7⟧은 지금 이 마을을\n비우고 계신다.\n따라서 이 앞의 저택에 가도\n만나실 수는 없소이다.\n⟦P⟧"
  },
  {
   "key": "f39d19105ed9",
   "speaker_korean": "병사",
   "korean": "⟦1⟧「⟦2⟧월터 님⟦3⟧이라면,\n저택 쪽에 계십니다.\n⟦P⟧"
  },
  {
   "key": "c59d66e9c2e8",
   "speaker_korean": "신앙심 깊은 노인",
   "korean": "⟦1⟧「당당히 신께 기도하는 것조차\n허락되지 않다니.\n참으로 고약한 세상이 되어 버렸구려.\n⟦P⟧내가 할 수 있는 일이라곤\n남몰래 마음속으로 계속 믿는 것,\n그저 그것뿐이라오.\n⟦P⟧"
  },
  {
   "key": "a31890ac175d",
   "speaker_korean": "소녀",
   "korean": "⟦1⟧「아~앙. 하지 마~.\n정말, 너무 싫어!\n⟦P⟧"
  },
  {
   "key": "f4b89580e689",
   "speaker_korean": "소녀",
   "korean": "⟦1⟧「아~앙. 하지 마~.\n정말 싫다니까아.\n⟦P⟧"
  },
  {
   "key": "bf9ef636e842",
   "speaker_korean": "소녀",
   "korean": "⟦1⟧「요즘 있지.\n⟦2⟧월터 님⟦3⟧이 자주 외출을 하셔.\n⟦P⟧전에는 맨날 친구들이 잔뜩\n저택에 놀러 왔었는데,\n지금은 하나도 안 오게 됐어.\n⟦P⟧"
  },
  {
   "key": "8a7b242b027a",
   "speaker_korean": "소녀",
   "korean": "⟦1⟧「나는 ⟦2⟧시하츠⟦3⟧의\n⟦4⟧시술사⟦5⟧인데 말이야,\n나쁜 사람이 아니야.\n⟦P⟧그러니까 심술은\n이제 안 부린대.\n⟦P⟧"
  },
  {
   "key": "2db813b74e0a",
   "speaker_korean": "소녀",
   "korean": "⟦1⟧「나는 ⟦2⟧성왕국 시하츠⟦3⟧의 여왕.\n⟦4⟧로메리아・진・에뮤릴 님⟦5⟧이야.\n⟦P⟧그대들에게 빛의 축복을\n내려 주겠어요.\n에~잇! 반짝반짝반짝~!\n⟦P⟧"
  },
  {
   "key": "7203bc185061",
   "speaker_korean": "조숙한 소녀",
   "korean": "⟦1⟧「나는 있지, 마물 같은 거\n하나도 안 무서워.\n⟦P⟧왜냐면.\n피트가 지켜 준다고\n약속해 줬으니까.\n⟦P⟧"
  },
  {
   "key": "fb05e446d96d",
   "speaker_korean": "기운이 넘치는 소년",
   "korean": "⟦1⟧「나는 ⟦2⟧칠흑⟦3⟧의 부단장\n⟦4⟧무쇠팔 셸비 님⟦5⟧이다!\n⟦P⟧⟦6⟧시하츠⟦7⟧의 나쁜 녀석.\n⟦8⟧크림슨 블레이드⟦9⟧의\n⟦10⟧넬・젤퍼⟦11⟧ 놈!\n⟦P⟧이 몸이 처단해 주마!\n얍! 얍!\n⟦P⟧"
  },
  {
   "key": "83b81cdab33b",
   "speaker_korean": "기운이 넘치는 소년",
   "korean": "⟦1⟧「나는 ⟦2⟧질풍⟦3⟧의 단장\n⟦4⟧복스 공작님⟦5⟧이다!\n⟦P⟧⟦6⟧시하츠⟦7⟧의 나쁜 녀석.\n⟦8⟧크림슨 블레이드⟦9⟧의\n⟦10⟧클레어・라즈버드⟦11⟧ 놈!\n⟦P⟧이 몸이 처단해 주마!\n얍! 얍!\n⟦P⟧"
  },
  {
   "key": "3e2c7ef25cc2",
   "speaker_korean": "기운이 넘치는 소년",
   "korean": "⟦1⟧「어떠냐, 항복이냐!\n⟦2⟧셸비 님⟦3⟧은 강하다고!\n⟦P⟧"
  },
  {
   "key": "9f0eeecad354",
   "speaker_korean": "기운이 넘치는 소년",
   "korean": "⟦1⟧「봤냐!\n이 ⟦2⟧복스 님⟦3⟧은\n정말로 강하지!\n⟦P⟧"
  },
  {
   "key": "7b5d1ce66468",
   "speaker_korean": "마을 사람TG8 『큰 힌트』",
   "korean": "⟦1⟧「여기는 광산과 장인의 마을\n⟦2⟧컬소어⟦3⟧야.\n⟦P⟧⟦4⟧아페리스교⟦5⟧의 신들은\n⟦6⟧모젤의 고대 유적⟦7⟧에서 나타나\n다시 ⟦8⟧모젤의 고대 유적⟦9⟧으로\n떠나갔다고 하던데\n⟦P⟧지금 세상을 어지럽히는 마물들은\n대체 어디서 온 걸까?\n어딘가에 드나드는 곳이 있을 것\n같긴 한데 말이야.\n⟦P⟧"
  },
  {
   "key": "0a4a7c291cc6",
   "speaker_korean": "마을 사람TG7 『촌장 대리』",
   "korean": "⟦1⟧「여기는 광산과 장인의 마을\n⟦2⟧컬소어⟦3⟧야.\n⟦P⟧아니….\n예전에는 그랬다고\n해야 하려나?\n⟦P⟧지금은 아무 특별할 것 없는\n평범한 마을이지.\n⟦P⟧"
  },
  {
   "key": "fdeb2781d0cd",
   "speaker_korean": "마을 사람TG6 『길 안내』",
   "korean": "⟦1⟧「여기는 광산과 장인의 마을\n⟦2⟧컬소어⟦3⟧야.\n⟦P⟧서쪽으로 가면 ⟦4⟧아리그리프 시⟦5⟧.\n동쪽으로 가면 ⟦6⟧성왕국 시하츠⟦7⟧의\n⟦8⟧아리아스 마을⟦9⟧이지.\n⟦P⟧북쪽 ⟦10⟧컬소어 산 동굴⟦11⟧을 지나가면\n⟦12⟧베크렐 광산⟦13⟧이나 ⟦14⟧바르 산맥⟦15⟧ 근처로\n나갈 수 있을 거야.\n⟦P⟧"
  },
  {
   "key": "57ddf0457d01",
   "speaker_korean": "마을 사람TG5 『우물가 회의』",
   "korean": "⟦1⟧「여기는 광산과 장인의 마을\n⟦2⟧컬소어⟦3⟧야.\n⟦P⟧그나저나….\n요전의 전쟁은 정말 큰일이었지.\n⟦P⟧그대로 ⟦4⟧별의 배⟦5⟧가 날뛰었다면,\n이 마을도 위험했을 게\n분명하니까.\n⟦P⟧"
  },
  {
   "key": "fc59daaec994",
   "speaker_korean": "마을 사람TG1 『주소 불명』",
   "korean": "⟦1⟧「여기는 광산과 장인의 마을\n⟦2⟧컬소어⟦3⟧야.\n⟦P⟧아니….\n예전에는 그랬다고\n해야 하려나?\n⟦P⟧지금은 아무 특별할 것 없는\n평범한 마을이지.\n⟦P⟧"
  },
  {
   "key": "fff51701acbf",
   "speaker_korean": "마을 사람TG2 『지나가던 사람』",
   "korean": "⟦1⟧「여기는 광산과 장인의 마을\n⟦2⟧컬소어⟦3⟧야.\n⟦P⟧아니….\n예전에는 그랬다고\n해야 하려나?\n⟦P⟧지금은 아무 특별할 것 없는\n평범한 마을이지.\n⟦P⟧"
  },
  {
   "key": "099e104eff34",
   "speaker_korean": "마을 사람TG3 『평범한 마을 사람』",
   "korean": "⟦1⟧「여기는 광산과 장인의 마을\n⟦2⟧컬소어⟦3⟧야.\n⟦P⟧아니….\n예전에는 그랬다고\n해야 하려나?\n⟦P⟧지금은 아무 특별할 것 없는\n평범한 마을이지.\n⟦P⟧"
  },
  {
   "key": "706af9769aef",
   "speaker_korean": "마을 사람TG4 『집주인』",
   "korean": "⟦1⟧「여기는 광산과 장인의 마을\n⟦2⟧컬소어⟦3⟧야.\n⟦P⟧아니….\n예전에는 그랬다고\n해야 하려나?\n⟦P⟧지금은 아무 특별할 것 없는\n평범한 마을이지.\n⟦P⟧"
  },
  {
   "key": "4ba396c12dd0",
   "speaker_korean": "마을 사람TG1 『주소 불명』",
   "korean": "⟦1⟧「그러고 보니, 아까 엄청난 기세로\n마차가 지나가던데\n무슨 일이라도 있는 걸까?\n⟦P⟧"
  },
  {
   "key": "521b84564d04",
   "speaker_korean": "수다스러운 병사",
   "korean": "⟦1⟧「이곳은 이 ⟦2⟧컬소어 마을⟦3⟧을 다스리시는\n⟦4⟧월터 님⟦5⟧의 저택입니다.\n⟦6⟧월터 님⟦7⟧이라면, 지금은 저택의\n자기 방에서 집무를 보고 계시지요.\n⟦P⟧"
  },
  {
   "key": "f50059c746d5",
   "speaker_korean": "넬",
   "korean": "「여기가 ⟦1⟧컬소어⟦2⟧야.\n이 마을만 지나가면\n시하츠 영토로 들어갈 수 있어."
  },
  {
   "key": "bcf31ad4f1ea",
   "speaker_korean": "넬",
   "korean": "「괜찮아?"
  },
  {
   "key": "2cd950706cd8",
   "speaker_korean": "클리프",
   "korean": "「무리하지 말라고.\n약해 빠졌으니까 말이야, 넌."
  },
  {
   "key": "3f4ffaab6eb5",
   "speaker_korean": "페이트",
   "korean": "「너까지 무시하고 그래….\n괜찮다고 말했잖아."
  },
  {
   "key": "9368fbac91f2",
   "speaker_korean": "클리프",
   "korean": "「괜찮아 보이지 않으니까\n하는 말이잖냐."
  },
  {
   "key": "db5a3f977762",
   "speaker_korean": "넬",
   "korean": "「원래대로라면, 이대로 마을을\n빠져나가고 싶은 참이지만….\n어쩔 수 없지.\n오늘은 여관에서 묵기로 할까."
  },
  {
   "key": "a7b185c70239",
   "speaker_korean": "클리프",
   "korean": "「추격대는 괜찮은 거냐?"
  },
  {
   "key": "4bb5bc76dd3f",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧타이네브 일행⟦2⟧이 미끼가 되어 주고\n있으니까 괜찮을 거라고 생각해….\n낙관할 수는 없지만.\n다만, 몸이 안 좋은 사람을 무리시켜서\n나중에 고생하는 것보다는 나을 테니까."
  },
  {
   "key": "e32a37203f1b",
   "speaker_korean": "클리프",
   "korean": "「하긴 그렇지."
  },
  {
   "key": "9eb390662cf0",
   "speaker_korean": "넬",
   "korean": "「마침 잘된 게, 여관은 바로 저기\n있거든.\n바로 저기 마차가 있는 건물이야."
  },
  {
   "key": "7216a9b3bc34",
   "speaker_korean": "페이트",
   "korean": "「…괜찮다니까요."
  },
  {
   "key": "fda27684e9f0",
   "speaker_korean": "넬",
   "korean": "「가 볼까."
  },
  {
   "key": "9c697ef6a219",
   "speaker_korean": "페이트",
   "korean": "(저건…?"
  },
  {
   "key": "7582a64cd875",
   "speaker_korean": "페이트",
   "korean": "(역시 그랬어."
  },
  {
   "key": "619f9e3eec4e",
   "speaker_korean": "페이트",
   "korean": "(…이런 곳에서,\n대체 뭘 하고 있는 거지?"
  },
  {
   "key": "f9bb8682a59c",
   "speaker_korean": "???",
   "korean": "「―――하고 있습니다."
  },
  {
   "key": "d24fd8448026",
   "speaker_korean": "넬",
   "korean": "「그래…\n여전히 비겁한 놈들이네."
  },
  {
   "key": "91ea1b1964db",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧질풍⟦2⟧의 짓이야?"
  },
  {
   "key": "88cd0a77eea5",
   "speaker_korean": "???",
   "korean": "「아뇨, ⟦1⟧칠흑⟦2⟧인 것 같습니다.\n물론 ⟦3⟧질풍⟦4⟧도 협력은 하고 있는 듯합니다만."
  },
  {
   "key": "2c1f8f471933",
   "speaker_korean": "넬",
   "korean": "「그래. 수고했어."
  },
  {
   "key": "eb85522312bf",
   "speaker_korean": "???",
   "korean": "「부디 쓸데없는 생각은\n하지 말아 주십시오.\n그녀들도 바라던 바―――."
  },
  {
   "key": "37cdba07ce68",
   "speaker_korean": "넬",
   "korean": "「가 봐."
  },
  {
   "key": "55f4345f83c9",
   "speaker_korean": "???",
   "korean": "「옛."
  },
  {
   "key": "4264bfadaa6a",
   "speaker_korean": "넬",
   "korean": "「!? 쉿!!"
  },
  {
   "key": "c9de8b0699a7",
   "speaker_korean": "넬",
   "korean": "「무슨 일이야,\n이런 곳까지 와서."
  },
  {
   "key": "870205a88b49",
   "speaker_korean": "페이트",
   "korean": "「아뇨, 지나가다가\n모습이 보여서요."
  },
  {
   "key": "de4c164465a0",
   "speaker_korean": "페이트",
   "korean": "「……방금 그 사람은?"
  },
  {
   "key": "d3f8a381aec2",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧컬소어⟦2⟧에 잠복시켜 둔 내 부하야.\n……정기 연락이지."
  },
  {
   "key": "5c1c49882a52",
   "speaker_korean": "페이트",
   "korean": "「무슨 일 있어요?\n심각한 얼굴을 하고 있던데…."
  },
  {
   "key": "69bcb0ab0000",
   "speaker_korean": "넬",
   "korean": "「딱히 설명할 정도의\n일은 아니야.\n추격대가 이 마을에 다가오고 있다는 걸\n알게 된 정도랄까."
  },
  {
   "key": "fb3f7d96e2a2",
   "speaker_korean": "페이트",
   "korean": "「그것뿐이에요?"
  },
  {
   "key": "259775b7521d",
   "speaker_korean": "넬",
   "korean": "「그래……왜 그러는데?"
  },
  {
   "key": "819158228904",
   "speaker_korean": "페이트",
   "korean": "「아뇨, 딱히 이유가\n있는 건 아닌데요…."
  },
  {
   "key": "2ba2204ebe14",
   "speaker_korean": "넬",
   "korean": "「……내일은 아침 일찍 떠날 거야.\n그렇게 느긋하게 있을 수는\n없을 것 같으니까."
  },
  {
   "key": "c970ce4f8ac2",
   "speaker_korean": null,
   "korean": "⟦1⟧520폴⟦2⟧을 손에 넣었다."
  },
  {
   "key": "ddffadb6ef08",
   "speaker_korean": null,
   "korean": "⟦1⟧완숙 베리⟦2⟧를 손에 넣었다."
  },
  {
   "key": "7d7e34cefb9c",
   "speaker_korean": null,
   "korean": "⟦1⟧초숙성 베리⟦2⟧를 손에 넣었다."
  }
 ]
}