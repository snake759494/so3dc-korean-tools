{
 "batch_id": "batch_0134",
 "translations": [
  {
   "key": "b31ac409c342",
   "speaker_korean": null,
   "korean": "⟦1⟧듀얼 아머⟦2⟧를 손에 넣었다."
  },
  {
   "key": "f0aaf84350f5",
   "speaker_korean": null,
   "korean": "⟦1⟧스파이크 슈즈⟦2⟧를 손에 넣었다."
  },
  {
   "key": "cd125f2e2a0d",
   "speaker_korean": null,
   "korean": "⟦1⟧룬 클로크⟦2⟧를 손에 넣었다."
  },
  {
   "key": "8b7b4229f765",
   "speaker_korean": null,
   "korean": "⟦1⟧레이저 실드⟦2⟧를 손에 넣었다."
  },
  {
   "key": "cf6fc6cd8120",
   "speaker_korean": null,
   "korean": "문베이스 거주구역"
  },
  {
   "key": "ead9498b1742",
   "speaker_korean": "COM",
   "korean": "『침입자 경보, 침입자 경보.\n본 시설 내 침입자 확인."
  },
  {
   "key": "962ccfb65d05",
   "speaker_korean": "클리프",
   "korean": "「우리 얘긴 아니겠지?"
  },
  {
   "key": "1f46c9b71321",
   "speaker_korean": "페이트",
   "korean": "「아… 아닌 것 같아."
  },
  {
   "key": "d1e7bfdb3213",
   "speaker_korean": "소피아",
   "korean": "「천…사?"
  },
  {
   "key": "f02c1f982d15",
   "speaker_korean": "대변자",
   "korean": "「나는 ⟦1⟧집행자⟦2⟧의 ⟦3⟧대변자⟦4⟧다.\n네놈들을 멸해야 할 존재이니라."
  },
  {
   "key": "e846f64b2039",
   "speaker_korean": "마리아",
   "korean": "「저게 신의 사자,\n⟦1⟧엑스큐셔너⟦2⟧라는 녀석인가?"
  },
  {
   "key": "26007a777479",
   "speaker_korean": "알벨",
   "korean": "「흥, 거창한 놈이군."
  },
  {
   "key": "bdef31522e4d",
   "speaker_korean": "페이트",
   "korean": "「너희들 목적이 대체 뭐냐!?"
  },
  {
   "key": "f784de25e2bd",
   "speaker_korean": "대변자",
   "korean": "「⟦1⟧집행자⟦2⟧는 더러운 세계를 정화하는 존재,\n⟦3⟧대변자⟦4⟧는 더러움을 숙청하는 존재이니라.\n⟦P⟧멸하라… 세계를 오염시키는 이물들이여."
  },
  {
   "key": "4c4f3e4df81d",
   "speaker_korean": "로저",
   "korean": "「뭐야… 저 녀석?\n등에 날개가 돋아났잖아… 이상한 놈!"
  },
  {
   "key": "8b28de91c764",
   "speaker_korean": "넬",
   "korean": "「신의 사자……인가."
  },
  {
   "key": "f824517f3151",
   "speaker_korean": "대변자",
   "korean": "「나…는 지…행…자의 대…변자…"
  },
  {
   "key": "782c790fa82a",
   "speaker_korean": "스프레",
   "korean": "「타아아아앗!!!!"
  },
  {
   "key": "f56e636e65f1",
   "speaker_korean": "대변자",
   "korean": "「우매한 자에게 죽음과 소멸을…영겁 지옥을…"
  },
  {
   "key": "27acad12d7db",
   "speaker_korean": "스프레",
   "korean": "「흥! 꼴 좋다, 그치!\n뭐, 이 몸한테 걸리면\n이런 녀석쯤은―――."
  },
  {
   "key": "c33c1d9719a7",
   "speaker_korean": "소피아",
   "korean": "「엣?!\n⟦1⟧스프레⟦2⟧!?"
  },
  {
   "key": "16ae9814a274",
   "speaker_korean": "페이트",
   "korean": "「어떻게 여기에!?"
  },
  {
   "key": "29fdfb27bc1e",
   "speaker_korean": "넬",
   "korean": "「이런, 이런."
  },
  {
   "key": "23f4b787dc4b",
   "speaker_korean": "로저",
   "korean": "「아, 아까 그 녀석!"
  },
  {
   "key": "3ae64c37a551",
   "speaker_korean": "스프레",
   "korean": "「기다리라고 했었는데 말이야,\n왠지 참을 수가 없어서\n⟦P⟧다들이랑 단장님 말도 안 듣고,\n뛰쳐나와 버렸어."
  },
  {
   "key": "1b2394e305bf",
   "speaker_korean": "스프레",
   "korean": "「에헤헤."
  },
  {
   "key": "b55464f720e8",
   "speaker_korean": "마리아",
   "korean": "「…기가 막히네."
  },
  {
   "key": "2e4157823af0",
   "speaker_korean": "넬",
   "korean": "「'에헤헤' 할 때가 아니야.\n정말이지… 다짜고짜 공격을 하다니\n그건 무모함을 넘어서 만용이야."
  },
  {
   "key": "ca6e2db4fa98",
   "speaker_korean": "알벨",
   "korean": "「'에헤헤' 할 때가 아니잖아.\n정말 무모한 애송이로군…\n과연 네놈들 지인이라 할 만하군."
  },
  {
   "key": "bb94acdd1eff",
   "speaker_korean": "로저",
   "korean": "「귀여운 척해봤자 소용없어.\n이건 어른들의 싸움이라고.\n애가 낄 문제가 아니라고!"
  },
  {
   "key": "db1489bfc711",
   "speaker_korean": "클리프",
   "korean": "「네놈한테 듣고 싶진 않은데,\n그 대사는 말이지.\n그래서… 어떡할 거냐?"
  },
  {
   "key": "e95e15169f0e",
   "speaker_korean": "페이트",
   "korean": "「'어떡할 거냐'고 해도… 참."
  },
  {
   "key": "8a2adb838ed3",
   "speaker_korean": "스프레",
   "korean": "「좋잖아, 좋잖아.\n나도 같이 데려가 줘어.\n도움 될 거야, 내・가・말・이・야."
  },
  {
   "key": "44b4a4e7fea0",
   "speaker_korean": "마리아",
   "korean": "「글쎄."
  },
  {
   "key": "9e3eb6c882dd",
   "speaker_korean": "소피아",
   "korean": "「하지만, 저 아이 혼자서\n여기서 돌려보낼 수도 없잖아…"
  },
  {
   "key": "2e7fd014ef84",
   "speaker_korean": "마리아",
   "korean": "「혼자서 올 수 있었으니까,\n돌아가는 것도 문제없겠지."
  },
  {
   "key": "76fad70ca473",
   "speaker_korean": "소피아",
   "korean": "「그건 그럴지도 모르지만…"
  },
  {
   "key": "fc8d64ac7e98",
   "speaker_korean": "넬",
   "korean": "「자, 어떻게 할까?\n…돌려보낼까?"
  },
  {
   "key": "71fff60285e5",
   "speaker_korean": "로저",
   "korean": "「어떡할 거야, 형?"
  },
  {
   "key": "202a65d86fbc",
   "speaker_korean": "페이트",
   "korean": "「어쩔 수 없지…\n얌전히 있어야 한다."
  },
  {
   "key": "fa5e9fcf185f",
   "speaker_korean": "페이트",
   "korean": "「이제 와서 '괜찮아?'는 아니잖아,\n여기까지 와 놓고 말이야.\n그리고 여기서 너를 혼자 보내는 것도\n마음에 걸리고…\n그렇다면 적어도 여기 있는 동안은\n같이 행동하는 편이 안전하겠지."
  },
  {
   "key": "cc9c34a65eb4",
   "speaker_korean": "마리아",
   "korean": "「뭐, 맞는 말이지만."
  },
  {
   "key": "66dbfda2a6b9",
   "speaker_korean": "로저",
   "korean": "「뭐, 어쩔 수 없잖냐."
  },
  {
   "key": "e4c863e81de4",
   "speaker_korean": "스프레",
   "korean": "「해냈다! 야호!\n잘 부탁해, 얘들아!"
  },
  {
   "key": "c0ddc483e539",
   "speaker_korean": "페이트",
   "korean": "「말해두겠는데,\n여기 있는 동안만이야!"
  },
  {
   "key": "5e3b55e3b88b",
   "speaker_korean": "소피아",
   "korean": "「다들한테 폐 끼치면 안 돼…\n정말……"
  },
  {
   "key": "199a16f7b07c",
   "speaker_korean": "스프레",
   "korean": "「괜찮아, 괜찮다니까!\n다 맡겨두라구!!"
  },
  {
   "key": "3f8764dfe5dc",
   "speaker_korean": "소피아",
   "korean": "「정말이지?"
  },
  {
   "key": "e86ef7d0d8c4",
   "speaker_korean": "마리아",
   "korean": "「글쎄, 정말일지."
  },
  {
   "key": "5005546dfd48",
   "speaker_korean": "넬",
   "korean": "「그러길 바라야겠네."
  },
  {
   "key": "bbb7e9be7279",
   "speaker_korean": "알벨",
   "korean": "「또 바보가 하나 늘어난 모양이군."
  },
  {
   "key": "46f7ceda5a71",
   "speaker_korean": "로저",
   "korean": "「아직 못 믿겠는데……\n뭐, 어쩔 수 없나.\n진짜 제대로 일하라고!"
  },
  {
   "key": "e2c07e5fa14f",
   "speaker_korean": "스프레",
   "korean": "「자, 힘내서 가보자~!"
  },
  {
   "key": "2767e139a808",
   "speaker_korean": "스프레",
   "korean": "「진짜?!\n⟦1⟧페이트⟦2⟧!?"
  },
  {
   "key": "eded44886cd5",
   "speaker_korean": "클리프",
   "korean": "「수상한데."
  },
  {
   "key": "a328849f9b63",
   "speaker_korean": null,
   "korean": "⟦1⟧레이저 프로텍터⟦2⟧를 손에 넣었다."
  },
  {
   "key": "322f114001aa",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 1⟦2⟧을 손에 넣었다."
  }
 ]
}