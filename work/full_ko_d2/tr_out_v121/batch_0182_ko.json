{
 "batch_id": "batch_0182",
 "translations": [
  {
   "key": "2a409a313650",
   "speaker_korean": "페이트",
   "korean": "「모두!?"
  },
  {
   "key": "399d6235cff3",
   "speaker_korean": "소피아",
   "korean": "「살려…줘…."
  },
  {
   "key": "0c3baa2c44f6",
   "speaker_korean": "페이트",
   "korean": "「으아아아아아아아---앗!!"
  },
  {
   "key": "6b36fea6c8c8",
   "speaker_korean": null,
   "korean": "긴급 피난통로 전송실"
  },
  {
   "key": "0fbf2f3b4f67",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧이 앞에⟦2⟧피난 시설⟦3⟧이 있으려나?\n가자, ⟦4⟧페이트⟦5⟧야.\n⟦P⟧"
  },
  {
   "key": "52521b312e7f",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(이⟦2⟧트랜스포터⟦3⟧는\n일방통행으로 설정되어 있군.\n⟦P⟧설정을 건드리지 않는 한\n호텔로 돌아가는 건 무리인 것 같다.\n⟦P⟧"
  },
  {
   "key": "60b527e32162",
   "speaker_korean": "세이브 포인트에 대하여",
   "korean": "⟦1⟧지금 화면에 보이는, 이 빛나는 물체가\n세이브 포인트입니다.\n이 세이브 포인트는, 주인공이 다가가면\n작동합니다.\n⟦P⟧이 세이브 포인트는, 주로 여관이나\n던전 내부에 존재하기 때문에,\n세이브를 하고 싶어졌을 때는\n이 세이브 포인트 심볼에 다가가서,\n⟦P⟧심볼이 변화한 것을 확인한 후에\n버튼을 눌러 캠프 화면으로 이동한 후,\n메인 메뉴에서 카드를 선택하는 것으로\n게임 데이터를 세이브해 주십시오.\n⟦P⟧"
  },
  {
   "key": "763935009560",
   "speaker_korean": "클리프",
   "korean": "「어이 어이, 이제 와서 의심하겠다는 거냐?"
  },
  {
   "key": "c183c8116606",
   "speaker_korean": "클리프",
   "korean": "「못 믿겠냐?"
  },
  {
   "key": "679a0a554625",
   "speaker_korean": "페이트",
   "korean": "「처음 질문에 대한 답을\n들려주세요."
  },
  {
   "key": "5cbee3b20d34",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧문장술⟦2⟧이라는 게 뭐냐?"
  },
  {
   "key": "7b1b63849a87",
   "speaker_korean": "넬",
   "korean": "「그래서 우리는 ⟦1⟧시술⟦2⟧을 이용한 무기를\n개발하기로 했어.\n⟦3⟧시술⟦4⟧로 만들어낸 특수한 에너지를 모아서,\n인공적인 무기의 에너지원으로\n사용하는 거야."
  },
  {
   "key": "a05cd9d5b06f",
   "speaker_korean": "넬",
   "korean": "「기술자들은 그 에너지를\n⟦1⟧영력⟦2⟧이라고 불렀다더군."
  },
  {
   "key": "9db4a553eb7f",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧영력⟦2⟧?"
  },
  {
   "key": "69d9a4383746",
   "speaker_korean": "페이트",
   "korean": "「그러니까, ⟦1⟧영력⟦2⟧을 이용한\n무기 개발에 힘을 보태라는 겁니까?"
  },
  {
   "key": "5593bcdfa140",
   "speaker_korean": "페이트",
   "korean": "「게다가 저한테는 느긋하게 있을\n시간이 없어요."
  },
  {
   "key": "5bee2b7cc5cc",
   "speaker_korean": "넬",
   "korean": "「하지만 그건 당신 사정이지,\n우리랑은 상관없는 얘기잖아."
  },
  {
   "key": "b8815e2ae544",
   "speaker_korean": "페이트",
   "korean": "「그건 그렇지만요."
  },
  {
   "key": "0bae609ddfd7",
   "speaker_korean": "페이트",
   "korean": "「그렇다고 해서 제가 무기를\n만들 이유가 되지는 않잖아요."
  },
  {
   "key": "d56c359b4b9b",
   "speaker_korean": "넬",
   "korean": "「약속을 어기겠다는 거냐?"
  },
  {
   "key": "445727d58ceb",
   "speaker_korean": "페이트",
   "korean": "「그건 협박이잖아요."
  },
  {
   "key": "c42bd665292c",
   "speaker_korean": "페이트",
   "korean": "「그건…."
  },
  {
   "key": "e02592dd6ac8",
   "speaker_korean": "넬",
   "korean": "「가령 우리가 당신들을\n포기한다고 쳐도, ⟦1⟧아리그리프⟦2⟧는 어쩔 건데?"
  },
  {
   "key": "c0bd4b610a46",
   "speaker_korean": "페이트",
   "korean": "「그들 말도 듣지 않겠죠.\n당연한 일이잖아요."
  },
  {
   "key": "bbea3f0fae85",
   "speaker_korean": "페이트",
   "korean": "「…네. 이미 경험해 봤어요.\n걱정 마세요."
  },
  {
   "key": "f739d6b5d419",
   "speaker_korean": "페이트",
   "korean": "「그게 ⟦1⟧아페리스교⟦2⟧의 가르침인가요?"
  },
  {
   "key": "6f7ce9fc50fa",
   "speaker_korean": "넬",
   "korean": "「아니면 당신은 우리더러\n순순히 죽으라는 거냐?"
  },
  {
   "key": "5822ceb6277e",
   "speaker_korean": "넬",
   "korean": "「당신이 하는 말은 결국 그런 소리야."
  },
  {
   "key": "24ed5f2bc655",
   "speaker_korean": "페이트",
   "korean": "「그건 당신들의 논리일 뿐이잖――."
  },
  {
   "key": "29f9aa62cb4f",
   "speaker_korean": "파린",
   "korean": "「추격자예요오!\n아마 ⟦1⟧질풍⟦2⟧일 거라고 생각하는데요오!!"
  },
  {
   "key": "bd0206b8faed",
   "speaker_korean": "파린",
   "korean": "「저희라면 괜찮아요오!\n어떻게든 따돌릴 테니까요!"
  },
  {
   "key": "2a47b5b7a8bc",
   "speaker_korean": "페이트",
   "korean": "「그래도!"
  },
  {
   "key": "8060b40c3498",
   "speaker_korean": "타이네브",
   "korean": "「⟦1⟧페이트 씨⟦2⟧."
  },
  {
   "key": "53ed4496e12b",
   "speaker_korean": "파린",
   "korean": "「네에! 어떻게든 해볼게요오!\n⟦1⟧아페리스⟦2⟧의 가호가 있기를!"
  },
  {
   "key": "053d1b9a5f5b",
   "speaker_korean": "클리프",
   "korean": "「야, 이 예쁜 아가씨들\n소개는 안 해줄 거냐?"
  },
  {
   "key": "5a8b26c8750a",
   "speaker_korean": "클리프",
   "korean": "「불만은 없다만,\n죄다 여자뿐이구먼."
  },
  {
   "key": "cf5c943dffad",
   "speaker_korean": "넬",
   "korean": "「그건 우리나라의 특징이지.\n⟦1⟧시하츠⟦2⟧는 ⟦3⟧아페리스교⟦4⟧의 성녀가\n다스리는 나라니까.\n⟦5⟧아리그리프⟦6⟧에 비해 일하는 여성이 많은 거야."
  },
  {
   "key": "24775b2849c6",
   "speaker_korean": "넬",
   "korean": "「…이 아이는 ⟦1⟧타이네브⟦2⟧,\n마부석에 있는 게 ⟦3⟧파린⟦4⟧.\n내 직속 부하야.\n⟦5⟧아리그리프⟦6⟧에 잠입해서 정보를 모으는 게\n주된 임무지.\n당신들에 대해 보고해 온 게\n바로 이 아이들이야."
  },
  {
   "key": "6a3a1899db20",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아페리스교⟦2⟧?"
  },
  {
   "key": "076c277a4677",
   "speaker_korean": "타이네브",
   "korean": "「⟦1⟧아버지 신 아페리스⟦2⟧를 신봉하는 가르침입니다.\n저희 나라 ⟦3⟧시하츠⟦4⟧는,\n⟦5⟧아페리스교⟦6⟧의 성녀이시기도 한\n여왕 폐하께서 다스리고 계십니다."
  },
  {
   "key": "26adb439a1cb",
   "speaker_korean": "페이트",
   "korean": "「종교 국가인가…."
  },
  {
   "key": "b926a66ab348",
   "speaker_korean": "클리프",
   "korean": "「그렇군.\n무녀들이 잔뜩 있다는 느낌인가.\n거참 가는 게 기대되는구먼."
  },
  {
   "key": "fc8229f0509c",
   "speaker_korean": "페이트",
   "korean": "「그런데 ⟦1⟧넬 씨⟦2⟧,\n아까 그 질문의 답,\n이제 슬슬 들려주실 수 없을까요?"
  },
  {
   "key": "bcc017588741",
   "speaker_korean": "넬",
   "korean": "「그렇지.\n근데 그 전에 나도 하나 물어봐도 될까?"
  },
  {
   "key": "06d28d15912f",
   "speaker_korean": "페이트",
   "korean": "「뭔가요?"
  },
  {
   "key": "4d35ae7d32f1",
   "speaker_korean": "넬",
   "korean": "「당신들은 정말로\n⟦1⟧그리텐⟦2⟧의 기술자인 거냐?"
  },
  {
   "key": "7d91fcd168b0",
   "speaker_korean": "페이트",
   "korean": "「어, 저기…."
  },
  {
   "key": "facde8c8237b",
   "speaker_korean": "클리프",
   "korean": "「하지만 그건 믿어주는 수밖에 없어.\n애초에, 우리가 너한테 거짓말해서\n뭔 득이 있겠냐?\n⟦1⟧아리그리프⟦2⟧의 스파이라도 된다는 거냐?\n그거참 재밌는 농담이군."
  },
  {
   "key": "cdf6f3a8810f",
   "speaker_korean": "넬",
   "korean": "「뭐, 그건 그렇다만."
  },
  {
   "key": "058021341f73",
   "speaker_korean": "넬",
   "korean": "「아니, 믿어.\n뭐, 어느 쪽이든 당신들을\n데려오라고 폐하께 명령받았거든.\n안 데려갈 수는 없는 노릇이지."
  },
  {
   "key": "cd5dc0788cb9",
   "speaker_korean": "페이트",
   "korean": "「…그래서, ⟦1⟧넬 씨⟦2⟧."
  },
  {
   "key": "161f45f64d63",
   "speaker_korean": "넬",
   "korean": "「그랬었지.\n당신들은 이 지역 사정에 어두운 듯하니,\n구체적인 얘기는 지금 상황을 곁들여서\n설명해줄게."
  },
  {
   "key": "22dbf2e805fa",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧타이네브⟦2⟧, 지도 꺼내봐."
  },
  {
   "key": "bac9822ebab6",
   "speaker_korean": "타이네브",
   "korean": "「예."
  },
  {
   "key": "96d49b008447",
   "speaker_korean": "넬",
   "korean": "「여기가 아까까지 있던 도시, ⟦1⟧아리그리프⟦2⟧야.\n이 선보다 서쪽이 ⟦3⟧군사국가 아리그리프⟦4⟧.\n동쪽이 우리나라, ⟦5⟧시하츠⟦6⟧고.\n…여기까지는 됐지?"
  },
  {
   "key": "353ed49da469",
   "speaker_korean": "넬",
   "korean": "「전에도 말했듯이, 우리나라 ⟦1⟧시하츠⟦2⟧와\n여기 ⟦3⟧아리그리프⟦4⟧는 지금 전쟁 상태야.\n⟦5⟧아리그리프⟦6⟧는 힘을 숭배하는 무공의 나라.\n그에 반해 우리 ⟦7⟧시하츠⟦8⟧는\n⟦9⟧아페리스교⟦10⟧를 신앙하는 나라지."
  },
  {
   "key": "282fd999b533",
   "speaker_korean": "넬",
   "korean": "「몇 년 전까지는 ⟦1⟧시하츠⟦2⟧와 ⟦3⟧아리그리프⟦4⟧는\n우호 관계였어.\n…근데 그놈들은 어느 날 갑자기\n시하츠 영내로 침공해 왔지."
  },
  {
   "key": "4c84d7ad80d5",
   "speaker_korean": "넬",
   "korean": "「그런 거지.\n그놈들은 무력을 앞세워 힘으로 밀어붙여\n쳐들어왔어.\n우리도 저항했지만, 아무래도 물량이\n너무 차이 났지.\n결과적으로 어떻게든 밀어내긴 했지만,\n전장이 된 국경 마을 ⟦1⟧아리아스⟦2⟧는\n만신창이가 되어버렸어."
  },
  {
   "key": "2d32af1eff6e",
   "speaker_korean": "넬",
   "korean": "「다만 우리도 일방적으로\n당하고만 있는 건 아니야.\n물량으로는 못 당하지만,\n우리한테는 ⟦1⟧시술⟦2⟧이 있으니까."
  }
 ]
}