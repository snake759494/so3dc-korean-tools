{
 "batch_id": "batch_0153",
 "translations": [
  {
   "key": "1e5b66dc27da",
   "speaker_korean": "미라쥬",
   "korean": "「조심하세요.\n최대한 빨리 합류할 수 있도록 할게요."
  },
  {
   "key": "542c1011cd56",
   "speaker_korean": "클리프",
   "korean": "「준비는 됐냐?"
  },
  {
   "key": "8c3de3587ab7",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧미라쥬 씨⟦3⟧,\n⟦4⟧에리클 2호성⟦5⟧이란\n어떤 별인가요?\n⟦P⟧"
  },
  {
   "key": "d894422f9d3b",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「에리클 성계의 두 번째 행성으로\n자전축 기울기는 32.6도\n그리고 항성 거리는 0.8⟦2⟧천문단위⟦3⟧,\n중력은 0.9G입니다.\n⟦P⟧질소 대신 대기 대부분을\n네온을 중심으로 한 희가스족이\n차지하고 있다는 점 외에는,\n⟦4⟧지구⟦5⟧와 비슷한 ⟦6⟧대기 조성⟦7⟧을\n가지고 있어요.\n⟦P⟧이 행성의 기술 수준은\n⟦8⟧지구⟦9⟧로 치면 중세 후기…\n17세기 중반 정도라고 데이터에는\n나와 있어요.\n⟦P⟧⟦10⟧미개발 행성⟦11⟧으로 성도에는 등록되어\n있지만, 전란이 끊이지 않는 별인지\n지적 생명체의 총수까지는 기재되어\n있지 않아요.\n⟦P⟧"
  },
  {
   "key": "e4274ec30ffe",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「하필이면 ⟦2⟧미개발 행성⟦3⟧이라니…\n⟦P⟧"
  },
  {
   "key": "82747d1e76f2",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「우리가 지금 있는 지점 정보 같은 건\n없나요?\n⟦P⟧"
  },
  {
   "key": "80ae4fe6d7ca",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「일단 지적 생명체가 서식하는\n지역인 듯해요.\n⟦P⟧국가 체계 같은 자세한 건\n알 수 없지만, 꽤 큰\n도시네요.\n⟦P⟧외부 기온은 영하 5도.\n강설 및 적설이 확인되고\n있어요.\n⟦P⟧"
  },
  {
   "key": "4fe8b8a5bda5",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「도시라고요…\n⟦P⟧"
  },
  {
   "key": "8d5530ccff40",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「그리고, 이 별에는\n크게 나눠 두 개의 대륙이\n있는 것 같아요.\n⟦P⟧지금 저희가 있는 대륙과\n그 동쪽에 있는 대륙,\n이렇게 둘이에요.\n⟦P⟧다소 동쪽 대륙 쪽이\n문명 수준은 높은 것\n같습니다만…\n⟦P⟧"
  },
  {
   "key": "4cc61b25a01e",
   "speaker_korean": "미라쥬",
   "korean": "⟦1⟧「이 함의 데이터베이스에는,\n이 이상의 정보는 없네요.\n⟦P⟧"
  },
  {
   "key": "22e6706aeab2",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그 밖에 뭔가 알 수 있는 건\n없나요?\n⟦P⟧"
  },
  {
   "key": "e1b70a622460",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「자, 진정해.\n허둥댄다고 상황이 바뀌는 것도 아니잖아.\n⟦P⟧"
  },
  {
   "key": "5680d060225e",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「신경 쓰는 성격이구나, 너는.\n⟦P⟧"
  },
  {
   "key": "277034d15612",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「그럴지도 모르지.\n⟦P⟧"
  },
  {
   "key": "340aabb43e79",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「진정하라니, 그게 안 되잖아.\n⟦2⟧미개발 행성⟦3⟧ 도시 한복판에\n우주선으로 처박았다고!?\n⟦P⟧⟦4⟧미개발 행성 보호조약⟦5⟧ 위반\n정도가 아니야.\n아아…\n⟦P⟧"
  },
  {
   "key": "0918461fddb4",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧클리프⟦3⟧가 너무 신경을\n안 쓰는 거야!\n⟦P⟧"
  },
  {
   "key": "05211a9160fd",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「자, 진정하라고.\n허둥댄다고 상황이 바뀌는 것도 아니잖아.\n⟦P⟧"
  },
  {
   "key": "5c4546e88a5d",
   "speaker_korean": null,
   "korean": "소형 고속함 이글"
  },
  {
   "key": "ceeeeb744fa2",
   "speaker_korean": null,
   "korean": "문에는 잠금장치가 걸려 있다.\n⟦P⟧"
  },
  {
   "key": "abfcc4027d0e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(그렇게 쉽게 열릴 것 같지는\n않지만,\n⟦P⟧그렇다고 이대로는\n밖으로 나갈 수도 없잖아.\n⟦P⟧"
  },
  {
   "key": "be695370d8c1",
   "speaker_korean": "클리프",
   "korean": "「자, 슬슬 날려볼까.\n공주님이 기다리고 계시겠지.\n합류 포인트는\n⑤E747E372E406이었지.\n⟦1⟧미라쥬⟦2⟧, 부탁한다."
  },
  {
   "key": "1efebf7618dd",
   "speaker_korean": "미라쥬",
   "korean": "「예."
  },
  {
   "key": "854df5f8e9c2",
   "speaker_korean": "여성의 목소리",
   "korean": "「어서 오세요."
  },
  {
   "key": "b61bc534c00c",
   "speaker_korean": "페이트",
   "korean": "(예쁜 사람이네…"
  },
  {
   "key": "007d681b49a5",
   "speaker_korean": "클리프",
   "korean": "「그 녀석은 오퍼레이터인 ⟦1⟧미라쥬⟦2⟧다.\n내 파트너지.\n이 배에 관한 건 저 녀석한테 맡겨뒀어.\n⟦3⟧미라쥬⟦4⟧, 이쪽이 타깃이다."
  },
  {
   "key": "97b99ba93653",
   "speaker_korean": "미라쥬",
   "korean": "「네, 한눈에 알아봤어요.\n잘 부탁드려요, ⟦1⟧페이트⟦2⟧ 씨.\n⟦3⟧미라쥬・코스트⟦4⟧예요."
  },
  {
   "key": "a281e5c4db2c",
   "speaker_korean": "페이트",
   "korean": "「저, 저야말로."
  },
  {
   "key": "1fa7db516900",
   "speaker_korean": "클리프",
   "korean": "「왜 그래, ⟦1⟧페이트⟦2⟧?"
  },
  {
   "key": "60ba018e3c0f",
   "speaker_korean": "클리프",
   "korean": "「기다리게 했군."
  },
  {
   "key": "a9db632e2f82",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧미라쥬⟦2⟧한테 반한 거냐?\n관둬, 관둬.\n저래 봬도 ⟦3⟧클라우스트로인⟦4⟧이야.\n이상한 마음 먹었다간 되레 당하는 게\n뻔하다고."
  },
  {
   "key": "7eb76e737907",
   "speaker_korean": "미라쥬",
   "korean": "「통상 엔진, 시동…\n⟦1⟧중력 워프 코어⟦2⟧, 문제없습니다."
  },
  {
   "key": "cfb36d367417",
   "speaker_korean": "클리프",
   "korean": "「부끄러워하긴, 부끄러워하긴."
  },
  {
   "key": "a23b91829fc6",
   "speaker_korean": "미라쥬",
   "korean": "「적 ⟦1⟧일리미네이트 캐논⟦2⟧ 1차 사격은\n회피했습니다."
  },
  {
   "key": "c50b4cd85305",
   "speaker_korean": "클리프",
   "korean": "「좋아, ⟦1⟧중력 워프⟦2⟧ 기동!!"
  },
  {
   "key": "8de16516ebfd",
   "speaker_korean": "클리프",
   "korean": "「서두르지 않아도 곧 만날 수 있을 거야.\n합류 지점까지는 앞으로 3시간 정도니까.\n⟦1⟧미라쥬⟦2⟧,\n난 샤워라도 좀 하고 올게.\n나머진 맡긴다."
  },
  {
   "key": "b6876203f128",
   "speaker_korean": "미라쥬",
   "korean": "「저기…⟦1⟧클리프⟦2⟧,\n안타깝지만, 그건 무리인 것 같네요."
  },
  {
   "key": "0995ff8f20e3",
   "speaker_korean": "클리프",
   "korean": "「응? 왜 그래?"
  },
  {
   "key": "c938f7d9e5e8",
   "speaker_korean": "미라쥬",
   "korean": "「전방에 중력 공간 이상이 발생했습니다.\n당함은 이상 회피를 위해\n⟦1⟧중력 워프 공간⟦2⟧에서 이탈합니다."
  },
  {
   "key": "1d01e8c82ae1",
   "speaker_korean": "클리프",
   "korean": "「진짜냐…… 적인가?"
  },
  {
   "key": "550935bbaa15",
   "speaker_korean": "미라쥬",
   "korean": "「통상 공간으로 복귀했습니다.\n…400A000, 전방에\n반데인 전투함 2척을 탐지."
  },
  {
   "key": "07d6aaf2ba11",
   "speaker_korean": "페이트",
   "korean": "「어, 아, 아니야!\n그런 거 아니라니까!"
  },
  {
   "key": "8632e9921f34",
   "speaker_korean": "페이트",
   "korean": "「저기… 그게……\n⟦1⟧쿼크⟦2⟧ 리더가 있는 지점까지\n어느 정도 시간이 걸릴까?"
  },
  {
   "key": "3345504b97dd",
   "speaker_korean": "클리프",
   "korean": "「매복하고 있었나.\n젠장, 연방함이 아니어도 노려지는 거냐.\n…통신 회선을 열어라."
  },
  {
   "key": "e348689757ae",
   "speaker_korean": "미라쥬",
   "korean": "「알겠습니다."
  },
  {
   "key": "536ca9c2791d",
   "speaker_korean": "미라쥬",
   "korean": "「접속 확인… OK, 회선 엽니다."
  },
  {
   "key": "6d90bb987a5e",
   "speaker_korean": "클리프",
   "korean": "「어, 음… 흠흠.\n여기는 ⟦1⟧클라우스트로⟦2⟧ 소속 ⟦3⟧이글⟦4⟧이다.\n우리는 귀함들의 적이 아닐 텐데…"
  },
  {
   "key": "8b098c8d727b",
   "speaker_korean": "클리프",
   "korean": "「짐을 눈치챈 모양이군.\n그럼 도망칠 수밖에 없나.\n⟦1⟧중력 워프⟦2⟧를 못 쓴다면…\n어쩔 수 없지, 통상 엔진 풀파워로\n반전!!"
  },
  {
   "key": "796c3756cea5",
   "speaker_korean": "클리프",
   "korean": "「후방 실드를 전개 최대로 해라!\n그리고, 이 근처 성도를 띄워라!!"
  },
  {
   "key": "dbe05837bc15",
   "speaker_korean": "클리프",
   "korean": "「좋아, 코스 116 마크 267이다!\n자동 회피 프로그램을 기동!\n전원 벨트를 채워라!!"
  },
  {
   "key": "8540d50609bc",
   "speaker_korean": "클리프",
   "korean": "「나머진 운에 맡길 수밖에 없겠군."
  },
  {
   "key": "1ef45e9965df",
   "speaker_korean": "페이트",
   "korean": "「으왓!!"
  },
  {
   "key": "4e1c7b06ef5f",
   "speaker_korean": "미라쥬",
   "korean": "「목표 지점에 접근."
  },
  {
   "key": "434d4c465444",
   "speaker_korean": "클리프",
   "korean": "「좋아, 목표 지점에 도달과 동시에\n⟦1⟧중력 워프⟦2⟧."
  },
  {
   "key": "ceea8375dd05",
   "speaker_korean": "미라쥬",
   "korean": "「⟦1⟧클리프⟦2⟧,\n⟦3⟧중력 워프⟦4⟧는 현재 사용 불가능합니다만."
  },
  {
   "key": "4cfdddc81842",
   "speaker_korean": "클리프",
   "korean": "「내 감이 틀리지 않았다면,\n그 순간만은 쓸 수 있게 될 거다.\n반데인 함과 행성을 이은 직선…\n그 방향을 항성 쪽으로 날아 단숨에 거리를 벌린다."
  },
  {
   "key": "d9639999a00a",
   "speaker_korean": "미라쥬",
   "korean": "「하지만… 그렇게 하면\n저희도 워프 목적지 지정을\n할 수 없습니다만."
  },
  {
   "key": "2877461d06a7",
   "speaker_korean": "클리프",
   "korean": "「어차피 이대로 가봤자 궁지에 몰릴 뿐이다.\n그렇다면, 한판 걸어보는 것도 나쁘지 않지.\n뭐, 우주는 넓으니까.\n승산 없는 도박은 아닐 거다."
  },
  {
   "key": "3ca30b200d71",
   "speaker_korean": "페이트",
   "korean": "「감이라니…"
  },
  {
   "key": "e710010267ee",
   "speaker_korean": "미라쥬",
   "korean": "「적, 2차 사격을 발사했습니다.\n4발 접근 중입니다."
  },
  {
   "key": "4c95151a2b42",
   "speaker_korean": "클리프",
   "korean": "「4발인가.\n이쪽이 ⟦1⟧중력 워프⟦2⟧에 들어가는 게 먼저냐,\n피탄되는 게 먼저냐…\n그다음은 신만이 아는 거지."
  },
  {
   "key": "ec391f87e0a7",
   "speaker_korean": "미라쥬",
   "korean": "「안타깝지만,\n내기에는 진 것 같아요.\n다 피하지는 못합니다.\n1발이 명중합니다.\n목표 지점까지 앞으로 7초."
  },
  {
   "key": "32d3a8df6bcf",
   "speaker_korean": "클리프",
   "korean": "「신경 쓸 거 없다!\n맞아도 무시해! 무시!!\n예정대로 ⟦1⟧중력 워프⟦2⟧로 단숨에 도망쳐라!!"
  }
 ]
}