{
 "batch_id": "batch_0079",
 "translations": [
  {
   "key": "21796b957da0",
   "speaker_korean": null,
   "korean": "어라, 못 들은 건가?\n아니면 못 들은 척이라도\n하는 건가?\n⟦P⟧"
  },
  {
   "key": "daeae784ea7a",
   "speaker_korean": "자작급 건방진 도련님",
   "korean": "⟦1⟧「적당히 좀 하게, 자네!\n정말이지…\n무지에도 정도가 있는 법이라네.\n⟦P⟧"
  },
  {
   "key": "ecae25386642",
   "speaker_korean": "자작급 건방진 도련님",
   "korean": "⟦1⟧「정말이지…\n요즘 젊은이들이 이렇게까지\n어리석을 줄은 몰랐다네.\n⟦P⟧"
  },
  {
   "key": "5f085a104b0e",
   "speaker_korean": "자작급 건방진 도련님",
   "korean": "⟦1⟧「자, 그럼…\n미녀와의 우아한 만찬도\n이제 슬슬 끝나가는 모양이군.\n⟦P⟧아쉽기 그지없네만,\n시간의 흐름이란 대개\n잔혹한 법이라네.\n⟦P⟧"
  },
  {
   "key": "a32f36b16a96",
   "speaker_korean": "자작급 건방진 도련님",
   "korean": "⟦1⟧「자, 그럼…\n미녀와의 우아한 만찬도\n이제 슬슬 끝인가 보군.\n⟦P⟧아쉬운 마음이 없진 않지만,\n시간의 흐름이라는 것은\n잔혹한 법이니까.\n⟦P⟧"
  },
  {
   "key": "c825e4154663",
   "speaker_korean": null,
   "korean": "숙박 명부인 모양이다.\n⟦P⟧"
  },
  {
   "key": "2f2cc6282d3e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(너무 빤히\n쳐다보면 안 되겠지…\n⟦P⟧"
  },
  {
   "key": "0b3e6e367593",
   "speaker_korean": null,
   "korean": "호텔 손님에게 맡은 귀중품 등의\n기록되어 있다.\n⟦P⟧"
  },
  {
   "key": "01433ee3c9e7",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(너무 오래 보고 있으면\n의심받을 텐데…\n⟦P⟧"
  },
  {
   "key": "f5733d132420",
   "speaker_korean": "호텔 직원",
   "korean": "⟦1⟧「이곳에서는 귀중품을\n맡아 드리고 있습니다.\n⟦P⟧또한, 저희 호텔에서는\n불필요한 문제를 막기 위해\n숙박 시 이곳에서 손님께서\n지니고 계신\n⟦P⟧모든 무기를 맡아\n드리도록 하고 있습니다.\n양해 부탁드립니다.\n⟦P⟧"
  },
  {
   "key": "00d15df736b9",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(왠지 우리 이름으로\n매일 예약이 들어오고 있는데…\n⟦P⟧"
  },
  {
   "key": "1ba6bf480b9b",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(우리는 딱히 맡기지 않아도\n된다는 얘기던데…\n⟦P⟧"
  },
  {
   "key": "c0e87011b1ff",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「의자에 앉아만 있어도\n되는 거냐?\n지금 전쟁 중이라고!\n⟦P⟧"
  },
  {
   "key": "bf8387e9b0b7",
   "speaker_korean": "호텔 접수원",
   "korean": "⟦1⟧「어서 오세요.\n오늘 묵으실 건가요?\n⟦P⟧숙박하신다면,\n1박에 ⟦2⟧300폴⟦3⟧입니다.\n⟦P⟧"
  },
  {
   "key": "2666fdcd4125",
   "speaker_korean": "호텔 접수원",
   "korean": "⟦1⟧「방은 항상 비워 두고 있으니,\n언제든 편하실 때 오세요.\n⟦P⟧"
  },
  {
   "key": "8feee70d0d9d",
   "speaker_korean": "호텔 접수원",
   "korean": "⟦1⟧「잘 주무셨나요?\n방은 항상 비워 두고 있으니\n편하실 때 오세요.\n⟦P⟧"
  },
  {
   "key": "8be00513cf70",
   "speaker_korean": "호텔 접수원",
   "korean": "⟦1⟧「어젯밤은 즐거우셨나 보네요.\n방은 항상 비워 두고 있으니\n편하실 때 오세요.\n⟦P⟧"
  },
  {
   "key": "d9de23740fb3",
   "speaker_korean": null,
   "korean": "⟦1⟧・밉다."
  },
  {
   "key": "c42f7c718808",
   "speaker_korean": null,
   "korean": "⟦1⟧・별로."
  },
  {
   "key": "73b387d0c872",
   "speaker_korean": null,
   "korean": "⟦1⟧・쉬겠다."
  },
  {
   "key": "61950530d941",
   "speaker_korean": null,
   "korean": "⟦1⟧・그럴 시간 없습니다."
  },
  {
   "key": "152af3fcd984",
   "speaker_korean": null,
   "korean": "⟦1⟧・너무 비싸서 안 묵는다."
  },
  {
   "key": "829354dc93af",
   "speaker_korean": "호텔 접수원",
   "korean": "⟦1⟧「그럼 방으로\n안내해 드리겠습니다.\n⟦P⟧"
  },
  {
   "key": "303297c644de",
   "speaker_korean": "호텔 접수원",
   "korean": "⟦1⟧「죄송합니다만,\n소지금이 부족하신\n것 같네요.\n⟦P⟧그럼, 다음 방문을\n기다리고 있겠습니다.\n⟦P⟧"
  },
  {
   "key": "618ab7851325",
   "speaker_korean": "호텔 접수원",
   "korean": "⟦1⟧「어서 오세요.\n오늘 묵으실 건가요?\n⟦P⟧숙박하신다면,\n1박에 ⟦2⟧3000폴⟦3⟧입니다.\n⟦P⟧"
  },
  {
   "key": "11673570311b",
   "speaker_korean": "호텔 접수원",
   "korean": "⟦1⟧「그럼, 다음 방문을\n기다리고 있겠습니다.\n⟦P⟧"
  },
  {
   "key": "ebdcb39a628a",
   "speaker_korean": "레이디 G",
   "korean": "⟦1⟧「드디어 전쟁이 끝난 건가요?\n이걸로 드디어 프라다의\n봄 신작을 손에 넣겠군요.\n⟦P⟧"
  },
  {
   "key": "a735450a83ad",
   "speaker_korean": "넬",
   "korean": "「숙소 수속은 끝났어.\n언제든 쉴 수 있어."
  },
  {
   "key": "660e8eb8b7c1",
   "speaker_korean": "클리프",
   "korean": "「아아… 걱정 마."
  },
  {
   "key": "a2e0575a11e9",
   "speaker_korean": "넬",
   "korean": "「걱정되니까 말하는 거잖아."
  },
  {
   "key": "0ce78748e6ba",
   "speaker_korean": "넬",
   "korean": "「이 마을은 교역으로 붐비는 만큼\n다른 마을보다 질 나쁜 놈들도 많아.\n너 같은 타입은\n시비 걸리기 쉬우니까."
  },
  {
   "key": "f141f5a1b919",
   "speaker_korean": "클리프",
   "korean": "「괜찮다니까.\n뭐, 그렇게 되면 그렇게 되는 대로\n반격해서 손봐주면 그만이지."
  },
  {
   "key": "8c36c92bcfd4",
   "speaker_korean": "넬",
   "korean": "「바보……\n그게 걱정된다는 거잖아."
  },
  {
   "key": "6802cb3f2810",
   "speaker_korean": "클리프",
   "korean": "「지당하신 말씀."
  },
  {
   "key": "a87bcea7d982",
   "speaker_korean": "넬",
   "korean": "「하아…… 그럼, 다녀올게.\n밤까지는 돌아올 테니까."
  },
  {
   "key": "4c319f85465b",
   "speaker_korean": "클리프",
   "korean": "「그럼 난 술집에나\n다녀올까.\n너도 적당히 돌아다니다 와라."
  },
  {
   "key": "11d310e96bf3",
   "speaker_korean": "클리프",
   "korean": "「이 녀석은 몰라도,\n내가 그런 짓을 할 것 같냐?"
  },
  {
   "key": "132f43941f1e",
   "speaker_korean": "페이트",
   "korean": "「그래, 그렇게 할게."
  },
  {
   "key": "830f3570b0ab",
   "speaker_korean": "호텔 접수원",
   "korean": "「편히 쉬세요."
  },
  {
   "key": "fe883553099f",
   "speaker_korean": "넬",
   "korean": "「나는 마을 부하들에게 다녀올게.\n마을을 돌아다니는 건 상관없지만,\n제발 말썽은 일으키지 마."
  },
  {
   "key": "334d7e6d0ffa",
   "speaker_korean": "페이트",
   "korean": "「이봐… 왜 하필 나야."
  }
 ]
}