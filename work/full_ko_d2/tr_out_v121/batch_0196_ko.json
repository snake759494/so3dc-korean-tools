{
 "batch_id": "batch_0196",
 "translations": [
  {
   "key": "ca7d0b32c1f4",
   "speaker_korean": null,
   "korean": "⟦1⟧스킬북[어택스펠]⟦2⟧을 손에 넣었다"
  },
  {
   "key": "b357ba49730b",
   "speaker_korean": null,
   "korean": "⟦1⟧링 메일⟦2⟧을 손에 넣었다"
  },
  {
   "key": "f7a61a75950c",
   "speaker_korean": null,
   "korean": "⟦1⟧전사의 팔찌⟦2⟧를 얻었다"
  },
  {
   "key": "10839a348580",
   "speaker_korean": null,
   "korean": "⟦1⟧프로즌 체크⟦2⟧를 손에 넣었다"
  },
  {
   "key": "c562ba3d11af",
   "speaker_korean": "클리프",
   "korean": "「야, 무슨 일이야?"
  },
  {
   "key": "32cd07e9d253",
   "speaker_korean": "페이트",
   "korean": "「아니,\n땅이 얼어붙어 있어."
  },
  {
   "key": "1e09c3e766c1",
   "speaker_korean": "클리프",
   "korean": "「음~?"
  },
  {
   "key": "b26b6de55249",
   "speaker_korean": "클리프",
   "korean": "「이거…,\n조심해서 걷지 않으면 위험하겠는걸."
  },
  {
   "key": "6cd07cde967b",
   "speaker_korean": "클리프",
   "korean": "「또 덩치 큰 놈이\n나타나셨구만."
  },
  {
   "key": "f476ae47f267",
   "speaker_korean": "넬",
   "korean": "「아마 여기 오랫동안 눌러앉은\n『왕』인지도 모르겠네."
  },
  {
   "key": "3bce1bd2eb13",
   "speaker_korean": "페이트",
   "korean": "「후…\n그럭저럭 쓰러뜨렸네."
  },
  {
   "key": "0a394d2228f2",
   "speaker_korean": "넬",
   "korean": "「저런 게 눌러앉아 있었다니\n나도 놀랐어."
  },
  {
   "key": "e21a81680603",
   "speaker_korean": "넬",
   "korean": "「여기까지 걸어온 거리를 생각하면\n출구까지 얼마 안 남았을 거야."
  },
  {
   "key": "72bb1ef2cd61",
   "speaker_korean": null,
   "korean": "⟦1⟧마광석⟦2⟧을 얻었다"
  },
  {
   "key": "b0dcf1a8cc18",
   "speaker_korean": "페이트",
   "korean": "「저기서 빠져나오긴 했는데\n이제 돌아갈 수는 없겠어."
  },
  {
   "key": "651cd66f3cb1",
   "speaker_korean": "페이트",
   "korean": "「여긴…?"
  },
  {
   "key": "1e1e21fbc3e7",
   "speaker_korean": "넬",
   "korean": "「거리 지하에 뻗어 있는\n지하수로야."
  },
  {
   "key": "eb162299bb81",
   "speaker_korean": "넬",
   "korean": "「지금 ⟦1⟧아리그리프⟦2⟧ 주변은 겨울이니까.\n너희도 봤잖아?\n밖엔 눈이 내리고 있어.\n얼음 정도 얼어도 이상할 거 없지."
  },
  {
   "key": "a021f45c682c",
   "speaker_korean": "클리프",
   "korean": "「그랬었지."
  },
  {
   "key": "1c44637f7cb1",
   "speaker_korean": "넬",
   "korean": "「조심하도록 해.\n물속에 빠지기라도 하면\n바로 동상에 걸릴 거야."
  },
  {
   "key": "61e26fd9460b",
   "speaker_korean": "클리프",
   "korean": "「무섭구먼, 그거."
  },
  {
   "key": "10e542c9223e",
   "speaker_korean": "넬",
   "korean": "「가자.\n여기를 빠져나가면\n거리로 나갈 수 있어."
  },
  {
   "key": "d11841f299c7",
   "speaker_korean": "클리프",
   "korean": "「지하수로라…"
  },
  {
   "key": "999b38e000fd",
   "speaker_korean": "클리프",
   "korean": "「야,\n얼음 얼었어, 여기."
  },
  {
   "key": "0655b456175b",
   "speaker_korean": "페이트",
   "korean": "「이쪽에서는 문이\n열리지 않는 것 같아."
  },
  {
   "key": "416f2b13f351",
   "speaker_korean": "페이트",
   "korean": "「전송 방해 장치를 파괴하고\n⟦1⟧비위그⟦2⟧를 쓰러뜨리지 않으면…\n여기서 나갈 수는 없어."
  },
  {
   "key": "a5d51f9090e1",
   "speaker_korean": "클리프",
   "korean": "「아무도 없잖아.\n설마 벌써 끝나버린 거\n아니겠지."
  },
  {
   "key": "9a45aa39ea70",
   "speaker_korean": "페이트",
   "korean": "「그런 말\n하지 마."
  },
  {
   "key": "ad67643a5498",
   "speaker_korean": "페이트",
   "korean": "「후우."
  },
  {
   "key": "473157eeedfb",
   "speaker_korean": "클리프",
   "korean": "「별거 아닌 놈들이잖아.\n이런 것들만 나오면 편할 텐데."
  },
  {
   "key": "11de3a487a35",
   "speaker_korean": "페이트",
   "korean": "「방심은 금물이잖아."
  },
  {
   "key": "a2c19c52acf4",
   "speaker_korean": "클리프",
   "korean": "「알고 있다니까."
  },
  {
   "key": "3998d5b7731d",
   "speaker_korean": "클리프",
   "korean": "「날 누구라고\n생각하는 거야."
  },
  {
   "key": "809950c8e865",
   "speaker_korean": "페이트",
   "korean": "「잠겨 있는 것 같아.\n열릴 것 같지 않네."
  },
  {
   "key": "43d7188d3031",
   "speaker_korean": "페이트",
   "korean": "「그 여자아이에게 받은\n열쇠를 쓰자."
  },
  {
   "key": "e67a0b974682",
   "speaker_korean": "페이트",
   "korean": "「저건…!"
  },
  {
   "key": "1a6d6e20f99f",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧넬씨⟦2⟧!?"
  },
  {
   "key": "48990231f270",
   "speaker_korean": "클리프",
   "korean": "「이거 위험한데,\n밀리고 있잖아."
  },
  {
   "key": "0cb47b30c339",
   "speaker_korean": "페이트",
   "korean": "「도와야 해!!"
  },
  {
   "key": "19ae7c3bd409",
   "speaker_korean": "클리프",
   "korean": "「그래!"
  },
  {
   "key": "6365b3c187e4",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧페이트⟦2⟧!!\n⟦3⟧클리프⟦4⟧!!\n왜 여기 있는 거야!?"
  },
  {
   "key": "a18b561b7e36",
   "speaker_korean": "클리프",
   "korean": "「그런 건 나중이야!!"
  },
  {
   "key": "c460ac48fc89",
   "speaker_korean": "페이트",
   "korean": "「일단 가세하겠습니다!!"
  },
  {
   "key": "d504eff54800",
   "speaker_korean": "넬",
   "korean": "「너희들, 어째서 여기에!?\n⟦1⟧시랜드⟦2⟧까지 가면 자유로워질 텐데!?"
  },
  {
   "key": "9c5001807d55",
   "speaker_korean": "페이트",
   "korean": "「예.\n⟦1⟧클레어씨⟦2⟧에게 들었습니다."
  },
  {
   "key": "d49b7bf530c1",
   "speaker_korean": "넬",
   "korean": "「그럼 왜!?"
  },
  {
   "key": "b0e2518827e2",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧넬씨⟦2⟧, 당신의 임무는\n저희를 왕도까지 데려가는 것\n아니었습니까?\n임무를 중간에 내팽개쳐도 됩니까?"
  },
  {
   "key": "f050349198d3",
   "speaker_korean": "넬",
   "korean": "「그건―――――."
  },
  {
   "key": "0780ddf22c20",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧클리프⟦2⟧…"
  },
  {
   "key": "9240deb1704d",
   "speaker_korean": "페이트",
   "korean": "「어쨌든 이런저런 불만은 있지만,\n먼저 ⟦1⟧타이네브씨 일행⟦2⟧을 도웁시다.\n전부는 그다음입니다."
  },
  {
   "key": "dca5ccf5510c",
   "speaker_korean": "클리프",
   "korean": "「뭐, 우리 셋이서 덤비면\n여기 놈들 따위야 별거 아니지."
  },
  {
   "key": "043e4dedc637",
   "speaker_korean": "넬",
   "korean": "「…미안하네."
  },
  {
   "key": "4a5e072e17b0",
   "speaker_korean": "클리프",
   "korean": "「나도 동감이다.\n대체 인사도 없이 가버리는 것도\n마음에 안 드는군."
  }
 ]
}