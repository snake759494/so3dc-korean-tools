{
 "batch_id": "batch_0255",
 "translations": [
  {
   "key": "b956ae675feb",
   "speaker_korean": null,
   "korean": "계약한 크리에이터가 없으시네요?"
  },
  {
   "key": "69171378f662",
   "speaker_korean": null,
   "korean": "효율화를 꾀해서 더 나은 개발을 목표로 삼아 주세요."
  },
  {
   "key": "f7c467d8a681",
   "speaker_korean": null,
   "korean": "일정 관리도 힘드시겠네요."
  },
  {
   "key": "90ec083e0c17",
   "speaker_korean": null,
   "korean": "개발 자금은 괜찮으신가요?"
  },
  {
   "key": "8e28e03e590a",
   "speaker_korean": null,
   "korean": "적재적소죠, 하지만 가끔은\n⟦P⟧개인 의견도 들어주셨으면 좋겠어요."
  },
  {
   "key": "d82d24474bc1",
   "speaker_korean": null,
   "korean": "어머나, 강권 발동인가요~?"
  },
  {
   "key": "0ca97d8ec976",
   "speaker_korean": null,
   "korean": "크리에이터 겸 사장님이라니, 바쁘시겠네요."
  },
  {
   "key": "00195d558cd8",
   "speaker_korean": null,
   "korean": "당신은 개발에 전념해 주세요.\n⟦P⟧유통은 저희가 책임지고 맡을 테니까요."
  },
  {
   "key": "fb28766c3ce2",
   "speaker_korean": null,
   "korean": "요즘 피곤하지 않으세요? 납기는 괜찮으신가요?"
  },
  {
   "key": "642bdefc3a72",
   "speaker_korean": null,
   "korean": "3년간 제대로 된 휴가가 없다는 게,\n⟦P⟧어떤 기분일까요?\n⟦P⟧"
  },
  {
   "key": "6317b3bab404",
   "speaker_korean": null,
   "korean": "제멋대로인 크리에이터에겐 단호한 태도로, 알았죠!"
  },
  {
   "key": "8b27193abe39",
   "speaker_korean": null,
   "korean": "이건 이른바 편리한 명령이니까,\n⟦P⟧적극적으로 활용해 주세요."
  },
  {
   "key": "3898f8101a2c",
   "speaker_korean": null,
   "korean": "너무 많이 설정하면 시끄러울지도 몰라요."
  },
  {
   "key": "1c5c766b263f",
   "speaker_korean": null,
   "korean": "이건 휴대폰이 싫은 사람에게는\n⟦P⟧안 맞는 시스템이네요(웃음)"
  },
  {
   "key": "0d193fbcc6b8",
   "speaker_korean": null,
   "korean": "역시 크리에이터의 동향이 신경 쓰이시나요?"
  },
  {
   "key": "132506490f01",
   "speaker_korean": null,
   "korean": "유능한 크리에이터의 계약금은 비싸니까,\n⟦P⟧무턱대고 스카우트하는 것도 문제죠."
  },
  {
   "key": "12aa1d3893fa",
   "speaker_korean": null,
   "korean": "계약 크리에이터는 스스로 특허 신청을 하지 않으니까,\n⟦P⟧제대로 지시해 주세요."
  },
  {
   "key": "e8ede9392c9f",
   "speaker_korean": null,
   "korean": "특허 신청을 하고 싶은 아이템은 어느 것인가요?"
  },
  {
   "key": "a541b9029071",
   "speaker_korean": null,
   "korean": "이 아이템으로 괜찮으세요?"
  },
  {
   "key": "9cb2a3319fbf",
   "speaker_korean": null,
   "korean": "그럼 평가해 드릴게요."
  },
  {
   "key": "ca0dbbcd7a77",
   "speaker_korean": null,
   "korean": "아이템 평가는\n⟦P⟧잠정적으로 이렇게 나왔어요."
  },
  {
   "key": "7cf4caaa52fa",
   "speaker_korean": null,
   "korean": "꽤 좋은 평가네요."
  },
  {
   "key": "a05c8f36c283",
   "speaker_korean": null,
   "korean": "좀 아쉬웠네요."
  },
  {
   "key": "668d2407f1ab",
   "speaker_korean": null,
   "korean": "훌륭한 평가가 나왔네요!"
  },
  {
   "key": "7663e6bb6afc",
   "speaker_korean": null,
   "korean": "조금 더 힘내는 편이~, 좋을 것 같네요…"
  },
  {
   "key": "09ecf0a3984a",
   "speaker_korean": null,
   "korean": "더 이상은 생각할 수 없는 완성도네요!\n⟦P⟧정말 대단해요…"
  },
  {
   "key": "f2a3ab3227a9",
   "speaker_korean": null,
   "korean": "이후 시장 조사가 들어간 뒤 유통량이\n⟦P⟧결정되니 잠시만 기다려 주세요.\n⟦P⟧자세한 내용은 「발명 정보 참조」를 봐 주세요."
  },
  {
   "key": "28a9883d4f57",
   "speaker_korean": null,
   "korean": "다른 건 없으세요?"
  },
  {
   "key": "855b0b87cfb4",
   "speaker_korean": null,
   "korean": "이건 지금까지 없던 대발명이네요!"
  },
  {
   "key": "556e293ea0c6",
   "speaker_korean": null,
   "korean": "이건 꽤 개성적인 완성도네요."
  },
  {
   "key": "f5f37ed13741",
   "speaker_korean": null,
   "korean": "인물명을 선택해 주세요. 상세 정보를 볼 수 있습니다."
  },
  {
   "key": "ac8e21fe239d",
   "speaker_korean": null,
   "korean": "당장의 라이벌은 원래 동료죠.\n⟦P⟧역시 신경 쓰이죠."
  },
  {
   "key": "e94fb6aa89d1",
   "speaker_korean": null,
   "korean": "지금까지 발명된 제품을 참조할 수 있습니다."
  },
  {
   "key": "87cfe821977c",
   "speaker_korean": null,
   "korean": "여기에 자신이 발명한 것들이\n⟦P⟧줄줄이 늘어서면 장관이겠죠!"
  },
  {
   "key": "4ae92a5e403f",
   "speaker_korean": null,
   "korean": "유통품 재고를 확인할 수 있습니다."
  },
  {
   "key": "efb5533ac511",
   "speaker_korean": null,
   "korean": "귀중품은 망설이지 말고 획득이죠!"
  },
  {
   "key": "a474ab093b29",
   "speaker_korean": null,
   "korean": "대륙 곳곳에 있는 마을과 던전을 확인할 수 있습니다."
  },
  {
   "key": "81e7ff2c4498",
   "speaker_korean": null,
   "korean": "목적지 결정 등에 활용해 주세요."
  },
  {
   "key": "e10368406a7f",
   "speaker_korean": null,
   "korean": "아아, 랭크가 내려가고 말았네요.\n⟦P⟧음~. 하지만, 노력은 분명 보답받을 거예요!"
  },
  {
   "key": "4e4f995d28a5",
   "speaker_korean": null,
   "korean": "축하합니다. 랭크가 올라갔어요.\n⟦P⟧이 기세예요!"
  },
  {
   "key": "1a7c212e88ee",
   "speaker_korean": null,
   "korean": "한 걸음 더 가면 1위네요! 저도 응원하고 있으니까요.\n⟦P⟧사실은 편애하면 안 되는데 말이죠."
  },
  {
   "key": "32e5063ca362",
   "speaker_korean": null,
   "korean": "크리에이터로서 톱에 어울리는 활약이네요,\n⟦P⟧역시 대단해요!"
  },
  {
   "key": "59a981c572f4",
   "speaker_korean": null,
   "korean": "아아, 세상에 꼴찌라니!\n⟦P⟧조금 더 힘내 주세요~!"
  },
  {
   "key": "cec34c548e95",
   "speaker_korean": null,
   "korean": "최신 정보"
  },
  {
   "key": "6a1c89eb89a8",
   "speaker_korean": null,
   "korean": "특허 신청"
  },
  {
   "key": "afb1f765aeb8",
   "speaker_korean": null,
   "korean": "정보 참조"
  },
  {
   "key": "6ce31f0857fe",
   "speaker_korean": null,
   "korean": "명령 변경"
  },
  {
   "key": "5d44dd2292bf",
   "speaker_korean": null,
   "korean": "알림"
  },
  {
   "key": "994b2dda83bd",
   "speaker_korean": null,
   "korean": "메인 메뉴"
  },
  {
   "key": "427d98401efd",
   "speaker_korean": null,
   "korean": "발명품 평가"
  },
  {
   "key": "6a9c2f6fc605",
   "speaker_korean": null,
   "korean": "새로운 정보가 없습니다."
  },
  {
   "key": "64b842778999",
   "speaker_korean": null,
   "korean": "상점"
  },
  {
   "key": "3520a79adb7b",
   "speaker_korean": null,
   "korean": "⟦1⟧발명자"
  },
  {
   "key": "cdc93e757f19",
   "speaker_korean": null,
   "korean": "⟦1⟧가격"
  },
  {
   "key": "18fabf95a642",
   "speaker_korean": null,
   "korean": "⟦1⟧생산량"
  },
  {
   "key": "9f102b4a6e1b",
   "speaker_korean": null,
   "korean": "⟦1⟧평가"
  },
  {
   "key": "10fc9f652197",
   "speaker_korean": null,
   "korean": "⟦1⟧이름"
  },
  {
   "key": "b20fdd6308e5",
   "speaker_korean": null,
   "korean": "⟦1⟧탤런트"
  },
  {
   "key": "d5a0c278d847",
   "speaker_korean": null,
   "korean": "⟦1⟧탤런트LV"
  },
  {
   "key": "5df7a4279f2e",
   "speaker_korean": null,
   "korean": "⟦1⟧인물 설명"
  },
  {
   "key": "50f7f3b676f8",
   "speaker_korean": null,
   "korean": "⟦1⟧레어도"
  },
  {
   "key": "1a4216759f40",
   "speaker_korean": null,
   "korean": "최신 정보－아이템"
  },
  {
   "key": "aec5c166ba2b",
   "speaker_korean": null,
   "korean": "최신 정보－숍"
  },
  {
   "key": "0eedcc73aa5f",
   "speaker_korean": null,
   "korean": "최신 정보－크리에이터"
  },
  {
   "key": "e6f62dbf295e",
   "speaker_korean": null,
   "korean": "이걸로 OK"
  },
  {
   "key": "e95cdc9a192d",
   "speaker_korean": null,
   "korean": "역시 그만둘래"
  },
  {
   "key": "71c9a6bee112",
   "speaker_korean": null,
   "korean": "이 아이템은 이미 발명된 것이라\n특허 신청을 할 수 없습니다."
  },
  {
   "key": "6bc509f4476e",
   "speaker_korean": null,
   "korean": "특허 신청할 수 있는 아이템이 없습니다."
  },
  {
   "key": "1b86d09475ba",
   "speaker_korean": null,
   "korean": "특허 신청－발명품 평가"
  },
  {
   "key": "7feb65168fa1",
   "speaker_korean": null,
   "korean": "스킵"
  },
  {
   "key": "01750c2220e9",
   "speaker_korean": null,
   "korean": "크리에이터 정보"
  },
  {
   "key": "7bd6700c11af",
   "speaker_korean": null,
   "korean": "발명품 리스트"
  },
  {
   "key": "c1af34cd81df",
   "speaker_korean": null,
   "korean": "상점 정보"
  },
  {
   "key": "e7a346f2b548",
   "speaker_korean": null,
   "korean": "대륙 맵"
  },
  {
   "key": "78c3af761212",
   "speaker_korean": null,
   "korean": "랭킹"
  },
  {
   "key": "bd8a030a7f2c",
