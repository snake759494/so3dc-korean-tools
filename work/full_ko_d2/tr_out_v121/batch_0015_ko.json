{
 "batch_id": "batch_0015",
 "translations": [
  {
   "key": "deefd5a904d7",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「그렇군.\n⟦P⟧"
  },
  {
   "key": "9ad2616be7d4",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「⟦2⟧스피어사⟦3⟧는 ⟦4⟧로스트 시티⟦5⟧라는 곳에\n있었던 거죠?\n⟦P⟧"
  },
  {
   "key": "ff89e40599e3",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「그래.\n⟦P⟧"
  },
  {
   "key": "3e486e92e6dd",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧스테이션⟦3⟧을 경유해서 ⟦4⟧로스트 시티⟦5⟧로\n가보자.\n나머진 그다음 문제야.\n⟦P⟧"
  },
  {
   "key": "a17497a862d4",
   "speaker_korean": "마리아",
   "korean": "「…안 되겠어.\n인증 디스크를 요구하네.\n원래 등록돼 있지 않으면\n여기서 플레이는 못 하나 봐."
  },
  {
   "key": "6dd18d8d7064",
   "speaker_korean": "페이트",
   "korean": "「젠장!\n모처럼 여기까지\n왔는데…"
  },
  {
   "key": "98cea51c27b8",
   "speaker_korean": "소피아",
   "korean": "「있잖아,\n혹시 ⟦1⟧플러드⟦2⟧의\n디스크인 거…?"
  },
  {
   "key": "20a89afea2b8",
   "speaker_korean": "페이트",
   "korean": "「아, 그렇군!\n시도해 볼 가치는\n있겠어."
  },
  {
   "key": "ef882fb6696e",
   "speaker_korean": "마리아",
   "korean": "「…OK, 될 것 같아."
  },
  {
   "key": "6145f008355a",
   "speaker_korean": "마리아",
   "korean": "「…안 되겠어."
  },
  {
   "key": "7e3370f9d0bf",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧플러드⟦2⟧의 말이 맞아.\n은하계는 잠겨 있어서\n못 들어가는 것 같아."
  },
  {
   "key": "4259355c3199",
   "speaker_korean": "페이트",
   "korean": "「젠장!\n어떻게 하면 되는 거야?"
  },
  {
   "key": "6df679ccd57f",
   "speaker_korean": "소피아",
   "korean": "「죄송해요…\n잠깐 괜찮을까요?"
  },
  {
   "key": "a206e27440f0",
   "speaker_korean": "마리아",
   "korean": "「어, 그래.\n상관없지만…"
  },
  {
   "key": "8a422488131f",
   "speaker_korean": "마리아",
   "korean": "「믿을 수가 없네.\n개발자용 페이지에\n접속하고 있어…"
  },
  {
   "key": "80c2584ed5a2",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧소피아⟦2⟧가 만진 게\n원인이라고밖에 생각할 수 없네.\n그런데, 어떻게 한 거야?"
  },
  {
   "key": "5039dc2d0a73",
   "speaker_korean": "소피아",
   "korean": "「저기, 그게…,\n그냥 만져 봤을 뿐인데요…"
  },
  {
   "key": "189f787c6142",
   "speaker_korean": "소피아",
   "korean": "「그냥 왠지, 그, ⟦1⟧타임게이트⟦2⟧ 때랑\n비슷한 걸까 싶어서…\n간절히, 은하계에 가고 싶다…\n가고 싶다고 생각해서…\n그, 죄송해요."
  },
  {
   "key": "2c4384c1356b",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧커넥션⟦2⟧의…\n공간을 잇는 힘인가.\n설마 이쪽 공간에서도\n효과가 있을 줄이야."
  },
  {
   "key": "9c23f0a5dbf5",
   "speaker_korean": "마리아",
   "korean": "「뭐, 됐어.\n어쨌든 여기까지 침입할 수 있었으면\n나머진 내 힘으로 어떻게든 될 거야.\n정보를 조작해서 은하계에 접속할게."
  },
  {
   "key": "a380b7d065e9",
   "speaker_korean": "클리프",
   "korean": "「어떻게 쓰는 거냐,\n이 녀석은?"
  },
  {
   "key": "48ef82874d6c",
   "speaker_korean": "소피아",
   "korean": "「저기 있는 장치로\n설정을 조작하는 것 같아요."
  },
  {
   "key": "1c6c4fb5475b",
   "speaker_korean": "페이트",
   "korean": "「인증은 됐던 거잖아?\n뭐가 안 되는 거야?"
  },
  {
   "key": "56271578698a",
   "speaker_korean": "마리아",
   "korean": "「이건…,\n왜!?"
  },
  {
   "key": "aa5123d7c2ac",
   "speaker_korean": "페이트",
   "korean": "「뭐라고?\n무슨 소리야?"
  },
  {
   "key": "a062a3e79f0b",
   "speaker_korean": "마리아",
   "korean": "「OK…완료야."
  },
  {
   "key": "d1042a8122d8",
   "speaker_korean": "마리아",
   "korean": "「어디로 가볼래?"
  },
  {
   "key": "d2e260224ba5",
   "speaker_korean": "소피아",
   "korean": "「난 어디든 좋아."
  },
  {
   "key": "d61354659f2b",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧클레어 일행⟦2⟧은 뭐 하고 있으려나?\n⟦3⟧우리 별⟦4⟧에 가보지 않을래?"
  },
  {
   "key": "788a1a963bb5",
   "speaker_korean": "알벨",
   "korean": "「네가 가고 싶은 곳에\n가면 될 거 아니냐,\n멍청한 놈."
  },
  {
   "key": "0412509a691b",
   "speaker_korean": "로저",
   "korean": "「군단 애들 상황,\n좀 보러 가고 싶은 마음도\n있긴 한데 말이야."
  },
  {
   "key": "0ac8bdbce2e1",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧문베이스⟦2⟧는 무사할까~\n다들 잘 지내고 있으면\n좋겠는데~"
  },
  {
   "key": "e5bf7c29a290",
   "speaker_korean": null,
   "korean": "⟦1⟧·뱅가드 3호성으로 간다."
  },
  {
   "key": "06efc1d305a7",
   "speaker_korean": null,
   "korean": "⟦1⟧·에리클 2호성으로 간다."
  },
  {
   "key": "4066ea02390f",
   "speaker_korean": null,
   "korean": "⟦1⟧·문베이스로 간다."
  },
  {
   "key": "c87f244758dc",
   "speaker_korean": null,
   "korean": "⟦1⟧·행성 스트림으로 간다."
  },
  {
   "key": "da7944fb4477",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧뱅가드 3호성⟦2⟧으로\n가보겠다는 거지?\nOK, 거기로 하자."
  },
  {
   "key": "b7bc0c9fc5a3",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧에리클 2호성⟦2⟧으로\n가보겠다는 거지?\nOK, 거기로 하자."
  },
  {
   "key": "9f20aec13712",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧문베이스⟦2⟧로\n가보겠다는 거지?\nOK, 거기로 하자."
  },
  {
   "key": "60025f15f871",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧행성 스트림⟦2⟧으로\n가보겠다는 거지?\nOK, 거기로 하자."
  },
  {
   "key": "cd012704568e",
   "speaker_korean": "소피아",
   "korean": "「꺄악!?"
  },
  {
   "key": "fc6c4af86ffa",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧미라쥬 일행⟦2⟧은 뭘 하고 있으려나?\n⟦3⟧엑스큐셔너⟦4⟧한테\n당하지나 않았으면 좋겠는데."
  }
 ]
}