{
 "batch_id": "batch_0129",
 "translations": [
  {
   "key": "c67e67a7f3e9",
   "speaker_korean": "시하트 27세",
   "korean": "「조용히 하시오, ⟦1⟧라셀⟦2⟧."
  },
  {
   "key": "8d89fee619a8",
   "speaker_korean": "시하트 27세",
   "korean": "「…선뜻 믿기\n어려운 이야기입니다만.\n하지만 지금까지 우리나라에\n일어난 일을 생각해보면\n믿지 않을 수 없겠지요."
  },
  {
   "key": "960631aefc06",
   "speaker_korean": "라셀 집정관",
   "korean": "「하오나……."
  },
  {
   "key": "6f4c7f7c54f0",
   "speaker_korean": "마리아",
   "korean": "「놀라시는 게 당연합니다.\n하지만 이건 움직일 수\n없는 사실입니다."
  },
  {
   "key": "9a20ac4434c9",
   "speaker_korean": "넬",
   "korean": "「폐하, 이들은 믿을\n만한 사람들입니다.\n거짓은 없다고 생각합니다."
  },
  {
   "key": "616a8342c30d",
   "speaker_korean": "시하트 27세",
   "korean": "「예…그래서, 그의 군대가\n다시 나타난다는 거군요?\n그건 어째서죠?"
  },
  {
   "key": "c4006f7043d3",
   "speaker_korean": "페이트",
   "korean": "「아마, 그들의 목적은 저일 겁니다."
  },
  {
   "key": "e0bf84975598",
   "speaker_korean": "페이트",
   "korean": "「믿고 싶지는 않지만…\n아마도요."
  },
  {
   "key": "645afd1f3864",
   "speaker_korean": "라셀 집정관",
   "korean": "「그렇다면 네놈을 그자들에게\n넘기면 될 일이 아니냐?\n그리하면 그자들도 물러갈 것 아니냐?"
  },
  {
   "key": "3315dd6b6eaf",
   "speaker_korean": "라셀 집정관",
   "korean": "「예!"
  },
  {
   "key": "5de1aa265b8a",
   "speaker_korean": "페이트",
   "korean": "「예, 확실하지는 않지만.\n⟦1⟧선더 애로우⟦2⟧로 ⟦3⟧반데인⟦4⟧을 교란시키고\n그 틈에 저희가 행성 밖으로 나갈 수 있다면…\n이 상황을 타개할 수 있을 겁니다."
  },
  {
   "key": "2166be262e9c",
   "speaker_korean": "시하트 27세",
   "korean": "「나라를 생각하면, 그대를 그들에게\n넘기는 것이 최선이겠지요.\n하지만, 그대들을 이 나라에\n받아들인 것은 우리들……\n이제 와서 내쫓는 것도 염치없는 일이지요."
  },
  {
   "key": "07dd1375a94e",
   "speaker_korean": "페이트",
   "korean": "「폐하, 감사합니다!!"
  },
  {
   "key": "27bcb9fa40fa",
   "speaker_korean": "마리아",
   "korean": "「감사드립니다, 폐하."
  },
  {
   "key": "c813446df68d",
   "speaker_korean": "클리프",
   "korean": "「근데 말이야.\n사거리는 어쩔 건데?\n모처럼 무기가 있어도 안 닿으면 말짱 꽝이잖냐."
  },
  {
   "key": "3c3618e666b5",
   "speaker_korean": "페이트",
   "korean": "「그게 문제란 말이지…"
  },
  {
   "key": "8dfec30ac1c7",
   "speaker_korean": "병사",
   "korean": "「크, 큰일입니다!!"
  },
  {
   "key": "648ed2879189",
   "speaker_korean": "라셀 집정관",
   "korean": "「무엇이냐, 소란스럽구나!\n폐하 앞이니라!!"
  },
  {
   "key": "beb88f825088",
   "speaker_korean": "병사",
   "korean": "「카, ⟦1⟧카난⟦2⟧에 침입자가 나타났습니다!!"
  },
  {
   "key": "b39d655d5112",
   "speaker_korean": "라셀 집정관",
   "korean": "「뭐라고!?"
  },
  {
   "key": "e81efffd454b",
   "speaker_korean": "병사",
   "korean": "「침입자는 지난번 그 ⟦1⟧별의 배⟦2⟧를 이용해\n⟦3⟧성전 카난⟦4⟧에 배를 대고\n그대로 성전에 쳐들어왔습니다!!\n목적은 진로로 보아 아마\n⟦5⟧세피라⟦6⟧인 것으로 추측됩니다!!"
  },
  {
   "key": "9a2db47d3ccc",
   "speaker_korean": "마리아",
   "korean": "「빛나는 무기… ⟦1⟧엘리미네이트 라이플⟦2⟧.\n아마 아까 그 반데인군의 잔당이겠지."
  },
  {
   "key": "3b7473cb1091",
   "speaker_korean": "클리프",
   "korean": "「근데 우리를 노리는 게 아니라\n왜 하필 그런 델 노리는 거냐?"
  },
  {
   "key": "d4a3d47901cd",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧카난⟦2⟧이니 ⟦3⟧세피라⟦4⟧니 하는 게 뭐야?"
  },
  {
   "key": "7bec1ada7dd3",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧카난⟦2⟧은 ⟦3⟧아페리스교⟦4⟧의 성지야.\n⟦5⟧세피라⟦6⟧가 안치된 곳이지.\n⟦7⟧세피라⟦8⟧는 맑고 성스러운 빛을 내며\n성수가 흘러넘치는 신비로운 오브야.\n⟦9⟧시하츠⟦10⟧의 통치자의 명을 받아\n온갖 기적을 일으킨다고 하지.\n⟦11⟧시랜드⟦12⟧를 둘러싼 이 호수도 ⟦13⟧세피라⟦14⟧에서\n넘치는 성수로 채워져 있는 거야."
  },
  {
   "key": "971c78477c57",
   "speaker_korean": "마리아",
   "korean": "「흐음……\n폐하, ⟦1⟧카난⟦2⟧은 어느 방향입니까?"
  },
  {
   "key": "d327591f924f",
   "speaker_korean": "미라쥬",
   "korean": "「이건!?"
  },
  {
   "key": "b5604bb1734e",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧카난⟦2⟧이라는 곳에는 이 행성의\n기술 수준으로는…\n아니, 우리 기술로도 식별할 수 없는\n종류의 에너지 반응이 있어."
  },
  {
   "key": "e997f22d42e4",
   "speaker_korean": "페이트",
   "korean": "「뭐라고?"
  },
  {
   "key": "f45b776f3494",
   "speaker_korean": "마리아",
   "korean": "ＯⅡT-H~-Of3E6 ＡvT“~3ETt…\n이른바 ⟦1⟧오파츠⟦2⟧일지도 모르겠네.\n⟦P⟧아마 ⟦3⟧반데인⟦4⟧은 우리를\n색적하던 중에 ⟦5⟧세피라⟦6⟧의 반응을\n감지했을 거야."
  },
  {
   "key": "5fe33d438e90",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧세피라⟦2⟧를 노리고 있다는 거야?"
  },
  {
   "key": "d436e2e1b1b8",
   "speaker_korean": "마리아",
   "korean": "「십중팔구 그렇게 생각해도\n틀림없을 거야.\n지금까지의 우주사를 되짚어봐도\n⟦1⟧오파츠⟦2⟧를 손에 넣은 자는 모두\n강대한 힘을 손에 쥐었어.\n그들이 그걸 원한다 해도\n이상할 것은 전혀 없어.\n오히려 당연한 일이겠지."
  },
  {
   "key": "0b4fbf52d2eb",
   "speaker_korean": "라셀 집정관",
   "korean": "「그럴 수가!?\n⟦1⟧세피라⟦2⟧를 빼앗기는 일 따위\n있어서는 안 됩니다!!\n⟦P⟧폐하, 어서 병사를!!"
  },
  {
   "key": "090023868a27",
   "speaker_korean": "페이트",
   "korean": "「그러니, ⟦1⟧카난⟦2⟧에는 제가 가겠습니다."
  },
  {
   "key": "9669d379fb5b",
   "speaker_korean": "넬",
   "korean": "「당신… 무슨 소리야?"
  },
  {
   "key": "9c9ada28875a",
   "speaker_korean": "클리프",
   "korean": "「어이어이, 우리라며?\n너 혼자 갈 셈이냐?"
  },
  {
   "key": "7210d13578fe",
   "speaker_korean": "마리아",
   "korean": "「혼자 가는 건 자살행위야.\n애초에, 네가 죽어버리면\n내가 여기 온 의미가 없잖아?\n당연히, 나도 갈 거야."
  },
  {
   "key": "b8fd628cf8a7",
   "speaker_korean": "마리아",
   "korean": "「그렇네."
  },
  {
   "key": "9e78a33d541e",
   "speaker_korean": "페이트",
   "korean": "「다들…"
  },
  {
   "key": "cee7e27155ff",
   "speaker_korean": "마리아",
   "korean": "「그렇군. 그런 거였네."
  },
  {
   "key": "c75af6bd10fc",
   "speaker_korean": "넬",
   "korean": "「폐하.\n저도 이들과 동행하겠습니다."
  },
  {
   "key": "f06dfdc7c333",
   "speaker_korean": "시하트 27세",
   "korean": "「죄송하지만,\n그대들의 안건은 나중에.\n우선은 ⟦1⟧카난⟦2⟧의 도적들에게\n대응해야만———."
  },
  {
   "key": "4deb1614e68a",
   "speaker_korean": "페이트",
   "korean": "「애초에, ⟦1⟧반데인⟦2⟧이\n이 땅에 온 건 저 때문입니다.\n제가 책임지고 해결하겠습니다…"
  },
  {
   "key": "02c82a04e3e5",
   "speaker_korean": "시하트 27세",
   "korean": "「그래서, 그 장소는 어디입니까?\n설마, 이쪽으로 오는 것은\n아니겠지요?"
  },
  {
   "key": "244d0dc8d0b9",
   "speaker_korean": "넬",
   "korean": "「예… ⟦1⟧모젤의 고대 유적⟦2⟧,\n원탁의 방을 지정해왔습니다."
  },
  {
   "key": "9274265a43a8",
   "speaker_korean": "넬",
   "korean": "「그 조건을 받아들이지 않으면\n협력할 수 없다고…"
  },
  {
   "key": "bf4a2a24e774",
   "speaker_korean": "라셀 집정관",
   "korean": "「허나 함정일 가능성도 있습니다!!"
  },
  {
   "key": "8808caec8774",
   "speaker_korean": "시하트 27세",
   "korean": "「알겠습니다.\n호위는 그대들에게\n맡기도록 하지요."
  },
  {
   "key": "3ba70513f9a0",
   "speaker_korean": "페이트",
   "korean": "「알겠습니다.\n맡겨주십시오."
  },
  {
   "key": "d3629f33960f",
   "speaker_korean": "넬",
   "korean": "「늦었잖아."
  },
  {
   "key": "399895713232",
   "speaker_korean": "페이트",
   "korean": "「늦어서 죄송합니다."
  },
  {
   "key": "0939f72aefc5",
   "speaker_korean": "시하트 27세",
   "korean": "「그대들의 보고에 따르면,\n⟦1⟧아리그리프 왕⟦2⟧은 우리 이야기를\n진지하게 받아들여준 모양이군요."
  },
  {
   "key": "643f6502ab68",
   "speaker_korean": "넬",
   "korean": "「예.\n다만, 한 번은 폐하와 직접 이야기를\n나누고 싶다고 하셨습니다만."
  },
  {
   "key": "8b4b320e9f3f",
   "speaker_korean": "라셀 집정관",
   "korean": "「직접이라니? 농담하지 마라!\n그런 위험한 짓을\n할 수 있을 리 없지 않으냐!!"
  },
  {
   "key": "3d30eb6befc6",
   "speaker_korean": "라셀 집정관",
   "korean": "「⟦1⟧모젤⟦2⟧이라고!? 모래바람 유적이 아니냐!\n그놈들이야 ⟦3⟧에어 드래곤⟦4⟧이 있으니 좋다지만\n우린 걸어서 가야 하지 않느냐!!"
  },
  {
   "key": "12fb0a9d1299",
   "speaker_korean": "시하트 27세",
   "korean": "「…알겠습니다.\n⟦1⟧모젤⟦2⟧로 가도록 하지요."
  },
  {
   "key": "c7ae54e5b475",
   "speaker_korean": "시하트 27세",
   "korean": "「그는 저를 시험하는 것이겠지요.\n본래대로라면 그런 곳에\n갈 수는 없지만.\n지금은 그런 것을 신경 쓸\n상황이 아닙니다.\n나라라는 작은 틀 안에서\n수습할 수 있는 사태가 아닙니다.\n⟦1⟧모젤⟦2⟧로 가서\n제가 직접 ⟦3⟧아리그리프 왕⟦4⟧을\n설득하겠습니다."
  },
  {
   "key": "0c8b5f43ed77",
   "speaker_korean": "라셀 집정관",
   "korean": "「폐하!?"
  },
  {
   "key": "fe92537fd0bb",
   "speaker_korean": "시하트 27세",
   "korean": "「믿는 것에서부터 모든 것이 시작됩니다.\n……상대를 믿지 않고서야\n어찌 상대가 저를 믿어주겠습니까."
  },
  {
   "key": "183672e4d0b0",
   "speaker_korean": "시하트 27세",
   "korean": "「호위에 관해서는\n무슨 조건이 나왔습니까?"
  },
  {
   "key": "800ab4962204",
   "speaker_korean": "넬",
   "korean": "「그에 관해서는 딱히 아무것도.\n자유롭게 해도 좋다고 합니다."
  },
  {
   "key": "0f7bb353a035",
   "speaker_korean": "시하트 27세",
   "korean": "「괜찮겠습니까?"
  },
  {
   "key": "32c9961123fc",
   "speaker_korean": "페이트",
   "korean": "「예, 문제없습니다."
  },
  {
   "key": "a4fb2ddb87a8",
   "speaker_korean": "시하트 27세",
   "korean": "「⟦1⟧라셀⟦2⟧."
  },
  {
   "key": "1c4a33c94750",
   "speaker_korean": "시하트 27세",
   "korean": "「제가 없는 동안은 ⟦1⟧엘레나⟦2⟧와 협력하여\n일을 처리하세요.\n……제 걱정은 하지 않아도 됩니다."
  },
  {
   "key": "3a55448dde01",
   "speaker_korean": "라셀 집정관",
   "korean": "「분부대로 하겠습니다.\n너희들… 폐하를 부탁한다."
  },
  {
   "key": "181cd50b702d",
   "speaker_korean": "페이트",
   "korean": "「폐하, 이곳 ⟦1⟧에리클⟦2⟧에서도\n날개 달린 이형의 생물이 존재한다는\n것이 확인되었을 겁니다."
  },
  {
   "key": "4427828e7cdf",
   "speaker_korean": "페이트",
   "korean": "「저희가 다시 ⟦1⟧에리클⟦2⟧에 온 것은\n그 일과 관련이 있어서입니다."
  },
  {
   "key": "cabf1c7d09cf",
   "speaker_korean": "시하트 27세",
   "korean": "「…설명해 주겠습니까?"
  },
  {
   "key": "062f4164e3fc",
   "speaker_korean": "페이트",
   "korean": "「예.\n저희는 그 작은 천사… ⟦1⟧단죄자⟦2⟧를\n근본부터 제거하려고 합니다.\n⟦P⟧그를 위해 ⟦3⟧시하츠⟦4⟧의 보물,\n⟦5⟧세피라⟦6⟧를 빌리고 싶습니다."
  },
  {
   "key": "3495ee021d03",
   "speaker_korean": "시하트 27세",
   "korean": "「다들, 오랜만이군요.\n다시 만날 수 있으리라곤 생각지 못했습니다."
  },
  {
   "key": "98b7b34b0233",
   "speaker_korean": "시하트 27세",
   "korean": "「예. 현재 ⟦1⟧아리그리프⟦2⟧와 협력하여\n대처하고 있는 중입니다.\n하지만, 꽤 고전하고 있는 모양이군요."
  },
  {
   "key": "77bd1255ff35",
   "speaker_korean": "라셀 집정관",
