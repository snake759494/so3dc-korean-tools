{
 "batch_id": "batch_0002",
 "translations": [
  {
   "key": "ffc891727569",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「내 입장에서는 너희 세계도\n어지간했지만…\n⟦P⟧이 ⟦2⟧FD 공간⟦3⟧도 그에 못지않게\n…그런 느낌이야.\n정말 세상엔 참\n다양한 세계가 다 있구나.\n⟦P⟧"
  },
  {
   "key": "6a2f074d01ce",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「우리 상대가 설령 진짜\n신이라 해도, 잘못은 바로잡아야지.\n⟦P⟧⟦2⟧아페리스 신⟦3⟧이라는 존재는\n오랜 세월에 걸쳐 ⟦4⟧시하츠⟦5⟧ 백성의\n이념으로 형성된 것이야.\n⟦P⟧이미 본래의 존재와는 다른 것이라\n해도 과언이 아니지.\n⟦P⟧"
  },
  {
   "key": "5fc0c0d5a102",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「신이란 존재가 그저\n강한 힘을 가진 것뿐이라면,\n아무도 믿고 따르지 않았을 거야.\n⟦P⟧신이라는 이름이 내세우는\n그 이상에야말로 의미가 있는 거지.\n안 그래?\n⟦P⟧"
  },
  {
   "key": "a1e3f8e28b27",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「그나저나…\n참 알다가도 모를 희한한 감각의\n마을이네, 정말로.\n⟦P⟧신들의 세계라…\n천국이란 곳이 사실 이런 데라는 걸\n다들 알게 되면, 세상이 악인들로\n넘쳐나게 될지도 모르겠어.\n⟦P⟧"
  },
  {
   "key": "ef6aa7a41278",
   "speaker_korean": "포스터 루드",
   "korean": "⟦1⟧「이래 봬도 나 옛날에 ⟦2⟧스피어사⟦3⟧에서\n일류 엔지니어로 일했었다고.\n⟦P⟧⟦4⟧에터널 스피어⟦5⟧라는 게임 속\n은하계 부분 유지를 맡고 있었는데,\n이제 됐다 싶어져 버렸지 뭐야.\n⟦P⟧"
  },
  {
   "key": "8ff0b37a21e6",
   "speaker_korean": "혈색 좋은 아주머니",
   "korean": "⟦1⟧「뭔가 찾는 게 있나 몰라?\n몰라, 몰라?\n갖고 싶은 게 있나 몰라?\n⟦P⟧"
  },
  {
   "key": "9f7fe11fb244",
   "speaker_korean": "상쾌한 청년",
   "korean": "⟦1⟧「야, 오늘은 무슨 용건이지?\n⟦P⟧"
  },
  {
   "key": "8d8eb61fe0ea",
   "speaker_korean": "넬",
   "korean": "「동감이야.\n대체 어떻게 된 거야."
  },
  {
   "key": "94ea7211c66e",
   "speaker_korean": "알벨",
   "korean": "「그래.\n적어도 여긴 평범한 거리로 보이는군.\n김이 빠지는 기분이다."
  },
  {
   "key": "af84a66cb592",
   "speaker_korean": "로저",
   "korean": "「우와, 쩐다!\n반짝반짝하잖아!!"
  },
  {
   "key": "80e305c7ab2b",
   "speaker_korean": "스프레",
   "korean": "「그러게 말이야~\n대체 어떻게 된 거지?"
  },
  {
   "key": "4dbfe76161a4",
   "speaker_korean": "소년",
   "korean": "「저기저기, 형아들,\n방금 ⟦1⟧엑스큐셔너⟦2⟧라고 했어?"
  },
  {
   "key": "e5b34bb205c0",
   "speaker_korean": "페이트",
   "korean": "「어, 아, 아아."
  },
  {
   "key": "1da6e1b0fb1a",
   "speaker_korean": "마리아",
   "korean": "「…넌 대체 누구지?"
  },
  {
   "key": "2416841ce8d2",
   "speaker_korean": "소년",
   "korean": "「난 ⟦1⟧플러드 갈런드⟦2⟧야."
  },
  {
   "key": "ab3124517ada",
   "speaker_korean": "클리프",
   "korean": "「그런 걸 묻고 싶은 게\n아니란 말이지."
  },
  {
   "key": "555f9d31e69d",
   "speaker_korean": "플러드",
   "korean": "「아, 괜찮아, 괜찮아!\n난 적이 아니니까."
  },
  {
   "key": "be916ef1dafb",
   "speaker_korean": "넬",
   "korean": "「글쎄, 어떨지."
  },
  {
   "key": "4e677fd961df",
   "speaker_korean": "알벨",
   "korean": "「흥.\n믿으라는 건가?"
  },
  {
   "key": "a1cd332bdd87",
   "speaker_korean": "로저",
   "korean": "「적이 아니라고?\n그럼~ 아군이란 거냐?"
  },
  {
   "key": "1ae954d2f0a5",
   "speaker_korean": "스프레",
   "korean": "「에엣, 진짜아?"
  },
  {
   "key": "48ae0828b763",
   "speaker_korean": "플러드",
   "korean": "「우리 집으로 와!\n아마 형아들이 알고 싶어 하는 걸\n알 수 있을 거야."
  },
  {
   "key": "64c6e2e94c82",
   "speaker_korean": "클리프",
   "korean": "「뭐, 이런 꼬맹이가 우릴\n어떻게 할 수 있을 것 같지도 않고."
  },
  {
   "key": "d31b282a5e1e",
   "speaker_korean": "마리아",
   "korean": "「그래.\n게다가 정보를 모을 필요는\n있다고 생각해."
  },
  {
   "key": "f7e165115d4d",
   "speaker_korean": "소피아",
   "korean": "「그렇겠네요."
  },
  {
   "key": "2a2fd34f04df",
   "speaker_korean": "페이트",
   "korean": "「그래…가 보자.\n아무래도 ⟦1⟧엑스큐셔너⟦2⟧에 대해\n뭔가 알고 있는 것 같고,\n게다가 여기까지 와서\n위험을 겁내면 아무것도 못 해."
  },
  {
   "key": "b8ffba217173",
   "speaker_korean": "클리프",
   "korean": "「호랑이굴에 안 들어가면\n호랑이를 못 잡는다, 뭐 그거지."
  },
  {
   "key": "d0bbca9a4d80",
   "speaker_korean": "알벨",
   "korean": "「당연한 판단이군."
  },
  {
   "key": "af6d5b98eb32",
   "speaker_korean": "로저",
   "korean": "「사나이는 앞으로 나가야 할\n때가 있는 법이거든."
  },
  {
   "key": "dfe8adc678f3",
   "speaker_korean": "스프레",
   "korean": "「응, 맞아맞아!"
  },
  {
   "key": "40fff951daa2",
   "speaker_korean": "마리아",
   "korean": "「결정됐네."
  },
  {
   "key": "8e0c3e26552d",
   "speaker_korean": "플러드",
   "korean": "「빨리 안 하면\n⟦1⟧시큐리티서비스⟦2⟧가 와 버려!\n빨리, 빨리!!"
  },
  {
   "key": "b4eceadf9db9",
   "speaker_korean": "여성",
   "korean": "「꺄악!!"
  },
  {
   "key": "bba74da6da3a",
   "speaker_korean": "남성",
   "korean": "「뭐야?"
  },
  {
   "key": "d39da296fb85",
   "speaker_korean": "여자아이",
   "korean": "「⟦1⟧에터널 스피어⟦2⟧\n디스플레이에서\n뭔가 나왔어."
  },
  {
   "key": "9599e011a747",
   "speaker_korean": "남성",
   "korean": "「새로운\n퍼포먼스인가?"
  },
  {
   "key": "ec06688f96ac",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧엑스큐셔너⟦2⟧는\n어디 있지!?"
  },
  {
   "key": "a6c22ed7234c",
   "speaker_korean": "소피아",
   "korean": "「무사히 도착했네요.\n다행이에요."
  },
  {
   "key": "087d6e9f077e",
   "speaker_korean": "마리아",
   "korean": "「그래, 맞아."
  },
  {
   "key": "5f5e35af8b22",
   "speaker_korean": "클리프",
   "korean": "「어이 어이,\n적의 본거지라면 좀 더 긴장감이\n있어야 하는 거 아니냐, 보통?"
  },
  {
   "key": "e6202a23cd2d",
   "speaker_korean": "소피아",
   "korean": "「하지만…여긴 ⟦1⟧FD 공간⟦2⟧이에요.\n틀림없다고 생각해요."
  },
  {
   "key": "8a4d1e0ffc7b",
   "speaker_korean": "페이트",
   "korean": "「대체\n어떻게 된 거지?"
  },
  {
   "key": "1ef7f2667f1b",
   "speaker_korean": "마리아",
   "korean": "「글쎄…\n아무튼 여기가 ⟦1⟧FD 공간⟦2⟧인 것 같네."
  }
 ]
}