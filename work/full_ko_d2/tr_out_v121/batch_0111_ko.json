{
 "batch_id": "batch_0111",
 "translations": [
  {
   "key": "61a9d624d5d0",
   "speaker_korean": "마리아",
   "korean": "「남의 일처럼 말하네…"
  },
  {
   "key": "2419a5368a8b",
   "speaker_korean": "마리아",
   "korean": "「개조된 건 나뿐만이 아니야\n⟦P⟧그들은 나보다 먼저 실험체 1호를\n완성시켰던 거야……\n나는 말하자면 2호인 셈이지"
  },
  {
   "key": "800cfa433ed7",
   "speaker_korean": "마리아",
   "korean": "「네가…그런 거야"
  },
  {
   "key": "6afddfdc201c",
   "speaker_korean": "페이트",
   "korean": "「뭐라고? 내가…내가 실험체라고?\n⟦P⟧대체 무슨 소리를 하는 거야?\n아버지가 나한테 그런 짓을\n하실 리가 없잖아…"
  },
  {
   "key": "8f969ee83c1d",
   "speaker_korean": "마리아",
   "korean": "「믿기지 않는 것도 무리는 아니야\n아직 진정한 각성을 한 건 아니니까\n⟦P⟧그래도, 그럼 설명해줄래?\n대체 누가 어떻게 ⟦1⟧반데인⟦2⟧의\n⟦3⟧전함⟦4⟧을 격추시킨 거지?\n⟦P⟧왜 ⟦5⟧반데인⟦6⟧은 집요하게 너를,\n라인갓 관계자들을 노리는 거지?"
  },
  {
   "key": "c8721793e131",
   "speaker_korean": "마리아",
   "korean": "「그 자리에 있던 사람이라면 다 아는 얘기야\n…너만 빼고 다 말이야"
  },
  {
   "key": "e87aa088d936",
   "speaker_korean": "마리아",
   "korean": "「인정하고 싶지 않은 건 알아\n하지만 진실은 하나뿐이야\n⟦P⟧나는 박사님들을 ⟦1⟧반데인⟦2⟧에게서 되찾아서\n왜 이런 짓을 했는지\n그 이유를 캐낼 거야\n⟦P⟧그러기 위해서는 ⟦3⟧페이트⟦4⟧,\n네 힘이 필요해\n나 혼자서는, 나 혼자 힘으로는 할 수 없어―――"
  },
  {
   "key": "ca3a5c1c70a4",
   "speaker_korean": "페이트",
   "korean": "(내가 무기라고?\n무슨 말도 안 되는 소리를…"
  },
  {
   "key": "be10a1ca5307",
   "speaker_korean": "마리아",
   "korean": "「너도 아버지랑 소꿉친구를\n구하는 데는 이견 없지?\n소중한 가족이니까……"
  },
  {
   "key": "18a311cfc24f",
   "speaker_korean": "페이트",
   "korean": "「그래, 그건 맞아\n소중해서 바꿀 수 없는 사람들이니까"
  },
  {
   "key": "5dcfd54e06c0",
   "speaker_korean": "페이트",
   "korean": "「알았어…협력하자"
  },
  {
   "key": "48623db9b88a",
   "speaker_korean": "마리아",
   "korean": "「그렇게 정해졌다면…"
  },
  {
   "key": "b50b6a5ae0d4",
   "speaker_korean": "마리아",
   "korean": "「뭐, 물어봤다고 해서\n딱히 문제될 건 없으니 상관없지만"
  },
  {
   "key": "25bf76c775e1",
   "speaker_korean": "마리아",
   "korean": "「하지만 그렇게만 말할 순 없어\n문제가 산더미거든"
  },
  {
   "key": "5a86f40d8faa",
   "speaker_korean": "페이트",
   "korean": "「맞아\n애초에 본함이 오는 건 좋은데\n또 다른 반데인 함선한테\n방해받는 거 아니야?"
  },
  {
   "key": "30a695742e95",
   "speaker_korean": "마리아",
   "korean": "「그렇긴 하지…\n궤도에 오르는 시간, 전송에 걸리는 시간,\n워프아웃이 끝날 때까지의 시간…\n전부 합쳐 5분은 걸릴 거야"
  },
  {
   "key": "8e20b5ae6a83",
   "speaker_korean": "미라쥬",
   "korean": "「아무리 본함이라 해도 5분이라는 시간 동안\n반데인 함의 공격을 버티는 건\n힘들 것 같은데요?"
  },
  {
   "key": "ed34293d443a",
   "speaker_korean": "마리아",
   "korean": "「그렇네……"
  },
  {
   "key": "fdc762f69c62",
   "speaker_korean": "클리프",
   "korean": "「이 녀석은 힘 제어하는 법도\n모르잖냐"
  },
  {
   "key": "d3280f573127",
   "speaker_korean": "마리아",
   "korean": "「나 자신도 완전히 힘을 제어할\n수 있는 건 아니고…\n어차피 불확실한 요소를\n믿고 갈 순 없지"
  },
  {
   "key": "42c264c6fd3b",
   "speaker_korean": "미라쥬",
   "korean": "「그렇군요…\n이 ⟦1⟧시하츠⟦2⟧에 있는 ⟦3⟧시술 병기⟦4⟧가 유일한\n가능성을 갖고 있다고 봅니다만"
  },
  {
   "key": "dd746303389a",
   "speaker_korean": "클리프",
   "korean": "「그렇지! 야,\n⟦1⟧디온⟦2⟧의 그건 어때?"
  },
  {
   "key": "995acc766b74",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧선더 애로우⟦2⟧ 얘기야?"
  },
  {
   "key": "90fedb1de4b5",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧반데인⟦2⟧의 ⟦3⟧전함⟦4⟧에 얼마나 피해를\n줄 수 있을지는 모르겠지만\n다만, 내가 아는 한\n이게 이 행성에서 가장 강력한\n무기라는 건 틀림없다고 생각해"
  },
  {
   "key": "09be1b4268fd",
   "speaker_korean": "마리아",
   "korean": "「그거네…\n바로 준비에 들어가자"
  },
  {
   "key": "cc36b6cbbc5a",
   "speaker_korean": "페이트",
   "korean": "「하지만 아직 개발 중이야\n지금 시점에서는 실전 사용을\n견딜 수 있는 게 아니야\n⟦P⟧유효 사거리도 아마 상공의\n반데인 함까지는\n닿지 않을 거고…\n⟦P⟧애초에 그건 이 나라,\n⟦1⟧시하츠⟦2⟧의 소유물이라서\n우리 마음대로 쓸 수 있는 게 아니야"
  },
  {
   "key": "9ff77dc6bf47",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧반데인⟦2⟧이라니\n요전의 그 적을 말하는 거야?"
  },
  {
   "key": "7fba6724d157",
   "speaker_korean": "넬",
   "korean": "「그게 다시 나타난다는 거지?"
  },
  {
   "key": "22b192cf9e8a",
   "speaker_korean": "마리아",
   "korean": "「거의 틀림없이 올 거야"
  },
  {
   "key": "2118faf05df4",
   "speaker_korean": "넬",
   "korean": "「그래서 그것에 대항하기 위해\n우리나라의 ⟦1⟧선더 애로우⟦2⟧를 쓰고 싶다고\n말하는 거지?"
  },
  {
   "key": "d5e70a8625fc",
   "speaker_korean": "클리프",
   "korean": "「뭐, 그런 거지"
  },
  {
   "key": "ca58eeb9c71b",
   "speaker_korean": "넬",
   "korean": "「알았어\n내가 폐하께 말씀드려 볼게"
  },
  {
   "key": "72b77bec7cee",
   "speaker_korean": "페이트",
   "korean": "「그렇게 쉽게 믿어주지는\n못할 거라고 생각하지만"
  },
  {
   "key": "b7a5065ab471",
   "speaker_korean": "마리아",
   "korean": "「역시 넌 아무것도 모르는구나"
  },
  {
   "key": "f3dcf3dc18f7",
   "speaker_korean": "마리아",
   "korean": "「그게 좋겠어"
  },
  {
   "key": "8c3dda8f5400",
   "speaker_korean": "페이트",
   "korean": "「뭐!?"
  },
  {
   "key": "e23110b54c5b",
   "speaker_korean": "페이트",
   "korean": "「뭐, 뭐야?"
  },
  {
   "key": "44075d934cd9",
   "speaker_korean": "페이트",
   "korean": "「당신은!?"
  },
  {
   "key": "bb1cef3c7e47",
   "speaker_korean": "클리프",
   "korean": "「이 별을 떠날 함선은 어쩌고?"
  },
  {
   "key": "af36f4a2a9ea",
   "speaker_korean": "마리아",
   "korean": "「괜찮아…아까는 ⟦1⟧반데인⟦2⟧의 방해를 예상해서\n일부러 소형함으로 온 거니까\n⟦3⟧디플로 본함⟦4⟧은 나중에 오기로 되어 있어\n나머지는 ⟦5⟧마리에타⟦6⟧가 잘해줄 거야"
  },
  {
   "key": "5afa94824702",
   "speaker_korean": "클리프",
   "korean": "「준비성 한번 철저하네\n예상대로란 거군"
  },
  {
   "key": "90e3d06d44b9",
   "speaker_korean": "마리아",
   "korean": "「이상적으로 말하면 지상에서도 뭔가\n견제할 수 있으면 좋겠는데\n뭐, 이 행성의 문명 수준으론\n어쩔 도리가 없다는 건 알아\n그래도 뭔가 방법을 생각해봐야 해"
  },
  {
   "key": "936359e6b7cf",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧미라쥬⟦2⟧,\n이 행성의 무기 중 가장 강력하고\n유효한 게 뭐야?\n⟦P⟧⟦3⟧반데인⟦4⟧의 ⟦5⟧실드⟦6⟧를 부수라는 둥\n무리한 말은 안 해\n우리 전력을 오판하게 만들 정도의\n시간만 벌면 돼"
  },
  {
   "key": "1fd6e312d4be",
   "speaker_korean": "페이트",
   "korean": "「…고마워"
  },
  {
   "key": "8e4fe5341665",
   "speaker_korean": "클리프",
   "korean": "「어차피\n폐하께는 사정을 설명하기로\n약속했었잖아"
  },
  {
   "key": "991a0f01a445",
   "speaker_korean": "마리아",
   "korean": "「이게 내가 라인갓 박사님들의\n문장 유전자 개조로 얻은 힘이야\n⟦P⟧나는 물질의 성질을 바꾸는\n능력을 갖고 있어\n…그래도 평범한 여자애로 보여?"
  },
  {
   "key": "32e47869c16a",
   "speaker_korean": "페이트",
   "korean": "(지금 그거…뭐야?"
  },
  {
   "key": "a9bb04261469",
   "speaker_korean": "페이트",
   "korean": "「어…괜찮은 건가요?"
  },
  {
   "key": "9746d194b327",
   "speaker_korean": "넬",
   "korean": "「솔직히 사정은 잘 모르겠지만\n그 ⟦1⟧별의 배⟦2⟧가 다시 이 땅에 온다면\n또다시 끔찍한 사태가 벌어질 거라는 건\n틀림없겠지\n게다가……너희 둘이 믿을 만한\n사람들이라고, 나는 믿고 있으니까"
  },
  {
   "key": "554f670ac401",
   "speaker_korean": "마리아",
   "korean": "「네 아버지는 금지된 연구에\n손을 댄 거야"
  },
  {
   "key": "a480ac7119d0",
   "speaker_korean": "마리아",
   "korean": "「그런 걸 말해줄 리가 없잖아\n당사자 말고는 연방 상층부 일부만\n아는 얘기니까"
  }
 ]
}