{
 "batch_id": "batch_0221",
 "translations": [
  {
   "key": "1261f2bbc013",
   "speaker_korean": null,
   "korean": "나선의 탑 제1층"
  },
  {
   "key": "cbdb0620214a",
   "speaker_korean": "블레어",
   "korean": "「엇?\n뭐야…꺅악!?"
  },
  {
   "key": "5a95bb138fc7",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧블레어 씨⟦2⟧!?\n얘, 다들!!"
  },
  {
   "key": "6882f49c18d0",
   "speaker_korean": "마리아",
   "korean": "「뭔가 장치가\n되어 있었나 봐."
  },
  {
   "key": "923234ca31e0",
   "speaker_korean": "페이트",
   "korean": "「먼저 서두르자."
  },
  {
   "key": "32a0423157f6",
   "speaker_korean": "소피아",
   "korean": "「그런…빨리 구해줘야 해!!"
  },
  {
   "key": "5749fb8c35e6",
   "speaker_korean": "소피아",
   "korean": "「어……하지만!!"
  },
  {
   "key": "a451c2eadb9d",
   "speaker_korean": "페이트",
   "korean": "「괜찮아, ⟦1⟧블레어 씨⟦2⟧라면\n혼자서도 어떻게든 해낼 거야.\n우리에겐 시간이 없어."
  },
  {
   "key": "33b240e63272",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧블레어 씨⟦2⟧가!?"
  },
  {
   "key": "0920cdec6209",
   "speaker_korean": "페이트",
   "korean": "「알았지?"
  },
  {
   "key": "ce25610c32a6",
   "speaker_korean": "페이트",
   "korean": "「어떻게 된 거야!?"
  },
  {
   "key": "00247c958a48",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 3⟦2⟧을 손에 넣었다."
  },
  {
   "key": "dc70f3814608",
   "speaker_korean": null,
   "korean": "나선의 탑 제2층"
  },
  {
   "key": "2a6d6798b59e",
   "speaker_korean": "페이트",
   "korean": "「신기하게 생긴 오브제가 있네…"
  },
  {
   "key": "469fe30c0b0e",
   "speaker_korean": "페이트",
   "korean": "「이제 반응은 없는 것 같네."
  },
  {
   "key": "fd6530b50104",
   "speaker_korean": "마리아",
   "korean": "「닥쳐!"
  },
  {
   "key": "c4db78d2d2ec",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧블레어 씨⟦2⟧,\n여긴 어떻게?"
  },
  {
   "key": "a2c18f96e4f1",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧블레어 씨⟦2⟧…?"
  },
  {
   "key": "814d52c436e8",
   "speaker_korean": "클리프",
   "korean": "「어이, ⟦1⟧블레어⟦2⟧…"
  },
  {
   "key": "5705e277e6b1",
   "speaker_korean": "블레어",
   "korean": "「후흐흐흐흐…"
  },
  {
   "key": "2d76c8d7d2e7",
   "speaker_korean": "마리아",
   "korean": "「아니야! 이 사람은…!!"
  },
  {
   "key": "7e4914530c37",
   "speaker_korean": "블레어",
   "korean": "「그래……난 ⟦1⟧블레어⟦2⟧이지만\n⟦3⟧블레어⟦4⟧가 아니야.\n그분이 만들어낸,\n그 여자의 모습을 한 프로그램…이야."
  },
  {
   "key": "9912b7f9a2ce",
   "speaker_korean": "넬",
   "korean": "「이봐, 너…\n뭐라고 말 좀 해봐."
  },
  {
   "key": "21be93802659",
   "speaker_korean": "알벨",
   "korean": "「이봐, 대답해."
  },
  {
   "key": "4951aeaeb94f",
   "speaker_korean": "로저",
   "korean": "「어라, 뭔가 이상한데?"
  },
  {
   "key": "e6e8851de4f6",
   "speaker_korean": "스프레",
   "korean": "「⟦1⟧블레어⟦2⟧… 그치?"
  },
  {
   "key": "27315c1ea282",
   "speaker_korean": "페이트",
   "korean": "「그분? 오너인가!?"
  },
  {
   "key": "103649b0b259",
   "speaker_korean": "블레어",
   "korean": "「후흐흐흐…정답이네."
  },
  {
   "key": "e30973c4de44",
   "speaker_korean": "마리아",
   "korean": "「악취미네."
  },
  {
   "key": "0b297884c6f3",
   "speaker_korean": "블레어",
   "korean": "「세상을 오염시키는 너희는\n여기서 사라져야 해.\n얌전히 죽어버리라고."
  },
  {
   "key": "6cc59f15512e",
   "speaker_korean": "소피아",
   "korean": "「그런…!?"
  },
  {
   "key": "40e961a2e4b3",
   "speaker_korean": "클리프",
   "korean": "「그런 짓 하게 둘까 보냐."
  },
  {
   "key": "e44ce83370c3",
   "speaker_korean": "넬",
   "korean": "「장난하지 마."
  },
  {
   "key": "cd18b1b91b51",
   "speaker_korean": "알벨",
   "korean": "「까불지 마라, 멍청아."
  },
  {
   "key": "679620af7a25",
   "speaker_korean": "로저",
   "korean": "「싫어!\n메라, 까불지 말라고!!"
  },
  {
   "key": "763bd308f24d",
   "speaker_korean": "스프레",
   "korean": "「장난하지 마!\n그런 거 싫어!!"
  },
  {
   "key": "2801b9c61793",
   "speaker_korean": "소피아",
   "korean": "「응! 안 질 거야!!"
  },
  {
   "key": "bafe5b09428c",
   "speaker_korean": "블레어",
   "korean": "「말 안 듣는 나쁜 아이들에겐\n벌이 필요하겠네…"
  },
  {
   "key": "0b075962a058",
   "speaker_korean": "마리아",
   "korean": "「까불지 마!!"
  },
  {
   "key": "46375bb4a40c",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧블레어 씨⟦2⟧는 어디 있지?"
  },
  {
   "key": "0dfb0d0b68aa",
   "speaker_korean": "블레어",
   "korean": "「후흐흐…\n그런 여자는 몰라."
  },
  {
   "key": "727dd09839df",
   "speaker_korean": "블레어",
   "korean": "「글쎄? 어디 있을까?\n직접 찾아보면 되잖아.\n후흐흐흐…후하하하하하핫…"
  },
  {
   "key": "13b86ff68bcf",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧블레어 씨⟦2⟧, 괜찮을까?"
  },
  {
   "key": "c0ffb7f9d65c",
   "speaker_korean": "페이트",
   "korean": "「모르겠어…\n무사하면 좋겠는데."
  },
  {
   "key": "40e90383323c",
   "speaker_korean": "클리프",
   "korean": "「어이, 좀 성가신 일이\n벌어진 것 같은데."
  },
  {
   "key": "2147b97bf392",
   "speaker_korean": "클리프",
   "korean": "「이 장치 말인데, 생김새로 보아\n아까 쓴 전송 장치랑 같은 물건인 것 같은데\n어째 기능이 멈춘 것 같단 말이지.\n아마…아까 그 여자 짓이겠지."
  },
  {
   "key": "a5d4c2d87d22",
   "speaker_korean": "클리프",
   "korean": "「글쎄."
  },
  {
   "key": "ef13fcec1c5d",
   "speaker_korean": "페이트",
   "korean": "「다른 길이 있을까?"
  },
  {
   "key": "7f699ccb7cf0",
   "speaker_korean": "마리아",
   "korean": "「일단은,\n다른 데를 찾아보죠."
  },
  {
   "key": "e9bad2577778",
   "speaker_korean": "소피아",
   "korean": "「그러네요."
  },
  {
   "key": "e56f92c83e0f",
   "speaker_korean": "클리프",
   "korean": "「어이, 이게 어떻게 된 거야?\n기능이 안 돌아오잖아."
  },
  {
   "key": "e414fc5f9bf5",
   "speaker_korean": "마리아",
   "korean": "「…또 다른 뭔가가\n있는 걸까?"
  },
  {
   "key": "bbad8a99235f",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧블레어 씨⟦2⟧라면\n뭔가 알 수 있을지도 모르겠네요."
  },
  {
   "key": "24f4fc7a303f",
   "speaker_korean": "클리프",
   "korean": "「보다시피 이 꼴이잖아."
  },
  {
   "key": "73cf8a6e4134",
   "speaker_korean": "블레어",
   "korean": "「잠깐만…"
  },
  {
   "key": "e8bda3383b26",
   "speaker_korean": "블레어",
   "korean": "「이걸로 앞으로 나아갈 수 있을 거야."
  },
  {
   "key": "cb21b00e3c0a",
   "speaker_korean": "소피아",
   "korean": "「감사합니다."
  },
  {
   "key": "c7b201faeed2",
   "speaker_korean": "마리아",
   "korean": "「서두르죠.\n시간이 꽤 걸려버렸네."
  }
 ]
}