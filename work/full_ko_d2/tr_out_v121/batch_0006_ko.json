{
 "batch_id": "batch_0006",
 "translations": [
  {
   "key": "19c4bada51c9",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「몸은 괜찮으신 거예요?\n아직 완전히 회복되진 않았죠?\n⟦P⟧"
  },
  {
   "key": "83a263d101b6",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「정말로, 무리는 하지 않으셔도\n돼요.\n⟦P⟧⟦2⟧미나⟦3⟧에게는 제가\n잘 말해 둘 테니까요.\n⟦P⟧"
  },
  {
   "key": "31aa6150713c",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「윽….\n크으윽….\n⟦P⟧"
  },
  {
   "key": "926c0529f7fa",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「아버지, 어머니….\n저, 저는….\n⟦P⟧"
  },
  {
   "key": "ae91badd7d9e",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「네…. 네, 괜찮아요.\n제가… ⟦2⟧미나⟦3⟧를 지킬게요….\n⟦P⟧"
  },
  {
   "key": "19fccbafbabc",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「⟦2⟧페이트⟦3⟧ 오빠는\n아직 다 낫지 않았으니까\n무리하면 안 되는 거야.\n⟦P⟧"
  },
  {
   "key": "349e5792312c",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「오르골, 정말로 고칠 수 있어?\n응? 응?\n⟦P⟧"
  },
  {
   "key": "85967cbe1489",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「⟦2⟧노키아 오빠⟦3⟧가 없어….\n나, 이제 외톨이인 거야?\n⟦P⟧"
  },
  {
   "key": "1a454722ed7e",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「싫어, 오빠～!\n으앙～! 으앙～!\n⟦P⟧"
  },
  {
   "key": "c024dca8560f",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「오빠….\n⟦2⟧노키아 오빠⟦3⟧….\n⟦P⟧으앙～! 으앙～!\n⟦P⟧"
  },
  {
   "key": "61648c1b4718",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「훌쩍, 훌쩍….\n⟦P⟧"
  },
  {
   "key": "8c2cd7b4bc21",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「그거, 정말?\n⟦P⟧정말로 ⟦2⟧페이트⟦3⟧\n오빠가 ⟦4⟧미나⟦5⟧ 오빠를\n찾아 주는 거야?\n⟦P⟧"
  },
  {
   "key": "2aadb618cc17",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「물론 정말이지.\n⟦P⟧그러니까…,\n자, 울지 마.\n⟦P⟧"
  },
  {
   "key": "72c1eb56b198",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「괜찮아. 걱정하지 마.\n내가 금방 찾아와 줄 테니까.\n⟦P⟧"
  },
  {
   "key": "e4c31e0afd08",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「좋～아, 착하구나.\n⟦P⟧"
  },
  {
   "key": "cd369d6b111c",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「오빠….\n어디로 가 버린 거야?\n⟦P⟧"
  },
  {
   "key": "f469c20c32b5",
   "speaker_korean": null,
   "korean": "미소 지으며 잠들어 있다.\n아무래도 즐거운 꿈을 꾸는 모양이다.\n⟦P⟧"
  },
  {
   "key": "e1080a455e37",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「으윽….\n훌쩍…. 오빠……."
  },
  {
   "key": "2854d8b0ef2e",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「엣!?\n아빠…, 게다가 엄마도?\n⟦P⟧"
  },
  {
   "key": "f69f44e97647",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「응….\n⟦2⟧미나⟦3⟧는… 잘 지내.\n⟦P⟧"
  },
  {
   "key": "3f0be3413a4d",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「응…. 응….\n⟦2⟧미나⟦3⟧… 힘낼게.\n⟦P⟧오빠랑…,\n같이… 말이야….\n⟦P⟧"
  },
  {
   "key": "e03647dc8353",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「⟦2⟧페이트 씨⟦3⟧는 우리의….\n아뇨, 이 ⟦4⟧위플 마을⟦5⟧ 그 자체의\n은인이에요.\n⟦P⟧⟦6⟧페이트 씨⟦7⟧가 안 계셨다면\n이 마을은 그때 ⟦8⟧노턴⟦9⟧에게\n멸망당했을 테니까요.\n⟦P⟧"
  },
  {
   "key": "e78c7bed687a",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「그때는 정말\n감사했습니다.\n⟦P⟧⟦2⟧페이트 씨⟦3⟧에게는\n아무리 감사를 드려도\n모자랄 정도예요.\n⟦P⟧"
  },
  {
   "key": "2a15e50ab401",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「어서 와.\n⟦2⟧페이트⟦3⟧ 오빠.\n⟦P⟧있지.\n오늘은 우리 집에서\n자고 가 주는 거야?\n⟦P⟧"
  },
  {
   "key": "f16c75bc5a17",
   "speaker_korean": null,
   "korean": "⟦1⟧・자고 간다."
  },
  {
   "key": "03ed573c5e55",
   "speaker_korean": null,
   "korean": "⟦1⟧・자고 가지 않는다."
  },
  {
   "key": "b43747916b7f",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그럼, 모처럼이니까\n신세 좀 질까.\n⟦P⟧"
  },
  {
   "key": "d3f8c831590a",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「정말!?\n⟦P⟧그럼, ⟦2⟧미나⟦3⟧ 열심히 해서\n오빠랑 맛있는 밥\n만들게.\n⟦P⟧그러니까 있지.\n전처럼 많이많이\n이야기하자.\n⟦P⟧"
  },
  {
   "key": "11c45be6fbd7",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「아, 안녕하세요.\n⟦P⟧어젯밤에는 늦게까지 ⟦2⟧미나⟦3⟧가\n폐를 끼쳐 버려서\n죄송해요.\n⟦P⟧"
  },
  {
   "key": "5f5e6590e920",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「괜찮으시다면 언제든지\n또 와 주세요.\n⟦P⟧⟦2⟧페이트 씨⟦3⟧라면\n언제라도 대환영이니까요.\n⟦P⟧"
  },
  {
   "key": "6f0c02415198",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「오늘은 좀 바빠서 말이야….\n미안해.\n⟦P⟧"
  },
  {
   "key": "bea65033ea58",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「그렇구나….\n⟦P⟧"
  },
  {
   "key": "1431aec4bf7d",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「잘 가.\n또 놀러 와야 해.\n⟦P⟧꼭, 꼭이야.\n약속이야!\n⟦P⟧"
  },
  {
   "key": "4c22a7d6a052",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「⟦2⟧페이트⟦3⟧ 오빠.\n벌써 가 버리는 거야?\n⟦P⟧또 놀러 와야 해.\n약속이야.\n⟦P⟧"
  },
  {
   "key": "418356a6d6cd",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「약속한 거니까.\n또 놀러 와야 해.\n⟦P⟧⟦2⟧미나⟦3⟧, 착한 아이로\n기다리고 있을게.\n⟦P⟧계속, 계속.\n기다리고 있을 테니까.\n⟦P⟧"
  },
  {
   "key": "bc1ed1c6c616",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「오랜만이네, ⟦2⟧노키아⟦3⟧.\n⟦P⟧음, 그러니까….\n맞다, 그때 입은 상처는\n이제 괜찮은 거야?\n⟦P⟧"
  },
  {
   "key": "8db4f05fe332",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「네, 그건 이제 멀쩡해요.\n⟦P⟧그런 것보다\n⟦2⟧페이트 씨⟦3⟧야말로\n무사하셨던 거예요?\n⟦P⟧갑자기 사라져 버리셔서\n걱정했다고요.\n⟦P⟧"
  },
  {
   "key": "8e389a0544ba",
   "speaker_korean": null,
   "korean": "그 뒤로 여러 가지\n일이 있었거든….\n⟦P⟧"
  },
  {
   "key": "21ccabb4b6ce",
   "speaker_korean": null,
   "korean": "⟦1⟧페이트 씨⟦2⟧가\n사과하실 일이\n아니에요.\n⟦P⟧"
  },
  {
   "key": "c67a2a72f83a",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「정말로….\n정말 진짜로, ⟦2⟧페이트⟦3⟧\n오빠인 거지?\n⟦P⟧"
  },
  {
   "key": "ce9523036614",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「응, 맞아.\n잘 지냈어?\n⟦P⟧"
  },
  {
   "key": "34bae6ec365a",
   "speaker_korean": null,
   "korean": "작물 기르는 법이 꼼꼼하게 기록된\n책이 늘어서 있다.\n⟦P⟧"
  },
  {
   "key": "1e0499dff3bb",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「발아 온도, 적절한 습도,\n작물 성장에 필요한 영양분….\n⟦P⟧정말 잘 조사해 놨네.\n이걸 쓴 사람은 상당한\n노력가였나 보네.\n⟦P⟧"
  },
  {
   "key": "cba185a39f7f",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「오랜만이네, ⟦2⟧미나⟦3⟧.\n⟦P⟧"
  },
  {
   "key": "5589cd233d5c",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「어….\n⟦2⟧페이트 씨⟦3⟧!?\n⟦P⟧"
  },
  {
   "key": "546d949ca364",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「응!\n⟦P⟧"
  },
  {
   "key": "24173c6049c5",
   "speaker_korean": null,
   "korean": "값비싸 보이는 오르골이다.\n하지만 톱니바퀴가 망가져 소리는 안 난다.\n⟦P⟧"
  },
  {
   "key": "05d94c5bd584",
   "speaker_korean": null,
   "korean": "노키아와 미나의 집"
  },
  {
   "key": "59d65ed757ec",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어라?\n⟦2⟧노키아⟦3⟧는 어떻게 된 거야?\n⟦P⟧"
  },
  {
   "key": "d6175ddeaa3b",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「몰라….\n⟦P⟧"
  },
  {
   "key": "2383bb9579a4",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어딘가에 나가기라도 한 걸까?\n⟦P⟧"
  },
  {
   "key": "f29c74a91e97",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「일어났더니 없었어.\n오빠도 사라져 버린 걸까?\n아빠랑 엄마…처럼….\n⟦P⟧"
  },
  {
   "key": "104a584a5136",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧노키아⟦3⟧가 ⟦4⟧미나⟦5⟧를 두고\n갈 리가 없잖아?\n괜찮아. 내가 금방 찾아서 데려올게.\n⟦P⟧"
  },
  {
   "key": "c98b48643aff",
   "speaker_korean": null,
   "korean": "⟦1⟧페이트 씨⟦2⟧\n잖아요!\n⟦P⟧"
  },
  {
   "key": "d6e94cc2d3c1",
   "speaker_korean": "노키아",
   "korean": "⟦1⟧「아….\n아뇨, 그런 말씀을.\n⟦P⟧"
  },
  {
   "key": "2f57bff46017",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「잘 지냈나, ⟦2⟧노키아⟦3⟧.\n⟦P⟧"
  },
  {
   "key": "874d07fde0e8",
   "speaker_korean": null,
   "korean": "역시 ⟦1⟧페이트⟦2⟧\n오빠다!\n⟦P⟧"
  },
  {
   "key": "a20bc4690de3",
   "speaker_korean": "미나",
   "korean": "⟦1⟧「⟦2⟧페이트⟦3⟧ 오빠?\n⟦P⟧"
  },
  {
   "key": "7a929f5dd1d0",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아무 말 없이 사라진 건\n미안하게 생각하고 있어.\n⟦P⟧무슨 말을 해도 변명밖에\n안 될 거라고는 생각하지만,\n⟦P⟧"
  }
 ]
}