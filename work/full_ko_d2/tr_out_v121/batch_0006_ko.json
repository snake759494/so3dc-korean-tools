{
 "batch_id": "batch_0006",
 "translations": [
  {
   "key": "998c067f4047",
   "speaker_korean": "페이트",
   "korean": "「나는…\n우리는 너희 ⟦1⟧FD공간⟦2⟧ 주민들에게\n놀아난 것뿐이었던 거냐!?"
  },
  {
   "key": "f5addce55bd1",
   "speaker_korean": "플러드",
   "korean": "「그렇게 말하면\n그렇긴 하지만"
  },
  {
   "key": "6906370589ca",
   "speaker_korean": "플러드",
   "korean": "「근데 너희들도 각자\n독자적인 AI 프로그램으로 움직이니까\n본질적으로는 우리랑 같아"
  },
  {
   "key": "1a2c7bf94feb",
   "speaker_korean": "플러드",
   "korean": "「딱히 컨트롤러로\n조종당하는 건 아니잖아\n적어도 난 그렇게 생각하는데\n그냥 존재하는 차원이 다를 뿐이야"
  },
  {
   "key": "e4e1c495985c",
   "speaker_korean": "마리아",
   "korean": "「그래서 평행세계라고\n표현한 거군"
  },
  {
   "key": "3178b314958d",
   "speaker_korean": "플러드",
   "korean": "「응"
  },
  {
   "key": "92c96364490f",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧엑스큐셔너⟦2⟧라는 게\n대체 뭐야?\n역시 프로그램인 거야?"
  },
  {
   "key": "5438506df301",
   "speaker_korean": "플러드",
   "korean": "「응, 맞아"
  },
  {
   "key": "ff6946dce8bc",
   "speaker_korean": "플러드",
   "korean": "「얼마 전에 발표된 보도자료에\n따르면 말이야, ⟦1⟧이터널 스피어⟦2⟧\n프로그램의 일부인 '은하계'라는\n구역에 이상이 발견됐다는 거야\n⟦P⟧형이 태어난 구역이지\n그래서 그 이상을 그대로\n방치해두면, 프로그램 전체에\n나쁜 영향을 끼칠 거라고\n판단한 모양이야\n그래서, 그 악영향 부분을 지우려고\n보내진 프로그램, 그게 바로 ⟦3⟧집행자⟦4⟧\n즉 ⟦5⟧엑스큐셔너⟦6⟧라는 거지"
  },
  {
   "key": "d890db029387",
   "speaker_korean": "마리아",
   "korean": "「버그 수정 프로그램\n이라는 거군"
  },
  {
   "key": "eab5b6f44218",
   "speaker_korean": "클리프",
   "korean": "「장난 아니냐…\n⟦P⟧신이니 뭐니 하는 것도\n어이없는 소리라고 생각했는데\n프로그램이라고!?"
  },
  {
   "key": "f4249e958e7e",
   "speaker_korean": "소피아",
   "korean": "「하지만, 우리가 프로그램이라면…\n어떻게 여기 존재할 수 있는 걸까요?\n이 아이 말이 사실이라면\n우리는 여기 존재할 수 없을 텐데…"
  },
  {
   "key": "7f79ece041c1",
   "speaker_korean": "플러드",
   "korean": "「그건 나도 몰라"
  },
  {
   "key": "575129c18247",
   "speaker_korean": "마리아",
   "korean": "「그런 거겠지\n라인갓 박사님이 주신 힘,\n프로그램이 낳은 프로그램\n…생각해보면, 소름 끼치는 힘이야"
  },
  {
   "key": "cc695301b89f",
   "speaker_korean": "클리프",
   "korean": "「그나저나, 꼬마 왕\n넌 왜 그렇게 잘 아는 거냐?"
  },
  {
   "key": "6154ff245870",
   "speaker_korean": "플러드",
   "korean": "「응\n내 친구가 ⟦1⟧이터널 스피어⟦2⟧\n개발사 관계자거든\n⟦3⟧블레어⟦4⟧라고 하는데\n나한테 이것저것 알려줬어\n아! 근데 오해는 하지 마\n난 적이 아니니까"
  },
  {
   "key": "a26cd838ca74",
   "speaker_korean": "마리아",
   "korean": "「그럼 왜\n우리를 여기로 데려온 거야?"
  },
  {
   "key": "ea5e5ad4c456",
   "speaker_korean": "플러드",
   "korean": "「음, 흥미가 있었다는 게\n제일 큰 이유일까\n⟦P⟧그야 보통은 안 믿기잖아?\n프로그램 생명체가 스스로의 힘으로\n이쪽 세계에 온다는 건\n상상도 못 할 이야기니까"
  },
  {
   "key": "3f7018a25c6f",
   "speaker_korean": "클리프",
   "korean": "「뭐, 그건 그렇지"
  },
  {
   "key": "500d59a40504",
   "speaker_korean": "플러드",
   "korean": "「…너희들은 ⟦1⟧엑스큐셔너⟦2⟧에\n맞서려고 온 거지?\n근데, 어때? 이길 수 있을 것 같아?"
  },
  {
   "key": "dfcc1200c76a",
   "speaker_korean": "플러드",
   "korean": "「⟦1⟧시큐리티서비스⟦2⟧!?"
  },
  {
   "key": "c7bc7c7c485b",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧플러드⟦2⟧,\n너, 역시!?"
  },
  {
   "key": "50db81289b09",
   "speaker_korean": "플러드",
   "korean": "「아니야\n난 아무것도 안 했어!"
  },
  {
   "key": "f0e5c33f77e6",
   "speaker_korean": "시큐리티서비스",
   "korean": "「움직이지 마!\n양손을 들어!"
  },
  {
   "key": "16b1da9a48ff",
   "speaker_korean": "시큐리티서비스",
   "korean": "「수상한 놈들,\n네놈들의 신병을 구속한다!"
  },
  {
   "key": "165322776d45",
   "speaker_korean": "플러드",
   "korean": "「엄마, 엄마가\n⟦1⟧시큐리티서비스⟦2⟧에 연락한 거야!?"
  },
  {
   "key": "612939df8cdd",
   "speaker_korean": "어머니",
   "korean": "「그야, ⟦1⟧플러드⟦2⟧…\n엄마는 네가 걱정돼서 그래"
  },
  {
   "key": "83796d8727d0",
   "speaker_korean": "플러드",
   "korean": "「진짜,\n쓸데없는 짓을 하고 그래!"
  },
  {
   "key": "b5bdb93dafb7",
   "speaker_korean": "페이트",
   "korean": "「어떻게 해야 할지 지금 나로선\n잘 모르겠어…하지만,\n여기서 붙잡힐 수는 없어"
  },
  {
   "key": "c82813d4910a",
   "speaker_korean": "클리프",
   "korean": "「그래, 그렇지"
  },
  {
   "key": "14836f21955d",
   "speaker_korean": "마리아",
   "korean": "「갈까?"
  },
  {
   "key": "7ec8353efd5a",
   "speaker_korean": "클리프",
   "korean": "「적이냐!?"
  },
  {
   "key": "1ea77b9d1aab",
   "speaker_korean": "플러드",
   "korean": "「다녀왔어~"
  },
  {
   "key": "102c54fbe835",
   "speaker_korean": "어머니",
   "korean": "「어서 오렴…응?\n⟦1⟧플러드⟦2⟧, 이분들은?\n옷차림이 꽤 독특한데…"
  },
  {
   "key": "9faf143fb1f4",
   "speaker_korean": "플러드",
   "korean": "「어? 아, 친구, 친구야"
  },
  {
   "key": "2c461c73ab5c",
   "speaker_korean": "어머니",
   "korean": "「친구…그렇구나"
  },
  {
   "key": "0fef45bb4c89",
   "speaker_korean": "클리프",
   "korean": "「그런 걸 물어서\n뭘 어쩌려고?"
  },
  {
   "key": "eee11b84e17c",
   "speaker_korean": "페이트",
   "korean": "「나는,\n⟦1⟧페이트 라인갓⟦2⟧\n⟦3⟧지구⟦4⟧라는 행성 출신인데…"
  },
  {
   "key": "4928449ae0a2",
   "speaker_korean": "플러드",
   "korean": "「자, 이러면 됐고"
  },
  {
   "key": "f583365d5036",
   "speaker_korean": "플러드",
   "korean": "「…나왔다!"
  },
  {
   "key": "4ca49f38b48d",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧블레어⟦2⟧?"
  },
  {
   "key": "ffc2d367154a",
   "speaker_korean": "넬",
   "korean": "「뭐가 역시라는 거냐?\n알기 쉽게 설명을\n좀 해줬으면 좋겠는데"
  },
  {
   "key": "5278d62f1378",
   "speaker_korean": "알벨",
   "korean": "「어이, 꼬맹이\n뭘 혼자 납득하고 있는 거냐"
  },
  {
   "key": "91a24bb20406",
   "speaker_korean": "스프레",
   "korean": "「저기, 뭐가 역시라는 거야?\n나도 알 수 있게 설명해줘"
  },
  {
   "key": "afab17e9945d",
   "speaker_korean": "클리프",
   "korean": "「어이, 꼬마 왕\n혼자 납득하지 좀 마라\n뭐가 역시라는 거냐?"
  },
  {
   "key": "45c81e7c99f4",
   "speaker_korean": "클리프",
   "korean": "「너, ⟦1⟧엑스큐셔너⟦2⟧랑\n관계있는 건 아니겠지"
  },
  {
   "key": "e15c7d4aed8c",
   "speaker_korean": "플러드",
   "korean": "「음,\n그건 좀 다른데"
  },
  {
   "key": "0e7fd4e470d0",
   "speaker_korean": "플러드",
   "korean": "「뭐라고 해야 할까?\n너희들은\n⟦1⟧이터널 스피어⟦2⟧의\n주민인 거잖아"
  },
  {
   "key": "aeb49447c5d7",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧이터널 스피어⟦2⟧?"
  },
  {
   "key": "1e0fc7c685ff",
   "speaker_korean": "플러드",
   "korean": "「그래, 이거야"
  },
  {
   "key": "9b23bed0a302",
   "speaker_korean": "플러드",
   "korean": "「저기, 형 이름 전부\n알려줄 수 있어?\n그리고 출신지도"
  },
  {
   "key": "22c59bdf0380",
   "speaker_korean": "페이트",
   "korean": "「내, 이름?"
  },
  {
   "key": "a383df152391",
   "speaker_korean": "플러드",
   "korean": "「딱히, 별건 아니고\n그냥 확인하고 싶을 뿐이야"
  },
  {
   "key": "37d248a008e9",
   "speaker_korean": "플러드",
   "korean": "「굉장해!"
  },
  {
   "key": "fa6a6eec487a",
   "speaker_korean": "플러드",
   "korean": "「역시, 너희들은\n그랬던 거구나\n그렇군, 납득이야\n⟦1⟧블레어⟦2⟧ 말대로네"
  },
  {
   "key": "70bd5698ef75",
   "speaker_korean": "로저",
   "korean": "「야, 뭐가 역시라는 거냐?\n이 몸한테도 알려달라고"
  }
 ]
}