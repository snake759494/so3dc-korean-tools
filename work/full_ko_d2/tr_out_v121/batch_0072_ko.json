{
 "batch_id": "batch_0072",
 "translations": [
  {
   "key": "8be3337a93c4",
   "speaker_korean": "온화한 어머니",
   "korean": "⟦1⟧「⟦2⟧천본화⟦3⟧에 빌어온 소원은,\n이루어지지 않은 것 같네요.\n⟦P⟧결국 주술이란 건,\n그저 주술일 뿐인 거예요.\n그런 건 알고 있었어요.\n분명 알고 있었을 텐데…\n⟦P⟧"
  },
  {
   "key": "4545141079e9",
   "speaker_korean": "온화한 어머니",
   "korean": "⟦1⟧「⟦2⟧천본화⟦3⟧에 소원을 담아 그저 빌기만 하는 것…\n역시 그것만으론 안 되는 거였어요.\n⟦P⟧소원이 있다면, 그걸 이루기 위한\n행동을 해야죠.\n⟦P⟧기도만 올리고 그저 기다리기만 하면\n소원이 이루어진다니…\n그런 좋은 이야기가 있을 리 없잖아요.\n⟦P⟧"
  },
  {
   "key": "e0164a87ec60",
   "speaker_korean": null,
   "korean": "하지만, 결국 주술은 주술일 뿐.\n그 사실을 제대로 이해해\n둬야겠죠.\n⟦P⟧"
  },
  {
   "key": "e422f1948f1e",
   "speaker_korean": "온화한 어머니",
   "korean": "⟦1⟧「세계 평화를 빌며 ⟦2⟧천본화⟦3⟧를 행하는 것,\n그 자체는 나쁜 일이 아니에요.\n⟦P⟧"
  },
  {
   "key": "669ee68b34bb",
   "speaker_korean": "아미나",
   "korean": "⟦1⟧「여러분의 여행이 무사히 끝나기를\n기도하고 있어요.\n⟦P⟧여러분이 나아갈 길이,\n달의 여신 ⟦2⟧이리스 님⟦3⟧의 가호로\n밝게 비추어지기를.\n⟦P⟧"
  },
  {
   "key": "fc299278af6d",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「음~\n지금 쓰는 것보다 좋은 공구가 있으면\n훨씬 편해질 텐데 말이야…\n⟦P⟧근데, 이 나라에서 그건 그림의 떡\n이란 말이지…\n⟦P⟧"
  },
  {
   "key": "cc0bcd309131",
   "speaker_korean": null,
   "korean": "⟦1⟧드레메라 공구세트⟦2⟧를 보여주시겠습니까?\n⟦P⟧"
  },
  {
   "key": "74b44c203692",
   "speaker_korean": null,
   "korean": "⟦1⟧드레메라 공구세트⟦2⟧, 건네시겠습니까?\n⟦P⟧"
  },
  {
   "key": "9a3d39914766",
   "speaker_korean": null,
   "korean": "⟦1⟧・갖고 싶으면 줄게."
  },
  {
   "key": "c67f90a8e18c",
   "speaker_korean": null,
   "korean": "⟦1⟧・미안하지만 이건 못 줘."
  },
  {
   "key": "e46bbf28d3a0",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「엇!?\n혹시 그거, 드레메라제\n신형 툴이야?\n⟦P⟧"
  },
  {
   "key": "d36efa17c465",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「그렇구나…\n그렇다는 건 적어도\n구할 방법은 있다는 거네.\n⟦P⟧그럼 아직 희망은 있는 건가…\n어차피 불법일 거라면 제작 효율을 생각해서\nlO툴을 밀수입하는 게…\n중얼중얼…\n⟦P⟧"
  },
  {
   "key": "aed530b1d6f8",
   "speaker_korean": null,
   "korean": "크리에이터 메릴과 계약했습니다.\n⟦P⟧"
  },
  {
   "key": "cc04ff71501b",
   "speaker_korean": null,
   "korean": "응.\n이런 걸 손에 넣을 수 있다면,\n딱히 너랑 손잡아 줘도 괜찮아.\n⟦P⟧"
  },
  {
   "key": "c44133be6c2b",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「⟦2⟧시술⟦3⟧이라는, 정체도 모를\n그런 미덥지 않은 것에 잘도 기대는구나…\n난 됐어. 패스 패스.\n⟦P⟧"
  },
  {
   "key": "b24e4064f954",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「이거야.\n이 색, 이 광택, 이 그립감.\n역시 모터 툴은 드레메라제가\n최고라니까.\n⟦P⟧"
  },
  {
   "key": "89f18e62536c",
   "speaker_korean": "페이트",
   "korean": "(이 목소리는……"
  },
  {
   "key": "e65183d0ea02",
   "speaker_korean": "여성의 목소리",
   "korean": "「그렇죠,\n아주머니."
  },
  {
   "key": "856b7a53c65b",
   "speaker_korean": "페이트",
   "korean": "(이 집 안인가?"
  },
  {
   "key": "28554f910ded",
   "speaker_korean": "페이트",
   "korean": "(⟦1⟧아미나⟦2⟧의 목소리?"
  },
  {
   "key": "636780c0c166",
   "speaker_korean": "여성의 목소리",
   "korean": "「분명 괜찮을 거예요."
  },
  {
   "key": "30b072e022f0",
   "speaker_korean": "중년 여성의 목소리",
   "korean": "「그야 그렇지~"
  },
  {
   "key": "d9868183a5b5",
   "speaker_korean": "여성의 목소리",
   "korean": "「예. 저도 그렇게 생각해요."
  },
  {
   "key": "88b35b291512",
   "speaker_korean": "중년 여성의 목소리",
   "korean": "「그런 일도\n있는 법이구나…"
  },
  {
   "key": "dc563c67c672",
   "speaker_korean": "중년 여성의 목소리",
   "korean": "「싫다니까~"
  },
  {
   "key": "53918fe7d65a",
   "speaker_korean": "여성의 목소리",
   "korean": "「후후후."
  },
  {
   "key": "2834d347b07b",
   "speaker_korean": "넬",
   "korean": "「늦었네."
  },
  {
   "key": "ca43bd011181",
   "speaker_korean": "넬",
   "korean": "「무슨 얘기를 하고 있었던 거야?"
  },
  {
   "key": "fc5d31705477",
   "speaker_korean": "클리프",
   "korean": "「별거 아니야.\n이 녀석한테 ⟦1⟧아미나⟦2⟧랑 떨어지는 게\n섭섭하냐고 물어본 거라고."
  },
  {
   "key": "55b9dda6f1cb",
   "speaker_korean": "넬",
   "korean": "「그건 어리석은 질문이네.\n섭섭한 게 당연하잖아."
  },
  {
   "key": "308bec3774cc",
   "speaker_korean": "페이트",
   "korean": "「그런, 놀리지 마세요.\n그녀와는 그런 사이 아니니까요."
  },
  {
   "key": "063bb5b89c68",
   "speaker_korean": "넬",
   "korean": "「후후…"
  },
  {
   "key": "15c50b267afd",
   "speaker_korean": "페이트",
   "korean": "「아… 의사 건은,\n감사했습니다."
  },
  {
   "key": "10d2806cd45b",
   "speaker_korean": "넬",
   "korean": "「고맙다는 말을 들을 정도는 아니야.\n난… 그저 내가 하고 싶어서 한 것뿐이니까."
  },
  {
   "key": "7ec5ce9da376",
   "speaker_korean": "페이트",
   "korean": "「하지만―――"
  },
  {
   "key": "d89449c79d52",
   "speaker_korean": "넬",
   "korean": "「사실은 말이지… 그 의사, 내 부하야."
  },
  {
   "key": "9e91cbb51a9c",
   "speaker_korean": "클리프",
   "korean": "「그렇다는 건, ⟦1⟧타이네브들⟦2⟧과 같은 건가?"
  },
  {
   "key": "a9a764ad261f",
   "speaker_korean": "넬",
   "korean": "「아…다소 업무 내용은 다르지만,\n일단 ⟦1⟧시하츠⟦2⟧의 밀정이거든.\n그・러・니・까… 내 지갑은 안 아픈 거야."
  },
  {
   "key": "027096af6498",
   "speaker_korean": "페이트",
   "korean": "「그래도, 감사 인사는\n하게 해 주세요."
  },
  {
   "key": "7892189d6d60",
   "speaker_korean": "넬",
   "korean": "「신경 쓰지 말라고 했잖아."
  },
  {
   "key": "a70a23f5a431",
   "speaker_korean": "페이트",
   "korean": "「…뭔가요?"
  },
  {
   "key": "a29ada8647fe",
   "speaker_korean": "페이트",
   "korean": "「무슨 말씀이세요?"
  },
  {
   "key": "df8c972e5283",
   "speaker_korean": "넬",
   "korean": "「할 수 있는 일을 하겠다는 얘기야.\n그건 우리한테 협력해 주겠다는\n뜻으로 받아들여도 되는 거지?"
  },
  {
   "key": "642a4598e949",
   "speaker_korean": "페이트",
   "korean": "「예, 그렇습니다."
  },
  {
   "key": "9337b56be046",
   "speaker_korean": "넬",
   "korean": "「…후.\n네 마음이 바뀐 걸 환영해.\n⟦1⟧아미나 일행⟦2⟧에게는 감사해야겠네.\n그래도, 정말 괜찮은 거야?"
  },
  {
   "key": "6a954d685898",
   "speaker_korean": "클리프",
   "korean": "「나는 이 녀석 판단에\n따를 뿐이다."
  },
  {
   "key": "d64df2222998",
   "speaker_korean": "페이트",
   "korean": "「예…이미 정했어요."
  },
  {
   "key": "8c416f030153",
   "speaker_korean": "넬",
   "korean": "「그래…그런 거라면,\n다시 한번 잘 부탁해."
  },
  {
   "key": "7e55b9e471a4",
   "speaker_korean": "페이트",
   "korean": "「예…어서 ⟦1⟧시랜드⟦2⟧로\n향합시다."
  },
  {
   "key": "7a3f0d5f5017",
   "speaker_korean": "넬",
   "korean": "「아까 그 얘기…믿어도 되는 거야?"
  },
  {
   "key": "2c79a99062a5",
   "speaker_korean": "넬",
   "korean": "「……"
  },
  {
   "key": "6c052adc1f63",
   "speaker_korean": null,
   "korean": "⟦1⟧3400폴⟦2⟧을 손에 넣었다."
  }
 ]
}