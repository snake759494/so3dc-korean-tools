{
 "batch_id": "batch_0208",
 "translations": [
  {
   "key": "90b94ec24181",
   "speaker_korean": null,
   "korean": "⟦1⟧글레어 체인⟦2⟧을 손에 넣었다"
  },
  {
   "key": "063d018376e9",
   "speaker_korean": "페이트",
   "korean": "「후, 여기라면\n⟦1⟧드래곤⟦2⟧도 못 쫓아올 것 같군"
  },
  {
   "key": "a18123b4b18c",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧드래곤⟦2⟧…의 새끼?"
  },
  {
   "key": "dec8fdaec625",
   "speaker_korean": "페이트",
   "korean": "「따라오라고\n말하는 건가…?"
  },
  {
   "key": "3783d7da7cbb",
   "speaker_korean": "페이트",
   "korean": "「기뻐하는 것 같군"
  },
  {
   "key": "58392d2b8926",
   "speaker_korean": "페이트",
   "korean": "「즐거워하는 것 같은데"
  },
  {
   "key": "b394f5432683",
   "speaker_korean": "페이트",
   "korean": "「슬퍼하는 것 같다"
  },
  {
   "key": "ffd2883ed232",
   "speaker_korean": "페이트",
   "korean": "「화난 것 같군…"
  },
  {
   "key": "41bb63ffca7b",
   "speaker_korean": null,
   "korean": "⟦1⟧46000폴⟦2⟧을 손에 넣었다"
  },
  {
   "key": "d11d0658f8bd",
   "speaker_korean": null,
   "korean": "⟦1⟧다마스커스 너클⟦2⟧을 손에 넣었다"
  },
  {
   "key": "1583d8ee934b",
   "speaker_korean": "페이트",
   "korean": "「뭐지, 이건?\n⟦1⟧버니⟦2⟧인가?\n신경 쓰이네… 귀가…"
  },
  {
   "key": "9ef504ebe35e",
   "speaker_korean": null,
   "korean": "⟦1⟧・조각상을 본다"
  },
  {
   "key": "4d6d97c2b9a6",
   "speaker_korean": null,
   "korean": "⟦1⟧・안 본다"
  },
  {
   "key": "1b95b80053f9",
   "speaker_korean": "페이트",
   "korean": "「신경 쓰이는데…\n엄청 신경 쓰이는데…\n귀가… 귀가아…"
  },
  {
   "key": "b9ef331f25f8",
   "speaker_korean": "페이트",
   "korean": "「이제 아무것도 없는 것 같다"
  },
  {
   "key": "9dd572cc0b22",
   "speaker_korean": "페이트",
   "korean": "「이건… 열쇠… 인가?"
  },
  {
   "key": "f366a3494fc6",
   "speaker_korean": "페이트",
   "korean": "「열쇠라고 해야 할지, 귀라고 해야 할지…"
  },
  {
   "key": "1db9ff5fe54d",
   "speaker_korean": null,
   "korean": "⟦1⟧토끼 귀 열쇠⟦2⟧를 손에 넣었다"
  },
  {
   "key": "608572b4df62",
   "speaker_korean": null,
   "korean": "칠7서루\n작열지옥\n귀긴종족7거인키내려봄Xι적색7쌍둥이\n안비밀오⟦G:41bbefcd⟧L힘※해＝방tθ누구"
  },
  {
   "key": "0ae6f87622f4",
   "speaker_korean": null,
   "korean": "⟦1⟧토끼 귀 성배⟦2⟧를 손에 넣었다"
  },
  {
   "key": "8c1c3c28b496",
   "speaker_korean": "페이트",
   "korean": "「음!?\n문에 뭔가 적혀 있는데"
  },
  {
   "key": "cce2b68c36a7",
   "speaker_korean": null,
   "korean": "몬스터 사절\n여벌열쇠 찾지 마!!\nPL 할멈오빠"
  },
  {
   "key": "3cfe96421d56",
   "speaker_korean": "페이트",
   "korean": "「…역시 이건가\n⟦P⟧토끼 귀 열쇠를 쓰자"
  },
  {
   "key": "72db8fe6c1dc",
   "speaker_korean": "페이트",
   "korean": "「자물쇠가 걸려 있군\n⟦P⟧"
  },
  {
   "key": "8f81f2a1f2cb",
   "speaker_korean": "페이트",
   "korean": "「그야말로 그런 느낌의 문이\n안쪽에 있군. 하지만 이걸론\n열 수가 없어\n뭔가 여는 방법을 찾아야 하는데…"
  },
  {
   "key": "ec8d62cb1a6b",
   "speaker_korean": "페이트",
   "korean": "「이건…\n앞이 거의 안 보이는군\n손으로 더듬으며\n나아갈 수밖에 없나…"
  },
  {
   "key": "14a8535a5d55",
   "speaker_korean": null,
   "korean": "⟦1⟧예언서2⟦2⟧를 손에 넣었다"
  },
  {
   "key": "5d80eb1b21f7",
   "speaker_korean": "???",
   "korean": "「너희들은 누구야?\n멋대로 남의 집 안에\n들어오지 말아줄래?"
  },
  {
   "key": "7e4c9c60c9eb",
   "speaker_korean": "???",
   "korean": "「그래서, 너희들 대체 누구야?"
  },
  {
   "key": "b9cc3c71bea3",
   "speaker_korean": "???",
   "korean": "「너희들…\n예전에 얘기한 적 있었지?"
  },
  {
   "key": "2bb30f4fd911",
   "speaker_korean": null,
   "korean": "⟦1⟧・1000폴 낸다"
  },
  {
   "key": "dc0f1c63baa7",
   "speaker_korean": null,
   "korean": "⟦1⟧・10000폴 낸다"
  },
  {
   "key": "e6223097224b",
   "speaker_korean": null,
   "korean": "⟦1⟧・30000폴 낸다"
  },
  {
   "key": "f2fa6f1e17fa",
   "speaker_korean": "바닐라",
   "korean": "「그래서야 얘기가 안 되잖아\n이 얘기는 없었던 걸로 해줘"
  },
  {
   "key": "c2f2199f3f88",
   "speaker_korean": "바닐라",
   "korean": "「음…뭐 적당한 선이려나\n좋아. 맡아줄게"
  },
  {
   "key": "9880dc06071f",
   "speaker_korean": "바닐라",
   "korean": "「…근데 돈은 못 낼 것 같네"
  },
  {
   "key": "180418563404",
   "speaker_korean": "페이트",
   "korean": "「그런…것 같네"
  },
  {
   "key": "5473014d4f99",
   "speaker_korean": "바닐라",
   "korean": "「그럼, 돈이 모이면\n다시 와줘"
  },
  {
   "key": "604d9e1d5922",
   "speaker_korean": "바닐라",
   "korean": "「어? 그렇게나 주는 거야?\n야호!"
  },
  {
   "key": "09be127eac12",
   "speaker_korean": "페이트",
   "korean": "「어, 아, 잠깐…"
  },
  {
   "key": "3cc468c8825c",
   "speaker_korean": "바닐라",
   "korean": "「사나이가 한 입으로 두 말은 안 하지\n그렇지, 누나?"
  },
  {
   "key": "28e83bf89a17",
   "speaker_korean": "???",
   "korean": "「여벌 열쇠 찾지 말랬잖아,\n못 읽었어?"
  },
  {
   "key": "151371d3739b",
   "speaker_korean": "페이트",
   "korean": "「여벌 열쇠…?"
  },
  {
   "key": "2193e08a0863",
   "speaker_korean": "마리아",
   "korean": "「아마 그 토끼 귀 열쇠일 거야"
  },
  {
   "key": "821ebb79ade9",
   "speaker_korean": "페이트",
   "korean": "「아, 그렇구나. 그거 말이지"
  },
  {
   "key": "10ae00bc377b",
   "speaker_korean": "???",
   "korean": "「…뭐, 됐나\n몬스터도 아니고\n그래서, 무슨 볼일인데?"
  },
  {
   "key": "c03853a24b92",
   "speaker_korean": "페이트",
   "korean": "「그 전에,\n자기소개부터 할게"
  },
  {
   "key": "f78e8e075d7d",
   "speaker_korean": "페이트",
   "korean": "「나는 ⟦1⟧페이트⟦2⟧야"
  },
  {
   "key": "30f7a7e20824",
   "speaker_korean": "페이트",
   "korean": "「그리고,\n그녀가 ⟦1⟧마리아⟦2⟧야"
  },
  {
   "key": "4f3e171f4315",
   "speaker_korean": "마리아",
   "korean": "「그리고 그 외 다수"
  },
  {
   "key": "f1319ee15288",
   "speaker_korean": "알벨",
   "korean": "「이봐,\n누가 그 외 다수야!"
  },
  {
   "key": "96f1338023b5",
   "speaker_korean": "???",
   "korean": "「나는 ⟦1⟧바닐라⟦2⟧라고 해\n뭐, 잘 부탁해"
  },
  {
   "key": "e6d42e28ea85",
   "speaker_korean": "페이트",
   "korean": "「우리는 후작급 ⟦1⟧드래곤⟦2⟧을\n만나러 왔어"
  },
  {
   "key": "488ea421de2e",
   "speaker_korean": "바닐라",
   "korean": "「그분을?\n흐음…"
  }
 ]
}