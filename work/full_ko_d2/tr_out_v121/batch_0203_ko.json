{
 "batch_id": "batch_0203",
 "translations": [
  {
   "key": "2fa4cf8dd01a",
   "speaker_korean": null,
   "korean": "⟦1⟧3000폴⟦2⟧을 손에 넣었다."
  },
  {
   "key": "870ddfacae77",
   "speaker_korean": null,
   "korean": "⟦1⟧5000폴⟦2⟧을 손에 넣었다."
  },
  {
   "key": "68742883b248",
   "speaker_korean": null,
   "korean": "⟦1⟧팔시온⟦2⟧을 손에 넣었다."
  },
  {
   "key": "a015ac337c6d",
   "speaker_korean": null,
   "korean": "⟦1⟧영감의 목걸이⟦2⟧를 손에 넣었다."
  },
  {
   "key": "efd908daf53a",
   "speaker_korean": null,
   "korean": "⟦1⟧오크 주얼리⟦2⟧를 손에 넣었다."
  },
  {
   "key": "dd906248d09b",
   "speaker_korean": "페이트",
   "korean": "「…뭔가 스위치 같은 게 있군.\n지금은 OFF 상태군."
  },
  {
   "key": "ff2a52d853b0",
   "speaker_korean": null,
   "korean": "⟦1⟧・스위치를 켠다."
  },
  {
   "key": "564442a98a24",
   "speaker_korean": "페이트",
   "korean": "「…뭔가 스위치 같은 게 있군.\n지금은 ON 상태군."
  },
  {
   "key": "435de72fd6e4",
   "speaker_korean": null,
   "korean": "⟦1⟧・스위치를 끈다."
  },
  {
   "key": "449fe5cb5364",
   "speaker_korean": "페이트",
   "korean": "「이제 더 조작할 필요는\n없겠지."
  },
  {
   "key": "a957c8e86afd",
   "speaker_korean": "페이트",
   "korean": "「레버가 있군.\n뭔가를 조작하기 위한\n물건인 걸까?"
  },
  {
   "key": "849141ffdb2a",
   "speaker_korean": null,
   "korean": "⟦1⟧・레버를 내린다."
  },
  {
   "key": "3678e295e49a",
   "speaker_korean": null,
   "korean": "⟦1⟧콜드 체인⟦2⟧을 손에 넣었다."
  },
  {
   "key": "2d7f0125ad95",
   "speaker_korean": null,
   "korean": "⟦1⟧인챈트 북(땅・무효)⟦2⟧을 손에 넣었다."
  },
  {
   "key": "0cba2197811a",
   "speaker_korean": "페이트",
   "korean": "「안 되나….\n꽤 단단히 닫혀 있군."
  },
  {
   "key": "95ec950a24bd",
   "speaker_korean": "페이트",
   "korean": "「스위치를 전환하는 건\n안 되는 것 같군."
  },
  {
   "key": "9a95160f3393",
   "speaker_korean": "페이트",
   "korean": "「…뭔가 스위치 같은 게 있군.\n지금은 OFF 상태다."
  },
  {
   "key": "d3eeaf2a5894",
   "speaker_korean": "페이트",
   "korean": "「안 되겠어.\n블록이 움직이고 있어서\n나아갈 수가 없어."
  },
  {
   "key": "22691a3cc49c",
   "speaker_korean": null,
   "korean": "⟦1⟧루나 탈리스만⟦2⟧을 손에 넣었다."
  },
  {
   "key": "6e153d6c33f8",
   "speaker_korean": null,
   "korean": "새겨진 글\n신궁병들이 지키는 썩어가는⟦G:41bbefcd⟧회랑\n관 속에 잠든 태양왕\n말없는 해골의 말은?"
  },
  {
   "key": "058bc326bd08",
   "speaker_korean": null,
   "korean": "⟦1⟧인트 시드⟦2⟧를 손에 넣었다."
  },
  {
   "key": "328c755b7bfa",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「역시 내 예상이 맞았네.\n형씨들이라면, 남들은 못 하는 일도\n해낼 거라고 생각했거든.\n⟦P⟧장사 기본은 선행 투자야.\n앞의 앞까지 내다봐야,\n성공하는 거지.\n⟦P⟧"
  },
  {
   "key": "6458f78ba492",
   "speaker_korean": null,
   "korean": "⟦1⟧・해머를 넘겨줘."
  },
  {
   "key": "05f39a6a47ca",
   "speaker_korean": null,
   "korean": "⟦1⟧・배니시 해머가 뭐였지…떠올려본다."
  },
  {
   "key": "8452ccf7b586",
   "speaker_korean": null,
   "korean": "⟦1⟧・할 말 없어."
  },
  {
   "key": "b663acfbc82e",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「말 건 건 형씨들이면서,\n그 태도는 뭐야?\n⟦P⟧뭐, 상관없지만.\n우리 해머도 쓰여야 제 값을 하니까.\n손님은 왕이잖아.\n⟦P⟧"
  },
  {
   "key": "88e062110d3c",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「우리 해머는 특별 제작이야.\n아무리 형씨들이라도, 더는\n못 들 거야.\n무겁지?\n⟦P⟧"
  },
  {
   "key": "13711e075a46",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「우리 해머가 정말로\n갖고 싶다고 하면, 특별히\n팔아줄 수도 있는데 말이야.\n⟦P⟧"
  },
  {
   "key": "d8ec00bcdff5",
   "speaker_korean": null,
   "korean": "⟦1⟧・하나 팔아줘."
  },
  {
   "key": "db781da8d347",
   "speaker_korean": null,
   "korean": "⟦1⟧・다섯 개 팔아줘."
  },
  {
   "key": "7d9ee0fcafdf",
   "speaker_korean": null,
   "korean": "⟦1⟧・10회분 팔아줘."
  },
  {
   "key": "96922e0262b6",
   "speaker_korean": null,
   "korean": "⟦1⟧・이제 필요 없어."
  },
  {
   "key": "7c7c18e53a6c",
   "speaker_korean": "보유 해머 수",
   "korean": "⟦1⟧⟦2⟧⟦3⟧/회"
  },
  {
   "key": "25feca8f324f",
   "speaker_korean": null,
   "korean": "⟦1⟧・그럼, 받아볼까."
  },
  {
   "key": "cef3be27a7c9",
   "speaker_korean": null,
   "korean": "⟦1⟧・역시 됐어."
  },
  {
   "key": "2250f1b9f6b0",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「그러면 다 못 들어.\n형씨들 체격이면 들 수 있는 건\n10회 정도까지일 테니까.\n⟦P⟧으음…\n그러면 ⟦2⟧⟦3⟧폴⟦4⟧을\n받으면 되려나?\n⟦P⟧"
  },
  {
   "key": "f3f4c4f5bbbc",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「뭐야, 안 살 거야?\n푼돈 아끼려다 크게 다치기라도 하면\n재미없을 텐데 말이야.\n⟦P⟧"
  },
  {
   "key": "f3323e3107e3",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「우리 해머는 성능은 좋은데,\n잘 부서지니까.\n다루는 데 조심해.\n⟦P⟧"
  },
  {
   "key": "225d67dd2092",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「돈이 모자라잖아.\n내가 악당은 아니지만, 받을 수 있는데\n그냥 넘어갈 만큼 만만하지도 않다고.\n⟦P⟧"
  },
  {
   "key": "7773914cb99d",
   "speaker_korean": null,
   "korean": "⟦1⟧・당연히 낼게."
  },
  {
   "key": "ce2e65cb4503",
   "speaker_korean": null,
   "korean": "⟦1⟧・마음이 바뀌었네."
  },
  {
   "key": "f74057a55cf0",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「그럼, ⟦2⟧⟦3⟧폴⟦4⟧이야.\n아무리 그래도, 이 정도 금액을\n못 낼 리는 없겠지?\n⟦P⟧"
  },
  {
   "key": "9cdd391c9abf",
   "speaker_korean": null,
   "korean": "⟦1⟧・좋아, 산다."
  },
  {
   "key": "eef80da82dc4",
   "speaker_korean": null,
   "korean": "⟦1⟧・역시 필요 없어."
  },
  {
   "key": "f40ce779efcd",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「그럼, ⟦2⟧⟦3⟧폴⟦4⟧.\n비싸다고 볼지 싸다고 볼지는\n형씨들 마음이겠지만,\n난 이게 시세라고 생각해.\n⟦P⟧"
  },
  {
   "key": "e8298cc16644",
   "speaker_korean": null,
   "korean": "⟦1⟧・싸네. 산다!"
  },
  {
   "key": "8358bff5a3d9",
   "speaker_korean": null,
   "korean": "⟦1⟧・너무 비싸."
  },
  {
   "key": "cfd4c969b718",
   "speaker_korean": "마치래빗족의 해머 장인",
   "korean": "⟦1⟧「어머나…\n많이 썼구나.\n그럼, ⟦2⟧⟦3⟧폴⟦4⟧이야.\n⟦P⟧"
  }
 ]
}