{
 "batch_id": "batch_0139",
 "translations": [
  {
   "key": "3a179b62efd6",
   "speaker_korean": null,
   "korean": "문장유전학연구소"
  },
  {
   "key": "236619e14b2b",
   "speaker_korean": "페이트",
   "korean": "「…안 되겠어.\n일반 연구 데이터밖에 못 찾겠어."
  },
  {
   "key": "daf9d6ae965e",
   "speaker_korean": "클리프",
   "korean": "「컴퓨터, ⟦1⟧문장유전자학⟦2⟧을\n이용한 무기에 대한\n데이터베이스를 열람하고 싶은데."
  },
  {
   "key": "7d7545c2207e",
   "speaker_korean": "컴퓨터",
   "korean": "『해당하는 데이터, 존재하지 않습니다."
  },
  {
   "key": "72d1b986acf7",
   "speaker_korean": "페이트",
   "korean": "「젠장!\n정말 그런 데이터가 있는 거야?!"
  },
  {
   "key": "6a4bb4689911",
   "speaker_korean": "소피아",
   "korean": "「아저씨가 거짓말할 리 없는걸.\n분명 어딘가에 데이터는 있을 거야."
  },
  {
   "key": "b2060292faa3",
   "speaker_korean": "페이트",
   "korean": "「알아…\n알고는 있는데…"
  },
  {
   "key": "0ae0a529edf5",
   "speaker_korean": "마리아",
   "korean": "「컴퓨터, 내 유전자 정보를\n스캔해서, 그 데이터와 일치하는\n데이터베이스를 검색해."
  },
  {
   "key": "0a150c664af0",
   "speaker_korean": "컴퓨터",
   "korean": "『알겠습니다."
  },
  {
   "key": "75b765068664",
   "speaker_korean": "컴퓨터",
   "korean": "『…검색 중…\n⟦P⟧………·."
  },
  {
   "key": "c065b989cb8e",
   "speaker_korean": "컴퓨터",
   "korean": "『1건이 발견되었습니다."
  },
  {
   "key": "61f13500c994",
   "speaker_korean": "클리프",
   "korean": "「빙고♪"
  },
  {
   "key": "b367a4827435",
   "speaker_korean": "마리아",
   "korean": "「표시해."
  },
  {
   "key": "c84a895feb89",
   "speaker_korean": "페이트",
   "korean": "「『다가올 인류의 위기에 대하여』?"
  },
  {
   "key": "09f5f0b3b424",
   "speaker_korean": "마리아",
   "korean": "「재생해 보자."
  },
  {
   "key": "b04586fbca6f",
   "speaker_korean": "소피아",
   "korean": "「아빠랑…\n⟦1⟧로키시 아저씨들⟦2⟧?"
  },
  {
   "key": "82737514704d",
   "speaker_korean": "페이트",
   "korean": "「젊어 보이지만,\n아마 맞을 거야."
  },
  {
   "key": "01f42d72460a",
   "speaker_korean": "페이트",
   "korean": "「이 끝에 있는 여자가?"
  },
  {
   "key": "9c8f8cba65b5",
   "speaker_korean": "마리아",
   "korean": "「그래…\n내… 어머니야."
  },
  {
   "key": "141978e5b762",
   "speaker_korean": "마리아",
   "korean": "「그렇네… 포기하긴 일러."
  },
  {
   "key": "24077449ad25",
   "speaker_korean": "마리아",
   "korean": "「어머니…"
  },
  {
   "key": "07302d534abc",
   "speaker_korean": "로키시",
   "korean": "『수 주에 걸친 조사 결과, ⟦1⟧타임게이트⟦2⟧는\n문장 데이터에 반응함이 확인됐습니다.\n그리고 ⟦3⟧타임게이트⟦4⟧에 특수한 문장 데이터를\n흘려 넣으면 ⟦5⟧타임게이트⟦6⟧ 자체의 기록 데이터를\n취득할 수 있다는 사실도 새롭게\n알게 되었습니다."
  },
  {
   "key": "bf490db111be",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧FD…인⟦2⟧?\n또 알 수 없는 말이 나왔네."
  },
  {
   "key": "ac1caa81e3cf",
   "speaker_korean": "알벨",
   "korean": "「⟦1⟧FD…인⟦2⟧?"
  },
  {
   "key": "2d175c5ab2f7",
   "speaker_korean": "로저",
   "korean": "「⟦1⟧FD…인⟦2⟧? 그게 뭔데?\n먹는 거냐?"
  },
  {
   "key": "f5eaabf49a54",
   "speaker_korean": "스프레",
   "korean": "「⟦1⟧FD…인⟦2⟧?"
  },
  {
   "key": "f24a93b5ec27",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧FD…인⟦2⟧?"
  },
  {
   "key": "350aee30ac78",
   "speaker_korean": "로키시",
   "korean": "『⟦1⟧ＦHⅡvＤ\"I6at\"Ha인⟦2⟧…\n우리를 훨씬 능가하는 기술력을 지니고,\n시간을 오갈 수 있는 인간입니다.\n⟦P⟧그리고 연구를 진행하다 보니,\n실은 그들이야말로 우리가 사는 세계의\n창조왕일 가능성이 드러난 것입니다."
  },
  {
   "key": "36ccb6f3f051",
   "speaker_korean": "소피아",
   "korean": "「그, 창조왕?"
  },
  {
   "key": "6f8195662df9",
   "speaker_korean": "마리아",
   "korean": "「제법 동화 같은 얘기가 되어가네."
  },
  {
   "key": "d49dfad229f2",
   "speaker_korean": "페이트",
   "korean": "「쉿, 조용히 해."
  },
  {
   "key": "b28187662f69",
   "speaker_korean": "로키시",
   "korean": "『우리가 지금 일상적으로 사용하는\n문장 기술도 그들이 남긴 기술이었습니다.\n⟦1⟧행성 스트림⟦2⟧의 ⟦3⟧타임게이트⟦4⟧도\n그들의 고도한 문장 기술을 사용해\n만들어진 것이었습니다."
  },
  {
   "key": "49adb36f9bb4",
   "speaker_korean": "로키시",
   "korean": "『하지만 그 기록엔 우리 상상을 뛰어넘는\n끔찍한 내용이 담겨 있었습니다."
  },
  {
   "key": "860d8dd4c9d8",
   "speaker_korean": "로키시",
   "korean": "『그것은… ⟦1⟧FD인⟦2⟧의 존재입니다."
  },
  {
   "key": "ff4010e47200",
   "speaker_korean": "로키시",
   "korean": "『⟦1⟧문베이스⟦2⟧로 돌아온 우리는\n망연자실할 수밖에 없었습니다."
  },
  {
   "key": "6958e5883af0",
   "speaker_korean": null,
   "korean": "『인지를 초월한 존재에게\n미래의 멸망을 선고받았으니까요…"
  },
  {
   "key": "e247d909e9c6",
   "speaker_korean": "로키시",
   "korean": "『처음엔 우리도 은하연방 상층부에\n보고하는 것도 고려했지만,\n너무나도 황당무계한 이야기라\n보고해도 믿어주지 않을 것입니다.\n대응은 그 자리에 있던 연구자들이\n결정할 수밖에 없었습니다.\n창조왕의 멸망 의지를 순순히\n받아들일지, 단호히 맞서 싸울지…\n우리는 싸움의 길을 선택했습니다.\n멸망의 운명 따위 받아들일 수는 없다.\n어차피 멸망할 거라면, 싸우다 멸망하자.\n그렇게 생각한 것입니다."
  },
  {
   "key": "6b4000b02f38",
   "speaker_korean": "로키시",
   "korean": "『하지만 상대는 창조왕.\n말하자면 신과 같은 존재입니다.\n절대적인 힘을 가진 상대 앞에서\n우리는 너무나 무력했습니다.\n그래서 그들에게 대항하기 위해\n강대한 힘을 갖는 것이\n필요해졌습니다.\n우리는 그 힘으로서 창조왕의 힘과\n같은 종류의 힘, 특수 문장 유전자에 있는\n창조력을 인간에게 부여하기로 했습니다."
  },
  {
   "key": "a67c8399bb8e",
   "speaker_korean": "로키시",
   "korean": "『그것이 바로 이 프로젝트입니다."
  },
  {
   "key": "7a827feec299",
   "speaker_korean": "로키시",
   "korean": "『피험자로는…\n두 아이를 선택했습니다."
  },
  {
   "key": "d8769c202a64",
   "speaker_korean": "로키시",
   "korean": "『그들에게는 아무리 사죄해도\n용서받지 못할 것입니다. 온 세상으로부터\n악마라는 비난을 받을지도 모릅니다.\n⟦P⟧하지만 우리는 이 연구야말로 인류를 구할\n유일한 수단이라고 믿고 있습니다.\n그들은 인류의 희망인 것입니다."
  },
  {
   "key": "86bcabe8c0fd",
   "speaker_korean": "페이트",
   "korean": "「그게… 우리인 거야,\n아버지…"
  },
  {
   "key": "90648cc2b0cf",
   "speaker_korean": "마리아",
   "korean": "「……"
  },
  {
   "key": "6c2ea32dec5e",
   "speaker_korean": "로키시",
   "korean": "『⟦1⟧타임게이트⟦2⟧에서\n산출한 데이터로 추측할 수 있는\n창조왕의 힘은 강대합니다."
  },
  {
   "key": "786ea6734305",
   "speaker_korean": "로키시",
   "korean": "『한 사람에게 준 파괴의 힘,\n⟦1⟧디스트럭션⟦2⟧.\n⟦P⟧한 사람에게 준 개변의 힘,\n⟦3⟧알티네이션⟦4⟧.\n⟦P⟧하지만 그 둘만의 힘으로는\n창조왕인 ⟦5⟧FD인⟦6⟧을 상대로\n어떻게 할 수 없을 것입니다."
  },
  {
   "key": "6119d1ae5602",
   "speaker_korean": "로키시",
   "korean": "『하지만 ⟦1⟧FD 공간⟦2⟧으로 뛰어들어\n직접 그들의 통치자를 쓰러뜨림으로써\n활로를 찾을 수 있다고 믿습니다."
  },
  {
   "key": "4b263b440d5a",
   "speaker_korean": "로키시",
   "korean": "『그러기 위해 우리는 ⟦1⟧타임게이트⟦2⟧에 ⟦3⟧FD 공간⟦4⟧으로\n통하는 길을 만드는 문장 유전자, 공간을 잇는 힘,\n⟦5⟧커넥션⟦6⟧을, 다음 아이,\n에스테드 박사의 아이에게 맡겼습니다."
  },
  {
   "key": "61c4ec970954",
   "speaker_korean": "로키시",
   "korean": "『아직 이름도 없는 이 아이야말로\n⟦1⟧FD 공간⟦2⟧으로의 길을 여는 것입니다."
  },
  {
   "key": "1009c68e9b06",
   "speaker_korean": "로키시",
   "korean": "『아이들의 힘은 금방 꽃피지 않을 것입니다.\n하지만, 이 세 사람이 모임으로써\n각자의 특수 문장 유전자가 공명하여\n힘을 발휘할 수 있게 될 것입니다.\n이후에는 실전 속에서 그 힘을 다루어 나가기를\n바랍니다.\n때가 오면 직접 그들에게 말하려 하지만\n혹시 저에게 무슨 일이 생긴다면\n이 영상을 본 사람이 그들에게 전해 주십시오.\n제멋대로인 부탁이지만 잘 부탁드립니다."
  },
  {
   "key": "a1c049e6225a",
   "speaker_korean": "로키시",
   "korean": "『우리가 행한 행위는 비인도적이며,\n현재의 연방법으로는 위법입니다.\n그래서 비밀리에 일을 진행해 왔습니다.\n피험자인 그들에게는\n아무리 사죄해도 부족합니다.\n이 행위가 옳았는지 어땠는지,\n그것은 저 자신이 결정할\n수 없습니다.\n그것은 언젠가 찾아올 심판의 때에\n분명해질 것입니다.\n또한 아이들이\n멸망을 선택한다 해도,\n그것은 그것대로 상관없다고 생각합니다.\n미래는 그들의 것이니까요…"
  },
  {
   "key": "8156ef7fa4cf",
   "speaker_korean": "로키시",
   "korean": "『마지막으로 아이들에게…"
  },
  {
   "key": "55d767379e64",
   "speaker_korean": "로키시",
   "korean": "『너희에게 무거운 십자가를\n지워버려서\n미안하게 생각한다.\n용서해 달라고는 말하지 않으마.\n다만 너희 자신의 미래는 너희 손으로\n개척해 나가길 바란다.\n스스로 생각하고, 납득하며 행동해 주길 바란다.\n설령 그것이 힘겨운 싸움의 길이라 해도,\n멸망의 길이라 해도 말이다.\n그것이 제멋대로인 우리 부모의 유일한 바람이다."
  },
  {
   "key": "bd7a5264cf0b",
   "speaker_korean": "로키시",
   "korean": "『…"
  },
  {
   "key": "433ec894d85e",
   "speaker_korean": "로키시",
   "korean": "「사랑한다,\n아이들아―――――."
  },
  {
   "key": "903258378ab6",
   "speaker_korean": "소피아",
   "korean": "「왜 우리인 걸까?"
  },
  {
   "key": "11d251b89b97",
   "speaker_korean": "페이트",
   "korean": "「아니, 아마 우리이기 때문일 거야.\n아버지들은 남이 아니라\n자기 자식에게 그걸 맡긴 거야.\n미래를 믿고…"
  },
  {
   "key": "d9feb7a5fd29",
   "speaker_korean": "소피아",
   "korean": "「나, 솔직히 아직 잘 모르겠어.\n근데… 아빠들이 우리를 믿고\n미래를 맡겨준 건 알겠어."
  },
  {
   "key": "26b05bb5862b",
   "speaker_korean": "마리아",
   "korean": "「우리의 운명은 ⟦1⟧문장⟦2⟧에 의해\n정해져 있었던 거네."
  },
  {
   "key": "56465d1ebce6",
   "speaker_korean": "페이트",
   "korean": "「지금까지는 그랬을지도 몰라.\n하지만 아버지도 말했듯이,\n앞으로의 운명을\n개척해 나가는 건 우리 자신이야."
  },
  {
   "key": "de2481b204c9",
   "speaker_korean": "알벨",
   "korean": "「흥."
  },
  {
   "key": "a30e2fdc06d6",
   "speaker_korean": "로저",
   "korean": "「가는 거지?\n그 뭐시기 공간이라는 데.\n우홋!\n완전 불타는 전개잖아!"
  },
  {
   "key": "8cb9b0474825",
   "speaker_korean": "스프레",
   "korean": "「그럼 가는 거구나…,\n그 우두머리가 있는 데로!"
  },
  {
   "key": "9df9ebf9d0f7",
   "speaker_korean": "클리프",
   "korean": "「갈까?"
  },
  {
   "key": "22ebacce1223",
   "speaker_korean": "페이트",
   "korean": "「가자,\n⟦1⟧행성 스트림⟦2⟧으로!"
  },
  {
   "key": "db17b9fdd9cf",
   "speaker_korean": "스프레",
   "korean": "「오오!!"
  },
  {
   "key": "53a0a13dee4d",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧소피아⟦2⟧도 그런 거야?"
  },
  {
   "key": "7fa8250b19b9",
   "speaker_korean": "소피아",
   "korean": "「그런…\n나――――――."
  },
  {
   "key": "e0af7e1ecb91",
   "speaker_korean": "소피아",
   "korean": "「어…?"
  }
 ]
}