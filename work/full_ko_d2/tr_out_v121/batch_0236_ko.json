{
 "batch_id": "batch_0236",
 "translations": [
  {
   "key": "c5e4aff74b32",
   "speaker_korean": "페이트",
   "korean": "「안 되나…\n문이 굳게 닫혀 있어서\n열릴 것 같지 않군."
  },
  {
   "key": "3ca34c98a753",
   "speaker_korean": "페이트",
   "korean": "「젠장!\n문이 닫혀 버렸어.\n열 수 없을 것 같아."
  },
  {
   "key": "eb30c2683bff",
   "speaker_korean": null,
   "korean": "⟦1⟧미스틱 체인⟦2⟧을 손에 넣었다."
  },
  {
   "key": "9c25d25a0da7",
   "speaker_korean": null,
   "korean": "⟦1⟧레이븐 건틀릿⟦2⟧을 손에 넣었다."
  },
  {
   "key": "be8dd4a68352",
   "speaker_korean": null,
   "korean": "⟦1⟧58000폴⟦2⟧을 손에 넣었다."
  },
  {
   "key": "9f8aa9d71c2a",
   "speaker_korean": "행상성인 산타",
   "korean": "「매번 감사합니다~"
  },
  {
   "key": "fd1697d3075b",
   "speaker_korean": "페이트",
   "korean": "(뭐지?\n아까부터 뭔가에게\n미행당하고 있는 것 같은데…"
  },
  {
   "key": "d5ccdacf0122",
   "speaker_korean": "페이트",
   "korean": "(뭐, 뭐야 뭐야!?"
  },
  {
   "key": "c40aee117910",
   "speaker_korean": "페이트",
   "korean": "「으와아!!"
  },
  {
   "key": "a17ee1ea2e6d",
   "speaker_korean": "???",
   "korean": "「호오,\n이런 곳에 사람이 있다니\n참으로 희귀한 일이구먼."
  },
  {
   "key": "a2307648afc0",
   "speaker_korean": "페이트",
   "korean": "「말, 말을 했어…"
  },
  {
   "key": "1f0215c0b853",
   "speaker_korean": "???",
   "korean": "「거참 무례한 말을\n하는구먼."
  },
  {
   "key": "140a7a255c7f",
   "speaker_korean": "???",
   "korean": "「뭐 됐다 치지,\n여기서 만난 것도 인연이라 하니\n⟦P⟧내는 ⟦1⟧행상성인 산타⟦2⟧라고 하네\n잘 부탁하겠구먼."
  },
  {
   "key": "2081ebbdcd1f",
   "speaker_korean": "페이트",
   "korean": "「행상…성인?"
  },
  {
   "key": "634f6beea799",
   "speaker_korean": "행상성인 산타",
   "korean": "「행상성인이라 하면 그거 아이가.\n별을 떠돌며 장사한단 그거 말이다.\n뭐 말 그대로긴 하네만.\n나처럼 고상한 상인쯤 되면\n다른 세계로도 넘나들 수 있다 이 말이지.\n어떠냐, 대단하지?"
  },
  {
   "key": "2992cd5a2074",
   "speaker_korean": "페이트",
   "korean": "「하, 하아…"
  },
  {
   "key": "878132b5606c",
   "speaker_korean": "행상성인 산타",
   "korean": "「뭐꼬 니,\n긴장한 거가?"
  },
  {
   "key": "3102100e1c33",
   "speaker_korean": "페이트",
   "korean": "「긴장이라기보다\n꽤 무서운데요…"
  },
  {
   "key": "f7f181b11ab9",
   "speaker_korean": "행상성인 산타",
   "korean": "「니 사람을 겉모습으로 판단하면\n안 된다, 진짜로.\n⟦P⟧내는 상인, 손님은 신이여.\n물건 사주는 손님을\n덮치거나 잡아먹을 리가 있겠나?"
  },
  {
   "key": "a4af4707ae46",
   "speaker_korean": "페이트",
   "korean": "「…안 사는 손님은?"
  },
  {
   "key": "413192710fc3",
   "speaker_korean": "행상인 산타",
   "korean": "「걱정 마라!\n상인은 신용이 제일이니까.\n그럼 장사 시작해볼까."
  },
  {
   "key": "483859e5ad59",
   "speaker_korean": "행상성인 산타",
   "korean": "「내는 당분간 여기 있을 생각이니\n볼일 있으면 언제든 불러라."
  },
  {
   "key": "0516f8a619ef",
   "speaker_korean": "페이트",
   "korean": "(바, 방금 그건 대체…!?"
  },
  {
   "key": "a3858105995b",
   "speaker_korean": "페이트",
   "korean": "(그러니까 대체 뭐냐고!?"
  },
  {
   "key": "5e1c05d043fd",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX13⟦2⟧을 손에 넣었다."
  },
  {
   "key": "f77d71054cfb",
   "speaker_korean": null,
   "korean": "시련의 유적 4하층"
  },
  {
   "key": "dbb1233805dc",
   "speaker_korean": "페이트",
   "korean": "「『빛이 길을 막으니\n어둠이야말로 모든 길잡이가 되리라』\n라고 쓰여 있다."
  },
  {
   "key": "402a736f6668",
   "speaker_korean": null,
   "korean": "⟦1⟧이프리트 케이프⟦2⟧를 손에 넣었다."
  },
  {
   "key": "acd05c2b7d5a",
   "speaker_korean": "페이트",
   "korean": "「문이 굳게 닫혀 있어서\n열릴 것 같지 않군."
  },
  {
   "key": "63701ae976af",
   "speaker_korean": "어스드래곤",
   "korean": "「용케도 여기까지 왔구나.\n환영해 주지 않겠나."
  },
  {
   "key": "a4993e68b5b8",
   "speaker_korean": "어스드래곤",
   "korean": "「제4하층의 시련이라니!\n짐이 친히 상대해 주마.\n후후… 싸움은 실로 오랜만이로다.\n마음껏 즐겨보지 않겠느냐!!"
  },
  {
   "key": "b3ed78a7d347",
   "speaker_korean": null,
   "korean": "⟦1⟧61000폴⟦2⟧을 손에 넣었다."
  },
  {
   "key": "de70973b5a28",
   "speaker_korean": null,
   "korean": "시련의 유적 5하층"
  },
  {
   "key": "b6115709c218",
   "speaker_korean": "페이트",
   "korean": "「누군가 있다…"
  },
  {
   "key": "bed2537e19a6",
   "speaker_korean": "???",
   "korean": "「드디어 여기까지\n왔구나…"
  },
  {
   "key": "d2dd855c3cea",
   "speaker_korean": "???",
   "korean": "「부처님 얼굴도 세 번까지라지만\n난 말이지\n세 번도 봐주지 않을 거야!"
  },
  {
   "key": "dde3827cdb3d",
   "speaker_korean": "페이트",
   "korean": "「네놈은…"
  },
  {
   "key": "7d260b1bcef8",
   "speaker_korean": null,
   "korean": "⟦1⟧・파피"
  },
  {
   "key": "b92ddf0adfc9",
   "speaker_korean": null,
   "korean": "⟦1⟧・미〇피"
  },
  {
   "key": "30c15ccfda7a",
   "speaker_korean": null,
   "korean": "⟦1⟧・조〇피"
  },
  {
   "key": "d273e390f9d6",
   "speaker_korean": null,
   "korean": "⟦1⟧・다른 이름이 떠올랐다."
  },
  {
   "key": "f3499cc469e3",
   "speaker_korean": null,
   "korean": "⟦1⟧・머피"
  },
  {
   "key": "21183064c46b",
   "speaker_korean": null,
   "korean": "⟦1⟧・카다피"
  },
  {
   "key": "7ece70a0bdb8",
   "speaker_korean": null,
   "korean": "⟦1⟧・슈퍼돌피"
  },
  {
   "key": "afa123e6062f",
   "speaker_korean": null,
   "korean": "⟦1⟧・귀찮아졌다."
  },
  {
   "key": "c1ac7f92ae64",
   "speaker_korean": null,
   "korean": "⟦1⟧・몰라."
  },
  {
   "key": "0ff71709dac2",
   "speaker_korean": null,
   "korean": "⟦1⟧・죽어 주세요."
  },
  {
   "key": "6e2e48db9384",
   "speaker_korean": null,
   "korean": "⟦1⟧・처음부터 다시."
  },
  {
   "key": "5710c305bd25",
   "speaker_korean": "파피",
   "korean": "「어머, 잘 알고 있잖아.\n지우고 싶어도 지워지지 않는\n공포의 기억이 유전자에\n각인되어 있는 걸까?"
  },
  {
   "key": "90942bdf4bea",
   "speaker_korean": "???",
   "korean": "「뭐라고!?\n그 ×입 달린 애랑 똑같이 취급하지 마!"
  },
  {
   "key": "27be8807975b",
   "speaker_korean": "???",
   "korean": "「뭐라고!?\n그 3분 만에 죽는 우주인이랑\n똑같이 취급하지 마!!"
  },
  {
   "key": "59a18c42e864",
   "speaker_korean": "???",
   "korean": "「뭐라고!?\n난 무슨 이상한 법칙이나\n경험치 벌이용 훼방꾼 유령이 아니야!"
  },
  {
   "key": "7950a852626a",
   "speaker_korean": "???",
   "korean": "「뭐라고!?\n난 어디의 대령도\n감독도 아니야!"
  },
  {
   "key": "0911e3cf6c27",
   "speaker_korean": "???",
   "korean": "「뭐라고!?\n내 눈은 못 보는 눈도 아니고\n유리눈도 아니야!"
  },
  {
   "key": "fd51728f4022",
   "speaker_korean": "???",
   "korean": "「무, 무슨\n뭐라고오오오옹~!?"
  },
  {
   "key": "ff30b5278514",
   "speaker_korean": "???",
   "korean": "「나는 아직 젊단 말이야!\n이상한 신…이었나?\n시나스 발큐리아?던가 하는 게\n마중 나오기엔 너무 이르다고!\n아무튼\n중노동은 사양이야."
  },
  {
   "key": "10e2ed7b6fd5",
   "speaker_korean": "???",
   "korean": "「…들었어?\n귀 후비고 잘 들어!\n⟦P⟧내 이름은 ⟦1⟧파・피⟦2⟧,\n파피E가 아니라 ⟦3⟧파피⟦4⟧야!"
  },
  {
   "key": "0d54217f8279",
   "speaker_korean": "페이트",
   "korean": "「…하아."
  },
  {
   "key": "4e7b6130b280",
   "speaker_korean": "파피",
   "korean": "「뭐 그런 이유로 설명하는 것도\n귀찮으니까 그냥 여기서 죽어!"
  },
  {
   "key": "d6ad291693ef",
   "speaker_korean": "클리프",
   "korean": "「뭐야? 결국\n정신 나간 놈이란 소리잖냐!!"
  },
  {
   "key": "75c9e03cb1c3",
   "speaker_korean": "파피",
   "korean": "「하, 해냈단 말이지…\n뭐 오늘은 봐주도록 하지.\n다음번엔 봐주지 않을 거야!!"
  },
  {
   "key": "72f0a258c678",
   "speaker_korean": "페이트",
   "korean": "「다음번이라니…\n아직… 할 거야?"
  },
  {
   "key": "4219e82aa3f0",
   "speaker_korean": "페이트",
   "korean": "「문이 굳게 닫혀 있어서\n쉽게 열릴 것 같지 않군."
  },
  {
   "key": "f60200845f58",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧파피⟦2⟧가 떨어뜨리고 간\n열쇠를 쓰자."
  },
  {
   "key": "3ff6c17a8c61",
   "speaker_korean": "클리프",
   "korean": "「영문 모를 소리\n지껄이지 좀 마라!"
  },
  {
   "key": "41facb67d018",
   "speaker_korean": "클리프",
   "korean": "「모르는 건 모르는 거니까\n어쩔 수 없잖냐!"
  }
 ]
}