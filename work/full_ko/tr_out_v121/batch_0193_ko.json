{
 "batch_id": "batch_0193",
 "translations": [
  {
   "key": "300375cb8aed",
   "speaker_korean": null,
   "korean": "⟦1⟧연금 소재⟦2⟧를 손에 넣었다."
  },
  {
   "key": "30a939f11173",
   "speaker_korean": null,
   "korean": "⟦1⟧얼럿 오브⟦2⟧를 손에 넣었다."
  },
  {
   "key": "bc3253e2a510",
   "speaker_korean": null,
   "korean": "⟦1⟧한정 돌핀⟦2⟧을 손에 넣었다."
  },
  {
   "key": "81fcab80a0fc",
   "speaker_korean": null,
   "korean": "⟦1⟧12000폴⟦2⟧을 손에 넣었다."
  },
  {
   "key": "7efb8360985c",
   "speaker_korean": null,
   "korean": "⟦1⟧금 조각상⟦2⟧을 손에 넣었다."
  },
  {
   "key": "b3d207736eb9",
   "speaker_korean": "로저",
   "korean": "「으아앗!!"
  },
  {
   "key": "0006460ac877",
   "speaker_korean": "월영 두목",
   "korean": "「누군가 했더니 아까 그\n코흘리개 놈 아니냐?\n여긴 왜 얼쩡대는 거야?\n우리에 처넣어놨을 텐데…"
  },
  {
   "key": "b18855b424c4",
   "speaker_korean": "로저",
   "korean": "「위험했잖아… 어라?"
  },
  {
   "key": "3a6247e159b1",
   "speaker_korean": "???",
   "korean": "「우왓!?"
  },
  {
   "key": "0635986933a4",
   "speaker_korean": "로저",
   "korean": "「사나이 중의 사나이, ⟦1⟧로저⟦2⟧님을\n그런 우리에 가둬 놓을 수 있을 리가\n없잖아!\n날 붙잡아 둘 수 있는 건\n아리따운 누님, 오직 그뿐이라고!"
  },
  {
   "key": "4ed86f305083",
   "speaker_korean": "월영 두목",
   "korean": "「무슨 헛소리를 지껄이는 거야.\n냉큼 우리로 돌아가."
  },
  {
   "key": "c6b7fff46ceb",
   "speaker_korean": "로저",
   "korean": "「그런 말 듣고 순순히 돌아갈 바보가 어딨냐!\n그럼 사나이 승부에서 지는 거잖아!!"
  },
  {
   "key": "962b2ca42f9d",
   "speaker_korean": "월영 두목",
   "korean": "「시끄러, 말 좀 들어!\n대체 사나이 승부라는 게 뭔데?"
  },
  {
   "key": "1528e5a8ee27",
   "speaker_korean": "로저",
   "korean": "「사나이와 사나이의 승부잖아!"
  },
  {
   "key": "952cc6fdd84d",
   "speaker_korean": "월영 두목",
   "korean": "「아앙?"
  },
  {
   "key": "549b7e838d5a",
   "speaker_korean": "로저",
   "korean": "「그런 건 아무래도 상관없다니까!\n냉큼 네가 가진 보물을\n내놓으라는 거잖아!!"
  },
  {
   "key": "cfe5cd5b7aa4",
   "speaker_korean": "클리프",
   "korean": "「그런 말은 한마디도 안 했다고."
  },
  {
   "key": "9304965585dc",
   "speaker_korean": "넬",
   "korean": "「그래, 안 했지."
  },
  {
   "key": "12c287f7e8a0",
   "speaker_korean": "로저",
   "korean": "「음… 뭐, 됐어.\n냉큼 내놔.\n구시렁대지 말고 내놔.\n꾸물대지 말고 내놔.\n아, 진짜, 아무튼 내놔."
  },
  {
   "key": "16e965749088",
   "speaker_korean": "로저",
   "korean": "「아앗! 너!?"
  },
  {
   "key": "03099bfef9d5",
   "speaker_korean": "페이트",
   "korean": "「저 녀석… 두목인가?"
  },
  {
   "key": "3fa0659882ee",
   "speaker_korean": "클리프",
   "korean": "「그래, 그런 것 같군.\n일단 인상부터가 안 좋아."
  },
  {
   "key": "93da5f09c8e2",
   "speaker_korean": "넬",
   "korean": "「거의 틀림없겠지."
  },
  {
   "key": "e11638295ac9",
   "speaker_korean": "월영 두목",
   "korean": "「농담하지 마!\n왜 내 보물을 네놈한테\n줘야 하는 거냐!?"
  },
  {
   "key": "ab350847977a",
   "speaker_korean": "로저",
   "korean": "「너도 참 말귀 못 알아듣는 놈이네…\n흔히 말하는 바보란 건가? …응, 그래!\n야, 등신아!! 보물 내놔!!"
  },
  {
   "key": "0d64c0efd472",
   "speaker_korean": "로저",
   "korean": "「응? 그랬던가?"
  },
  {
   "key": "247f67d8a875",
   "speaker_korean": "월영 두목",
   "korean": "「등신이라고?\n네놈, 더는 못 참아!\n흠씬 두들겨 패주마!!"
  },
  {
   "key": "7347370ee8a2",
   "speaker_korean": "로저",
   "korean": "「헤헤엥이다!\n너 따위한테 질까 보냐!"
  },
  {
   "key": "aa32ca031adc",
   "speaker_korean": "로저",
   "korean": "「간다! 너희들!!"
  },
  {
   "key": "9c35e7ecc341",
   "speaker_korean": "클리프",
   "korean": "「헤이헤이."
  },
  {
   "key": "c65ba321795f",
   "speaker_korean": "페이트",
   "korean": "「그 전에 일단 물어보겠는데,\n너, 이 근처에 꽃을 꺾으러 온\n긴 머리 여자애 못 봤어?"
  },
  {
   "key": "d0f56be9eaaf",
   "speaker_korean": "월영 두목",
   "korean": "「모른다고! 대체 네놈들은 또 뭐야!\n아까부터 옆에서 이러쿵저러쿵!!\n아, 인상 더러워서 미안하다!!"
  },
  {
   "key": "c9a28de2a51a",
   "speaker_korean": "클리프",
   "korean": "「들렸나."
  },
  {
   "key": "91d74df05eb6",
   "speaker_korean": "넬",
   "korean": "「그런 것 같네.\n…의외로 신경 쓰고 있나 봐.\n더는 말하지 않는 게 좋겠어."
  },
  {
   "key": "ac24ee051815",
   "speaker_korean": "클리프",
   "korean": "「그렇군.\n아무리 사실이라도 신경 쓰고 있잖아.\n더는 그만해 주자고.\n근데, 진짜 인상 더럽네…"
  },
  {
   "key": "39ed635b11b3",
   "speaker_korean": "월영 두목",
   "korean": "「네놈들!!"
  },
  {
   "key": "3df44946bff6",
   "speaker_korean": "로저",
   "korean": "「오, 이거다 이거야!"
  },
  {
   "key": "50e3c51ae313",
   "speaker_korean": "로저",
   "korean": "「이걸로 내 승리군.\n헤헷, 꼴좋다는 거다,\n⟦1⟧루시오⟦2⟧ 이 자식아!"
  },
  {
   "key": "6cb7d67aaec4",
   "speaker_korean": "페이트",
   "korean": "「잘됐네."
  },
  {
   "key": "25a7065a061f",
   "speaker_korean": "로저",
   "korean": "「오우!\n…이것도 누님 덕분입니다."
  },
  {
   "key": "4afd49785a4e",
   "speaker_korean": "클리프",
   "korean": "「어이, 이봐…\n우리는 무시냐?"
  },
  {
   "key": "5590cbfa7ce4",
   "speaker_korean": "로저",
   "korean": "「감사해 줘도 되지."
  },
  {
   "key": "520e3886f54e",
   "speaker_korean": "클리프",
   "korean": "「해 줘도 된다고?"
  },
  {
   "key": "6a594951111c",
   "speaker_korean": "로저",
   "korean": "「…감사 안 해줄 것도 없지."
  },
  {
   "key": "3bf954d122b7",
   "speaker_korean": "로저",
   "korean": "「…감사한 기분이 돼 주지."
  },
  {
   "key": "a6996396be35",
   "speaker_korean": "로저",
   "korean": "「…감사하기도 하고 안 하기도 하고."
  },
  {
   "key": "975d27c71274",
   "speaker_korean": "로저",
   "korean": "「잘했다. 수고했어."
  },
  {
   "key": "3d286808ce4f",
   "speaker_korean": "로저",
   "korean": "「…감사했습니다."
  },
  {
   "key": "3ad7b43c4321",
   "speaker_korean": "넬",
   "korean": "「자, 이 둘은 내버려 두고\n얼른 ⟦1⟧아미나⟦2⟧를 찾아야겠어."
  },
  {
   "key": "31f7df370e0c",
   "speaker_korean": "클리프",
   "korean": "「어, 어이!"
  },
  {
   "key": "e7933b1b94c5",
   "speaker_korean": "로저",
   "korean": "「자, 잠깐\n기다리라고!"
  },
  {
   "key": "92b5bbc710d1",
   "speaker_korean": "클리프",
   "korean": "「그래, 그거면 됐어."
  }
 ]
}