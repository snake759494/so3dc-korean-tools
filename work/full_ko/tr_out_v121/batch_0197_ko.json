{
 "batch_id": "batch_0197",
 "translations": [
  {
   "key": "45d407d2a2a1",
   "speaker_korean": null,
   "korean": "⟦1⟧・2층"
  },
  {
   "key": "8684743fea6a",
   "speaker_korean": null,
   "korean": "⟦1⟧・3층"
  },
  {
   "key": "c665f0f5133a",
   "speaker_korean": null,
   "korean": "⟦1⟧・4층"
  },
  {
   "key": "9bfb70ca1147",
   "speaker_korean": null,
   "korean": "⟦1⟧・취소"
  },
  {
   "key": "b6b440cdb1ee",
   "speaker_korean": "셸비",
   "korean": "아직도 ⟦1⟧크림슨 블레이드⟦2⟧의\n한쪽을 못 붙잡은 거냐!?\n이 무능한 놈들 같으니!!"
  },
  {
   "key": "ca0eb785c0e6",
   "speaker_korean": "기사",
   "korean": "「죄송합니다.\n상당히 몰아붙이고 있습니다만\n상대도 보통내기가 아닌 모양입니다…"
  },
  {
   "key": "16317984b3e8",
   "speaker_korean": "셸비",
   "korean": "「감탄할 시간이 있으면\n냉큼 붙잡아 오지 못해!"
  },
  {
   "key": "e96b666eff0a",
   "speaker_korean": "기사",
   "korean": "「네, 넷!!"
  },
  {
   "key": "0a34c72e9944",
   "speaker_korean": "기사",
   "korean": "「⟦1⟧셸비 님⟦2⟧!!"
  },
  {
   "key": "865cc2483f28",
   "speaker_korean": "셸비",
   "korean": "「무슨 일이냐?\n⟦1⟧크림슨 블레이드⟦2⟧는 붙잡았나?"
  },
  {
   "key": "d969f0f598d2",
   "speaker_korean": "기사",
   "korean": "「아, 아닙니다…보고와…\n⟦1⟧복스 님⟦2⟧께서 서신을 보내오셔서 말입니다."
  },
  {
   "key": "2539d8b864ff",
   "speaker_korean": "셸비",
   "korean": "「질풍 단장한테서? 뭐냐?\n뭐 됐다. 일단 보고가 먼저다."
  },
  {
   "key": "7d88632201c6",
   "speaker_korean": "기사",
   "korean": "「예. 파수병들에 의하면 새로이\n수상한 남자 두 명이 성 안에 침입한 듯합니다.\n정보와 대조해 본 결과\n목표로 하는 남자들로 추측됩니다."
  },
  {
   "key": "107bf66799e6",
   "speaker_korean": "셸비",
   "korean": "「호오…그런가.\n설마 정말로 구하러 올 줄이야."
  },
  {
   "key": "9056e6c0977f",
   "speaker_korean": "셸비",
   "korean": "「⟦1⟧크림슨 블레이드⟦2⟧의 한쪽만\n혼자서 왔을 때는 어찌해야 하나\n싶었다만…\n⟦P⟧정말이지 ⟦3⟧아페리스⟦4⟧의 신도들은\n인정이 많아서 다행이군.\n그 물러터짐이 명줄을 앗아갈 텐데 말이다."
  },
  {
   "key": "c71612dc8c17",
   "speaker_korean": "셸비",
   "korean": "「좋아, ⟦1⟧그 여자⟦2⟧까지 함께 몰아붙여 붙잡아라.\n실수하지 마라."
  },
  {
   "key": "6c076e8fc27b",
   "speaker_korean": "기사",
   "korean": "「예…그리고\n이것이 ⟦1⟧복스 님⟦2⟧께서 보내신 서신입니다."
  },
  {
   "key": "172e1bea1c30",
   "speaker_korean": "셸비",
   "korean": "「하핫!"
  },
  {
   "key": "bf74c75e9fcc",
   "speaker_korean": "기사",
   "korean": "「⟦1⟧셸비 님⟦2⟧,\n무슨 일이십니까?"
  },
  {
   "key": "543583055d25",
   "speaker_korean": "셸비",
   "korean": "「하하하하! 이거 재미있군.\n⟦1⟧알벨⟦2⟧ 그 녀석, 당분간\n돌아오지 못할 모양이야."
  },
  {
   "key": "aff67e33fe71",
   "speaker_korean": "기사",
   "korean": "「단장님이 말입니까?\n어째서입니까?"
  },
  {
   "key": "38f26368f369",
   "speaker_korean": "셸비",
   "korean": "「아무래도 ⟦1⟧질풍 단장⟦2⟧도 ⟦3⟧칠흑 단장⟦4⟧을\n싫어하는 모양이더군. 한동안 그놈을 붙잡아\n두겠다고 하더라. 그 사이에 처리해서\n공을 세워 두라고 하더군."
  },
  {
   "key": "b2dc9a684b1c",
   "speaker_korean": "기사",
   "korean": "「그렇군요…즉, ⟦1⟧알벨 님⟦2⟧이\n돌아오시기 전에 ⟦3⟧셸비 님⟦4⟧께서 목표인 남자들을\n붙잡아 버리면, 공은 ⟦5⟧셸비 님⟦6⟧의 것.\n그리 되면 언젠가 칠흑 단장의 자리도…"
  },
  {
   "key": "b7ff23b0bc3f",
   "speaker_korean": "셸비",
   "korean": "「그런 것이다.\n지금, 사냥감은 내 손안에 있다.\n그놈이 오기 전에 전부 끝내주마."
  },
  {
   "key": "00adc28aa607",
   "speaker_korean": "셸비",
   "korean": "「남자 둘은 죽이지 마라.\n반드시 생포하도록 해라!!"
  },
  {
   "key": "7fa533b29917",
   "speaker_korean": "기사",
   "korean": "「옛!!"
  },
  {
   "key": "920a479b4224",
   "speaker_korean": null,
   "korean": "⟦1⟧미들 대거⟦2⟧를 손에 넣었다."
  },
  {
   "key": "762e69fb2194",
   "speaker_korean": null,
   "korean": "⟦1⟧포이즌 체크⟦2⟧를 손에 넣었다."
  },
  {
   "key": "1bdf80188568",
   "speaker_korean": null,
   "korean": "⟦1⟧스킬북[서포트스펠]⟦2⟧을 손에 넣었다."
  },
  {
   "key": "e1eb6a7b1a4c",
   "speaker_korean": null,
   "korean": "⟦1⟧・1층"
  },
  {
   "key": "950400bbc072",
   "speaker_korean": "페이트",
   "korean": "「안 되겠어.\n이쪽에서는\n안 열리는 것 같아."
  },
  {
   "key": "112a27f753b6",
   "speaker_korean": null,
   "korean": "⟦1⟧카운터 오라 습득서4⟦2⟧를 손에 넣었다."
  },
  {
   "key": "347e99795305",
   "speaker_korean": null,
   "korean": "⟦1⟧용기의 문장⟦2⟧을 손에 넣었다."
  },
  {
   "key": "2e3ff07a4a1c",
   "speaker_korean": "약간 험상궂은 아줌마",
   "korean": "「너희들, 뭐 하는 놈들이야!?"
  },
  {
   "key": "a346fc7a609c",
   "speaker_korean": "더욱 험상궂어진 아줌마",
   "korean": "「보면 알잖아! 조리장이라고!\n여긴 말이야, 여자 둘뿐이라고.\n피를 보고 싶다면\n피 보고 싶은 놈들끼리\n알아서 해 줬으면 좋겠는데!"
  },
  {
   "key": "0391d08ad06e",
   "speaker_korean": "페이트",
   "korean": "「…우리는 동료를 구하러 온 거야.\n해칠 생각은 없어."
  },
  {
   "key": "e504be61d2f0",
   "speaker_korean": "더욱더 험상궂은 아줌마",
   "korean": "「정말인지 원, 참…\n구시렁구시렁구시렁…"
  },
  {
   "key": "d9ca0a15d183",
   "speaker_korean": "역시 험상궂은 아줌마",
   "korean": "「참 요즘\n젊은것들이란…"
  },
  {
   "key": "7855d90c5c8e",
   "speaker_korean": "험상궂은 아줌마의 딸",
   "korean": "(꺅! 잘생긴 남자~."
  },
  {
   "key": "e27332c602dc",
   "speaker_korean": "페이트",
   "korean": "「어? 뭐?"
  },
  {
   "key": "920b47eab642",
   "speaker_korean": "험상궂은 아줌마의 딸",
   "korean": "「아, 저기요!\n아까 옥상 쪽으로 향해 간\n사람이 있었는데요…\n이 열쇠가 없으면 안 되니까\n가져가세요!"
  },
  {
   "key": "db57e3fa9acc",
   "speaker_korean": "페이트",
   "korean": "「어, 그래도 돼?"
  },
  {
   "key": "9303bce9cadd",
   "speaker_korean": "험상궂은 아줌마의 딸",
   "korean": "「네, 네!"
  },
  {
   "key": "9ab3b1c4caf7",
   "speaker_korean": "험상궂은 아줌마의 딸",
   "korean": "「또 와 주세요♥"
  },
  {
   "key": "e2e38f64458a",
   "speaker_korean": null,
   "korean": "⟦1⟧치유 고양이⟦2⟧를 줄까요?\n⟦P⟧"
  },
  {
   "key": "b833a60342c6",
   "speaker_korean": null,
   "korean": "⟦1⟧・선물할게."
  },
  {
   "key": "6004a6f4d14c",
   "speaker_korean": null,
   "korean": "⟦1⟧・그냥 자랑하고 싶었을 뿐이야."
  },
  {
   "key": "91eb5e8b0511",
   "speaker_korean": null,
   "korean": "크리에이터 마유와 계약했습니다.\n⟦P⟧"
  },
  {
   "key": "36375083c180",
   "speaker_korean": "역시 험상궂은 아줌마",
   "korean": "「참, 요즘 젊은것들은…\n자기가 사는 곳 정도는\n깨끗이 못 하는 건가.\n⟦P⟧"
  },
  {
   "key": "d205d9776f8c",
   "speaker_korean": null,
   "korean": "무리한 소리 하지 마.\n봐, 너도 네 방 정도는\n네가 알아서 청소하고 오라고!\n⟦P⟧"
  },
  {
   "key": "9e81cae4a480",
   "speaker_korean": "역시 험상궂은 아줌마",
   "korean": "「혼자서 다 꾸려나가야 하게 돼서\n일이 두 배로 늘었잖아.\n구시렁구시렁…\n⟦P⟧"
  },
  {
   "key": "d5bf96112ef1",
   "speaker_korean": "마유",
   "korean": "⟦1⟧「⟦2⟧페이트 씨⟦3⟧,\n저한테 무슨 볼일이세요?\n⟦P⟧"
  },
  {
   "key": "9ad22ee25355",
   "speaker_korean": null,
   "korean": "⟦1⟧치유 고양이⟦2⟧를 보여줄까요?\n⟦P⟧"
  },
  {
   "key": "ea62344f6ca3",
   "speaker_korean": "마유",
   "korean": "⟦1⟧「와아!\n정말 귀여운 인형이네요.\n⟦P⟧"
  }
 ]
}