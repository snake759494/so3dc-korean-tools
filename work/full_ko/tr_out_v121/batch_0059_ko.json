{
 "batch_id": "batch_0059",
 "translations": [
  {
   "key": "afb5ce901285",
   "speaker_korean": "클리프",
   "korean": "「그래서, 까놓고 말해서,\n지금 전황은 어떻게 돌아가냐?"
  },
  {
   "key": "6861ceefcd32",
   "speaker_korean": "넬",
   "korean": "「솔직히, 힘든 상황이야.\n적군은 이미 ⟦1⟧컬소어⟦2⟧를 넘어서,\n⟦3⟧아리아스⟦4⟧ 앞, 국경 부근에\n전선을 펼치고 있어.\n이번엔 지금까지보다 많은 병력을\n투입해 오고 있다는 정보도\n있고 말이야……."
  },
  {
   "key": "124fd70301a6",
   "speaker_korean": "클리프",
   "korean": "「그거 골치 아프군…\n적놈들도 진심이란 거냐.\n진두지휘는 ⟦1⟧복스⟦2⟧라고 했었지?\n게다가 아리그리프 삼군도\n전 부대가 참가한다는 거잖냐?"
  },
  {
   "key": "565f4b2a380f",
   "speaker_korean": "클리프",
   "korean": "「그런 거냐?"
  },
  {
   "key": "d7de87f91240",
   "speaker_korean": "넬",
   "korean": "「다만 ⟦1⟧일그러진 알벨⟦2⟧은\n작전에 참가하지 않는다는 얘기야."
  },
  {
   "key": "59942b737856",
   "speaker_korean": "넬",
   "korean": "「자세한 상황은 알 수 없지만,\n그런 보고가 들어와 있어.\n어쩌면 ⟦1⟧베크렐 광산⟦2⟧에서의 일이\n영향을 준 걸지도 모르겠네."
  },
  {
   "key": "0f9f91c8a659",
   "speaker_korean": "넬",
   "korean": "「너희를 이런 일에 끌어들이려고\n여기까지 데려온 건 아니었는데 말이야."
  },
  {
   "key": "c8058e2e481c",
   "speaker_korean": "클리프",
   "korean": "「이제 와서 무슨 소리냐.\n애초에 결정한 건 우리다.\n네가 책임을 느낄 필요는 없어."
  },
  {
   "key": "e626551df684",
   "speaker_korean": "넬",
   "korean": "「그렇게 말해 주면, 고맙지.\n대놓고 말하진 않았지만,\n본부도 너희 힘을\n믿고 있는 건 확실하니까.\n틀림없이 작전에 편입될 거야."
  },
  {
   "key": "ed5a28fea861",
   "speaker_korean": "클리프",
   "korean": "「이제 와서 모른 척할 수 있다고\n생각하진 않아.\n칼을 뽑았으면 무라도 썰어야지. 안 그래?"
  },
  {
   "key": "c8c47c6b60e4",
   "speaker_korean": "페이트",
   "korean": "「…어, 아아, 그렇지."
  },
  {
   "key": "7fb218897bce",
   "speaker_korean": "클리프",
   "korean": "「안 듣고 있었지…너.\n왜 그래? 무슨 생각 하냐?"
  },
  {
   "key": "974b8a6c17bc",
   "speaker_korean": "페이트",
   "korean": "「아니, ⟦1⟧아미나⟦2⟧랑 ⟦3⟧디오르⟦4⟧를 보고 있자니,\n나도 소꿉친구 생각이 나서 말이야.\n…어떻게 지내고 있을까 하고.\n게다가 아버지 일도 있고…….\n다들, 무사하면 좋겠는데."
  },
  {
   "key": "ad5e35eb6112",
   "speaker_korean": "넬",
   "korean": "「미안하네.\n결국 이렇게 오래 붙잡아 두고 말았어.\n너로서는 한시라도 빨리\n아버지를 구하러 가고 싶을 텐데 말이야."
  },
  {
   "key": "75ff926bc591",
   "speaker_korean": "페이트",
   "korean": "「그건, 괜찮아요.\n어차피 지금으로선 아버지가 계신 곳에\n닿을 방법도 없으니까요.\n조금 떠올렸을 뿐이에요…."
  },
  {
   "key": "b0fd84c82d4b",
   "speaker_korean": "클리프",
   "korean": "「지난번에도 말했지만,\n신경 써 봤자 소용없다고.\n지금, 할 수 있는 걸 할 뿐이야."
  },
  {
   "key": "6ba7715af154",
   "speaker_korean": "페이트",
   "korean": "「응, 알고 있어.\n지금은 이 나라 일…\n그리고 무사히 살아남는 걸\n생각해야겠지."
  },
  {
   "key": "374d0f355dba",
   "speaker_korean": "클리프",
   "korean": "「아아, 그렇지."
  },
  {
   "key": "7848eda67b6f",
   "speaker_korean": "미라쥬",
   "korean": "「그런데, 저는 어떻게 하면\n되나요?\n싸우라고 하시면 싸우겠습니다만?"
  },
  {
   "key": "20bf18d297f9",
   "speaker_korean": "클리프",
   "korean": "「오, 그렇군……어쩔래?\n전에도 말했지만, 전력은 된다고."
  },
  {
   "key": "5f081de4b1f8",
   "speaker_korean": "페이트",
   "korean": "「난 ⟦1⟧미라쥬 씨⟦2⟧가\n⟦3⟧아미나⟦4⟧ 곁에 있어 줬으면\n하는데."
  },
  {
   "key": "556fa957332f",
   "speaker_korean": "미라쥬",
   "korean": "「알겠습니다."
  },
  {
   "key": "db9272c26699",
   "speaker_korean": "디오르",
   "korean": "「여러분,\n오래 기다리셨습니다."
  },
  {
   "key": "07d34c799672",
   "speaker_korean": "넬",
   "korean": "「이제 됐어?"
  },
  {
   "key": "7650a60ee30b",
   "speaker_korean": "디오르",
   "korean": "「예…그렇게 느긋하게 있을\n수는 없으니까요."
  },
  {
   "key": "68518b86f131",
   "speaker_korean": "페이트",
   "korean": "「응…그러기 위해서라도 이 전쟁,\n질 수는 없어."
  },
  {
   "key": "044831f9c654",
   "speaker_korean": "디오르",
   "korean": "「예, 반드시 이깁니다.\n⟦1⟧아미나⟦2⟧와도 약속했으니까요."
  },
  {
   "key": "669b9874b107",
   "speaker_korean": "클리프",
   "korean": "「OK, 한번 해 보자고."
  },
  {
   "key": "676acf6d6cbd",
   "speaker_korean": "넬",
   "korean": "「그렇다면 ⟦1⟧디오르⟦2⟧는 서둘러\n준비를 끝내도록 해."
  },
  {
   "key": "4553b8f2db86",
   "speaker_korean": "디오르",
   "korean": "「그럴 수가…⟦1⟧아미나⟦2⟧가, 병이라고요?\n원래 활발한 편은 아니었지만…."
  },
  {
   "key": "0bfbe16730a4",
   "speaker_korean": "페이트",
   "korean": "「내가 이런 말을 하는 것도\n좀 그렇다고는 생각하지만…\n부탁이야, 그녀를―――."
  },
  {
   "key": "7667f10ae36e",
   "speaker_korean": "클리프",
   "korean": "「뭐 됐어…덤벼드는 놈은\n누구든 박살 내 주지."
  },
  {
   "key": "1fc1fb4c37a1",
   "speaker_korean": "넬",
   "korean": "「내가 할 말은 아니지만…."
  },
  {
   "key": "15cba7e05090",
   "speaker_korean": "클리프",
   "korean": "「음…그렇군.\n확실히, 굳이 ⟦1⟧미라쥬⟦2⟧를\n싸우게 할 필요도 없지."
  },
  {
   "key": "13596c31e6eb",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧미라쥬⟦2⟧,\n그런 걸로 부탁 좀 하자."
  },
  {
   "key": "10502e03781b",
   "speaker_korean": "디오르",
   "korean": "「게다가…⟦1⟧아미나⟦2⟧와는 전쟁이 끝나면,\n천천히 이야기하면 되니까요."
  },
  {
   "key": "c36a564819c2",
   "speaker_korean": "넬",
   "korean": "「우리는 먼저 ⟦1⟧아리아스⟦2⟧로\n향할게."
  },
  {
   "key": "98f043255537",
   "speaker_korean": "미라쥬",
   "korean": "「아아……\n힘드셨나 보군요."
  },
  {
   "key": "1ddad13e1927",
   "speaker_korean": "미라쥬",
   "korean": "「예, 좋지는 않네요.\n상당히 무리해서 여기까지 온 거겠죠."
  },
  {
   "key": "e8debe7c271a",
   "speaker_korean": "페이트",
   "korean": "「…그래."
  },
  {
   "key": "f1e5b0bab4b3",
   "speaker_korean": "미라쥬",
   "korean": "「무슨 일 있었나요?"
  },
  {
   "key": "fd1763a60a6d",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧……."
  },
  {
   "key": "fbec421614f1",
   "speaker_korean": "아미나",
   "korean": "「당신이 여기 있다는\n것은…전쟁은\n끝난 건가요?\n…다행이다……."
  },
  {
   "key": "4c357cff7fed",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧, ⟦3⟧디오르⟦4⟧가…."
  },
  {
   "key": "63fae5827cf0",
   "speaker_korean": "아미나",
   "korean": "「네…?"
  },
  {
   "key": "c2fab4c86d27",
   "speaker_korean": "페이트",
   "korean": "「같이 가.\n⟦1⟧디오르⟦2⟧는 지금, 성에 있어."
  },
  {
   "key": "4f143db5dc78",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧미라쥬 씨⟦2⟧,\n⟦3⟧아미나⟦4⟧는요?"
  },
  {
   "key": "e6ff94df4a02",
   "speaker_korean": "미라쥬",
   "korean": "「무리를 해서는\n안 돼요."
  },
  {
   "key": "26450554c9f3",
   "speaker_korean": "미라쥬",
   "korean": "「그건 안 됩니다.\n의사도 지금 옮기는 건 위험하다고 하셨어요.\n그녀에게 그런 무리를 시켜서는―――."
  },
  {
   "key": "4cb49b3e4075",
   "speaker_korean": "페이트",
   "korean": "「부탁할게요."
  },
  {
   "key": "558f5bc0c062",
   "speaker_korean": "아미나",
   "korean": "「예, 알겠습니다."
  },
  {
   "key": "ebc886cc2962",
   "speaker_korean": "페이트",
   "korean": "「미안."
  },
  {
   "key": "91c5a2163c34",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧페이트 씨⟦2⟧……."
  }
 ]
}