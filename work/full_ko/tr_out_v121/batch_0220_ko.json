{
 "batch_id": "batch_0220",
 "translations": [
  {
   "key": "f596401becde",
   "speaker_korean": "블레어",
   "korean": "「우리가 ⟦1⟧에터널 스피어⟦2⟧ 안에서\n쓰기 위해 준비된…\n뭐, 디버그 툴 같은 거야.\n사용법을 이해한 사람이 쓰면\n그건 ⟦3⟧에터널 스피어⟦4⟧ 안에서\n강대한 힘이 될 거야."
  },
  {
   "key": "ccbca3b22853",
   "speaker_korean": "블레어",
   "korean": "「너희가 봐도 아마\n뭐에 쓰는지 모를 수수께끼 아이템이야.\n이른바 ⟦1⟧오파츠⟦2⟧라고 하면\n감이 좀 잡힐까?"
  },
  {
   "key": "44568fccde35",
   "speaker_korean": "마리아",
   "korean": "「그건 어떤 거야?"
  },
  {
   "key": "45eee9680652",
   "speaker_korean": "블레어",
   "korean": "「모양은 다양해.\n정육면체 크리스탈 큐브인 경우도 있고,\n정체 모를 기계인 경우도 있고.\n설정한 개발자의 취향이나\n배치 장소에 따라 달라지니까…."
  },
  {
   "key": "a8a98a2f6a4e",
   "speaker_korean": "클리프",
   "korean": "「그럼 두 손 두 발 다 드는 거잖아.\n지금부터 모양도 모르는 걸\n온 은하를 뒤지고 다니자는 거냐?\n시간 안에 될 리가 없잖냐."
  },
  {
   "key": "4f008ffa3267",
   "speaker_korean": "블레어",
   "korean": "「잠깐만 기다려.\n지금 이쪽에서 데이터베이스를\n검색해 볼 테니까…."
  },
  {
   "key": "28ea553ba464",
   "speaker_korean": "블레어",
   "korean": "「이거네."
  },
  {
   "key": "2ffaec5a2e84",
   "speaker_korean": "블레어",
   "korean": "「은하계에 있는 특수 ⟦1⟧AD⟦2⟧는\n대략 은빛으로 빛나는 구체 같아.\n특별한 효과는 없지만,\n보유 에너지는 꽤 높게\n설정되어 있는 듯해.\n스캔해 보면 확인할 수 있을 거야."
  },
  {
   "key": "67df93ce826e",
   "speaker_korean": "블레어",
   "korean": "「잠깐만… 배치된 장소도\n검색해 볼 테니까."
  },
  {
   "key": "53c08a754672",
   "speaker_korean": "페이트",
   "korean": "「은색… 구체?"
  },
  {
   "key": "15218209eadf",
   "speaker_korean": "블레어",
   "korean": "「응…\n그렇게 데이터엔 나와 있어."
  },
  {
   "key": "98b8caa7a547",
   "speaker_korean": "블레어",
   "korean": "「아, 이 별도 이미 소실되어 버렸어.\n다른 곳은… 아, 정말!"
  },
  {
   "key": "12224cdc27aa",
   "speaker_korean": "클리프",
   "korean": "「저기, ⟦1⟧블레어⟦2⟧.\n혹시 크기는 이 정도냐?"
  },
  {
   "key": "6d9223d0e598",
   "speaker_korean": "블레어",
   "korean": "「딱 그 정도야… 왜?"
  },
  {
   "key": "57116d0bb77e",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧블레어 씨⟦2⟧, ⟦3⟧에리클 2호성⟦4⟧에는\n그게 없나요?"
  },
  {
   "key": "7e6ed1d1bc4b",
   "speaker_korean": "마리아",
   "korean": "「역시 그랬군."
  },
  {
   "key": "09478205711c",
   "speaker_korean": "블레어",
   "korean": "「어떻게 알았어?"
  },
  {
   "key": "c3e5c0813661",
   "speaker_korean": "마리아",
   "korean": "「한 번 본 적이 있으니까."
  },
  {
   "key": "098566d7be5a",
   "speaker_korean": "페이트",
   "korean": "「우리가 ⟦1⟧에리클⟦2⟧에 있을 때\n그 아이템을 본 적이 있어요.\n분명 ⟦3⟧세피라⟦4⟧와 ⟦5⟧에리클⟦6⟧에서는\n그렇게 불렸었는데요."
  },
  {
   "key": "d5c2f4a9554e",
   "speaker_korean": "블레어",
   "korean": "「그렇구나. 그런 우연이 있었다니….\n그 ⟦1⟧세피라⟦2⟧를 사용하면\n특수 공간에 접근할 수 있을 거야."
  },
  {
   "key": "325c2d296481",
   "speaker_korean": "페이트",
   "korean": "「알겠습니다.\n다들, ⟦1⟧에리클⟦2⟧로 가자!"
  },
  {
   "key": "c0c8b04f35e5",
   "speaker_korean": "로저",
   "korean": "「오냐!"
  },
  {
   "key": "60f3b20511b4",
   "speaker_korean": "스프레",
   "korean": "「오케이!"
  },
  {
   "key": "3f9b516903ff",
   "speaker_korean": "블레어",
   "korean": "「아 참, ⟦1⟧소피아⟦2⟧….\n⟦3⟧세피라⟦4⟧를 발견하면 네가 만져 봐."
  },
  {
   "key": "b579ecb0af96",
   "speaker_korean": "소피아",
   "korean": "「제가요…?"
  },
  {
   "key": "b480ae49f92c",
   "speaker_korean": "블레어",
   "korean": "「특수 ⟦1⟧AD⟦2⟧는 원래 ⟦3⟧FD인⟦4⟧이 사용하도록\n설치된 아이템이야.\n⟦P⟧그래서 ⟦5⟧FD인⟦6⟧ 외에는 본래 방식으로는\n쓸 수 없게 설정되어 있어.\n즉 너희로는 안 된다는 뜻이야."
  },
  {
   "key": "aeba6e22c90b",
   "speaker_korean": "블레어",
   "korean": "「하지만 지금까지 상황을 보면,\n너만은 쓸 수 있을 것 같아."
  },
  {
   "key": "4403baedbddf",
   "speaker_korean": "소피아",
   "korean": "「알겠습니다."
  },
  {
   "key": "b01a7eb70213",
   "speaker_korean": "블레어",
   "korean": "「반응하면, 염력으로 나를 떠올려.\n이 지점에 대해서….\n아마 그러면 나와 연락이\n닿을 수 있게 될 거야."
  },
  {
   "key": "74bcaf79b3eb",
   "speaker_korean": "소피아",
   "korean": "「예. 해 볼게요."
  },
  {
   "key": "23379445fcc8",
   "speaker_korean": "블레어",
   "korean": "「조심해."
  },
  {
   "key": "10306804a981",
   "speaker_korean": "페이트",
   "korean": "「특수 ⟦1⟧AD⟦2⟧?"
  },
  {
   "key": "0956c5a81ce6",
   "speaker_korean": "블레어",
   "korean": "「⟦1⟧에리클 2호성⟦2⟧?\n잠깐만…."
  },
  {
   "key": "14c502a95416",
   "speaker_korean": "블레어",
   "korean": "「있었어… 있잖아!?"
  },
  {
   "key": "2244ff07cba9",
   "speaker_korean": "록시",
   "korean": "『우리는 ⟦1⟧타임게이트⟦2⟧를 시간 여행자로\n인식했지만, 착각이었던 모양입니다."
  },
  {
   "key": "9ec8f58b604c",
   "speaker_korean": null,
   "korean": "『⟦1⟧타임게이트⟦2⟧는 ⟦3⟧FD인⟦4⟧의 세계인\n⟦5⟧FD 공간⟦6⟧으로 향하는 문이다."
  },
  {
   "key": "329c0527642c",
   "speaker_korean": null,
   "korean": "『시간 여행은 ⟦1⟧FD 공간⟦2⟧의 존재를 우리가\n감지하지 못하게 하려는 보호 장치의 결과로\n발생한 현상입니다."
  },
  {
   "key": "a1ee34027bb2",
   "speaker_korean": null,
   "korean": "『시간을 오갈 수 있는 ⟦1⟧FD 세계⟦2⟧.\n그곳을 경유함으로써 ⟦3⟧타임게이트⟦4⟧는\n시간 여행이 가능했던 것――――――"
  },
  {
   "key": "2a57a6d033fd",
   "speaker_korean": null,
   "korean": "『그 사실을 알았을 때,\n우리 연구자들은 흥분했습니다."
  },
  {
   "key": "9be49a2abbf1",
   "speaker_korean": null,
   "korean": "『어쨌든 여태껏 수수께끼였던 ⟦1⟧타임게이트⟦2⟧의\n시스템을 해명해 낸 것에 더해,\n새로운 인류의 존재를 확인할 수\n있었으니까요."
  },
  {
   "key": "0025f9fb67ef",
   "speaker_korean": null,
   "korean": "『하지만 그때, 저희로서는 상상도 못 할\n사태가 벌어졌습니다. 우리에게 ⟦1⟧타임게이트⟦2⟧가\n경고를 해 온 것입니다―――――――――"
  },
  {
   "key": "a661b24e1279",
   "speaker_korean": "타임게이트",
   "korean": "『각오하라."
  },
  {
   "key": "11b77fe1beec",
   "speaker_korean": "조수",
   "korean": "「박사님,\n⟦1⟧타임게이트⟦2⟧가…."
  },
  {
   "key": "72cad3358aff",
   "speaker_korean": "록시",
   "korean": "「윽, 이건…!?"
  },
  {
   "key": "6d43340099e1",
   "speaker_korean": "타임게이트",
   "korean": "『⟦1⟧에터널 스피어⟦2⟧의 과학은\n지나치게 발전해 버렸다.\n더는 못 본 척할 수 없다."
  },
  {
   "key": "c043258a86c6",
   "speaker_korean": "록시",
   "korean": "「⟦1⟧에터널 스피어⟦2⟧?"
  },
  {
   "key": "f295168c9376",
   "speaker_korean": "타임게이트",
   "korean": "『⟦1⟧에터널 스피어⟦2⟧란\n네놈들 인간의 세계다."
  },
  {
   "key": "12bc67f18124",
   "speaker_korean": "록시",
   "korean": "「게이트여, 과학이 너무 발전했다는 건\n대체 무슨 뜻이지?"
  },
  {
   "key": "65e0e7aab957",
   "speaker_korean": "타임게이트",
   "korean": "『문장 기술은 창조왕의 기술.\n그리고 그 문장 기술을 받아들인 ⟦1⟧문장유전학⟦2⟧.\n이것은 금단의 과학이다."
  },
  {
   "key": "2f8775f6da30",
   "speaker_korean": null,
   "korean": "『인간은 어리석게도 허락되지 않은\n영역에 발을 들이고 말았다."
  },
  {
   "key": "07d1378e4528",
   "speaker_korean": null,
   "korean": "『과도하게 발달한 인간의 과학은\n언젠가 창조왕에게 칼끝을 겨눌지도 모른다.\n머지않은 미래에, 창조왕은 ⟦1⟧집행자⟦2⟧를 통해\n인간을 멸망시킬 것이다."
  },
  {
   "key": "52b7edd60c39",
   "speaker_korean": "록시",
   "korean": "『⟦1⟧타임게이트⟦2⟧의 경고는\n두려운 것이었습니다."
  },
  {
   "key": "bacae882050e",
   "speaker_korean": null,
   "korean": "『창조왕이 창조물을 멸한다."
  },
  {
   "key": "f87050762d43",
   "speaker_korean": null,
   "korean": "『바로 수많은 예언서와 종교서에\n기록된 일이 현실이\n된다는 것이니까요."
  },
  {
   "key": "e568609ce9d8",
   "speaker_korean": null,
   "korean": "『⟦1⟧문장유전학⟦2⟧을 포기하면\n인간은 멸망을 피하는가?"
  },
  {
   "key": "21bb1b9e90bf",
   "speaker_korean": null,
   "korean": "『하지만 ⟦1⟧타임게이트⟦2⟧의 대답은\n우리 희망을 속절없이 무너뜨렸습니다."
  },
  {
   "key": "ce67c3a23731",
   "speaker_korean": "타임게이트",
   "korean": "『소용없다. 지금 그것을 버린다 해도,\n머지않아 다시 그 뜻을 이어받을 자가\n나타날 것이다. 인간이란 그런 존재다."
  },
  {
   "key": "e3499e6a427d",
   "speaker_korean": null,
   "korean": "『오염은 이미 회복 불가능한 수준까지\n번져 있다."
  },
  {
   "key": "e01748fb49f5",
   "speaker_korean": null,
   "korean": "『각오하라."
  },
  {
   "key": "7500492ef530",
   "speaker_korean": null,
   "korean": "『멸망은 이미 정해진 일.\n이건 경고가 아니다. 선고다."
  }
 ]
}