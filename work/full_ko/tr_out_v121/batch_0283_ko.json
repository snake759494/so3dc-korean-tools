   "korean": "액세서리를 봅니다"
  },
  {
   "key": "f592fe3eab25",
   "speaker_korean": null,
   "korean": "사용 아이템을 봅니다"
  },
  {
   "key": "ebe626ec973c",
   "speaker_korean": null,
   "korean": "음식을 봅니다"
  },
  {
   "key": "bf80c12ab9fc",
   "speaker_korean": null,
   "korean": "어디에 속하지 않는 아이템을 봅니다"
  },
  {
   "key": "8c6455990837",
   "speaker_korean": null,
   "korean": "소재를 봅니다"
  },
  {
   "key": "f751f347dfa4",
   "speaker_korean": null,
   "korean": "귀중품을 봅니다"
  },
  {
   "key": "469858b6a953",
   "speaker_korean": null,
   "korean": "전투용 아이템을 봅니다"
  },
  {
   "key": "999e90635255",
   "speaker_korean": null,
   "korean": "새로 입수한 아이템을 봅니다"
  },
  {
   "key": "76f390612ee1",
   "speaker_korean": null,
   "korean": "무기를 장착함"
  },
  {
   "key": "0ac8a036125c",
   "speaker_korean": null,
   "korean": "방어구를 장착함"
  },
  {
   "key": "e8973dd9c954",
   "speaker_korean": null,
   "korean": "액세서리1에 장착합니다 (으)로 위치 전환이 가능합니다"
  },
  {
   "key": "6024abe7d1e2",
   "speaker_korean": null,
   "korean": "액세서리2에 장착합니다 (으)로 위치 전환이 가능합니다"
  },
  {
   "key": "619c3ec24bdb",
   "speaker_korean": null,
   "korean": " 정보"
  },
  {
   "key": "876b096566be",
   "speaker_korean": null,
   "korean": " 사용"
  },
  {
   "key": "67d57c50146d",
   "speaker_korean": null,
   "korean": " 선택"
  },
  {
   "key": "395f8b398d7b",
   "speaker_korean": null,
   "korean": " 정렬"
  },
  {
   "key": "b5be1aea4bee",
   "speaker_korean": null,
   "korean": " 버림"
  },
  {
   "key": "2e4e6355513e",
   "speaker_korean": null,
   "korean": "버림 전환"
  },
  {
   "key": "f3287621c776",
   "speaker_korean": null,
   "korean": "뒤로 용"
  },
  {
   "key": "24bf520f5c8a",
   "speaker_korean": null,
   "korean": "전환 복귀"
  },
  {
   "key": "14de258741ad",
   "speaker_korean": null,
   "korean": "폐기확인"
  },
  {
   "key": "d74db808634b",
   "speaker_korean": null,
   "korean": "이 아이템을 버립니다\n정말 버리시겠습니까?"
  },
  {
   "key": "496fcfe7c215",
   "speaker_korean": null,
   "korean": "이벤트 스킵 메시지가 표시됩니다"
  },
  {
   "key": "c121e40f8b97",
   "speaker_korean": null,
   "korean": "이벤트를 스킵하지 않습니다"
  },
  {
   "key": "a7a2282b2580",
   "speaker_korean": null,
   "korean": "메시지 창과 음성이 모두 재생됩니다"
  },
  {
   "key": "7b85b4f896e4",
   "speaker_korean": null,
   "korean": "메시지 창만 표시됩니다"
  },
  {
   "key": "f4a477a254ec",
   "speaker_korean": null,
   "korean": "음성만 재생됩니다"
  },
  {
   "key": "9b9548da95b9",
   "speaker_korean": null,
   "korean": "음성이 있을 때만 자동으로 대화창을 닫고 시나리오가 진행됩니다"
  },
  {
   "key": "8ed27451a06e",
   "speaker_korean": null,
   "korean": "자동 타겟팅 모드로 설정합니다"
  },
  {
   "key": "fc7fcec93f89",
   "speaker_korean": null,
   "korean": "수동 타겟팅 모드로 설정합니다"
  },
  {
   "key": "b9565a4feaa1",
   "speaker_korean": null,
   "korean": "카메라 워크가 자동으로 전환되며 전투를 진행합니다"
  },
  {
   "key": "b15192c269a6",
   "speaker_korean": null,
   "korean": "카메라를 고정한 채 전투를 진행합니다"
  },
  {
   "key": "0d21aa539aa9",
   "speaker_korean": null,
   "korean": "높은 위치 카메라로 전투를 진행합니다"
  },
  {
   "key": "eda9d3571ec1",
   "speaker_korean": null,
   "korean": "낮은 위치 카메라로 전투를 진행합니다"
  },
  {
   "key": "242ea707087d",
   "speaker_korean": null,
   "korean": "전투 중 보이스가 재생됩니다"
  },
  {
   "key": "9117f59a871e",
   "speaker_korean": null,
   "korean": "전투 중 보이스가 없습니다"
  },
  {
   "key": "07444f1e52dd",
   "speaker_korean": null,
   "korean": "전투 스텝은 L2 버튼과 방향키 또는 왼쪽 스틱으로 진행합니다"
  },
  {
   "key": "08003b01ee00",
   "speaker_korean": null,
   "korean": "전투 스텝은 방향키로만 진행합니다"
  },
  {
   "key": "194625549a38",
   "speaker_korean": null,
   "korean": "진동을 켭니다"
  },
  {
   "key": "ace3fe18b71e",
   "speaker_korean": null,
   "korean": "진동을 끕니다"
  },
  {
   "key": "b9e68bd8bfd3",
   "speaker_korean": null,
   "korean": "사운드를 모노럴로 출력합니다"
  },
  {
   "key": "c63c742786a9",
   "speaker_korean": null,
   "korean": "사운드를 스테레오로 출력합니다"
  },
  {
   "key": "ee0397f94fe0",
   "speaker_korean": null,
   "korean": "사운드를 돌비 디지털 프로로직으로 출력합니다"
  },
  {
   "key": "b6b1821dc174",
   "speaker_korean": null,
   "korean": "사운드를 헤드폰으로 출력할 때 최적의 효과를 발휘합니다"
  },
  {
   "key": "93d99eb910e2",
   "speaker_korean": null,
   "korean": "버튼 위치를 초기화합니다 (으)로 결정"
  },
  {
   "key": "45ef5364103a",
   "speaker_korean": null,
   "korean": "버튼 위치를 변경합니다 (으)로 결정"
  },
  {
   "key": "da480ddc7a04",
   "speaker_korean": null,
   "korean": "윈도우 색을 초기화합니다 (으)로 결정"
  },
  {
   "key": "c5460ff51830",
   "speaker_korean": null,
   "korean": "윈도우 색을 변경합니다 (으)로 결정"
  },
  {
   "key": "6decde2970b6",
   "speaker_korean": null,
   "korean": "화면을 4:3으로 설정"
  },
  {
   "key": "88fc4b840479",
   "speaker_korean": null,
   "korean": "화면을 16:9로 설정"
  },
  {
   "key": "ff85cf9d6040",
   "speaker_korean": null,
   "korean": "전투 종료 후 전투 컬렉션을 수집합니다"
  },
  {
   "key": "6203d51cae3b",
   "speaker_korean": null,
   "korean": "전투 종료 후 전투 컬렉션을 수집하지 않습니다"
  },
  {
   "key": "c94718339392",
   "speaker_korean": null,
   "korean": "″PlayStation BB Unit″ 에서 불러옵니다"
  },
  {
   "key": "e00111931275",
   "speaker_korean": null,
   "korean": "Star Ocean Till the End of Time D.C.의 DVD-ROM에서 불러옵니다"
  },
  {
   "key": "2432d959df4d",
   "speaker_korean": null,
   "korean": "전투 중 공격 버튼을 눌러도 타겟까지 달려가지 않는 모드로 설정합니다"
  },
  {
   "key": "d357593fd9e1",
