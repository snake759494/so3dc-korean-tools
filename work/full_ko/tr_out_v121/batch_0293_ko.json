{
 "batch_id": "batch_0293",
 "translations": [
  {
   "key": "bdb2eb22685a",
   "speaker_korean": null,
   "korean": "최대 MP가 ⟦1⟧ 증가합니다"
  },
  {
   "key": "a5f6e3f0dc08",
   "speaker_korean": null,
   "korean": "레벨이 높을수록 적에게\n효율적인 공격이 가능합니다"
  },
  {
   "key": "e889c163766b",
   "speaker_korean": null,
   "korean": "적의 공격을 정확히\n회피할 수 있게 됩니다"
  },
  {
   "key": "a9fcb04e981b",
   "speaker_korean": null,
   "korean": "스킬 습득에 영향을 줍니다"
  },
  {
   "key": "0bbb71e606a7",
   "speaker_korean": null,
   "korean": "약공격 쇼트레인지 설정"
  },
  {
   "key": "81e71756e384",
   "speaker_korean": null,
   "korean": "약공격 롱레인지 설정"
  },
  {
   "key": "2771861a2aaa",
   "speaker_korean": null,
   "korean": "강공격 쇼트레인지 설정"
  },
  {
   "key": "db7ae216b5e1",
   "speaker_korean": null,
   "korean": "강공격 롱레인지 설정"
  },
  {
   "key": "44f731b31ac5",
   "speaker_korean": null,
   "korean": "신조 스킬 1 설정"
  },
  {
   "key": "e1b554b48761",
   "speaker_korean": null,
   "korean": "신조 스킬 2 설정"
  },
  {
   "key": "5bae87141fab",
   "speaker_korean": null,
   "korean": "도발"
  },
  {
   "key": "17617f9ba545",
   "speaker_korean": null,
   "korean": "에너미서치"
  },
  {
   "key": "5fef4f515faf",
   "speaker_korean": null,
   "korean": "버서크"
  },
  {
   "key": "e614fb46fa6b",
   "speaker_korean": null,
   "korean": "수행"
  },
  {
   "key": "253eda3e2616",
   "speaker_korean": null,
   "korean": "오라셀렉트"
  },
  {
   "key": "a4019672080c",
   "speaker_korean": null,
   "korean": "밸런스컨디션"
  },
  {
   "key": "e6debcfa4e0f",
   "speaker_korean": null,
   "korean": "적을 자신에게 유인할 수 있습니다"
  },
  {
   "key": "5f737897e5be",
   "speaker_korean": null,
   "korean": "적의 능력치와 입수 가능한 아이템을 조사합니다"
  },
  {
   "key": "68446e9aa851",
   "speaker_korean": null,
   "korean": "공격력이 30% 상승하고 소비 Guts가 1/2이 됩니다\n단, 방어력이 30% 하락합니다"
  },
  {
   "key": "1271b1faed71",
   "speaker_korean": null,
   "korean": "경험치 획득량이 40% 상승\n하지만 소비 Guts가 3배가 되어버립니다"
  },
  {
   "key": "a6a959df3ed8",
   "speaker_korean": null,
   "korean": "카운터 오라의 베리에이션 선택\n효과 결정"
  },
  {
   "key": "df01b6fa2729",
   "speaker_korean": null,
   "korean": "설정에 따라 HP・MP를 보호합니다"
  },
  {
   "key": "72fd948d689b",
   "speaker_korean": null,
   "korean": "독・마비・석화・동결・기절 효과를 약화시킵니다\n단, 방어력이 20% 하락합니다"
  },
  {
   "key": "315de71e4ac3",
   "speaker_korean": null,
   "korean": "스탠더드"
  },
  {
   "key": "99bda9cfc0c0",
   "speaker_korean": null,
   "korean": "링웨이브"
  },
  {
   "key": "de92a90ab93b",
   "speaker_korean": null,
   "korean": "에이밍"
  },
  {
   "key": "eb9d7a5bd8da",
   "speaker_korean": null,
   "korean": "와이드・에이밍"
  },
  {
   "key": "8394148f4e94",
   "speaker_korean": null,
   "korean": "리제너레이션"
  },
  {
   "key": "91ba4eb117a9",
   "speaker_korean": null,
   "korean": "오라는 전방에 발생\n효과.기절"
  },
  {
   "key": "40215fe496eb",
   "speaker_korean": null,
   "korean": "오라는 전방 광범위에 발생\n효과.70% 확률로 기절"
  },
  {
   "key": "6dd22fd2356b",
   "speaker_korean": null,
   "korean": "오라는 주위에 발생\n효과.데미지"
  },
  {
   "key": "3617b768b1f8",
   "speaker_korean": null,
   "korean": "오라는 비상하여 적에게 유도됩니다\n효과.데미지"
  },
  {
   "key": "4647e847b464",
   "speaker_korean": null,
   "korean": "오라는 확산하여 다수의 적에게 유도됩니다\n효과.데미지"
  },
  {
   "key": "7812febcfdc7",
   "speaker_korean": null,
   "korean": "오라는 확산한 후 자신에게 흡수됩니다\n효과.HP・MP 회복"
  },
  {
   "key": "5ae723b2cb1c",
   "speaker_korean": null,
   "korean": "오라는 무수한 양이 되어 방사됩니다\n효과.데미지"
  },
  {
   "key": "65acd2efcdcf",
   "speaker_korean": null,
   "korean": "HP 보호"
  },
  {
   "key": "fdf684d6889e",
   "speaker_korean": null,
   "korean": "MP 보호"
  },
  {
   "key": "9b00b954ec1e",
   "speaker_korean": null,
   "korean": "HP 데미지를 1/7로 하여\nMP 데미지로 변환합니다"
  },
  {
   "key": "ae3bbc5e31a9",
   "speaker_korean": null,
   "korean": "MP 데미지를 13배로 하여\nHP 데미지로 변환합니다"
  },
  {
   "key": "b74fbbd62a33",
   "speaker_korean": null,
   "korean": "스킬로 인한 HP 증가는 불가능합니다"
  },
  {
   "key": "afc5bc8305eb",
   "speaker_korean": null,
   "korean": "스킬로 인한 MP 증가는 불가능합니다"
  },
