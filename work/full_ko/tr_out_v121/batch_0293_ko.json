  {
   "key": "a6f3e086151b",
   "speaker_korean": null,
   "korean": "문장술을 사용합니다, 전투 중 사용 가능・불가능 전환도 할 수 있습니다"
  },
  {
   "key": "ca1f283198a4",
   "speaker_korean": null,
   "korean": "아군 전원의 HP를 회복하는 주문"
  },
  {
   "key": "b95e721bffd2",
   "speaker_korean": null,
   "korean": "HP가 줄어든 적을 즉사시키는 주문"
  },
  {
   "key": "361a7e90abdc",
   "speaker_korean": null,
   "korean": "독을 해독하는 주문"
  },
  {
   "key": "2a6f89029c4a",
   "speaker_korean": null,
   "korean": "독・마비・석화를 치료하는 주문"
  },
  {
   "key": "548b99b00779",
   "speaker_korean": null,
   "korean": "공격 방어 명중 회피 마법방어를\n상승시키는 주문"
  },
  {
   "key": "328791ea7167",
   "speaker_korean": null,
   "korean": "주문 데미지를 절반으로 하는 주문"
  },
  {
   "key": "e3c4c4113a66",
   "speaker_korean": null,
   "korean": "행동불능자를 부활시키는 주문"
  },
  {
   "key": "4677847d48b5",
   "speaker_korean": null,
   "korean": "일정 범위의 적에게서 HP를 흡수합니다\n발동하려면 공격 버튼을 계속 누릅니다"
