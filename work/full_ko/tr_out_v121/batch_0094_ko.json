{
 "batch_id": "batch_0094",
 "translations": [
  {
   "key": "e4daa37cd3f5",
   "speaker_korean": null,
   "korean": "⟦1⟧・쉰다."
  },
  {
   "key": "46b7edc9348c",
   "speaker_korean": null,
   "korean": "⟦1⟧・안 쉰다."
  },
  {
   "key": "5996d2c63502",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(돈이 모자라네…\n⟦P⟧"
  },
  {
   "key": "e0e7290f4f51",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(한번 써 볼까?\n⟦P⟧"
  },
  {
   "key": "959d0eae21e2",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(그만두자.\n⟦P⟧"
  },
  {
   "key": "ce99ab764d55",
   "speaker_korean": null,
   "korean": "⟦1⟧・거절."
  },
  {
   "key": "125aa07c3e9e",
   "speaker_korean": "임산부",
   "korean": "⟦1⟧「그렇습니까.\n그럼, 다음에도\n또 찾아주시길 기다리겠습니다.\n⟦P⟧"
  },
  {
   "key": "3d93d2c1a7fa",
   "speaker_korean": "임산부",
   "korean": "⟦1⟧「피로는 좀 풀리셨나요?\n그럼 또 찾아주시길 기다리겠습니다.\n⟦P⟧"
  },
  {
   "key": "ef8d4520b544",
   "speaker_korean": "임산부",
   "korean": "⟦1⟧「저기…\n죄송합니다만, 돈이 부족하신\n것 같습니다만…\n⟦P⟧"
  },
  {
   "key": "0a209623ca36",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「아니야, 아니야, 틀렸다니까!\n여긴 남서쪽 문으로 나가는 게\n정답이야.\n⟦P⟧북문 쪽으로 갔다간,\n점점 사람 사는 곳에서\n멀어져 버릴 거잖아!?\n⟦P⟧"
  },
  {
   "key": "cb01c4282c14",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「아니요, 그렇지 않아요.\n분명 지도를 보면, 이 마을은 이전 마을에서 볼 때\n남서쪽 방향에 있다고 적혀 있지만,\n⟦P⟧여기까지 오는 길에 발견한\n나무 그루터기 모양을 보면, 아무래도 방향이\n어긋난 것 같더라고요.\n⟦P⟧아세요?\n베어진 나무의 나이테를 보면 대략적인\n방향을 알 수 있거든요.\n나이테 폭이 넓은 쪽이 남쪽이라는 식으로요.\n⟦P⟧"
  },
  {
   "key": "69d4ce973efd",
   "speaker_korean": null,
   "korean": "그래서 여긴, 북서쪽 문으로 나가는 게\n정답이거든요.\n⟦P⟧"
  },
  {
   "key": "f1106ebf3c19",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「너, 평소보다 유난히 자신만만한데\n말이야…\n그거, 이 지역에서도 통하는 거야?\n⟦P⟧"
  },
  {
   "key": "f02fcf51371a",
   "speaker_korean": null,
   "korean": "자전 각도는? 나무 종류는?\n남반구에서도 되는 거야?\n진짜 그걸로 괜찮은 거야?!\n⟦P⟧"
  },
  {
   "key": "bd84326ed201",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「그게… 아마도.\n⟦P⟧"
  },
  {
   "key": "0031cd43cc1e",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「수상해…\n완전 수상하다니까…\n⟦P⟧내 안의 장사꾼 감이,\n지도 그리는 일에 관해서는\n너 같은 애는 절대 믿지 말라고\n온 힘을 다해 말하고 있단 말이지.\n⟦P⟧"
  },
  {
   "key": "38bebc273693",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「애초에 말이야…\n아무리 지도가 부실하다고 해도,\n중계지점인 이 마을에는\n제대로 도착했으니까,\n⟦P⟧그때까지 과정에서 방향이\n아무리 틀렸다고 해도,\n아무 문제 없는 거 아니야?\n⟦P⟧지금, 이 시점에서 문제인 건,\n처음 마을에서 봤을 때 ⟦2⟧카루사아⟦3⟧라는 마을이\n어느 쪽에 있느냐가 아니라,\n이 마을에서 봤을 때, 그 마을이\n어느 방향에 있느냐잖아?\n⟦P⟧"
  },
  {
   "key": "db3d01f9726c",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「뭐, 그렇네요.\n아니, 그래도…\n⟦P⟧"
  },
  {
   "key": "79afeb5a556c",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「아~ 진짜, 정말!\n더 이상 여기서 우물쭈물해봤자\n소용없으니까,\n⟦P⟧얼른 흑백을\n가려버리자고.\n⟦P⟧전처럼 아무나 붙잡고 길을 물어서,\n그 사람이 가르쳐준 대로\n가는 거야.\n⟦P⟧당연히 그게 맞든\n틀리든, 원망하기는\n절대 없기다.\n어때?\n⟦P⟧"
  },
  {
   "key": "685466803806",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「좋아요.\n그 도전, 받아들이죠.\n⟦P⟧"
  },
  {
   "key": "8130b4aed59d",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「OK, 결정!\n⟦P⟧"
  },
  {
   "key": "66d792030c1e",
   "speaker_korean": null,
   "korean": "그럼, 이제 누구한테 물어볼까\n싶은데…\n누구 없나… 응!?\n⟦P⟧"
  },
  {
   "key": "cffb4b2ca0af",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「잠깐, 너!\n거기 너 말이야, 너!\n⟦P⟧"
  },
  {
   "key": "c8967ad44407",
   "speaker_korean": null,
   "korean": "그래!\n시치미 떼지 말고 얼른\n이리로 오란 말이야!\n⟦P⟧"
  },
  {
   "key": "533503b8d5ba",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「어라!?\n당신은 분명 ⟦2⟧페타니 마을⟦3⟧에서\n뵈었던…\n⟦P⟧"
  },
  {
   "key": "bdc564b8df9c",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「어? 아~!\n뭐야, 그럼 마침 잘됐잖아.\n⟦P⟧우리가 어느 쪽으로 갈지는\n또 이 사람한테 정하라고 하죠.\n굳이 설명하는 수고도 덜고.\n⟦P⟧"
  },
  {
   "key": "55e642b875fb",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「그렇네요.\n그럼, 그렇게 할까요.\n⟦P⟧"
  },
  {
   "key": "e401c81686cd",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「그런 이유니까…\n또다시 오빠한테 ⟦2⟧카루사아⟦3⟧까지\n가는 길을 알려줬으면 하는데.\n⟦P⟧미안하지만…\n한 번만 더 알려줄래?\n⟦P⟧"
  },
  {
   "key": "04e7f8c08c0f",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(하아…\n이거, 어느 쪽 길을\n추천해야 하는 걸까?\n⟦P⟧"
  },
  {
   "key": "70eafbc96ee8",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「북서쪽 문으로 가는 게 좋아.\n좀 길 찾기 어려울지도\n모르지만,\n⟦P⟧조심해서 보면\n금방 찾을 수 있을 거야.\n⟦P⟧"
  },
  {
   "key": "88b652693563",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「북서쪽이라…\n⟦P⟧"
  },
  {
   "key": "8be7b8241fb1",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「그, 그렇습니다, ⟦2⟧루미나 님⟦3⟧.\n⟦P⟧"
  },
  {
   "key": "92cf33354159",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「일일이 확인 안 해도\n알고 있거든!\n내가 한 말은 절대 안 바꿔!\n⟦P⟧"
  },
  {
   "key": "61bbd15ab2eb",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「확실히…\n⟦P⟧"
  },
  {
   "key": "abae4f5c2835",
   "speaker_korean": null,
   "korean": "좋든 나쁘든 한번 말한 건\n절대 굽히지 않는, 고집 센\n분이셨지…\n⟦P⟧"
  },
  {
   "key": "28722b886d02",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「뭐… 아…\n⟦P⟧"
  },
  {
   "key": "207908994c3e",
   "speaker_korean": null,
   "korean": "흥!\n맘대로 지껄이라지.\n⟦P⟧그런 것보다,\n얼른 여행 준비나\n하란 말이야.\n⟦P⟧"
  },
  {
   "key": "df8b71d0e30e",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「네, 네.\n⟦P⟧"
  },
  {
   "key": "e965dcf03cf9",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「남서쪽 문으로 가면 편해.\n딱히 누군가한테 쫓기는 게\n아니라면 말이지만.\n⟦P⟧"
  },
  {
   "key": "c96987b212b2",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「거 봐, 보라니까.\n⟦P⟧정말이지…\n네 말대로 걸었다간\n아무리 시간이 지나도 목적지에\n도착 못 하잖아.\n⟦P⟧"
  },
  {
   "key": "92cd36f48d59",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「아니, 하지만!\n어라? 이상하네…\n⟦P⟧"
  },
  {
   "key": "69b9622ecc06",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「사실은 동쪽이 정답인데…\n북서든 남서든 어느 쪽을 골라도\n⟦2⟧카루사아⟦3⟧에는 절대 못 가.\n⟦P⟧"
  },
  {
   "key": "823974142cb2",
   "speaker_korean": "라돌 & 루미나",
   "korean": "⟦1⟧「뭐~~~어!!!\n⟦P⟧"
  },
  {
   "key": "f2210807d39d",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「어, 어떡하죠?\n⟦2⟧루미나 님⟦3⟧.\n⟦P⟧"
  },
  {
   "key": "b3df080d586b",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「이러니저러니 할 것 없어!\n당장 돌아가는 거야.\n⟦P⟧"
  },
  {
   "key": "fd0c1a1634cb",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「그, 그럼…\n서둘러 짐을 챙길게요.\n⟦P⟧"
  },
  {
   "key": "792c08c008dd",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「서두르란 말이야!\n⟦P⟧"
  },
  {
   "key": "2ec9c514e408",
   "speaker_korean": null,
   "korean": "정말이지…\n너 같은 애한테 길안내를 맡긴 게\n애초부터 잘못이었던 거야…\n⟦P⟧"
  }
 ]
}