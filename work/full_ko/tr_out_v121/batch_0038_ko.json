{
 "batch_id": "batch_0038",
 "translations": [
  {
   "key": "d7c269cad545",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「보통은~, 멋대로 대기실에\n들어오면 곤란한데~.\n오빠 멋있으니까, 특별히 봐주는 거야.\n⟦P⟧"
  },
  {
   "key": "5a220632c49b",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「애초에 ⟦2⟧로세티 극단⟦3⟧이라는 게,\n대체 뭐야?\n게다가 이 『환혹의 요정』이라는\n수상쩍은 광고 문구는….\n⟦P⟧"
  },
  {
   "key": "cdc0645c56e2",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「후에엣!? 뭐라니?\n그야 오빠는, 내 사인\n받으러 온 거잖아~?\n⟦P⟧"
  },
  {
   "key": "83cf5c27e48c",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「설마…. 도둑!?\n⟦P⟧"
  },
  {
   "key": "84e74a485953",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아니, 그것도 아닌데….\n⟦P⟧"
  },
  {
   "key": "c41f3aa1c236",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「그럼, 대체 뭔데~!\n⟦P⟧내 팬도 아니고,\n빚 받으러 온 것도 아니고,\n미아도 아니라면, 왜~ 남의 방에\n멋대로 들어오는 건데~!?\n⟦P⟧"
  },
  {
   "key": "53d5a3e071e9",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아니, 멋대로 들어온 건 사과할게.\n그냥 우린, 여기저기 산책하고\n있었을 뿐이야.\n⟦P⟧"
  },
  {
   "key": "3ade28501b0d",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「응.\n⟦P⟧"
  },
  {
   "key": "5a53670ced1f",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「산책~!?\n⟦P⟧"
  },
  {
   "key": "4d72b65264a5",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그래, 그래.\n⟦P⟧"
  },
  {
   "key": "2c10fffb10f9",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「멋대로 남의 방에 들어오는 건,\n산책이라곤 안・하・는・거・야~.\n⟦P⟧"
  },
  {
   "key": "62f600c7fefe",
   "speaker_korean": null,
   "korean": "도둑이라든가, 미아라든가,\n스토커라든가, 추종자라든가….\n⟦P⟧"
  },
  {
   "key": "7e001c2d8c67",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「…… …….\n이제, 미아라도 상관없어….\n⟦P⟧"
  },
  {
   "key": "81166b2ad9a4",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그러네.\n⟦P⟧"
  },
  {
   "key": "b2249601b226",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「뭐야~, 그냥 미아였던 거야~….\n난 또, 내 팬 제1호인 줄\n알았는데~.\n⟦P⟧"
  },
  {
   "key": "340d301b4d0a",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「뭐, 무대도 아직 안 했고,\n솔직히 조금 이상하다고\n생각 안 한 것도 아니었지만\n말이야.\n⟦P⟧"
  },
  {
   "key": "d68383ad8de2",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「무대!?\n⟦P⟧"
  },
  {
   "key": "80ccfa97615c",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「그래.\n⟦P⟧"
  },
  {
   "key": "d170aef1220b",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「우린, 찰나의 미래를 보여주는\n⟦2⟧로세티 극단⟦3⟧.\n그리고 나는, 그 인도의 요정,\n⟦4⟧스프레・로세티⟦5⟧.\n⟦P⟧"
  },
  {
   "key": "c1091fea07e0",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「뭐, 쉽게 말하자면~\n서커스단이랑, 그 안내역\n같은 거려나?\n⟦P⟧"
  },
  {
   "key": "ebed49920065",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「호~.\n그럼, 이 사인이 들어간 셔츠도\n값나가는 물건이 되려나?\n⟦P⟧"
  },
  {
   "key": "c368205043f8",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「무~론이지♪\n뭐니 뭐니 해도, 내가 한\n첫 사인이니까♪\n⟦P⟧"
  },
  {
   "key": "d88a90fd55fa",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「처음!?\n⟦P⟧"
  },
  {
   "key": "733442bea932",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「내일이, 내 데뷔거든.\n반년만 지나면, 그 셔츠 한 장으로\n행성을 통째로 한 번 살 만큼\n값이 뛸 예정이야!\n⟦P⟧"
  },
  {
   "key": "7ec119b5cb4c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그, 그건 대단한데….\n행성 한 번이라니, 소중히\n간직해야겠는데.\n⟦P⟧"
  },
  {
   "key": "099e01ab862e",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「뭐야~, 그 말투~!?\n안 믿는 거지~!\n⟦P⟧"
  },
  {
   "key": "401814cb74e3",
   "speaker_korean": null,
   "korean": "⟦1⟧・아니, 믿어."
  },
  {
   "key": "d735ca9f5b34",
   "speaker_korean": null,
   "korean": "⟦1⟧・좀 심한 과장 아닐까?"
  },
  {
   "key": "96fa2e04584d",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아니, 믿어.\n분명 굉장한 무대일\n거야.\n⟦P⟧"
  },
  {
   "key": "deda48ec2bad",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「후훗~.\n고마워♪\n⟦P⟧"
  },
  {
   "key": "b89af3029d72",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「이건…. 티켓?\n⟦P⟧"
  },
  {
   "key": "ce34e122a2d7",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「그건~, 우리 무대 티켓이야.\n내일부터니까,\n절~대 보러 와야 해.\n⟦P⟧"
  },
  {
   "key": "4e9460370543",
   "speaker_korean": null,
   "korean": "그 사인을, 평생의 보물로\n삼고 싶어질 만한 무대를\n보여줄게♪\n⟦P⟧"
  },
  {
   "key": "0cc7a72ad12c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「오~, 고마워.\n내일을 기대하고 있을게.\n⟦P⟧"
  },
  {
   "key": "f4bf12c19ac1",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「행성 1회는, 좀 심한 과장\n아닐까?\n⟦P⟧"
  },
  {
   "key": "c4013199449f",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「뭐야~!\n안 믿는 거야~!?\n⟦P⟧"
  },
  {
   "key": "57c2c79f8883",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「믿고 말고 할 것도 없잖아?\n아무리 그래도, 그 정도까지는… 그치.\n⟦P⟧"
  },
  {
   "key": "02478c57952d",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「으~!!\n⟦P⟧"
  },
  {
   "key": "d835c06e1f75",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「그럼, 기쁘니까,\n기념할 만한 내 팬\n제1호가 되는 오빠한테는,\n이걸 줄게.\n⟦P⟧"
  },
  {
   "key": "ff4db1ea5154",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「아무리 덩치가 커도,\n길을 잃어버리는 사람은\n짱을 붙여도 되는 거야.\n⟦P⟧"
  },
  {
   "key": "0ae93144d26d",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧페이트⟦3⟧….\n근데….\n⟦P⟧"
  },
  {
   "key": "c71533c037c3",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「⟦2⟧소피아⟦3⟧예요.\n⟦P⟧"
  },
  {
   "key": "76b15f2a7c89",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「엣!?\n⟦P⟧"
  },
  {
   "key": "c6cc94b240cf",
   "speaker_korean": null,
   "korean": "⟦1⟧소피아⟦2⟧.\n⟦P⟧"
  },
  {
   "key": "c793bd7294bf",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「저기, 이제 그만 가자.\n⟦2⟧페이트⟦3⟧.\n⟦P⟧"
  },
  {
   "key": "54f9aa30af81",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아…. 그러니까….\n⟦2⟧로, 로세티 극단⟦3⟧?\n⟦P⟧"
  },
  {
   "key": "44742ca289f6",
   "speaker_korean": null,
   "korean": "환혹의 요정.\n⟦1⟧스프레・로세티⟦2⟧로부터…하고\n자~, 다 됐다♪\n⟦P⟧"
  },
  {
   "key": "4dcb1be57c25",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「흐~응.\n⟦P⟧"
  },
  {
   "key": "10cf28b3551a",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「⟦2⟧페이트・짱・⟦3⟧에게.\n⟦P⟧"
  },
  {
   "key": "d2c90e0d2a04",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「그럼, 엄마 사인을 갖고 싶은 거야?\n아니면 아빠?\n⟦P⟧"
  },
  {
   "key": "67ed867465d3",
   "speaker_korean": null,
   "korean": "설마, 피에로 ⟦1⟧바질짱⟦2⟧이나,\n덩치 큰 ⟦3⟧곤조라짱⟦4⟧이란 건….\n없겠지~, 역시.\n⟦P⟧"
  },
  {
   "key": "d73c20b29a27",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어라라라…?\n그치만…. 에~? 어라?!\n난, 완전히 그런 줄….\n⟦P⟧"
  },
  {
   "key": "bd31a8771239",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「어라? 오빠들, 누구야?\n여긴 ⟦2⟧로세티 극단⟦3⟧의 대기실이야.\n응~…?\n⟦P⟧"
  },
  {
   "key": "f75715e63d82",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「응!\n그럼 또 봐, ⟦2⟧페이트짱⟦3⟧♪\n⟦P⟧"
  },
  {
   "key": "ed61b2b679b1",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「자, 잠깐 ⟦2⟧페이트⟦3⟧.\n너무 심한 말인 것 같아….\n⟦P⟧"
  },
  {
   "key": "78744330b5c8",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그런 말 들어도, 곤란한데….\n⟦P⟧"
  },
  {
   "key": "78fe7f6185bb",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「잘 들어~,\n⟦2⟧페이트짱⟦3⟧!\n⟦P⟧"
  },
  {
   "key": "8651b83c457a",
   "speaker_korean": null,
   "korean": "절~대로, 와야 해!\n그 사인을 평생의 보물로\n삼고 싶어질 만한 무대를\n보여줄 테니까!!\n⟦P⟧"
  },
  {
   "key": "75195114e714",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아얏!\n⟦P⟧"
  },
  {
   "key": "b7f592c9b0b9",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「그럼 내일 보러 오라고!\n눈물을 뚝뚝 흘리면서 사과하게 될 만한, 굉장한 무대를 보여줄 테니까!\n⟦P⟧"
  },
  {
   "key": "b46d1b42188a",
   "speaker_korean": "스프레",
   "korean": "⟦1⟧「아무리 애를 써도\n안 되는 건, 안 되는 거야~!\n⟦P⟧착한 아이니까,\n저쪽에서 놀고 있으렴.\n알았지♪\n⟦P⟧"
  },
  {
   "key": "229edf061046",
   "speaker_korean": "발랄한 소녀",
   "korean": "⟦1⟧「아~, 알았다!\n내 사인 갖고 싶은 거지?\n정말~, 어쩔 수 없네….\n⟦P⟧"
  },
  {
   "key": "bafcbf670fdf",
   "speaker_korean": null,
   "korean": "⟦1⟧로세티 극단 공연 티켓⟦2⟧을 손에 넣었다."
  }
 ]
}