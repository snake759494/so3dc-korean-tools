{
 "batch_id": "batch_0138",
 "translations": [
  {
   "key": "1b01ea15a150",
   "speaker_korean": "소피아",
   "korean": "「하지만 위험하단 말이야?\n어떤 곳인지도 모르잖아!"
  },
  {
   "key": "0e279a25e6a8",
   "speaker_korean": "스프레",
   "korean": "「그래도 다들\n가는 거잖아?"
  },
  {
   "key": "cb49b974a416",
   "speaker_korean": "마리아",
   "korean": "「부모님께 돌아가.\n여기서부터는 장난으로 안 끝나.\n…애들 장난이 아니니까."
  },
  {
   "key": "e8266a16d767",
   "speaker_korean": "소피아",
   "korean": "「그런 말투는…"
  },
  {
   "key": "b1d59715c50f",
   "speaker_korean": "마리아",
   "korean": "「사실이야.\n…어설픈 각오로\n따라와도 폐만 될 뿐이야."
  },
  {
   "key": "10d4760cbd20",
   "speaker_korean": "스프레",
   "korean": "「나 말이야, 단장님네\n진짜 자식이 아니야."
  },
  {
   "key": "20d9a1269df2",
   "speaker_korean": "스프레",
   "korean": "「그리고 있잖아, 진짜 아빠는\n⟦1⟧은하연방⟦2⟧의 군인이었대.\n돌아가신 엄마가 그랬어."
  },
  {
   "key": "61f544f45a9c",
   "speaker_korean": "스프레",
   "korean": "「정말 훌륭한 군인이라서, 모두를 지키는 걸\n삶의 보람으로 여기는 사람이라고\n항상 그렇게 말해줬어.\n『너에겐 아버지 피가 흐르고 있어,\n훌륭한 아버지 피가 말이야』라고 말했어."
  },
  {
   "key": "d302d6dc226d",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧스프레⟦2⟧…"
  },
  {
   "key": "ad0414454ba9",
   "speaker_korean": "스프레",
   "korean": "「⟦1⟧마리아⟦2⟧야,\n창조왕을 쓰러뜨리지 않으면\n전부 끝나버리는 거지?"
  },
  {
   "key": "d0ebdd7bd5e9",
   "speaker_korean": "스프레",
   "korean": "「나, 어려운 건\n잘 모르겠지만…\n⟦P⟧해야 하는 일이라는 것만은\n알 것 같아.\n⟦P⟧나를 여기까지 키워준\n단장님이랑 엄마, ⟦1⟧곤조라⟦2⟧네를\n지키기 위해서… 나는 가고 싶어.\n⟦P⟧어설픈 마음이 아니야,\n나는 죽어도 좋아!\n부탁이야… 데려가줘!!"
  },
  {
   "key": "77aea819076b",
   "speaker_korean": null,
   "korean": "⟦1⟧・데려가지 않는다⟦2⟧"
  },
  {
   "key": "28c720d0c420",
   "speaker_korean": "페이트",
   "korean": "「죽어도 좋다는 말 하지 마."
  },
  {
   "key": "c179693b78e1",
   "speaker_korean": "소피아",
   "korean": "「맞아,\n그러니까 얌전히―――"
  },
  {
   "key": "bf369ae95dd3",
   "speaker_korean": "페이트",
   "korean": "「죽을 각오를 한 사람은 데려갈 수 없어…\n그런 각오는 필요 없어.\n같이 가고 싶으면, 다시는\n그런 말은 하지 마."
  },
  {
   "key": "7a0ae8a81e8e",
   "speaker_korean": "스프레",
   "korean": "「어…?"
  },
  {
   "key": "79a54d9516f2",
   "speaker_korean": "마리아",
   "korean": "「너…!"
  },
  {
   "key": "f37b7304bb35",
   "speaker_korean": "페이트",
   "korean": "「우리는 죽으러 가는 게 아니야.\n살기 위해 가는 거야…알겠지?"
  },
  {
   "key": "5d90e3871020",
   "speaker_korean": "스프레",
   "korean": "「으, 응!!"
  },
  {
   "key": "94950167755e",
   "speaker_korean": "클리프",
   "korean": "「할 수 없구만, 진짜."
  },
  {
   "key": "58f469576d1d",
   "speaker_korean": "넬",
   "korean": "「후……"
  },
  {
   "key": "4c045dee0606",
   "speaker_korean": "알벨",
   "korean": "「무른 놈이군."
  },
  {
   "key": "e4638b24bb5d",
   "speaker_korean": "로저",
   "korean": "「아이고~\n뭐, 난 형 성격을 보면\n처음부터 이럴 줄 알았지만 말이야."
  },
  {
   "key": "11f1a55e0d13",
   "speaker_korean": "페이트",
   "korean": "「단, 단장님네 허락을\n받고 나서야.\n그게 없으면 안 돼."
  },
  {
   "key": "2e31e0bfe167",
   "speaker_korean": "스프레",
   "korean": "「에에엣~~~!?"
  },
  {
   "key": "660e16097d9d",
   "speaker_korean": "소피아",
   "korean": "「그렇겠지,\n분명 엄청 걱정하고 있을 거야."
  },
  {
   "key": "5f0c42925b9c",
   "speaker_korean": "페이트",
   "korean": "「알았지?"
  },
  {
   "key": "307cafa31e98",
   "speaker_korean": "스프레",
   "korean": "「으…응. 다녀올게."
  },
  {
   "key": "b8f07183b11b",
   "speaker_korean": "스프레",
   "korean": "「기다렸지! 오케이래!!"
  },
  {
   "key": "28d16dceb61a",
   "speaker_korean": "스프레",
   "korean": "「자, 다들…렛츠 고~!!"
  },
  {
   "key": "cfcb64327d9c",
   "speaker_korean": "페이트",
   "korean": "「안 돼.\n역시 널 데려\n갈 순 없어."
  },
  {
   "key": "462f822f74e9",
   "speaker_korean": "페이트",
   "korean": "「네 얘기를 듣고 나니\n더더욱 데려갈 수 없어.\n단장님네도 너한테 그런 걸\n바라진 않을 거야."
  },
  {
   "key": "45d07942f5e8",
   "speaker_korean": "마리아",
   "korean": "「그렇네.\n뒷일은 우리한테 맡겨."
  },
  {
   "key": "75bd182f68f9",
   "speaker_korean": "클리프",
   "korean": "「그래, 창조왕 따위는\n후딱 해치우고 올 테니까."
  },
  {
   "key": "2936ebccda6f",
   "speaker_korean": "스프레",
   "korean": "「그래도…!"
  },
  {
   "key": "03b1ae4cb659",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧FD공간⟦2⟧이 어떤 곳인지도 모르는데.\n그런 위험한 곳에 널 데려갈 수는 없어."
  },
  {
   "key": "ed0c907f669e",
   "speaker_korean": "소피아",
   "korean": "「부탁이야, 말 좀 들어줘."
  },
  {
   "key": "18fc0a116ea1",
   "speaker_korean": "페이트",
   "korean": "「다들 널 걱정하고 있어."
  },
  {
   "key": "e849ad3e2820",
   "speaker_korean": "스프레",
   "korean": "「응…알았어."
  },
  {
   "key": "ae3d78c14ecf",
   "speaker_korean": "페이트",
   "korean": "「창조왕은 우리가 반드시 어떻게든 할게.\n…믿어줘."
  },
  {
   "key": "54c5dfa72414",
   "speaker_korean": "스프레",
   "korean": "「응!"
  },
  {
   "key": "310680cad9bd",
   "speaker_korean": "스프레",
   "korean": "「혹시…혹시 말이야?"
  },
  {
   "key": "9c4418ec9eca",
   "speaker_korean": "스프레",
   "korean": "「혹시 다들 위기에 처하면…\n그때는 날 불러줘!\n순식간에 달려가서 도와줄 테니까♪"
  },
  {
   "key": "ff29a74b1607",
   "speaker_korean": "페이트",
   "korean": "「그래!"
  },
  {
   "key": "e5a06ca0e9e4",
   "speaker_korean": "넬",
   "korean": "「자신을 잃지 마.\n넌 그렇게\n약한 존재였던 거야?"
  },
  {
   "key": "6161790aa0f6",
   "speaker_korean": "알벨",
   "korean": "「멍청아, 얼빠진 얼굴 하지 마.\n한심하군."
  },
  {
   "key": "d22e2c76dee2",
   "speaker_korean": "로저",
   "korean": "「프로그램이란 게 잘은 모르겠지만\n난 나잖아?\n그거 말고 뭐가 더 있냐?"
  },
  {
   "key": "5ac2fcdd6a26",
   "speaker_korean": "스프레",
   "korean": "「감동은 나 스스로 느끼는 거잖아.\n절대 남이 심어준 게 아니야.\n응."
  },
  {
   "key": "58a18f06e595",
   "speaker_korean": "클리프",
   "korean": "「그래, 절대 프로그램된\n존재 따위가 아니야. 난 나다.\n'나는 생각한다, 고로 존재한다'는 말도 있잖냐."
  },
  {
   "key": "ede61f6a1bc5",
   "speaker_korean": "넬",
   "korean": "「알고 있는 일이야.\n그렇기에 목숨이 소중한\n거 아니겠어."
  },
  {
   "key": "8bf9cac8a4eb",
   "speaker_korean": "알벨",
   "korean": "「시작도 하기 전에 그렇게 약한 소리 하면\n앞날이 뻔하다.\n이길 생각으로 하는 거잖아, 멍청아."
  },
  {
   "key": "8b7909046918",
   "speaker_korean": "로저",
   "korean": "「그거야말로 사내\n보여줄 때란 거잖아."
  },
  {
   "key": "88dea6ace732",
   "speaker_korean": "스프레",
   "korean": "「응.\n근데 우리가 하지 않으면\n안 되는 거잖아.\n그럼 할 수밖에 없지!"
  },
  {
   "key": "faec01c67d9f",
   "speaker_korean": "스프레",
   "korean": "「⟦1⟧문베이스⟦2⟧…\n진짜로 올 수 있었구나…"
  },
  {
   "key": "efc32eee5c1c",
   "speaker_korean": "페이트",
   "korean": "「여긴…"
  },
  {
   "key": "d95e03d434e4",
   "speaker_korean": "클리프",
   "korean": "「이거 참 놀랍구만.\n⟦1⟧타임게이트⟦2⟧를 거치지 않고도\n이쪽으로 돌아올 수 있다니."
  },
  {
   "key": "d722d2309d80",
   "speaker_korean": "소피아",
   "korean": "「믿을 수가 없어…"
  },
  {
   "key": "0d424818151f",
   "speaker_korean": "마리아",
   "korean": "「이렇게 되니 ⟦1⟧플러드⟦2⟧가 한 말을\n믿지 않을 수가 없겠네."
  },
  {
   "key": "df3ffc4ebb5c",
   "speaker_korean": "소피아",
   "korean": "「그럼 정말로 우리는\n그들이 만들어낸 프로그램이라고\n말씀하시는 건가요?"
  },
  {
   "key": "749931475af1",
   "speaker_korean": "마리아",
   "korean": "「이 상황을 보면 말이야.\n그렇게 생각할 수밖에 없잖아?"
  },
  {
   "key": "44b4576dc29c",
   "speaker_korean": "페이트",
   "korean": "「…그럴 수가.\n역시 우리는 만들어진 존재라는 건가…\n⟦P⟧아버지의 죽음도…\n⟦1⟧아미나⟦2⟧와 ⟦3⟧디온⟦4⟧네의 죽음도\n만들어진 거라고!"
  },
  {
   "key": "0b17bdd8bdd8",
   "speaker_korean": "마리아",
   "korean": "「그래."
  },
  {
   "key": "8b75c2d1277e",
   "speaker_korean": "마리아",
   "korean": "「하지만 말이야…\n만들어진 존재라 해도, 우리는 살아있어.\n그것 또한 사실이잖아?\n⟦P⟧우리가 현실이라고 생각하면,\n그건 우리에게 있어 현실이며,\n진실인 거야."
  },
  {
   "key": "4d39c91a7411",
   "speaker_korean": "소피아",
   "korean": "「느끼는 걸 솔직하게 믿을래.\n…믿는 길을 나아가자, 응?"
  },
  {
   "key": "3c79ede8f560",
   "speaker_korean": "페이트",
   "korean": "「응…그렇네."
  },
  {
   "key": "8f9df77d8310",
   "speaker_korean": "페이트",
   "korean": "「게다가 여기서 꺾여버리면\n아버지와 ⟦1⟧아쿠아엘리⟦2⟧ 모두에게\n면목이 없어."
  },
  {
   "key": "f5d4d8f65ec3",
   "speaker_korean": "소피아",
   "korean": "「응."
  },
  {
   "key": "19ecff66d38b",
   "speaker_korean": "클리프",
   "korean": "「그래.\n우리한테는 아직 할 수 있는 일이 있어.\n빌어먹을 창조왕을 박살내는\n큰일이 남았잖냐."
  },
  {
   "key": "f2e0c4591c01",
   "speaker_korean": "페이트",
   "korean": "「위험한 일이야."
  },
  {
   "key": "cc1cc50c6d70",
   "speaker_korean": "페이트",
   "korean": "「그래. 그렇지."
  },
  {
   "key": "e274b72f3bbd",
   "speaker_korean": "소피아",
   "korean": "「하지만 우리가 정말로 창조왕인\n⟦1⟧FD인⟦2⟧을 쓰러뜨릴 수 있을까?"
  },
  {
   "key": "e0541d865a5e",
   "speaker_korean": "마리아",
   "korean": "「그건 괜찮을 거야."
  },
  {
   "key": "d2e191ff8f3d",
   "speaker_korean": "마리아",
   "korean": "「우리는 이미 그곳에서\n⟦1⟧시큐리티서비스⟦2⟧를 쓰러뜨렸어.\n그들에게 치명상을 입히는 건\n충분히 가능하다고 봐."
  },
  {
   "key": "c591caab7de0",
   "speaker_korean": "소피아",
   "korean": "「응. 그렇겠죠.\n…힘내야겠어."
  }
 ]
}