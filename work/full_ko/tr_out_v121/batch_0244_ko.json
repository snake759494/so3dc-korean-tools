{
 "batch_id": "batch_0244",
 "translations": [
  {
   "key": "966d0dee499f",
   "speaker_korean": "아드레이",
   "korean": "「하하하!\n생일이란 건 새빨간 거짓말일세."
  },
  {
   "key": "57c27491a50f",
   "speaker_korean": "페이트",
   "korean": "「뭐야, 그게!?\n그럼 대체 뭘 위해서!?"
  },
  {
   "key": "ec5594c1ed9a",
   "speaker_korean": "아드레이",
   "korean": "「있잖은가, 실은 그전에\n건네줄 아이템이 있다네.\n⟦P⟧⟦1⟧클레어⟦2⟧도 기다리고 있다네.\n⟦3⟧페이트 공⟦4⟧의\n한마디와 함께 말일세."
  },
  {
   "key": "7f2403072730",
   "speaker_korean": "페이트",
   "korean": "「무, 뭘 말이야!?"
  },
  {
   "key": "07ba57c37b1a",
   "speaker_korean": "아드레이",
   "korean": "「아직도 ⟦1⟧네벨⟦2⟧의 딸을\n신경 쓰고 있는 게냐?\n의외로 속이 좁은 사내로군.\n⟦P⟧걱정 마라, 옛 여인 따위는\n⟦3⟧클레어⟦4⟧는 신경 쓰지 않는다.\n안심하고 그 아이한테\n가보도록 하게."
  },
  {
   "key": "a65693eb2e77",
   "speaker_korean": "페이트",
   "korean": "「아직도 그런 소리야?\n전에도 말했잖아.\n애초에 나랑 ⟦1⟧클레어 씨⟦2⟧는…"
  },
  {
   "key": "80b4c2484870",
   "speaker_korean": "아드레이",
   "korean": "「호오, 그런 말을 하는 겐가?\n요전에 정원에서 한참을\n둘이서만 얘기하던 게 누구였더라?\n⟦P⟧꽤나 다정해 보이던데,\n내가 잘못 본 겐가…"
  },
  {
   "key": "a95536cb57f5",
   "speaker_korean": "페이트",
   "korean": "「보, 보고 있었던 거야!?\n그, 그건 그냥 업무 얘기였다니까."
  },
  {
   "key": "38bc7edbec08",
   "speaker_korean": "아드레이",
   "korean": "「6시간이나 단둘이서 말인가?\n그렇게 중요한 업무 얘기라면\n다른 이도 껴서 해야 하지 않나?"
  },
  {
   "key": "3432e5cff470",
   "speaker_korean": "페이트",
   "korean": "「진짜라니까!\n게다가 그건 ⟦1⟧클레어 씨⟦2⟧가\n불러서 간 것뿐이고…"
  },
  {
   "key": "8f4450e6a270",
   "speaker_korean": "아드레이",
   "korean": "「끄으응, 저 아이도 고생이 많군.\n⟦P⟧일을 핑계 삼아서\n그 사람과 함께 있고 싶다는 여심을,\n이 양반은 전혀 모르는구먼."
  },
  {
   "key": "bf1921848308",
   "speaker_korean": "페이트",
   "korean": "「그러니까 말야…"
  },
  {
   "key": "4f22c38e3a69",
   "speaker_korean": "아드레이",
   "korean": "「음, 살기!?"
  },
  {
   "key": "a099baf65dd8",
   "speaker_korean": "페이트",
   "korean": "「이봐."
  },
  {
   "key": "94e644652ecc",
   "speaker_korean": "아드레이",
   "korean": "「⟦1⟧페이트 공⟦2⟧, 아무래도 그 얘기는\n나중으로 미뤄야 할 것 같군."
  },
  {
   "key": "2e5f9fa93aab",
   "speaker_korean": "페이트",
   "korean": "「그러니까…"
  },
  {
   "key": "c22a62abaaf6",
   "speaker_korean": "아드레이",
   "korean": "「걱정 말게, 시간 걱정은 없네.\n어차피 한동안은 여기서\n못 나갈 것 같으니 말이야. 와핫핫핫!"
  },
  {
   "key": "b8c6a5a21fc6",
   "speaker_korean": "페이트",
   "korean": "「웃을 일이 아니라니까…"
  },
  {
   "key": "5913b7e6ef77",
   "speaker_korean": "아드레이",
   "korean": "「가자!!"
  },
  {
   "key": "89cc108246d0",
   "speaker_korean": "미라쥬",
   "korean": "「도착했네요."
  },
  {
   "key": "30517f5dfc50",
   "speaker_korean": "페이트",
   "korean": "「여기, 인가요?"
  },
  {
   "key": "4fb7131ba466",
   "speaker_korean": "페이트",
   "korean": "「……!"
  },
  {
   "key": "ca1681813991",
   "speaker_korean": "미라쥬",
   "korean": "「아, 걱정하지 않으셔도 됩니다.\n⟦P⟧이 틈새에는 신기한 장치가\n되어 있어서요,\n여럿이서 찾아오면 상대도 여럿이\n되도록 되어 있다고 하더군요.\n⟦P⟧다만 저도 아직 다수를\n겪어본 적은 없습니다만…"
  },
  {
   "key": "0448fd839f8c",
   "speaker_korean": "페이트",
   "korean": "「헤, 헤에, 그렇구나."
  },
  {
   "key": "335d816a48cc",
   "speaker_korean": "미라쥬",
   "korean": "「게다가 이번엔 아직 시험이니까요.\n어디까지나 경험을 쌓기 위함입니다.\n⟦P⟧그리고 아직 당신은\n다 배우셨다고 할 순 없잖아요?\n아버님이 허락해도 전 안 됩니다."
  },
  {
   "key": "c93febe46d8e",
   "speaker_korean": "페이트",
   "korean": "「하긴, 그렇겠네.\n응…… 그렇게 생각하니까\n마음이 한결 편해졌어.\n⟦P⟧사실 사범님 기대가\n꽤 부담이었거든."
  },
  {
   "key": "44dfd46b766e",
   "speaker_korean": "미라쥬",
   "korean": "「후후, 맞아요.\n어깨에 힘 빼고 가죠."
  },
  {
   "key": "905b38876aae",
   "speaker_korean": "페이트",
   "korean": "「응, 고마워."
  },
  {
   "key": "99fd2b9ebfb4",
   "speaker_korean": "미라쥬",
   "korean": "「아니에요, 신경 쓰지 마세요.\n게다가 당신을 돕는 것이\n제 역할이자 기쁨이니까요."
  },
  {
   "key": "d60de7adcf9d",
   "speaker_korean": "페이트",
   "korean": "「왠지 부끄럽네."
  },
  {
   "key": "2101e742f6c5",
   "speaker_korean": "미라쥬",
   "korean": "「그런 말씀 하지 마세요.\n말한 제가 부끄러워지잖아요."
  },
  {
   "key": "decd7dc5146f",
   "speaker_korean": "미라쥬",
   "korean": "「네.\n지원은 맡겨 주세요."
  },
  {
   "key": "08b076b9cc2f",
   "speaker_korean": "페이트",
   "korean": "「응, 등은 맡길게.\n믿고 있어, ⟦1⟧미라쥬⟦2⟧."
  },
  {
   "key": "7584a23ff798",
   "speaker_korean": "미라쥬",
   "korean": "「네!"
  },
  {
   "key": "44e8835420e6",
   "speaker_korean": "페이트",
   "korean": "「헉, ⟦1⟧루시퍼 님⟦2⟧."
  },
  {
   "key": "c81769f92cf1",
   "speaker_korean": "루시퍼",
   "korean": "「음? 저건…\n⟦P⟧이런 곳에도 이물질이\n숨어들어 있었나.\n⟦P⟧완전히 소거했다고\n생각했건만…"
  },
  {
   "key": "a60c16424cc3",
   "speaker_korean": "루시퍼",
   "korean": "「이봐, 네 동료로군."
  },
  {
   "key": "d55c8d4da764",
   "speaker_korean": "루시퍼",
   "korean": "「이곳도 다른 세계처럼 몰아낸다.\n이물질은 모조리 소거해야 한다.\n⟦P⟧알고 있겠지?"
  },
  {
   "key": "278ab12e90af",
   "speaker_korean": "페이트",
   "korean": "「예…제 임무는 세상 평온을 어지럽히는\n이물질의 말살입니다."
  },
  {
   "key": "0c2c3f524f0a",
   "speaker_korean": "루시퍼",
   "korean": "「음, 바로 그렇다.\n확실히 일하도록 해라."
  },
  {
   "key": "07157dec94a0",
   "speaker_korean": "페이트",
   "korean": "「예, ⟦1⟧루시퍼 님⟦2⟧."
  },
  {
   "key": "b1c1f8262e6e",
   "speaker_korean": "루시퍼",
   "korean": "「짓밟아 버려라!!!!"
  },
  {
   "key": "6df7d0f0d99f",
   "speaker_korean": "페이트",
   "korean": "「무슨 소리 하는 거야.\n네 곁에 있기로 정한 건 나야.\n⟦P⟧누구랑 비교하는진 모르겠지만,\n혼자 멋대로 풀 죽지 말았으면 해."
  },
  {
   "key": "d83e5b4724a0",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧페이트⟦2⟧…"
  },
  {
   "key": "512807f51c9b",
   "speaker_korean": "넬",
   "korean": "「그래!"
  },
  {
   "key": "516b87a01377",
   "speaker_korean": "페이트",
   "korean": "「모처럼 둘이 마련해 준 휴가잖아.\n낭비하는 것도 아깝고,\n실컷 즐겨보자고.\n⟦P⟧우선 저 거슬리는 나부터 처리하고,\n그다음에 장소를 확인하자…알겠지?"
  },
  {
   "key": "e8dfb7d559fc",
   "speaker_korean": "페이트",
   "korean": "「미안, 심술궂은 말을 해서…"
  },
  {
   "key": "4f517eb1f485",
   "speaker_korean": "페이트",
   "korean": "「왜 그런 거지?"
  },
  {
   "key": "75480f73eb7c",
   "speaker_korean": "로저",
   "korean": "「⟦1⟧레자드⟦2⟧ 그 자식,\n꽤 괜찮은 승부를 준비했잖아!!"
  },
  {
   "key": "b7320e766fb9",
   "speaker_korean": "페이트",
   "korean": "「나도 모르겠어."
  },
  {
   "key": "5e09eb663c4d",
   "speaker_korean": "스프레",
   "korean": "「음~~.\n⟦1⟧바질⟦2⟧이 알려준\n특훈 방인데.\n⟦P⟧『아가씨, 오라버니랑 특훈할 거면\n빌딩 위 같은 데선 안 되는 거예유.\n어차피 할 거면 여기 한번\n가보는 게 좋은 거예유』라고…"
  },
  {
   "key": "e1d427e8588e",
   "speaker_korean": "페이트",
   "korean": "「미, 미안!"
  },
  {
   "key": "1148f6e1c12c",
   "speaker_korean": "페이트",
   "korean": "「…슬슬 시작해 볼까?"
  },
  {
   "key": "03dd9ae8035d",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX11⟦2⟧을 손에 넣었다."
  }
 ]
}