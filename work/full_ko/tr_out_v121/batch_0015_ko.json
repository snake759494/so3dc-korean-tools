{
 "batch_id": "batch_0015",
 "translations": [
  {
   "key": "2305b0e62c18",
   "speaker_korean": null,
   "korean": "여관 아이언 메이든"
  },
  {
   "key": "2ecef7bebf22",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「⟦2⟧반덴⟦3⟧의 ⟦4⟧전투함⟦5⟧을 어떻게든 하지 않으면\n이 별에서 탈출하는 것조차 어려워.\n⟦P⟧원래대로라면 이런 곳에서 시간을\n낭비할 여유 따위 없는데….\n⟦P⟧"
  },
  {
   "key": "be3a81bbed68",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「여기까지 왔다는 건,\n우연이나 실수 같은 게 아니겠지.\n⟦P⟧무슨 의도가 있는 거야?\n아니면, 뭔가 꾸미고 있는 거야?\n⟦P⟧"
  },
  {
   "key": "f640c8ccbcd5",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「⟦2⟧은하연방⟦3⟧이나 ⟦4⟧알디온 제국⟦5⟧은 물론,\n이번 일로 ⟦6⟧반덴⟦7⟧까지….\n이걸로 우리 ⟦8⟧쿼크⟦9⟧는 이 은하계의\n거의 모든 세력을 적으로 돌렸네.\n⟦P⟧⟦10⟧클라우스트로인⟦11⟧이나 다른 중립 세력이\n가진 힘 같은 건\n이 세 세력에 비하면 정말\n보잘것없는 수준이야.\n⟦P⟧이쯤 되면 ⟦12⟧클라우스트로⟦13⟧의\n정부도 가만히 있지는 않겠지.\n이제 우리에겐 돌아가야 할 곳 같은 건\n없는 걸지도 모르겠네….\n⟦P⟧"
  },
  {
   "key": "aa993883e628",
   "speaker_korean": null,
   "korean": "하지만 말이야.\n설령 돌아갈 곳이 사라진다 해도, 우리가\n지금 있어야 할 곳을 만들어 낼 수는 있어.\n그렇다면, 자신의 손으로 지금을 이어서,\n미래로 가는 길을 열어 가면 되는 거야.\n⟦P⟧"
  },
  {
   "key": "4061ae8b2dc2",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「어머니에게 출생의 비밀을 들은 뒤로,\n난 줄곧 라인갓 박사들을\n증오해 왔어.\n⟦P⟧설령 어떤 이유가 있었다고 해도,\n내 몸을 마치 장난감처럼 다룬\n그 사람들을 용서할 수 없었어….\n⟦P⟧하지만, 뭐 별것 아니었네.\n이 세계 그 자체가, 전부 장난감으로\n만들어진 것이었으니 말이야.\n정말, 질 나쁜 농담이야.\n⟦P⟧"
  },
  {
   "key": "ca12c051b4ae",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧「우리가 살고 있는 이 세계 그 자체가\n⟦2⟧FD인들⟦3⟧의 손에 의해 만들어진\n허구의 세계였어.\n⟦P⟧하지만 말이야….\n그래도 나는 살아 있어.\n내 의지로 움직이고 있어.\n이 마음은 결코 그들이 만들어 낸\n것이 아니야.\n⟦P⟧그렇기에 난, 우리의 이 마음마저\n마음대로 하려고 했던\n그 남자를 용서할 수 없는 거야.\n⟦P⟧"
  },
  {
   "key": "787a04cc930d",
   "speaker_korean": null,
   "korean": "잠겨 있는 것 같다.\n⟦P⟧"
  },
  {
   "key": "1c779a267884",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(창고나 뭐 그런 거겠지….\n⟦P⟧"
  },
  {
   "key": "2626f60b0c9a",
   "speaker_korean": null,
   "korean": "숙박부다.\n몇 사람의 이름이 적혀 있다.\n⟦P⟧"
  },
  {
   "key": "17ca6bb29d80",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(스칼렛 라즈그리즈….\n이 날짜는, 우리 건가.\n역시 가명을 쓰는구나.\n⟦P⟧"
  },
  {
   "key": "3fdb57211111",
   "speaker_korean": null,
   "korean": "⟦1⟧아페리스교⟦2⟧의 경전이다.\n하지만, 페이지 절반 이상이 새까맣게\n칠해져 있다.\n⟦P⟧"
  },
  {
   "key": "7e8ee18396b9",
   "speaker_korean": null,
   "korean": "⟦1⟧아페리스교⟦2⟧의 경전이다.\n새것처럼 반짝반짝하다.\n⟦P⟧"
  },
  {
   "key": "9422294ae19f",
   "speaker_korean": null,
   "korean": "⟦1⟧아페리스교⟦2⟧의 경전이다.\n⟦P⟧"
  },
  {
   "key": "9304d59a1586",
   "speaker_korean": "당찬 아가씨",
   "korean": "⟦1⟧「어서 오세요.\n여기는 나그네의 여관 아이언 메이든\n이랍니다~.\n⟦P⟧묵으실 거라면 ⟦2⟧100폴⟦3⟧ 정도\n받습니다~.\n⟦P⟧"
  },
  {
   "key": "95492957eed1",
   "speaker_korean": null,
   "korean": "⟦1⟧・여관에 묵는다."
  },
  {
   "key": "c39d0318f727",
   "speaker_korean": null,
   "korean": "⟦1⟧・거절한다."
  },
  {
   "key": "a304b709046b",
   "speaker_korean": "당찬 아가씨",
   "korean": "⟦1⟧「이제 캔슬은 안 돼요.\n그럼, 2층으로 올라가세요.\n⟦P⟧"
  },
  {
   "key": "c38086148a39",
   "speaker_korean": "당찬 아가씨",
   "korean": "⟦1⟧「감사합니다!\n그럼, 언젠가 또 기회가 있으시면\n들러 주세요.\n⟦P⟧"
  },
  {
   "key": "15381cafa393",
   "speaker_korean": "당찬 아가씨",
   "korean": "⟦1⟧「그거 아쉽네요.\n그럼, 언젠가 또 기회가 되면\n이용해 주세요~.\n⟦P⟧"
  },
  {
   "key": "db965861fd3f",
   "speaker_korean": "당찬 아가씨",
   "korean": "⟦1⟧「…아니, 돈이 모자라잖아요.\n이 가난뱅이 같으니.\n⟦P⟧"
  },
  {
   "key": "9d7abef85bd4",
   "speaker_korean": "당찬 아가씨",
   "korean": "⟦1⟧「일행이신 여성분은\n아직 돌아오지 않으셨어요.\n먼저 식사부터 하시겠어요?\n⟦P⟧"
  },
  {
   "key": "560845402cb2",
   "speaker_korean": "마치래빗족의 반지 장인",
   "korean": "⟦1⟧「응? 이 힘은….\n헤에, 형씨\n배니시 링을 갖고 있구나.\n⟦P⟧그래서, 뭐?\n그 반지에 내 『기 파워』를\n넣어 달라는 거야?\n⟦P⟧"
  },
  {
   "key": "71ce367bd9d0",
   "speaker_korean": null,
   "korean": "⟦1⟧돈⟦2⟧ ⟦3⟧폴"
  },
  {
   "key": "9769efaa1f62",
   "speaker_korean": "배니시 링에 대하여",
   "korean": "배니시 링은 맵 위에 있는 다양한 물질\n(이하 배니시 파츠)을 지워 없앨 수 있는\n특수한 아이템입니다.\n단, 전부 지울 수 있는 것은 아닙니다.\n무엇이 배니시 파츠인지는\n플레이어 스스로 찾아내 주세요.\n⟦P⟧배니시 파츠를 지우면 보석이 나타나고,\n화면 왼쪽 위에 시간 게이지가 표시되는\n경우가 있습니다. 시간 게이지는 「연쇄 시간」을\n나타내며, 이것이 0이 되기 전에 다음 배니시\n파츠를 지워 보석을 나타나게 하면 연쇄가 됩니다.\n이 연쇄가 끊어졌을 때, 뭔가 좋은 일이\n있을지도 모릅니다. 연쇄의 수가 많으면\n많을수록 더 좋은 일이 있을 것입니다.\n⟦P⟧단, 보석을 나타나게 하는 수에는\n제한이 있습니다. 이것은 나중에 설명합니다.\n⟦P⟧지운 배니시 파츠는 맵을 전환하면\n부활하지만, 일부 부활하지 않는 것도 있습니다.\n또 이와 관련해서, 한번 갔던 맵에\n시간을 두지 않고 다시 가면, 거기서 연쇄가\n강제로 끊어지고 맙니다.\n또, 낙하하거나 움직이고 있는 배니시 파츠에\n부딪히면 페널티로 맵의 처음 위치로\n되돌아갑니다. 이 경우에도 연쇄가 끊어지고\n맙니다. 주의해 주세요."
  },
  {
   "key": "0c5c93792255",
   "speaker_korean": null,
   "korean": "배니시 링 100"
  },
  {
   "key": "8fed5f602a81",
   "speaker_korean": "조작 방법",
   "korean": "를 누르면 아래의 윈도우가 표시됩니다.\n이 상태에서 배니시 파츠에 다가가면,\n지울 수 있는 배니시 파츠 주위에\n초록색 테두리가 표시됩니다. 그 상태에서 를 누르면\n배니시 파츠를 지울 수 있습니다.\n⟦P⟧아까 설명에서 배니시 파츠를 지웠을 때\n나타나는 보석의 수에 제한이 있다고\n했습니다만, 이것은 화면 왼쪽 아래에\n「배니시 링 100」이라고 되어 있듯이,\n보석을 낸 수만큼 표시되어 있는 숫자가\n줄어들며, 0이 되면 배니시해도\n보석이 나타나지 않게 됩니다.\n⟦P⟧물론 이 시점에서, 아까 설명한\n연쇄가 끊어져 버리게 되므로,\n주의가 필요합니다.\n낼 수 있는 보석 수를 늘리려면, 각 마을에 있는\n배니시 링 전용 수리인에게 부탁합니다."
  },
  {
   "key": "054d412a96d0",
   "speaker_korean": null,
   "korean": "⟦1⟧못생긴 반지⟦2⟧를 손에 넣었다."
  },
  {
   "key": "3cea5fd66d89",
   "speaker_korean": null,
   "korean": "⟦1⟧무거운 반지⟦2⟧를 손에 넣었다."
  },
  {
   "key": "518a1408680d",
   "speaker_korean": null,
   "korean": "⟦1⟧헐렁한 반지⟦2⟧를 손에 넣었다."
  },
  {
   "key": "42d1939dd723",
   "speaker_korean": null,
   "korean": "⟦1⟧촌티 나는 피어스⟦2⟧를 손에 넣었다."
  },
  {
   "key": "3a4a1b1f16d2",
   "speaker_korean": null,
   "korean": "⟦1⟧굴욕의 피어스⟦2⟧를 손에 넣었다."
  },
  {
   "key": "c5baa6e61c82",
   "speaker_korean": null,
   "korean": "⟦1⟧흐물흐물한 피어스⟦2⟧를 손에 넣었다."
  },
  {
   "key": "ec392bfa4826",
   "speaker_korean": null,
   "korean": "⟦1⟧무거운 팔찌⟦2⟧를 손에 넣었다."
  },
  {
   "key": "dbd69ae1d230",
   "speaker_korean": null,
   "korean": "⟦1⟧엉터리 팔찌⟦2⟧를 손에 넣었다."
  },
  {
   "key": "37ae22ba3bc9",
   "speaker_korean": null,
   "korean": "⟦1⟧웃기는 팔찌⟦2⟧를 손에 넣었다."
  },
  {
   "key": "52bb9dbd9ebd",
   "speaker_korean": null,
   "korean": "⟦1⟧부끄러운 귀걸이⟦2⟧를 손에 넣었다."
  },
  {
   "key": "deb32d85cd17",
   "speaker_korean": null,
   "korean": "⟦1⟧싸구려 슬레이어⟦2⟧를 손에 넣었다."
  },
  {
   "key": "453f545e7119",
   "speaker_korean": null,
   "korean": "⟦1⟧땅의 소요정⟦2⟧을 손에 넣었다."
  },
  {
   "key": "0d0f6490cdec",
   "speaker_korean": null,
   "korean": "⟦1⟧물의 소요정⟦2⟧을 손에 넣었다."
  },
  {
   "key": "a9d3e741bbc8",
   "speaker_korean": null,
   "korean": "⟦1⟧불의 소요정⟦2⟧을 손에 넣었다."
  },
  {
   "key": "9b651ae4cc1e",
   "speaker_korean": null,
   "korean": "⟦1⟧바람의 소요정⟦2⟧을 손에 넣었다"
  },
  {
   "key": "60235039b0ef",
   "speaker_korean": null,
   "korean": "⟦1⟧별의 소요정⟦2⟧을 손에 넣었다."
  },
  {
   "key": "a41a5afc3ffd",
   "speaker_korean": null,
   "korean": "⟦1⟧트라이 엠블럼⟦2⟧을 손에 넣었다."
  },
  {
   "key": "0e10e7312472",
   "speaker_korean": null,
   "korean": "⟦1⟧트라이 엠블럼⟦2⟧을 손에 넣었다."
  },
  {
   "key": "43e2c025e3d8",
   "speaker_korean": null,
   "korean": "⟦1⟧바니 슈즈⟦2⟧를 손에 넣었다."
  },
  {
   "key": "0fa6bcd059a0",
   "speaker_korean": null,
   "korean": "⟦1⟧합성 소재⟦2⟧를 손에 넣었다."
  },
  {
   "key": "d76c2c10c28d",
   "speaker_korean": null,
   "korean": "⟦1⟧멍게⟦2⟧를 손에 넣었다."
  },
  {
   "key": "66097c002c12",
   "speaker_korean": null,
   "korean": "⟦1⟧킹두리안⟦2⟧을 손에 넣었다."
  },
  {
   "key": "2b9ab6e4094a",
   "speaker_korean": null,
   "korean": "⟦1⟧데몬즈 스톤⟦2⟧을 손에 넣었다."
  },
  {
   "key": "c0aec30839d6",
   "speaker_korean": null,
   "korean": "⟦1⟧릴리스의 권속⟦2⟧을 손에 넣었다."
  },
  {
   "key": "0519589db9ca",
   "speaker_korean": null,
   "korean": "⟦1⟧바니의 부적⟦2⟧을 손에 넣었다."
  },
  {
   "key": "573c6536cf64",
   "speaker_korean": null,
   "korean": "⟦1⟧・링에 힘을 넣어 줘."
  },
  {
   "key": "eb5eebf26ca5",
   "speaker_korean": null,
   "korean": "⟦1⟧・배니시 링이 뭐였더라… 떠올린다."
  },
  {
   "key": "561a1d370b32",
   "speaker_korean": null,
   "korean": "⟦1⟧・아니, 지금은 됐어."
  },
  {
   "key": "4e7eca94095c",
   "speaker_korean": "마치래빗족의 반지 장인",
   "korean": "⟦1⟧「그래, 아쉽네.\n그럼, 또 기회가 있으면 봐.\n⟦P⟧일생에 한 번뿐인 돈거래를\n소중히 하자고.\n⟦P⟧"
  },
  {
   "key": "815b4d5926c5",
   "speaker_korean": "마치래빗족의 반지 장인",
   "korean": "⟦1⟧「뭐야, 『기 파워』를 넣을\n필요가 없잖아.\n놀리지 말라고.\n⟦P⟧"
  },
  {
   "key": "ef2f5dc5fe4c",
   "speaker_korean": "마치래빗족의 반지 장인",
   "korean": "⟦1⟧「흠흠.\n지금 링의 상태는\n이런 느낌이네.\n그래서 어떻게 할래?\n⟦P⟧"
  },
  {
   "key": "3a9187b345e9",
   "speaker_korean": null,
   "korean": "⟦1⟧・10회분 부탁해."
  },
  {
   "key": "cb6a4a12ff91",
   "speaker_korean": null,
   "korean": "⟦1⟧・50회분 부탁해."
  },
  {
   "key": "29e129e3c670",
   "speaker_korean": null,
   "korean": "⟦1⟧・100회분 부탁해."
  },
  {
   "key": "7917e39537eb",
   "speaker_korean": null,
   "korean": "⟦1⟧・역시 그만둔다."
  },
  {
   "key": "792a852c1ccf",
   "speaker_korean": null,
   "korean": "⟦1⟧남은 차지 수⟦2⟧\n⟦3⟧⟦4⟧/100회"
  },
  {
   "key": "a160b02b5a08",
   "speaker_korean": null,
