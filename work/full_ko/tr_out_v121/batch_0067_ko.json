{
 "batch_id": "batch_0067",
 "translations": [
  {
   "key": "82e19dcada7a",
   "speaker_korean": "아미나",
   "korean": "「원래, 제가 ⟦1⟧아리그리프⟦2⟧에서\n이곳으로 돌아올 때\n가지고 있던 물건이거든요."
  },
  {
   "key": "26bdb098aa76",
   "speaker_korean": "페이트",
   "korean": "「그래도, 미안한걸.\n귀한 물건 아니야?"
  },
  {
   "key": "17aed9269079",
   "speaker_korean": "아미나",
   "korean": "「괜찮아요.\n저한테는 이제 필요 없는 거니까요."
  },
  {
   "key": "42147bef6960",
   "speaker_korean": "아미나",
   "korean": "「예, 소중히 간직해 주세요."
  },
  {
   "key": "4fa3ccea5112",
   "speaker_korean": "페이트",
   "korean": "「하하하."
  },
  {
   "key": "ee07d642d135",
   "speaker_korean": "아미나",
   "korean": "「후후후."
  },
  {
   "key": "67d2dbce2e21",
   "speaker_korean": "페이트",
   "korean": "「아, 아니야!\n그, 그게… 저 애가 내가 아는\n사람이랑 닮아서 말이야.\n그래서 좀… 그런 거야."
  },
  {
   "key": "8902beacbaed",
   "speaker_korean": "클리프",
   "korean": "「말 거는 게 어지간히 뻔하구먼.\n다음에 내가 좀 더\n그럴듯한 대사를 알려주지."
  },
  {
   "key": "1bca8874cbd7",
   "speaker_korean": "페이트",
   "korean": "「그러니까 아니라고 하잖아!"
  },
  {
   "key": "feb8019d6c9d",
   "speaker_korean": "클리프",
   "korean": "「뭐야, 화낼 것까진 없잖냐?\n그냥 가벼운 농담이잖아.\n애초에, 놀림받기 싫으면,\n약속 장소에서\n시시덕거리고 있질 말라고."
  },
  {
   "key": "de67d9397f2a",
   "speaker_korean": "넬",
   "korean": "「…그건 그렇다 치고."
  },
  {
   "key": "13e326f63633",
   "speaker_korean": "넬",
   "korean": "「그 애 소개는 안 해 줄 거야?"
  },
  {
   "key": "2bf24afb0ff2",
   "speaker_korean": "페이트",
   "korean": "「응. 이쪽은 ⟦1⟧아미나⟦2⟧.\n이 마을에서 꽃을 판대."
  },
  {
   "key": "b32fd73d7733",
   "speaker_korean": "아미나",
   "korean": "「저, 저기, ⟦1⟧아미나⟦2⟧라고 해요."
  },
  {
   "key": "96e1df2fbb36",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧, 이 두 사람이\n아까 말한 일행이야.\n⟦3⟧클리프⟦4⟧랑\n⟦5⟧넬⟦6⟧ 씨."
  },
  {
   "key": "a95143e108ce",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧아미나⟦2⟧라… 좋은 이름이군.\n잘 부탁해.\n난 ⟦3⟧클리프 피터⟦4⟧다.\n뭐, 이 녀석 보호자 같은 거지."
  },
  {
   "key": "30d01a048f18",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧넬 젤퍼⟦2⟧야."
  },
  {
   "key": "2d48eba9c90c",
   "speaker_korean": "아미나",
   "korean": "「잘 부탁드려요."
  },
  {
   "key": "474277faa5d7",
   "speaker_korean": "넬",
   "korean": "「너, 진귀한 걸 갖고 있네.\n그거, 어디서 났어?"
  },
  {
   "key": "806104ea6b3a",
   "speaker_korean": "페이트",
   "korean": "「어… 이거?\n응, ⟦1⟧아미나⟦2⟧가 준 거야."
  },
  {
   "key": "dac99ddc2899",
   "speaker_korean": "클리프",
   "korean": "「대체 그게 뭔데?\n진귀하다고?"
  },
  {
   "key": "383300618926",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧이리스의 무녀화⟦2⟧.\n요즘은 전쟁으로 서식지가 망가져서,\n좀처럼 구할 수 없게 된 꽃이야.\n⟦P⟧⟦3⟧아페리스교⟦4⟧에서는 ⟦5⟧여신 이리스⟦6⟧를\n상징하는 꽃으로,\n신화에도 몇 번이고 등장하지.\n⟦P⟧지금은 여행자의 안전을 지키는\n부적으로 쓰이는 일이 많아.\n⟦P⟧기원 성취의 ⟦7⟧팔미라의 천송이꽃⟦8⟧,\n전승을 비는 ⟦9⟧엘레노어의 화관⟦10⟧과\n같은 거라고 생각하면 돼."
  },
  {
   "key": "3514c51f7d10",
   "speaker_korean": "클리프",
   "korean": "「허어… 대단한 물건이군.\n그렇게 귀한 걸,\n이 녀석한테 줘도 되는 거냐?"
  },
  {
   "key": "b95d567d23b7",
   "speaker_korean": "아미나",
   "korean": "「예, 저한텐 이제 필요 없는 거니까요.\n아, 저, 이제 슬슬 일하러 돌아가야\n해서요…"
  },
  {
   "key": "d3d4d1cfa479",
   "speaker_korean": "아미나",
   "korean": "「예, 죄송해요…\n여러 이야기 나눌 수 있어서 즐거웠어요.\n⟦1⟧시랜드⟦2⟧까지 가는 길, 조심하세요."
  },
  {
   "key": "c4db9a9b6291",
   "speaker_korean": "페이트",
   "korean": "「응. ⟦1⟧아미나⟦2⟧도\n여러모로 힘들겠지만, 힘내."
  },
  {
   "key": "5675ba4e704c",
   "speaker_korean": "페이트",
   "korean": "「소꿉친구도 분명 만날 수 있을 거야.\n나도 그렇게 믿으니까."
  },
  {
   "key": "ef99274d0c52",
   "speaker_korean": "클리프",
   "korean": "「그런가."
  },
  {
   "key": "8a41e7cd3a9b",
   "speaker_korean": "넬",
   "korean": "「둘 다, 서서 얘기하기도 뭐하네.\n슬슬 여관으로 들어갈까."
  },
  {
   "key": "704b2e4f998d",
   "speaker_korean": "페이트",
   "korean": "「그러네."
  },
  {
   "key": "5425233d0131",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧페터니⟦2⟧에 여관은 2곳 있는데,\n동부 쪽은 이래저래 문제가 있으니까,\n서부 여관으로 하지."
  },
  {
   "key": "4ed557de71c5",
   "speaker_korean": "클리프",
   "korean": "「문제, 라고?"
  },
  {
   "key": "59ac1c8dc60d",
   "speaker_korean": "넬",
   "korean": "「술집을 겸한 싸구려 여관이거든.\n쉽게 말해 험한 자들이 많다는 얘기지.\n시하츠 영내라고는 해도,\n되도록 말썽은 피하고 싶으니까."
  },
  {
   "key": "fc7129403bdb",
   "speaker_korean": "페이트",
   "korean": "「알겠습니다.\n서부 쪽으로 하죠."
  },
  {
   "key": "4af4232b19bd",
   "speaker_korean": "페이트",
   "korean": "「시시덕거린 적 없다니까."
  },
  {
   "key": "b83f91dd3a69",
   "speaker_korean": "클리프",
   "korean": "「이봐, 뭐 하고 있냐."
  },
  {
   "key": "280ef628c9e4",
   "speaker_korean": "클리프",
   "korean": "「…꼬시는 거냐?"
  },
  {
   "key": "e0761e659a18",
   "speaker_korean": "페이트",
   "korean": "「드, 두 사람 다!?"
  },
  {
   "key": "b3824cd02da8",
   "speaker_korean": "페이트",
   "korean": "「좀, 피곤한가……\n목도 마르고."
  },
  {
   "key": "6b5330802223",
   "speaker_korean": "아미나",
   "korean": "「예… 그래도…\n역시 씨를 붙여서 부를게요."
  },
  {
   "key": "079c98614a10",
   "speaker_korean": "아미나",
   "korean": "「일단, 편지 같은 걸로 연락은\n주고받고 있었는데 말이죠.\n전쟁이 시작되고 나서는,\n그것도 끊겨 버려서……\n지금은 그 사람이 어디 있는지도\n알 수가 없어요.\n마지막 편지에는, 연구자가 된다고\n쓰여 있었지만요."
  },
  {
   "key": "4762802fc433",
   "speaker_korean": "아미나",
   "korean": "「예. 저, 지금 혼자 살고 있는데,\n딱히 할 수 있는 일도 없어서…\n그래서 뜰에서 기르는 꽃이나\n산에서 캐 온 약초 같은 걸\n팔고 있어요."
  },
  {
   "key": "23291b327cf5",
   "speaker_korean": "페이트",
   "korean": "「어, 괜찮아?\n파는 물건이잖아… 돈 낼게."
  },
  {
   "key": "251918a770ad",
   "speaker_korean": "아미나",
   "korean": "「아, 파는 꽃이 아니에요.\n이건 제 개인적인 부적이니까요."
  },
  {
   "key": "c850d3fb3039",
   "speaker_korean": "페이트",
   "korean": "「어, 아뇨, 괜찮아요!\n계속 걷기만 해서\n좀 피곤할 뿐이니까요."
  },
  {
   "key": "553477ccced8",
   "speaker_korean": "젊은 아가씨",
   "korean": "「저… 죄송하지만,\n사람을 잘못 보신 것 같아요.\n제 이름은 ⟦1⟧아미나⟦2⟧라고 하는데요."
  },
  {
   "key": "82ab788e5c21",
   "speaker_korean": "아미나",
   "korean": "「아, 아뇨. 신경 쓰지 마세요.\n어, 저기…"
  },
  {
   "key": "0219ad816872",
   "speaker_korean": "페이트",
   "korean": "「아, 제 이름은 ⟦1⟧페이트⟦2⟧.\n⟦3⟧페이트 라인갓⟦4⟧이에요."
  },
  {
   "key": "914735115303",
   "speaker_korean": "아미나",
   "korean": "「그러셨군요… 콜록."
  },
  {
   "key": "93b562c165d5",
   "speaker_korean": "아미나",
   "korean": "「콜록… 콜록."
  },
  {
   "key": "a3a62f659e8c",
   "speaker_korean": "페이트",
   "korean": "「…정말 미안해요."
  },
  {
   "key": "5b03415b7023",
   "speaker_korean": "페이트",
   "korean": "「고마워, ⟦1⟧아미나⟦2⟧.\n소중히 간직할게."
  },
  {
   "key": "6084a0037674",
   "speaker_korean": "페이트",
   "korean": "「그래?"
  },
  {
   "key": "c9eaefa871fd",
   "speaker_korean": "페이트",
   "korean": "「어, 응.\n가벼운 감기에 걸렸다고 했는데."
  },
  {
   "key": "b4568b8122d8",
   "speaker_korean": "페이트",
   "korean": "「병기 개발이라… 다들 심정은 이해하지만.\n그래도…… 하아, 난 대체 어떻게 해야 하지?"
  },
  {
   "key": "a1713209c0c3",
   "speaker_korean": "아미나",
   "korean": "「예. 감사합니다.\n여러분께 ⟦1⟧아페리스⟦2⟧의 가호가\n있기를 빌게요.\n그럼 이만 실례할게요."
  },
  {
   "key": "160201e7af09",
   "speaker_korean": "클리프",
   "korean": "「저 애, 무슨 병이라도 있는 거냐?\n기침을 꽤 하던데."
  }
 ]
}