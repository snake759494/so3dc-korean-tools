{
 "batch_id": "batch_0226",
 "translations": [
  {
   "key": "55bf54e1eb21",
   "speaker_korean": null,
   "korean": "텅 비었다…"
  },
  {
   "key": "c283af83259e",
   "speaker_korean": null,
   "korean": "⟦1⟧콘 시드+⟦2⟧를 손에 넣었다."
  },
  {
   "key": "4db3e389022a",
   "speaker_korean": "몇 층으로 가시겠습니까?",
   "korean": "1층씩 변경 10층씩 변경\n결정 캔슬"
  },
  {
   "key": "abd8a142ca2a",
   "speaker_korean": null,
   "korean": "⟦1⟧층"
  },
  {
   "key": "243b3909cb1c",
   "speaker_korean": null,
   "korean": "⟦1⟧은의 성배⟦2⟧를 손에 넣었다."
  },
  {
   "key": "f090649b8ca6",
   "speaker_korean": null,
   "korean": "⟦1⟧땅의 상급 정령⟦2⟧을 손에 넣었다."
  },
  {
   "key": "ce24a60aacd6",
   "speaker_korean": "모자라그린",
   "korean": "「크흐흐흐!\n인간이 헤매다 흘러들어 왔구먼."
  },
  {
   "key": "7143bb3a2247",
   "speaker_korean": "모자라그린",
   "korean": "「여기서 내 발톱과 이빨에\n색깔 좀 입혀볼까나."
  },
  {
   "key": "1d18d760883b",
   "speaker_korean": "페이트",
   "korean": "「색?"
  },
  {
   "key": "049ab79aa0f4",
   "speaker_korean": "모자라그린",
   "korean": "「네놈 피의 색깔로 말이지!!"
  },
  {
   "key": "47e6397c5d73",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX8⟦2⟧을 손에 넣었다."
  },
  {
   "key": "298ce53a9ace",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX21⟦2⟧을 손에 넣었다."
  },
  {
   "key": "262e7d2116cf",
   "speaker_korean": "페이트",
   "korean": "「저 사람은…!?"
  },
  {
   "key": "e2f9522722df",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧블레어⟦2⟧ 씨!!"
  },
  {
   "key": "a336b7c3f894",
   "speaker_korean": "페이트",
   "korean": "「오랜만이네요, ⟦1⟧블레어⟦2⟧ 씨."
  },
  {
   "key": "3d2fc77dec44",
   "speaker_korean": "블레어",
   "korean": "「오랜만이네."
  },
  {
   "key": "ac8f228d87ed",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧블레어⟦2⟧ 씨가 왜 여기에?"
  },
  {
   "key": "aecc6a31cf63",
   "speaker_korean": "페이트",
   "korean": "「…설마!!"
  },
  {
   "key": "3f13c489612a",
   "speaker_korean": "블레어",
   "korean": "「맞아, 그 설마야."
  },
  {
   "key": "c81150108576",
   "speaker_korean": "블레어",
   "korean": "「나는 알아 버렸어.\n그분의 존재를.\n그래.\n『신』을 알아 버린 거야.\n설마 우리마저 능가하는\n『신』이 존재했을 줄이야…."
  },
  {
   "key": "e8555ff1425e",
   "speaker_korean": "블레어",
   "korean": "「이 앞으로는 지나가게 둘 수 없어."
  },
  {
   "key": "455489a6dd70",
   "speaker_korean": "블레어",
   "korean": "「용케 나를 물리쳤구나.\n길이 열렸어.\n자, 나아가렴."
  },
  {
   "key": "2ac3bbcf9fdd",
   "speaker_korean": "페이트",
   "korean": "「자, 잠깐만 기다려 주세요!\n당신이 말하는 『신』이란\n대체…!?"
  },
  {
   "key": "fd3f6f2fd28b",
   "speaker_korean": "블레어",
   "korean": "「만나면…알게 될 거야.\n또 어딘가에서 만나자.\n안녕."
  },
  {
   "key": "6cb8002f80ab",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX7⟦2⟧을 손에 넣었다."
  },
  {
   "key": "bd0603947b06",
   "speaker_korean": null,
   "korean": "⟦1⟧마기 시드+⟦2⟧를 손에 넣었다."
  },
  {
   "key": "45113a3b4dfe",
   "speaker_korean": null,
   "korean": "⟦1⟧이모션・토렌트⟦2⟧를 손에 넣었다."
  },
  {
   "key": "f36738010ea5",
   "speaker_korean": null,
   "korean": "⟦1⟧발리언트 메일⟦2⟧을 손에 넣었다."
  },
  {
   "key": "e144e5b8fda5",
   "speaker_korean": null,
   "korean": "⟦1⟧서던크로스⟦2⟧를 손에 넣었다."
  },
  {
   "key": "7016190c943d",
   "speaker_korean": null,
   "korean": "⟦1⟧그렘린 레어⟦2⟧를 손에 넣었다."
  },
  {
   "key": "1a0b7c623a42",
   "speaker_korean": null,
   "korean": "⟦1⟧예언서3⟦2⟧을 손에 넣었다."
  },
  {
   "key": "f664b82b4f57",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX18⟦2⟧을 손에 넣었다."
  },
  {
   "key": "f75853670864",
   "speaker_korean": "???",
   "korean": "「캬하하하하하!!\n용케도 여기까지 왔구나!!"
  },
  {
   "key": "27a45b5db442",
   "speaker_korean": "페이트",
   "korean": "「넌…!?"
  },
  {
   "key": "eac02986bd41",
   "speaker_korean": "페이트",
   "korean": "「누구더라?"
  },
  {
   "key": "2542dc1c5560",
   "speaker_korean": "???",
   "korean": "「카─────────!!!\n너 기억 못 하는 거냐!!\n확실히 본편 초반에\n나온 건 인정하지만,\n잊어버릴 리가 없잖아!!\n아무튼! 내가 바로 ⟦1⟧노턴 님⟦2⟧이시다!\n잘 기억해 둬라!!"
  },
  {
   "key": "43cadd81d8b8",
   "speaker_korean": "페이트",
   "korean": "「아니, 그게 말이지…."
  },
  {
   "key": "40e413475664",
   "speaker_korean": "노턴",
   "korean": "「그치고 나발이고 없어!!\n아무튼 여기서부터는\n못 지나가게 해주마!!"
  },
  {
   "key": "4a3832902c02",
   "speaker_korean": "페이트",
   "korean": "「저놈은…!?"
  },
  {
   "key": "fbb05e037989",
   "speaker_korean": "???",
   "korean": "「드디어 손님이 도착했군."
  },
  {
   "key": "fe1bb7047462",
   "speaker_korean": "???",
   "korean": "「내 이름은 아크데몬.\n데몬들 중에서도 고귀한 존재지.\n그 점은 부디 착각하지 말아주었으면 하는군."
  },
  {
   "key": "b6b2e0651274",
   "speaker_korean": "아크데몬",
   "korean": "「아래층의 놈들이 죄다\n쓰러졌다는 말을 듣고 어떤 녀석인가 했더니,\n그저 평범한 인간이라니….\n실소를 금할 길이 없군."
  },
  {
   "key": "6c6f8321c47f",
   "speaker_korean": "페이트",
   "korean": "「우리는 평범한 인간과는 달라!!"
  },
  {
   "key": "23015e46838d",
   "speaker_korean": "아크데몬",
   "korean": "「호오! 제법 기세등등하군.\n허나 그 언행은 만 번 죽어 마땅하다.\n신이신 그분의 곁으로는\n보내줄 수 없다."
  },
  {
   "key": "d2e0ecdce1f4",
   "speaker_korean": "페이트",
   "korean": "「그분?"
  },
  {
   "key": "b0947962b7fb",
   "speaker_korean": "아크데몬",
   "korean": "「그래. 네 상상도 못 할 만한 분이시지.\n설마 그분께서 와 주실 줄은 나도\n전혀 예상치 못했다만."
  },
  {
   "key": "a0cfc1e93fde",
   "speaker_korean": "아크데몬",
   "korean": "「이런,\n말이 좀 많았던 모양이군.\n그럼 간다."
  },
  {
   "key": "93f05323fe28",
   "speaker_korean": "아크데몬",
   "korean": "「후, 후후….\n과, 과연 여기까지 온\n보람은 있군….\n너라면 그분을 만날 만한 힘이\n있을지도 모르겠구나."
  },
  {
   "key": "6beee004ebb6",
   "speaker_korean": "아크데몬",
   "korean": "「하지만 그분은 신이긴 하나,\n어떤 의미로는 공포 그 자체다.\n부디 잊지 말도록!!"
  },
  {
   "key": "4923b5eab7ae",
   "speaker_korean": "페이트",
   "korean": "「저 아이는…!"
  },
  {
   "key": "6557d9866cb0",
   "speaker_korean": "페이트",
   "korean": "「또…?"
  },
  {
   "key": "d292dfa933f7",
   "speaker_korean": "클리프",
   "korean": "「어이어이,\n대체 몇 번째냐."
  },
  {
   "key": "b082e2e4b7c9",
   "speaker_korean": "?레나스",
   "korean": "「…이번엔 내가 직접."
  },
  {
   "key": "b18065676919",
   "speaker_korean": "페이트",
   "korean": "「오는 건가!?"
  },
  {
   "key": "e3d337016da2",
   "speaker_korean": "페이트",
   "korean": "「결국 뭐였던 걸까?\n그 아이는…."
  },
  {
   "key": "e22f55cd8df4",
   "speaker_korean": "클리프",
   "korean": "「신의 변덕이란\n그런 거 아니냐?"
  },
  {
   "key": "989b07997ab3",
   "speaker_korean": "?레나스",
   "korean": "「…이제 어떻게 되든\n난 모른다."
  },
  {
   "key": "46c4d6df2429",
   "speaker_korean": "로저",
   "korean": "「으음~, 아가씨 냄새가….\n어디냐 어디냐~?"
  },
  {
   "key": "e07adbf506b3",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧로저⟦2⟧,\n너무 멀리 가면 안 돼!"
  },
  {
   "key": "a520d0e6769f",
   "speaker_korean": "페이트",
   "korean": "「아, 저 아이는…!"
  },
  {
   "key": "19f798e84b8f",
   "speaker_korean": "로저",
   "korean": "「응? 뭐야, 꼬맹이잖아!\n어라? 어디서 본 것 같은데…."
  },
  {
   "key": "83dea1a09ee4",
   "speaker_korean": "페이트",
   "korean": "「다들 조심해!\n지금까지와는 뭔가 달라!!"
  },
  {
   "key": "c13cc8254427",
   "speaker_korean": "페이트",
   "korean": "「결국 뭐였던 걸까,\n그 아이는…?"
  },
  {
   "key": "2c267a310c05",
   "speaker_korean": "로저",
   "korean": "「아주 죽는 줄 알았다고!"
  },
  {
   "key": "035ee1eaad28",
   "speaker_korean": "클리프",
   "korean": "「자업자득이다!!"
  },
  {
   "key": "91107d265044",
   "speaker_korean": null,
   "korean": "⟦1⟧이세리얼・블래스트⟦2⟧를 손에 넣었다."
  },
  {
   "key": "7e7c656ed924",
   "speaker_korean": null,
   "korean": "⟦1⟧스트레 시드+⟦2⟧를 손에 넣었다."
  },
  {
   "key": "dc819ed04b67",
   "speaker_korean": null,
   "korean": "⟦1⟧예언서6⟦2⟧을 손에 넣었다."
  }
 ]
}