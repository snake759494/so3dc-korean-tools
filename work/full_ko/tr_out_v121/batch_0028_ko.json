{
 "batch_id": "batch_0028",
 "translations": [
  {
   "key": "d7d1b2fbc8fe",
   "speaker_korean": null,
   "korean": "식량창고"
  },
  {
   "key": "dea92f347c08",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「이 방은, 별로\n좋은 추억이 없단 말이지….\n⟦P⟧"
  },
  {
   "key": "e96294a9d08a",
   "speaker_korean": null,
   "korean": "심문실"
  },
  {
   "key": "26b264240b3d",
   "speaker_korean": "월터",
   "korean": "⟦1⟧「뭐….\n그런 녀석이지만 잘만 부리면\n없는 것보단 도움이 되겠지.\n⟦P⟧실컷 부려먹어도 상관없네.\n요즘 운동 부족이었을 테니,\n그 정도가 딱 좋을 게야.\n허허허….\n⟦P⟧"
  },
  {
   "key": "69d80bc89d94",
   "speaker_korean": "페이트",
   "korean": "「……."
  },
  {
   "key": "dfe16c39ee01",
   "speaker_korean": "페이트",
   "korean": "(…⟦1⟧시하츠⟦2⟧?"
  },
  {
   "key": "8f35175987a5",
   "speaker_korean": "심문관",
   "korean": "「너희들이 타고 있던 거,\n그건, 뭐냐?\n⟦1⟧시하츠⟦2⟧의 신병기냐?"
  },
  {
   "key": "408bcfc2a2e4",
   "speaker_korean": "심문관",
   "korean": "「음…?"
  },
  {
   "key": "e36544cee41d",
   "speaker_korean": "심문관",
   "korean": "「어이! 이놈을 감옥에 처넣어 둬!"
  },
  {
   "key": "f24f1d21404a",
   "speaker_korean": "심문관",
   "korean": "「대답하라니까, 이 자식!!"
  },
  {
   "key": "5e9f66e7014e",
   "speaker_korean": "페이트",
   "korean": "「……모른다…고…\n말했잖아……."
  },
  {
   "key": "59db5e17eb8c",
   "speaker_korean": "심문관",
   "korean": "「그럴 리가 있겠냐아!\n히히히히힛!"
  },
  {
   "key": "a77f692768e9",
   "speaker_korean": "페이트",
   "korean": "「크아악!!"
  },
  {
   "key": "a47a90d0cb58",
   "speaker_korean": "페이트",
   "korean": "「으……."
  },
  {
   "key": "bb30eb7b6f54",
   "speaker_korean": "심문관",
   "korean": "「쳇, 기절해 버렸군.\n이제부터가 재밌어지는 참인데 말이야.\n뭐 됐어, 나중에 또 보자고 아기 고양이.\n히히히…."
  },
  {
   "key": "690076852477",
   "speaker_korean": "아리그리프 병사",
   "korean": "「옛!"
  },
  {
   "key": "729cc3a74bff",
   "speaker_korean": "페이트",
   "korean": "「윽!"
  },
  {
   "key": "445ef7c71a21",
   "speaker_korean": "심문관",
   "korean": "「이제 그만 불어 버리지 그러냐?\n우리한테 협력하면,\n대우는 보장해 준다고 했잖냐."
  },
  {
   "key": "8d7bf7935713",
   "speaker_korean": "페이트",
   "korean": "「이건!?"
  },
  {
   "key": "6c5f1c04b425",
   "speaker_korean": "월터",
   "korean": "「그 녀석은 반역죄로 추궁당했다네.\n자네들을 ⟦1⟧컬소어 수련장⟦2⟧에서\n제 발로 놓아주었다는 이유로 말일세.\n그리고 ⟦3⟧베크렐 광산⟦4⟧에서 어이없이\n⟦5⟧구리 광석⟦6⟧을 빼앗긴 일도 있지.\n뭐, 그 결단을 내린 사내는\n이미 이 세상에 없지만 말일세."
  },
  {
   "key": "f8836a8b8c76",
   "speaker_korean": "월터",
   "korean": "「…여기서 기다리고 있게."
  },
  {
   "key": "54871acb3104",
   "speaker_korean": "클리프",
   "korean": "「……⟦1⟧복스⟦2⟧인가."
  },
  {
   "key": "b0722b66d929",
   "speaker_korean": "월터",
   "korean": "「애송이, 마중이 왔구먼."
  },
  {
   "key": "878779523113",
   "speaker_korean": "월터",
   "korean": "「자네는 저들과 함께 ⟦1⟧우르자 용암 동굴⟦2⟧로\n향하는 임무를 받았네.\n그것만 끝내면 무죄 방면이라는 얘기지."
  },
  {
   "key": "7d6bdc7e8ca5",
   "speaker_korean": "알벨",
   "korean": "「흥.\n그 전쟁광이 용케도 납득했군."
  },
  {
   "key": "594288a351cd",
   "speaker_korean": "알벨",
   "korean": "「저자들…이라고!?\n그놈들은 ⟦1⟧시하츠⟦2⟧의!\n어째서 그런 놈들과!"
  },
  {
   "key": "2ccddbe38658",
   "speaker_korean": "알벨",
   "korean": "「죽었다고!? 그놈들인가?"
  },
  {
   "key": "ef493965dee3",
   "speaker_korean": "월터",
   "korean": "「그자들과 싸우고 있었던 건 확실하네.\n실제로 손을 쓴 건 다른 존재일세."
  },
  {
   "key": "4cbbaabac995",
   "speaker_korean": "알벨",
   "korean": "「누구지?\n그놈들과 나 말고 ⟦1⟧복스⟦2⟧를\n쓰러뜨릴 자가 이 근방에 있단 말인가?"
  },
  {
   "key": "7e495693c507",
   "speaker_korean": "월터",
   "korean": "「이세계의 인간일세."
  },
  {
   "key": "e2c21d2657e0",
   "speaker_korean": "알벨",
   "korean": "「흥…정말로 노망이 났군, 영감.\n하필이면 이세계의 인간이라고?\n좀 더 그럴듯한 거짓말을 해라."
  },
  {
   "key": "d6ebfbd853fe",
   "speaker_korean": "월터",
   "korean": "「뭐, 그게 멀쩡한 인간의 반응이지.\n나도 반신반의하고 있으니 말이야.\n하지만 말이네, 애송이.\n지금, 우리 앞에 강대한 힘을 지닌\n새로운 적이 나타난 건 확실하네.\n그러기 위해선, ⟦1⟧시하츠⟦2⟧와도 손을 잡아야\n하는 걸세."
  },
  {
   "key": "ec1b65a21438",
   "speaker_korean": "알벨",
   "korean": "「노망 났나 영감, 그놈들은 적이라고!"
  },
  {
   "key": "e01d8f0c1f83",
   "speaker_korean": "알벨",
   "korean": "「…진심인가?\n그, 이세계의 인간이라는 것 말이다."
  },
  {
   "key": "03eac4894f39",
   "speaker_korean": "알벨",
   "korean": "「후작급이라고!?\n농담하지 마!\n그런 괴물을 상대하라는 거냐!?"
  },
  {
   "key": "68779c0a3bdc",
   "speaker_korean": "월터",
   "korean": "「그렇다네.\n뭐, 늘 큰소리를 치고 있지 않은가.\n후작급쯤이야 아무것도 아니겠지."
  },
  {
   "key": "e01205f9a195",
   "speaker_korean": "월터",
   "korean": "「저 ⟦1⟧시하츠⟦2⟧의 무리도 보통내기가 아닐세.\n그건 자네도 알고 있잖은가?\n그들과 협력하면 어떻게든 되겠지."
  },
  {
   "key": "3d4411aae670",
   "speaker_korean": "알벨",
   "korean": "「닥쳐…영감."
  },
  {
   "key": "955c794cc026",
   "speaker_korean": "알벨",
   "korean": "「쉽게도 말하는군, 영감."
  },
  {
   "key": "120acef5bc5c",
   "speaker_korean": "알벨",
   "korean": "「…가면 되는 거 아니냐."
  },
  {
   "key": "71ed86ca035c",
   "speaker_korean": "월터",
   "korean": "「어떻게든 되지 않으면,\n우리 모두가 멸망할 뿐일세.\n⟦1⟧시하츠⟦2⟧도, ⟦3⟧아리그리프⟦4⟧도 없는 걸세.\n깨끗이 몽땅 전멸일세.\n단 한 사람도 예외 없이 말일세."
  },
  {
   "key": "2b1991235e68",
   "speaker_korean": "월터",
   "korean": "「그런 거짓말을 해서 뭘 하겠나."
  },
  {
   "key": "965789e20c75",
   "speaker_korean": "월터",
   "korean": "「뭐, 그런 것일세.\n사이좋게 지내 주게."
  },
  {
   "key": "81b5a21bbd27",
   "speaker_korean": "클리프",
   "korean": "「뭐, 어쩔 수 없지."
  },
  {
   "key": "cc73508f8322",
   "speaker_korean": "마리아",
   "korean": "「사정은 잘 모르겠지만,\n잘 부탁할게."
  },
  {
   "key": "a392305ae9af",
   "speaker_korean": "페이트",
   "korean": "「잘 부탁해…."
  },
  {
   "key": "c43ff4796bc1",
   "speaker_korean": "넬",
   "korean": "「원래 같으면 당신 따위와는\n같이 있고 싶지 않지만…\n폐하의 명령이니까…참기로 하지."
  },
  {
   "key": "1b9243e46aca",
   "speaker_korean": "넬",
   "korean": "「부디 발목이나 잡지 않도록\n하는 게 좋을 거야."
  },
  {
   "key": "953bdb1033e5",
   "speaker_korean": "월터",
   "korean": "「그게 말이네, 자네가 투옥된 사이에\n사정이 조금 달라졌다네.\n우리나라와 ⟦1⟧시하츠⟦2⟧는 현재 정전 중일세."
  },
  {
   "key": "aa240a94c688",
   "speaker_korean": "월터",
   "korean": "「⟦1⟧복스⟦2⟧는 죽었다네."
  },
  {
   "key": "8be361b8d279",
   "speaker_korean": "월터",
   "korean": "「어쨌든 말일세.\n그 적에 맞서려면 ⟦1⟧시하츠⟦2⟧의 신병기를\n쓰는 수밖에 없네. 그러기 위해\n⟦3⟧우르자 용암 동굴⟦4⟧에서 후작급을 따르게 해야 하네."
  },
  {
   "key": "2a62c63b202f",
   "speaker_korean": "월터",
   "korean": "「그렇지 않나? ⟦1⟧뒤틀린 알벨⟦2⟧이여."
  },
  {
   "key": "d5d4babcbd27",
   "speaker_korean": "알벨",
   "korean": "「빌어먹을 영감탱이…."
  },
  {
   "key": "ebba1f6cd4d4",
   "speaker_korean": "월터",
   "korean": "「게다가 자네 아비였다면,\n기꺼이 나섰을 거라고 생각하네만."
  },
  {
   "key": "cecc4443390d",
   "speaker_korean": "월터",
   "korean": "「바로 그렇다네."
  },
  {
   "key": "7f30f5a2990e",
   "speaker_korean": "알벨",
   "korean": "「…흥."
  },
  {
   "key": "a26053be11f8",
   "speaker_korean": "알벨",
   "korean": "「…뭐?"
  }
 ]
}