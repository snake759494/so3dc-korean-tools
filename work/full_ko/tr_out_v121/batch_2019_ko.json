{
 "batch_id": "batch_2019",
 "translations": [
  {
   "key": "b7973a913a0e",
   "speaker_korean": null,
   "korean": "빛의 각도에 따라 중앙에 별과 같은 광채가 보이는\n희귀 보석"
  },
  {
   "key": "ac33b3508cbb",
   "speaker_korean": null,
   "korean": "어둠·죽음·영겁의 정적을 다스리는 마성 보석.\n감춰진 힘을 끌어내면, 그것은 두려운\n파괴력이 될 것이 틀림없다"
  },
  {
   "key": "829548862c25",
   "speaker_korean": null,
   "korean": "\"금검\"\n어느 고명한 무예가를 한평생 지켜냈다는 검"
  },
  {
   "key": "2352f2d23926",
   "speaker_korean": null,
   "korean": "왠지 지켜지고 있다는 기분이 들 듯하면서도\n들지 않는 신비한 인형"
  },
  {
   "key": "c012a72054a3",
   "speaker_korean": null,
   "korean": "숲의 수호 요정 엘프처럼 가볍게 움직일 수\n있다는 부츠"
  },
  {
   "key": "f3c015adf11c",
   "speaker_korean": null,
   "korean": "외계 행상인 산타가 킬러 타이틀이라며 팔던\n고가의 부츠.\n여관에 묵으면 좋은 일이 있을지도 모른다"
  },
  {
   "key": "1eaf927cefd6",
   "speaker_korean": null,
   "korean": "초록색 보석이 장식된 부적"
  },
  {
   "key": "b090a0602f62",
   "speaker_korean": null,
   "korean": "파란색 보석이 장식된 부적"
  },
  {
   "key": "0c6dc5da8d48",
   "speaker_korean": null,
   "korean": "빨간색 보석이 장식된 부적"
  },
  {
   "key": "4da69f2ee916",
   "speaker_korean": null,
   "korean": "노란색 보석이 장식된 부적"
  },
  {
   "key": "df5a6cae946e",
   "speaker_korean": null,
   "korean": "달빛처럼 은은한 빛을 발하는 환상적인 부적"
  },
  {
   "key": "626de8fb2aa2",
   "speaker_korean": null,
   "korean": "별빛을 모아놓은 듯한 아름다움을 품은 부적"
  },
  {
   "key": "f49f36f52148",
   "speaker_korean": null,
   "korean": "요술 방망이를 닮은 작은 부적"
  },
  {
   "key": "ced93d50c19f",
   "speaker_korean": null,
   "korean": "적당한 단맛이 특징이라 요즘 유행과는 다소\n동떨어져 있다.\n하지만 그 개성에 한번 빠지면 헤어나올 수 없다"
  },
  {
   "key": "cb36c0aae72e",
   "speaker_korean": null,
   "korean": "인공적으로 생성한 지방 가득한 소고기를 가열 처리한\n음식.\n너무 레어한 건 사양"
  },
  {
   "key": "4c07962cca0c",
   "speaker_korean": null,
   "korean": "고기, 채소를 볶은 것을\n향신료와 밀가루를 섞어 만든 루로 끓여,\n지은 밥에 얹은 요리"
  },
  {
   "key": "93558cba7060",
   "speaker_korean": null,
   "korean": "푸른곰팡이로 단백질을 감칠맛 성분으로 분해한 치즈.\n그것을 통째로 하나"
  },
  {
   "key": "09e4c2087f1c",
   "speaker_korean": null,
   "korean": "적당한 크기로 썬 순무를 기름에 볶아 가다랑어포를\n묻힌 요리. 담백해서 밥반찬으로 최고"
  },
  {
   "key": "1154189f01bb",
   "speaker_korean": null,
   "korean": "타르트 반죽에 아몬드 크림을 채워 넣고,\n그 위에 서양배를 깔아 구워낸 과자"
  },
  {
   "key": "cb36d8c7acf2",
   "speaker_korean": null,
   "korean": "별의 소요정.\n무기에 깃들이면 특별한 힘을 발휘한다"
  },
  {
   "key": "7b00e42b2bf2",
   "speaker_korean": null,
   "korean": "손도끼. 작지만 파괴력은 제법 있다"
  },
  {
   "key": "68be02115ea4",
   "speaker_korean": null,
   "korean": "팔 보호용 광물제 방어구.\n이걸로 때리는 격투가도 있다"
  },
  {
   "key": "f8f16ec662b6",
   "speaker_korean": null,
   "korean": "육체와 정신을 고도로 수호하는 궁극의 방어구"
  },
  {
   "key": "fbd821dae890",
   "speaker_korean": null,
   "korean": "이따금 별처럼 반짝이는 신비로운 방어구"
  },
  {
   "key": "336f9c76066c",
   "speaker_korean": null,
   "korean": "파괴력에 특화된 페이즈건"
  },
  {
   "key": "2cb555bdd3cf",
   "speaker_korean": null,
   "korean": "끝에 수호의 보주가 달린 지팡이"
  },
  {
   "key": "05ead60e7624",
   "speaker_korean": null,
   "korean": "이걸 본 이는 누구나 절로\n얼굴 붉어지는 부적"
  },
  {
   "key": "f1c2795dd874",
   "speaker_korean": null,
   "korean": "아무리 애써도 전혀 보답받지 못할 것\n같은 부적"
  },
  {
   "key": "a76d1820030c",
   "speaker_korean": null,
   "korean": "세인트 스톤으로 정제하는\n가디언 상대용 부적"
  },
  {
   "key": "9650863557bf",
   "speaker_korean": null,
   "korean": "별의 정령.\n무기에 깃들이면 특별한 힘을 발휘한다"
  },
  {
   "key": "2828634f6e5c",
   "speaker_korean": null,
   "korean": "교회에서 축복을 받은 은제 장검"
  },
  {
   "key": "1ffc663b99fb",
   "speaker_korean": null,
   "korean": "자루가 긴 도끼.\n원심력으로 파괴력이 배가된다"
  },
  {
   "key": "ed70f7041f64",
   "speaker_korean": null,
   "korean": "교회에서 축복을 받은 은제 창"
  },
  {
   "key": "7cab6203df20",
   "speaker_korean": null,
   "korean": "교회의 축복으로 마력이\n부여된 체인메일"
  },
  {
   "key": "c2484eb541b4",
   "speaker_korean": null,
   "korean": "교회로부터 축복을 받은 로브"
  },
  {
   "key": "5055e919637c",
   "speaker_korean": null,
   "korean": "초월적인 파괴를 위한 유닛.\n천재 과학자라면 이것을 탐낼지도 모른다.\n설령 자칭일지라도"
  },
  {
   "key": "241ec28aa2ee",
   "speaker_korean": null,
   "korean": "고출력 레이저를 이용한 근접 전투 무기.\n소유자의 의지에 따라 검이나 도끼 같은\n개별 칼날 형태를 만든다"
  },
  {
   "key": "b604d807553b",
   "speaker_korean": null,
   "korean": "도주 속도가 상승하는 부적"
  },
  {
   "key": "c468a1a5e80a",
   "speaker_korean": null,
   "korean": "땅속성 피해를 절반 줄이는 부적"
  },
  {
   "key": "bed14bd98d61",
   "speaker_korean": null,
   "korean": "물속성 피해를 절반 줄이는 부적"
  },
  {
   "key": "583b3634e485",
   "speaker_korean": null,
   "korean": "불속성 피해를 절반 줄이는 부적"
  },
  {
   "key": "4093e2d9adbb",
   "speaker_korean": null,
   "korean": "바람속성 피해를 절반 줄이는 부적"
  },
  {
   "key": "d4d0e31c42b2",
   "speaker_korean": null,
   "korean": "별의 인공생명체.\n무기에 깃들이면 특별한 힘을 발휘한다"
  },
  {
   "key": "989a24ad1692",
   "speaker_korean": null,
   "korean": "어둠·죽음·영겁의 정적을 다스리는 마성 보석.\n감춰진 힘을 끌어내면, 그것은 분명한\n파괴력이 될 것이 틀림없다"
  },
  {
   "key": "2c411d92ea7c",
   "speaker_korean": null,
   "korean": "왠지 지켜지고 있다는 기분이 들 듯하면서도\n들지 않는 신비한 인형"
  },
  {
   "key": "21c99190cc4b",
   "speaker_korean": null,
   "korean": "고기, 채소를 볶은 것에 향신료와 밀가루를 섞어 만든\n루를 지은 밥에 얹은 요리"
  },
  {
   "key": "05d5105fba51",
   "speaker_korean": null,
   "korean": "타르트 반죽에 아몬드 크림을 채워 넣고,\n그 위로 서양배를 깔아 구워낸 과자"
  },
  {
   "key": "3475ab773a02",
   "speaker_korean": null,
   "korean": "교회의 축복을 받은 은제 장검"
  },
  {
   "key": "af59780139b5",
   "speaker_korean": null,
   "korean": "교회의 축복을 받은 은제 창"
  }
 ]
}