{
 "batch_id": "batch_0149",
 "translations": [
  {
   "key": "e89e5484e570",
   "speaker_korean": "로저",
   "korean": "⟦1⟧「피곤하면 이 몸 집에서\n좀 쉬었다 가도 된다고~\n⟦P⟧신경 안 써도 되거든\n부하를 챙기는 게, 두목으로선\n당연한 거니까 말이야\n⟦P⟧"
  },
  {
   "key": "39e7ff4b5400",
   "speaker_korean": "로저",
   "korean": "「오, 형아. 웬일이야?"
  },
  {
   "key": "9d289d9574b4",
   "speaker_korean": "페이트",
   "korean": "「아니, 근처에 왔길래\n잠깐 들러 본 거야."
  },
  {
   "key": "ed5e3cfe90ef",
   "speaker_korean": "로저",
   "korean": "「그렇구나\n뭐, 편히 있다 가라고."
  },
  {
   "key": "4778844aeb0e",
   "speaker_korean": "페이트",
   "korean": "「응, 고마워\n근데 그렇게 여유 부릴\n시간은 없어."
  },
  {
   "key": "f5528815c803",
   "speaker_korean": "로저",
   "korean": "「모험이냐!?"
  },
  {
   "key": "e4b8ad6cb1d9",
   "speaker_korean": "로저",
   "korean": "「뭔데, 무슨 볼일이라도 있어?"
  },
  {
   "key": "ce51af19e2cb",
   "speaker_korean": "페이트",
   "korean": "「뭐, 그렇지."
  },
  {
   "key": "71860fc34594",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧클리프⟦2⟧."
  },
  {
   "key": "8b12775ded3b",
   "speaker_korean": "클리프",
   "korean": "「뭐, 모험이라면 모험이려나…"
  },
  {
   "key": "2914f59b3961",
   "speaker_korean": "로저",
   "korean": "「뭐야, 그럴 거면 진작 말해 주지\n너무 섭섭하잖아."
  },
  {
   "key": "086f40943a78",
   "speaker_korean": "로저",
   "korean": "「이 몸도 같이 가 줄게\n모험이잖아?\n그야말로 사내가 할 일이잖아~"
  },
  {
   "key": "52049e0518cd",
   "speaker_korean": "페이트",
   "korean": "「근데 말이야…"
  },
  {
   "key": "5f5353b97e89",
   "speaker_korean": "로저",
   "korean": "「뭔데?\n혹시 이 몸이 걸림돌이라도 된다는 거냐?"
  },
  {
   "key": "3156bd4bd370",
   "speaker_korean": null,
   "korean": "⟦1⟧・동행을 허락한다⟦2⟧"
  },
  {
   "key": "e2a3d543d60e",
   "speaker_korean": null,
   "korean": "⟦1⟧・적당히 얼버무린다⟦2⟧"
  },
  {
   "key": "8bd1f7884175",
   "speaker_korean": "페이트",
   "korean": "「아니, 그런 거 아니야.\n잘 부탁한다."
  },
  {
   "key": "a6262aea0fdb",
   "speaker_korean": "페이트",
   "korean": "「그런 게 아니야.\n근데, 안 되는 거야."
  },
  {
   "key": "f0f66b476f77",
   "speaker_korean": "로저",
   "korean": "「오케이! 나한테 맡겨!!\n사내 중의 사내, 이 ⟦1⟧로저⟦2⟧님이\n함께 하니까 말이야!\n진흙배를 탄 셈 치라고!"
  },
  {
   "key": "b101625f5023",
   "speaker_korean": "클리프",
   "korean": "「오이, 진흙배면\n가라앉는 거 아니냐\n…봐 달라고."
  },
  {
   "key": "ea5311a48f52",
   "speaker_korean": "로저",
   "korean": "「뭐, 신경 쓰지 말라고\n자잘한 거 신경 쓰는 남잔 인기 없어."
  },
  {
   "key": "a94a4f6cc2aa",
   "speaker_korean": "클리프",
   "korean": "「오, 그 몸집에\n말하는 건 다 컸단 말이지."
  },
  {
   "key": "437254883af8",
   "speaker_korean": "로저",
   "korean": "「시끄럽게 굴지 마, 덩치야!"
  },
  {
   "key": "98ece24a9f72",
   "speaker_korean": "클리프",
   "korean": "「뭐라고, 인마."
  },
  {
   "key": "e5d226d7f565",
   "speaker_korean": "로저",
   "korean": "「뭐야!"
  },
  {
   "key": "3e288d47e5d9",
   "speaker_korean": "클리프",
   "korean": "「이 망할 꼬맹이가…"
  },
  {
   "key": "8e96131a5155",
   "speaker_korean": "로저",
   "korean": "「꼬맹이 아니라고!\n이 ⟦1⟧로저⟦2⟧님이라고 했잖아!"
  },
  {
   "key": "f6db31557484",
   "speaker_korean": "클리프",
   "korean": "「오, 그럼 나도\n⟦1⟧클리프⟦2⟧ 님인 셈이군."
  },
  {
   "key": "bbeae32d18fa",
   "speaker_korean": "로저",
   "korean": "「흥, 그런 거 하나도\n안 대단하잖아."
  },
  {
   "key": "c9bcfcceb2f0",
   "speaker_korean": "페이트",
   "korean": "「하아……"
  },
  {
   "key": "e5653a310fa5",
   "speaker_korean": "클리프",
   "korean": "「엉?"
  },
  {
   "key": "004f31db3ea5",
   "speaker_korean": "로저",
   "korean": "「아?"
  },
  {
   "key": "25450a336f7a",
   "speaker_korean": "로저",
   "korean": "「그럼, 왜 그러는 건데?"
  },
  {
   "key": "e9a4a12889fe",
   "speaker_korean": "페이트",
   "korean": "「음… 그게…"
  },
  {
   "key": "28a004ae07a0",
   "speaker_korean": "로저",
   "korean": "「……"
  },
  {
   "key": "c6298dd0d1d2",
   "speaker_korean": "클리프",
   "korean": "「실은 말이야, 여기서만 하는 얘기다만…"
  },
  {
   "key": "046d5bc720cb",
   "speaker_korean": "클리프",
   "korean": "「우리는 지금, 비밀 임무를\n수행 중이거든."
  },
  {
   "key": "0eecb192400c",
   "speaker_korean": "로저",
   "korean": "「비밀…임무라고?\n왠지 끌리는 소리잖아!"
  },
  {
   "key": "481f055fa02a",
   "speaker_korean": "로저",
   "korean": "「이 몸이?"
  },
  {
   "key": "f77a8202410a",
   "speaker_korean": "클리프",
   "korean": "「그래, 몰랐냐?\n뭐, 아무튼 그런 거다.\n너는 데려갈 수 없어."
  },
  {
   "key": "7338bc4c1ae7",
   "speaker_korean": "클리프",
   "korean": "「그렇지?\n그리고, 비밀 임무란 건\n즉, 눈에 띄면 안 된다는 거야."
  },
  {
   "key": "614e20f3dc2a",
   "speaker_korean": "클리프",
   "korean": "「그래.\n그런데, 너는 사내 중의 사내로서\n온 세상에 이름을 떨치는 녀석이지."
  },
  {
   "key": "f8697fb52834",
   "speaker_korean": "로저",
   "korean": "「그야, 그렇지.\n뭐니 뭐니 해도 비밀이니까!"
  },
  {
   "key": "f493ec370871",
   "speaker_korean": "클리프",
   "korean": "「그러니까 말했잖아?\n이건 비밀 임무니까, 눈에 띄면 안 돼.\n너는 유명인, 눈에 띄니까 안 돼.\n…아주 간단한 이치 아니냐."
  },
  {
   "key": "6ab8e959641e",
   "speaker_korean": "로저",
   "korean": "「왜, 왜 그런 건데!?\n하나도 모르겠잖아!?"
  },
  {
   "key": "bc0a238d6e92",
   "speaker_korean": null,
   "korean": "⟦1⟧・말없이 튄다⟦2⟧"
  },
  {
   "key": "7308ca5f9c04",
   "speaker_korean": "로저",
   "korean": "「오, 오이!\n갑자기 어디 가는 거야!?"
  },
  {
   "key": "fe1584c171a1",
   "speaker_korean": "클리프",
   "korean": "「너도 사내잖아.\n임무가 사내에게 얼마나\n중요한 건지…알겠지?"
  },
  {
   "key": "ce8a1c470a6c",
   "speaker_korean": "로저",
   "korean": "「으…그래도 말이야!!"
  },
  {
   "key": "bfb3be84c0c1",
   "speaker_korean": "로저",
   "korean": "「그, 그야 뭐!\n당연히 알지!!\n무시하지 말라고!!"
  },
  {
   "key": "03a166226bfe",
   "speaker_korean": "클리프",
   "korean": "「그런 거다…알겠지?"
  },
  {
   "key": "815a3e35b7dc",
   "speaker_korean": "페이트",
   "korean": "「아, 그래.\n그런 거야."
  },
  {
   "key": "5176f434d141",
   "speaker_korean": "로저",
   "korean": "「알겠다고…\n비밀 임무, 힘내라고."
  },
  {
   "key": "28ff5b391e63",
   "speaker_korean": "로저",
   "korean": "「그나저나, 다음…\n비밀 임무 아닌 모험에는\n꼭 데려가 달라고!"
  },
  {
   "key": "67c798071c56",
   "speaker_korean": "페이트",
   "korean": "「그래, 알겠어."
  },
  {
   "key": "42efc4ccee98",
   "speaker_korean": "로저",
   "korean": "「좋았어! 됐다!!\n약속 어기면 아주 혼쭐을\n내줄 거니까!!"
  },
  {
   "key": "e0e4dd3598ae",
   "speaker_korean": "로저",
   "korean": "「그래! 그럼 잘 가라!!"
  },
  {
   "key": "e9739d51bc52",
   "speaker_korean": "페이트",
   "korean": "「그럼, 우리는 갈게."
  }
 ]
}