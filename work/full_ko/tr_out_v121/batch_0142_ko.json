{
 "batch_id": "batch_0142",
 "translations": [
  {
   "key": "b13fc59a3ed3",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「저야말로 오랜만이네요.\n⟦P⟧음…\n⟦2⟧페타니⟦3⟧ 여관에서 만났던\n분들이시죠?\n⟦P⟧"
  },
  {
   "key": "e86187df251d",
   "speaker_korean": null,
   "korean": "네가 엉터리로 가르쳐준 탓에\n우리가 이런 델 오게\n됐단 말이야~.\n그거 알고는 있어?\n⟦P⟧"
  },
  {
   "key": "ad8bedadb8a9",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「그래~, 거짓말쟁이 씨♥\n⟦P⟧"
  },
  {
   "key": "294024657c91",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「⟦2⟧루미나 님⟦3⟧,\n그런 말투는 실례입니다.\n⟦P⟧"
  },
  {
   "key": "f70fda6d487a",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「별로 상관없잖아!?\n그 얘기 자체에 불만이\n있는 것도 아니고…\n⟦P⟧난 그냥 오빠한테\n사실을 사실대로 말해줬을 뿐이야.\n⟦P⟧"
  },
  {
   "key": "1e8d1ed8d2e4",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「하하, 미안 미안.\n나도 이 근처 지리는\n잘 모르거든…\n⟦P⟧"
  },
  {
   "key": "ca6e5d0a307a",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「음, 아까도 말했지만,\n그 일에 대해선 진짜 전혀\n신경 안 쓰니까.\n⟦P⟧애초에 억지로 물어본 건\n이쪽이었잖아…\n⟦P⟧"
  },
  {
   "key": "a116b73adcb0",
   "speaker_korean": null,
   "korean": "모처럼 여기까지 왔으니까\n한동안 여기서 가게를\n열어볼까 하는 얘기까지 했다고.\n그치! ⟦1⟧라돌⟦2⟧!\n⟦P⟧"
  },
  {
   "key": "321076271f96",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「예, 뭐…\n이것도 무슨 인연인가\n싶어서요.\n⟦P⟧"
  },
  {
   "key": "5fe395aa3f17",
   "speaker_korean": null,
   "korean": "아, 잠깐!\n그래도 조금은 미안하면\n모처럼이니까 뭐라도 사 가.\n⟦P⟧희귀한 물건이 적당한 값에 있고\n절대 손해는 안 보게 할 테니까.\n응♪\n⟦P⟧"
  },
  {
   "key": "dc53c690ad07",
   "speaker_korean": null,
   "korean": "알았어.\n그럼 물건 좀\n보여줄래?\n⟦P⟧이 정도로 죗값이\n된다면 얼마든지\n사 줄게.\n⟦P⟧"
  },
  {
   "key": "dd5809fcb2e5",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「네~, 매번 감사합니다♪\n손님 안내해 드릴게요~!\n⟦P⟧"
  },
  {
   "key": "d64a23634aa5",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「참, 귀여운데도\n야무지네.\n⟦P⟧"
  },
  {
   "key": "1d21a1483b19",
   "speaker_korean": "여행자 라돌",
   "korean": "⟦1⟧「그런 문제가\n아닙니다.\n⟦P⟧"
  },
  {
   "key": "134b017f5f32",
   "speaker_korean": "말괄량이 루미나",
   "korean": "⟦1⟧「그런 거니까 너는\n아무것도 신경 안 써도 돼.\n⟦P⟧"
  },
  {
   "key": "d29d76fafac9",
   "speaker_korean": null,
   "korean": "여행 중입니다.\n언젠가 돌아올 거예요.\n⟦P⟧"
  },
  {
   "key": "7f44019aa49d",
   "speaker_korean": null,
   "korean": "어서 오세요.\n옆집에 없는 물건은 이쪽으로 오세요.\n반드시 바로 구해다 드립니다.\n⟦P⟧"
  },
  {
   "key": "09c41967214c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭐야, 이건?\n⟦P⟧"
  },
  {
   "key": "f3af69d94813",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「⟦2⟧기술국가 구리텐⟦3⟧이 자랑하는\n전투 인형이야.\n⟦P⟧"
  },
  {
   "key": "97f400f3f99c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧구리텐⟦3⟧의?\n⟦P⟧"
  },
  {
   "key": "025d4ba05d88",
   "speaker_korean": null,
   "korean": "하기야…\n그 전설이 어디까지 사실인지는\n나도 모르지만.\n⟦P⟧"
  },
  {
   "key": "47ce7608bc33",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「그래.\n옛날, 이 땅에 존재했던\n⟦2⟧고대왕국 시포트⟦3⟧를 멸망으로 몰아넣은\n태고의 전투병기야.\n⟦P⟧강철로 된 그 몸은 어떤 칼날도\n튕겨내고, 양팔에서는 천둥을 동반한\n화염을 내뿜었다고 전해지고 있어.\n⟦P⟧"
  },
  {
   "key": "9b35d1b80b2e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(로봇처럼 보이기도 하는데,\n동력 자체는 ⟦2⟧문장력⟦3⟧을 쓰고\n있는 것 같군…\n⟦P⟧하지만 자율 행동이 아니라 조종사가\n움직이는 타입이라 해도,\n두 다리로 동적 보행을 하려면\n상당한 기술이 필요할 텐데…\n⟦P⟧"
  },
  {
   "key": "01edca0fdede",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(그럼 그 ⟦2⟧구리텐⟦3⟧이란 나라는,\n지구로 치면 20~21세기 정도의\n문명을 가지고 있다는 건가…\n⟦P⟧⟦4⟧시술⟦5⟧이며 이 기계며,\n⟦6⟧미개발 행성⟦7⟧이 아니라 감시행성이 돼도\n이상하지 않을 수준이잖아.\n⟦P⟧"
  },
  {
   "key": "2b1f6591808f",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「무슨 일이야?\n⟦2⟧페이트⟦3⟧?\n⟦P⟧"
  },
  {
   "key": "51bc8e8900b4",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아니, 별거 아니야.\n그냥 호기심이야.\n⟦P⟧"
  },
  {
   "key": "8ff3a640cd3d",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「뭐냐니…\n너희 ⟦2⟧기술국가 구리텐⟦3⟧이\n자랑하는 전투 인형이잖아?\n⟦P⟧"
  },
  {
   "key": "a83fc6b8ccd7",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「엣!?\n⟦2⟧구리텐⟦3⟧의?\n⟦P⟧"
  },
  {
   "key": "5def4d792a6b",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「뭐야, 몰랐던 거야?\n옛날, 이 땅에 존재했던\n⟦2⟧고대왕국 시포트⟦3⟧를 멸망으로 몰아넣은\n태고의 전투병기가 바로 이거야.\n⟦P⟧"
  },
  {
   "key": "8e040ea256f5",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(그럼 그 ⟦2⟧구리텐⟦3⟧이란 나라는,\n⟦4⟧지구⟦5⟧로 치면 20~21세기 정도의\n문명을 가지고 있다는 건가…\n⟦P⟧이 ⟦6⟧구리텐⟦7⟧이라는 나라 사람들과\n잘 접촉할 수만 있다면, ⟦8⟧통신기⟦9⟧의\n동력은 어떻게든 될지도 모르겠군…\n생각해 두자.\n⟦P⟧"
  },
  {
   "key": "bce4e92b32cb",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「근데 ⟦2⟧구리텐⟦3⟧ 사람이면서\n이걸 모른다니 말이야.\n너희들 이민자나 뭐 그런 거야?\n⟦P⟧"
  },
  {
   "key": "63ae7e2de6ed",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「엇?! 아, 아아, 그래.\n나랑 ⟦2⟧클리프⟦3⟧ 둘 다\n원래는 이민자야.\n⟦P⟧그래서 역사 같은 건\n잘 모르거든.\n⟦P⟧"
  },
  {
   "key": "90846e7fb8dc",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「흐음, 그렇단 말이지.\n뭐, 그 나라 토착종인 ⟦2⟧안프록⟦3⟧과\n다른 종족들 사이에 이런저런 문제가\n있다고 들었으니까.\n⟦P⟧네 아버지가 납치됐다는 것도\n대체로 그거랑 관련 있는 거겠지?\n⟦P⟧"
  },
  {
   "key": "0b21a9db6c2e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭐, 그런 셈이야.\n대충 그런 거야.\n⟦P⟧"
  },
  {
   "key": "dfc6e9d4cc95",
   "speaker_korean": null,
   "korean": "⟦1⟧기공병단⟦2⟧이라 불리며 두렵던\n⟦3⟧기술국가 구리텐⟦4⟧의 전투병기가\n변해버린 잔해다.\n⟦P⟧"
  },
  {
   "key": "55957aa0cb65",
   "speaker_korean": null,
   "korean": "이제 이걸 만질 생각하니\n군침이 도는구먼.\n⟦P⟧"
  },
  {
   "key": "40661d6e6320",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「으엑…\n무슨 더러운 소릴 하는 거야.\n이 변태 아저씨!\n⟦P⟧"
  },
  {
   "key": "1940003e0fcb",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「뭐라고!\n너 같은 계집애가 내가 계속 좇아온\n사내의 로망을 알 리가 있나!\n⟦P⟧"
  },
  {
   "key": "5228f4b8194b",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「꺄악!\n즙이! 즙이 튀었어!\n⟦P⟧얼굴 썩겠어!\n나한테서 3미터 안으로는\n다가오지 마!\n⟦P⟧"
  },
  {
   "key": "75ff613316e3",
   "speaker_korean": null,
   "korean": "퉤퉤퉤퉤퉤퉤!\n⟦P⟧"
  },
  {
   "key": "c704627efbaa",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「무슨 짓이야!\n열받네!\n⟦P⟧"
  },
  {
   "key": "df225d92dcae",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「어이구.\n아무래도 두 사람 다 바쁜 것\n같으니 나 혼자 만져볼까.\n⟦P⟧"
  },
  {
   "key": "fb03821ba01a",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「허…\n이게 그거구나.\n⟦P⟧"
  },
  {
   "key": "aa4f7e893e4a",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「확실히…\n꽤 흥미로운 물건이네.\n⟦P⟧"
  },
  {
   "key": "b73a426c25b5",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「장난하지 마~!"
  },
  {
   "key": "a908c225ce90",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「장난하지 마~!"
  },
  {
   "key": "cb3fee6962cf",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「후히히히…\n언제 봐도 훌륭한 색과 윤기로군.\n⟦P⟧"
  },
  {
   "key": "763af2670fcf",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「시끄럽다!\n너 같은 녀석한텐\n이렇게 해주마.\n⟦P⟧"
  },
  {
   "key": "c46f4b8484ca",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「흐음.\n이건 제법…\n⟦P⟧"
  },
  {
   "key": "01c0cdbb03a5",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「드릴~, 드릴~.\n역시 로봇 하면 이거지.\n⟦P⟧"
  },
  {
   "key": "7083b40cd874",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「몇 년 전 얘기냐~!\n요즘 세상에 그런 불편한\n걸 달지 마~!\n⟦P⟧"
  },
  {
   "key": "c359740623cc",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「시끄러워!\n2미터 안으로 들어오지 마\n이 반편아!\n⟦P⟧"
  },
  {
   "key": "1091de067612",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「뭐, 뭐라고~!\n⟦P⟧"
  },
  {
   "key": "4c5cc9bef51a",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「그렇군, 그렇군…\n그럼 여길 이렇게 해볼까.\n⟦P⟧"
  },
  {
   "key": "d5dd6adf6c07",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「라저!\n⟦P⟧"
  },
  {
   "key": "a8f998c0bede",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「한 번 죽어봐!\n⟦P⟧"
  },
  {
   "key": "fb87a2390c93",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「그건 좀…\n동정은 못 하겠는걸~.\n⟦P⟧"
  },
  {
   "key": "30ae8c25453b",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「어라?! 그거 뭐야?\n아~~~아!!\n⟦P⟧태워버려~, ⟦2⟧바닐라⟦3⟧!!\n⟦P⟧"
  },
  {
   "key": "e712a57c4ab3",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「우오오~!!\n내 비장의 메이드복이~!\n⟦P⟧"
  },
  {
   "key": "39b93af0aa24",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「로봇 메이드의 꿈이…\n내 로망이…\n⟦P⟧"
  },
  {
   "key": "b932fe040cca",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「내 꿈이, 야망이…\n재가 되어버렸구나~.\n⟦P⟧"
  },
  {
   "key": "a581f97ef732",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「시끄러워!\n그 정도로 어른이 왜 울고불고야.\n액체 흘리지 마!\n⟦P⟧"
  },
  {
   "key": "9ea4957e96ce",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「우오오~!\n우옷, 흣, 끄흑…\n⟦P⟧"
  },
  {
   "key": "deecb98e718d",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「뭔가 진짜 우는 것 같은데.\n메릴 씨.\n⟦P⟧"
  },
  {
   "key": "603f92bb3c47",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「거짓말!? 소름 끼쳐!!\n⟦P⟧"
  }
 ]
