{
 "batch_id": "batch_0017",
 "translations": [
  {
   "key": "b55772ba2db6",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「이 별의 녀석들도 제법 하는걸.\n체력에 ⟦2⟧문장력⟦3⟧….\n아 참, 여기서는 ⟦4⟧시술력⟦5⟧이었나.\n⟦P⟧둘 다 종족적으로는 상당히 높은\n수준의 소양을 갖고 있단 말이지.\n이 정도 종족이 어째서 또 요만한\n문명 수준밖에 유지 못 하는 건지….\n⟦P⟧"
  },
  {
   "key": "cad0865fcacd",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「아리그리프군은 본격적으로 ⟦2⟧아리아스⟦3⟧\n점령을 위해 움직이기 시작한 모양이야.\n⟦P⟧이렇게 된 이상 이제 한시도\n지체할 수 없어.\n서둘러 ⟦4⟧시랜드 마을⟦5⟧로 가야겠어.\n⟦P⟧"
  },
  {
   "key": "48252cc35a16",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「⟦2⟧베크렐 광산⟦3⟧은 이 마을 북문에서\n갈 수 있어.\n한숨 돌리고 나면 출발할 거야.\n⟦P⟧"
  },
  {
   "key": "a0ef4f4a5dd9",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「영내에서 이렇게 제멋대로 당하고 있는데도\n⟦2⟧월터⟦3⟧ 그자는 ⟦4⟧풍뢰⟦5⟧를 움직이려고도\n하질 않아….\n⟦P⟧그 능구렁이 영감.\n대체 무슨 꿍꿍이를 꾸미고 있는 건지.\n⟦P⟧"
  },
  {
   "key": "63506a36a3e1",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「⟦2⟧아리그리프⟦3⟧ 쪽도\n꽤나 혼란스러운 모양이야.\n⟦P⟧뭐, 저런 걸 갑자기\n눈앞에서 보게 됐으니\n당연하다면 당연한\n일이지만 말이야….\n⟦P⟧"
  },
  {
   "key": "12d062c401e9",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「아무튼 지금은 시간이 중요해.\n이 마을에 오래 머물러 있을\n여유는 없어.\n⟦P⟧"
  },
  {
   "key": "5e3a156818fc",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「세계는 저렇게나 넓은데,\n우리는 이 작은 별의\n작은 대륙 위에서 다투고 있으니….\n⟦P⟧정말 부끄러운 이야기지.\n⟦P⟧"
  },
  {
   "key": "61b01d33fe40",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「밤하늘에 보이는 별들까지 아우른\n이 세상의 위기라….\n⟦P⟧왠지 스케일이 점점\n커져만 가네.\n⟦P⟧"
  },
  {
   "key": "022cca11c5de",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「그렇지만….\n설마 이 내가 당신들한테 도움을 받게\n될 줄은 생각도 못 했어.\n⟦P⟧"
  },
  {
   "key": "8686b05540cd",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어째서라니….\n그야….\n⟦P⟧"
  },
  {
   "key": "85e579fbaebb",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「쳇….\n마음대로 해!\n⟦P⟧"
  },
  {
   "key": "970898b1b64c",
   "speaker_korean": "넬",
   "korean": "⟦1⟧「잘 들어, ⟦2⟧페이트⟦3⟧.\n⟦P⟧내가 당신들을 구해 낸 건,\n당신들이라면 ⟦4⟧성왕국 시하츠⟦5⟧를\n구할 수 있다고 생각했기 때문이야.\n⟦P⟧"
  },
  {
   "key": "dc75059fdfca",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「뭐, 그야 그렇지.\n⟦P⟧"
  },
  {
   "key": "4a3369aa5455",
   "speaker_korean": "클리프",
   "korean": "⟦1⟧「무리해서 도망쳐 봤자\n갈 데도 없으니까 말이야.\n⟦P⟧지금은 순순히\n믿어 주는 대로 있자고.\n⟦P⟧"
  },
  {
   "key": "b59307a4d02a",
   "speaker_korean": "아드레이",
   "korean": "⟦1⟧「⟦2⟧월터 영감⟦3⟧은 아직 살아\n있는 모양이구먼.\n⟦P⟧그자의 몸이 성할 때 결판을\n지어 주고 싶네만, 매번 매번\n요리조리 잘도 빠져나가서 말이지…\n치사한 놈 같으니.\n⟦P⟧"
  },
  {
   "key": "e3e0347b5f25",
   "speaker_korean": "넬",
   "korean": "「잠깐 나갔다 올게."
  },
  {
   "key": "40240804f1ac",
   "speaker_korean": "클리프",
   "korean": "「어딜 가는 건데?"
  },
  {
   "key": "071aa9b28f45",
   "speaker_korean": "넬",
   "korean": "「주변 상황을 살펴보고 올 뿐이야.\n뭐, 금방 돌아올 거야."
  },
  {
   "key": "ef277f5dd59d",
   "speaker_korean": "클리프",
   "korean": "「그렇군.\n그래도 우리끼리만 놔둬도 되는 거냐?\n도망쳐 버릴지도 모른다고?"
  },
  {
   "key": "76d5b1aa35a2",
   "speaker_korean": "넬",
   "korean": "「그건 걱정 없어.\n당신들은 멋대로 도망치지 않아.\n믿고 있다고."
  },
  {
   "key": "83f4ced4c25a",
   "speaker_korean": "클리프",
   "korean": "「그런 말을 들으면\n도망칠 수가 없잖냐."
  },
  {
   "key": "21301e13f5d7",
   "speaker_korean": "넬",
   "korean": "「후후."
  },
  {
   "key": "a9c8b918fc60",
   "speaker_korean": "넬",
   "korean": "「다만, 나다니는 건 좋지만 마을 밖으로는\n나가지 말도록 해.\n그리고 눈에 띄는 행동은 하지 말 것.\n여긴 아직 아리그리프 영내니까 말이야.\n어디에 적이 숨어 있을지 모른다고."
  },
  {
   "key": "ae126c8cc9fb",
   "speaker_korean": "클리프",
   "korean": "「알았다."
  },
  {
   "key": "387e44090b86",
   "speaker_korean": "페이트",
   "korean": "「알겠습니다."
  },
  {
   "key": "1d766fea3cfb",
   "speaker_korean": "넬",
   "korean": "「다녀올게."
  },
  {
   "key": "cd94a19664cb",
   "speaker_korean": "클리프",
   "korean": "「너는 어쩔 거냐?"
  },
  {
   "key": "179caadfe263",
   "speaker_korean": "페이트",
   "korean": "「너야말로 어쩔 건데?"
  },
  {
   "key": "15b263200432",
   "speaker_korean": "클리프",
   "korean": "「눈에 띄지 말라는 건 나한테는\n나다니지 말라는 거나 마찬가지니까.\n따분하겠지만 여기서 얌전히 있으마."
  },
  {
   "key": "288c4dcf8e72",
   "speaker_korean": "페이트",
   "korean": "「나는 기분 전환 삼아 이 근처를\n좀 걷다 올게."
  },
  {
   "key": "c3fac9b82c49",
   "speaker_korean": "클리프",
   "korean": "「그래, 그래도 조심하라고.\n그 녀석도 말했다만 여긴 아직 적국이니까."
  },
  {
   "key": "b003713acd34",
   "speaker_korean": "페이트",
   "korean": "「응, 알고 있어."
  },
  {
   "key": "34b89c65e0b9",
   "speaker_korean": "클리프",
   "korean": "「어이, 돌아왔나… 했더니,\n뭐야, 같이 있었던 거냐."
  },
  {
   "key": "bb5b75ac0bf1",
   "speaker_korean": "페이트",
   "korean": "「입구에서 마주쳤거든."
  },
  {
   "key": "872a4f51a1ff",
   "speaker_korean": "넬",
   "korean": "「그런 거지."
  },
  {
   "key": "223a5cd4229b",
   "speaker_korean": "클리프",
   "korean": "「그렇군."
  },
  {
   "key": "1e9776ba063a",
   "speaker_korean": "넬",
   "korean": "「오늘은 이만 쉬는 게 좋겠어.\n내일은 ⟦1⟧컬소어 산 동굴⟦2⟧을 지날 거야."
  },
  {
   "key": "43bb9a5a0a81",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧컬소어 산 동굴⟦2⟧?"
  },
  {
   "key": "d8bb45a5e773",
   "speaker_korean": "넬",
   "korean": "「이 마을 북쪽에 있는 갱도야.\n거길 지나서 ⟦1⟧아리아스⟦2⟧로 가는 거지.\n원래는 동쪽 황야를\n가로질러 가는 게 더 빠르지만,\n그쪽은 매복이 있을 가능성도\n부정할 수 없으니까."
  },
  {
   "key": "c4af644c86b3",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧컬소어 산 동굴⟦2⟧은\n괜찮은 건가요?"
  },
  {
   "key": "d10769c4613f",
   "speaker_korean": "넬",
   "korean": "「적어도\n아리그리프 병사는 없어."
  },
  {
   "key": "258bed45a847",
   "speaker_korean": "클리프",
   "korean": "「왠지 좀 걸리는\n말투잖냐, 어이."
  },
  {
   "key": "e5e5e881d282",
   "speaker_korean": "넬",
   "korean": "「그래. 갱도에는 야생 마물이\n눌러살고 있으니까.\n반드시 안전하다는 건 아니야."
  },
  {
   "key": "48509b0bfda5",
   "speaker_korean": "클리프",
   "korean": "「그렇단 말이지."
  },
  {
   "key": "66a952f1e930",
   "speaker_korean": "넬",
   "korean": "「뭐, 그쪽이 그나마 낫다는 거지.\n알았으면 얼른 자 두라고.\n내일은 아침 일찍 출발할 거야."
  },
  {
   "key": "cb796693e552",
   "speaker_korean": "클리프",
   "korean": "「…알았다고."
  },
  {
   "key": "76e4ace571fc",
   "speaker_korean": "페이트",
   "korean": "「저기, ⟦1⟧넬 씨⟦2⟧."
  },
  {
   "key": "37b003f64e28",
   "speaker_korean": "넬",
   "korean": "「무슨 일이야?"
  },
  {
   "key": "fecd6926873b",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧타이네브 씨⟦2⟧랑 ⟦3⟧파린 씨⟦4⟧,\n무사히 도망쳤을까요?"
  },
  {
   "key": "ef72d3a9a973",
   "speaker_korean": "넬",
   "korean": "「괜찮아.\n그 아이들은 그렇게 약하지 않아.\n…그러기 위한 훈련도 쌓아 왔으니까."
  },
  {
   "key": "29425938d907",
   "speaker_korean": "페이트",
   "korean": "「그렇다면 다행이지만요…."
  },
  {
   "key": "35ee65dc1b03",
   "speaker_korean": "넬",
   "korean": "「자, 어서 준비해.\n추격대가 코앞까지 와 있으니까."
  },
  {
   "key": "0f84b2b2248d",
   "speaker_korean": "클리프",
   "korean": "「예예."
  },
  {
   "key": "8969ab8213cb",
   "speaker_korean": "페이트",
   "korean": "「응, 괜찮아.\n아마 피로가 쌓여 있었나 봐."
  },
  {
   "key": "31bc39510e04",
   "speaker_korean": "클리프",
   "korean": "「그러냐…….\n뭐, 그럼 됐다만."
  },
  {
   "key": "353301a4402b",
   "speaker_korean": "페이트",
   "korean": "「걱정 끼쳤네."
  },
  {
   "key": "b98cf1c80978",
   "speaker_korean": "클리프",
   "korean": "「뭐, 문제없다면 됐어.\n신경 쓰지 마라."
  },
  {
   "key": "464f3c23da59",
   "speaker_korean": "넬",
   "korean": "「곧 날이 저물겠어…."
  },
  {
   "key": "6cb5cb288a19",
   "speaker_korean": "클리프",
   "korean": "「그러고 보니, 너…\n몸 상태는 괜찮냐?"
  }
 ]
}