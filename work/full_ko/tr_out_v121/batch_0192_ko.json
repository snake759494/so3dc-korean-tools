{
 "batch_id": "batch_0192",
 "translations": [
  {
   "key": "487dc1c16510",
   "speaker_korean": "페이트",
   "korean": "「샘물이 콸콸\n솟아나고 있군"
  },
  {
   "key": "157741aea5f8",
   "speaker_korean": "페이트",
   "korean": "「샘물이 부글부글 끓고 있군"
  },
  {
   "key": "731af77c6630",
   "speaker_korean": "페이트",
   "korean": "「샘물이 반짝반짝\n빛나고 있군"
  },
  {
   "key": "13f225855c74",
   "speaker_korean": null,
   "korean": "⟦1⟧・샘물 긷기"
  },
  {
   "key": "2e313a42d875",
   "speaker_korean": null,
   "korean": "⟦1⟧・안 함"
  },
  {
   "key": "0c1232b1b6b3",
   "speaker_korean": "페이트",
   "korean": "「샘물을 손에 넣었어"
  },
  {
   "key": "b8f872bb137b",
   "speaker_korean": "페이트",
   "korean": "「샘물은 이미\n손에 넣었어"
  },
  {
   "key": "511cec9b23d1",
   "speaker_korean": "페이트",
   "korean": "「샘물을 바꿔 담았어"
  },
  {
   "key": "771f5e11e648",
   "speaker_korean": null,
   "korean": "⟦1⟧・샘물 갈아 담기"
  },
  {
   "key": "13bb1a65cb94",
   "speaker_korean": "요정",
   "korean": "「미안해~\n난 이 숲을 벗어날 수 없거든\n⟦P⟧너희랑 만났던 곳에서\n기다리고 있을 테니까\n그럼 안녕~"
  },
  {
   "key": "b4aefed63a2b",
   "speaker_korean": "페이트",
   "korean": "「이제 샘물은\n필요 없을 것 같군"
  },
  {
   "key": "4ef67bc81bb5",
   "speaker_korean": "페이트",
   "korean": "「샘물은 이미 손에 넣었어\n그냥 평범한 물이야"
  },
  {
   "key": "be68d93ec8ed",
   "speaker_korean": "페이트",
   "korean": "「샘물은 이미 손에 넣었어\n부글부글 끓는 물이야"
  },
  {
   "key": "2f68b9f99a28",
   "speaker_korean": "페이트",
   "korean": "「샘물은 이미 손에 넣었어\n반짝반짝 빛나는 물이야"
  },
  {
   "key": "2ffe4b88f34a",
   "speaker_korean": "요정",
   "korean": "「이 고목,\n몬스터가 둔갑한 거야!"
  },
  {
   "key": "8d30eb9bd0aa",
   "speaker_korean": "페이트",
   "korean": "「…요정!?"
  },
  {
   "key": "b1d97bdcb815",
   "speaker_korean": "넬",
   "korean": "「나도 처음 보는군\n신기하네"
  },
  {
   "key": "66a8fa47f0d4",
   "speaker_korean": "요정",
   "korean": "「…"
  },
  {
   "key": "8b788f76e8ad",
   "speaker_korean": "요정",
   "korean": "「…분명 이 녀석들한테\n잡아먹히고 말 거야"
  },
  {
   "key": "8debc1ef2762",
   "speaker_korean": "클리프",
   "korean": "「야!\n왜 날 쳐다보는 거야!?\n⟦P⟧난 벌레 먹는 취미는\n없다고!"
  },
  {
   "key": "89559129d459",
   "speaker_korean": "요정",
   "korean": "「실례네!\n난 벌레가 아니야!"
  },
  {
   "key": "ebc3f4420ff6",
   "speaker_korean": "페이트",
   "korean": "「어디 몸이 안 좋은 거야?"
  },
  {
   "key": "bbcc87abebd6",
   "speaker_korean": "요정",
   "korean": "「산꼭대기 안개를 맞아서…\n샘물만 있으면,\n기운 차릴 텐데…"
  },
  {
   "key": "c5c940cab0c2",
   "speaker_korean": "페이트",
   "korean": "「알겠어\n찾아다 줄게"
  },
  {
   "key": "44c77c88f50b",
   "speaker_korean": "페이트",
   "korean": "「자, 샘물이야"
  },
  {
   "key": "b0f459294775",
   "speaker_korean": "요정",
   "korean": "「꿀꺽, 꿀꺽…"
  },
  {
   "key": "0d005115d672",
   "speaker_korean": "요정",
   "korean": "「뜨거, 뜨거워!!\n⟦P⟧너!\n날 죽일 셈이야!?"
  },
  {
   "key": "bbf295021a62",
   "speaker_korean": "페이트",
   "korean": "「미, 미안!\n다시 한번 떠 올게"
  },
  {
   "key": "4a21628b2e22",
   "speaker_korean": "요정",
   "korean": "「이건… 그냥 물이잖아\n이걸론 안 돼…"
  },
  {
   "key": "debf82cdcdb9",
   "speaker_korean": "요정",
   "korean": "「으음…\n아깝다! 진짜 아깝네~\n괜찮은 선까진 갔는데 말이야\n조금 다른가 봐"
  },
  {
   "key": "ebb010a4d8f7",
   "speaker_korean": "요정",
   "korean": "「후… 살았다\n⟦P⟧고마워. 답례로 좋은 걸\n알려줄게"
  },
  {
   "key": "cd987ab357aa",
   "speaker_korean": "요정",
   "korean": "「숲속에 나무로 둔갑한 몬스터가\n있는 거, 알고 있어?\n그 몬스터가 가는 길을\n막고 있거든"
  },
  {
   "key": "4f8822b0299d",
   "speaker_korean": "페이트",
   "korean": "「그렇구나…\n그럼 어떻게 하면 돼?"
  },
  {
   "key": "6264e43a944b",
   "speaker_korean": "클리프",
   "korean": "「태워버릴까"
  },
  {
   "key": "aca2621c485e",
   "speaker_korean": "요정",
   "korean": "「그만해, 바보야!!"
  },
  {
   "key": "9291b573eac6",
   "speaker_korean": "요정",
   "korean": "「답례로 내가 따라가 줄게\n내 눈은 못 속이니까\n퇴치는 맡길게?"
  },
  {
   "key": "af7e454302a9",
   "speaker_korean": null,
   "korean": "요정이 동료가 됐다"
  },
  {
   "key": "4d51c16665a6",
   "speaker_korean": "페이트",
   "korean": "(뭐가 아깝다는 거지?"
  },
  {
   "key": "f1eac5cbe360",
   "speaker_korean": "요정",
   "korean": "「아, 왔다 왔어\n⟦P⟧또 따라가\n줄게"
  },
  {
   "key": "af29df17033e",
   "speaker_korean": "요정",
   "korean": "「…결국 나도\n끝인가 보네"
  }
 ]
}