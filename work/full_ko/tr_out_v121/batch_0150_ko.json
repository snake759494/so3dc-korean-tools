{
 "batch_id": "batch_0150",
 "translations": [
  {
   "key": "68cf2971336a",
   "speaker_korean": null,
   "korean": "⟦1⟧・태워달라기"
  },
  {
   "key": "52024796e8b1",
   "speaker_korean": "질풍",
   "korean": "「또 언제든지\n불러줘라!"
  },
  {
   "key": "6c9bf72b40b4",
   "speaker_korean": "질풍",
   "korean": "「어이!\n⟦1⟧알벨⟦2⟧ 나리한테\n부탁받았는데,\n⟦3⟧베크렐 광산⟦4⟧ 근처까지 데려다주마!"
  },
  {
   "key": "81333b3a7596",
   "speaker_korean": "질풍",
   "korean": "「언제든지 데려다줄 테니까!\n편하게 불러줘라!"
  },
  {
   "key": "f73acdb180cf",
   "speaker_korean": "추워 보이는 차림의 여성",
   "korean": "「⟦1⟧넬 님⟦2⟧!"
  },
  {
   "key": "b89da0e84611",
   "speaker_korean": "추워 보이는 차림의 여성",
   "korean": "「준비는 되어 있습니다.\n지금 당장이라도 출발할 수 있습니다!"
  },
  {
   "key": "0501936b09e8",
   "speaker_korean": "넬",
   "korean": "「수고했어, ⟦1⟧타이네브⟦2⟧."
  },
  {
   "key": "e42302c08dc9",
   "speaker_korean": "타이네브",
   "korean": "「아닙니다.\n무사하시니 다행입니다."
  },
  {
   "key": "89a1b39f336f",
   "speaker_korean": "더 추워 보이는 여성",
   "korean": "「이분들인가요~?"
  },
  {
   "key": "90248fceb585",
   "speaker_korean": "넬",
   "korean": "「맞아, ⟦1⟧파린⟦2⟧.\n예상대로 ⟦3⟧구리텐⟦4⟧의 기술자였어."
  },
  {
   "key": "1eabc2112b75",
   "speaker_korean": "파린",
   "korean": "「해냈다!\n이걸로 완성되겠네요!!"
  },
  {
   "key": "342ec73743de",
   "speaker_korean": "타이네브",
   "korean": "「역시, 그랬군요."
  },
  {
   "key": "4c651c0228c5",
   "speaker_korean": "타이네브",
   "korean": "「넷!!"
  },
  {
   "key": "0c701106379d",
   "speaker_korean": "파린",
   "korean": "「네~!!"
  },
  {
   "key": "6dabf9f80003",
   "speaker_korean": "넬",
   "korean": "「마차에 타.\n바로 출발할 거야."
  },
  {
   "key": "1aa85fddfc95",
   "speaker_korean": "더 추워 보이는 여성",
   "korean": "「⟦1⟧넬 님~⟦2⟧!!"
  },
  {
   "key": "b1994a741815",
   "speaker_korean": "넬",
   "korean": "「기다리게 했네."
  },
  {
   "key": "718ea16907b0",
   "speaker_korean": "넬",
   "korean": "「그래, 맞아.\n하지만 지금은 한가하게 얘기나\n하고 있을 때가 아니야.\n…서둘러 출발할 거야.\n곧 추격자가 올 거야.\n⟦1⟧질풍⟦2⟧이라도 나오면 곤란하니까.\n자, 서둘러!!"
  },
  {
   "key": "da024ad675ef",
   "speaker_korean": "넬",
   "korean": "「역시 나왔군… ⟦1⟧질풍⟦2⟧ 녀석들."
  },
  {
   "key": "54fc49fb49c0",
   "speaker_korean": "클리프",
   "korean": "「저게 ⟦1⟧질풍⟦2⟧이냐?"
  },
  {
   "key": "aee275294a44",
   "speaker_korean": "페이트",
   "korean": "「엇…?"
  },
  {
   "key": "8930247d07d9",
   "speaker_korean": "넬",
   "korean": "「그게 그녀들의 임무야.\n그녀들도 각오하고 있는 거야."
  },
  {
   "key": "f7fbdbc1a247",
   "speaker_korean": "넬",
   "korean": "「만약 나라도 동료의 발목을\n잡는 상황이 되면, 망설임 없이\n버려지고 말겠지.\n우리 일이라는 게\n원래 그런 거야."
  },
  {
   "key": "54dc820e57d6",
   "speaker_korean": "페이트",
   "korean": "「그렇대…"
  },
  {
   "key": "aa42ab2b48bd",
   "speaker_korean": "클리프",
   "korean": "「협력할지 말지는 너한테 맡기겠지만,\n적어도 이런 곳에서 입씨름하는 건\n그만둬라.\n일단 좀 더 안전한 곳으로\n이동하자고."
  },
  {
   "key": "3cfd29a927a3",
   "speaker_korean": "클리프",
   "korean": "「시하츠 영지까지\n가면 좀 안전해지는 거지?"
  },
  {
   "key": "f324bf29d24b",
   "speaker_korean": "넬",
   "korean": "「그래, 그건 보장하지."
  },
  {
   "key": "e2d7802055ec",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧타이네브 일행⟦2⟧의 노력을 헛되이\n만들 셈이냐?\n목적이야 어쨌든, 적어도 그들은,\n여기서 우리를 죽게 하지 않으려고\n목숨을 걸고 있는 거라고."
  },
  {
   "key": "29b9064689c3",
   "speaker_korean": "페이트",
   "korean": "「하지만……"
  },
  {
   "key": "81b89005c5b2",
   "speaker_korean": "페이트",
   "korean": "「……알았어요."
  },
  {
   "key": "0d57a2102e5c",
   "speaker_korean": "페이트",
   "korean": "「게다가 ⟦1⟧타이네브 씨네⟦2⟧를\n내버려 둬도 되는 건가요!?\n저런 용기사들에게 쫓기면\n도망칠 수 있을지――."
  },
  {
   "key": "39fcb5648137",
   "speaker_korean": "넬",
   "korean": "「가자. 놈들을 ⟦1⟧타이네브 일행⟦2⟧이\n붙잡아 두는 사이에,\n⟦3⟧컬소어⟦4⟧를 지나 시하츠 영지로 들어간다."
  },
  {
   "key": "0aa9071af33d",
   "speaker_korean": "넬",
   "korean": "「가자."
  },
  {
   "key": "06c7245200a9",
   "speaker_korean": "넬",
   "korean": "「맞아.\n⟦1⟧아리그리프⟦2⟧ 자랑의 3군 중 하나, 『⟦3⟧질풍⟦4⟧』.\n⟦5⟧에어드래곤⟦6⟧을 모는 용기사단이야.\n⟦P⟧성가신 놈들이지."
  },
  {
   "key": "54a3bbbcaf2a",
   "speaker_korean": "넬",
   "korean": "「그래, 붙잡힐 가능성은\n상당히 높겠지.\n하지만 그건 어쩔 수 없는 일이야."
  },
  {
   "key": "fa61d00ab2ed",
   "speaker_korean": "클리프",
   "korean": "「그렇다는군.\n그렇다면, 거기까지 가서\n결판을 내면 되잖아… 안 그래?"
  },
  {
   "key": "e1820a5f18e1",
   "speaker_korean": null,
   "korean": "놈들이 얼마나 당신들을\n중요하게 여기는지 알 만하지."
  },
  {
   "key": "fe58d8b2749b",
   "speaker_korean": "페이트",
   "korean": "「잠깐, 기다려 주세요.\n저는 아직 협력한다고\n말한 적 없어요."
  },
  {
   "key": "4a493be8f15f",
   "speaker_korean": "페이트",
   "korean": "「임무…임무라니!\n당신은!!"
  },
  {
   "key": "1bafa2b36c0b",
   "speaker_korean": "클리프",
   "korean": "「어이, ⟦1⟧페이트⟦2⟧.\n닥쳐."
  },
  {
   "key": "dec634f98d24",
   "speaker_korean": "페이트",
   "korean": "「아, 아니… 그냥 좀 어지러워서\n그런 거니까…"
  },
  {
   "key": "ab8650b07fd6",
   "speaker_korean": "클리프",
   "korean": "「……."
  },
  {
   "key": "a136ad00577e",
   "speaker_korean": "페이트",
   "korean": "「…괜찮아요.\n무시하지 마세요."
  },
  {
   "key": "5fa8ed76bed5",
   "speaker_korean": "페이트",
   "korean": "「크…으윽……."
  },
  {
   "key": "c4afef94ab0a",
   "speaker_korean": "넬",
   "korean": "「왜 그래?"
  },
  {
   "key": "7c591dfab748",
   "speaker_korean": "페이트",
   "korean": "「윽………."
  },
  {
   "key": "e3bd4c306e14",
   "speaker_korean": "넬",
   "korean": "「조금만 더 가면 ⟦1⟧컬소어⟦2⟧에 도착해.\n그때까지 버틸 수 있겠어?\n정 안 되겠으면, 그에게\n업어달라고 하는 것도――."
  },
  {
   "key": "023f2f103498",
   "speaker_korean": "넬",
   "korean": "「정말 괜찮은 거야?"
  },
  {
   "key": "463450adb641",
   "speaker_korean": "넬",
   "korean": "「그럼 다행이지만."
  },
  {
   "key": "796cf8f5a1a3",
   "speaker_korean": null,
   "korean": "⟦1⟧머리가…! 뭐야…!?⟦2⟧"
  },
  {
   "key": "6bd7915d1e25",
   "speaker_korean": null,
   "korean": "⟦1⟧400폴⟦2⟧을 손에 넣었다."
  },
  {
   "key": "79af68f331b0",
   "speaker_korean": null,
   "korean": "⟦1⟧바니1/144⟦2⟧를 손에 넣었다."
  }
 ]
}