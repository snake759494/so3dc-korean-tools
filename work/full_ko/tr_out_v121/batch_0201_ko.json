{
 "batch_id": "batch_0201",
 "translations": [
  {
   "key": "8e0f0a0793a3",
   "speaker_korean": "마리아",
   "korean": "「어째서!?"
  },
  {
   "key": "7a7b92eb3775",
   "speaker_korean": "비위그",
   "korean": "「네놈, 감히!"
  },
  {
   "key": "f28b9f08b62a",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧비위그⟦2⟧, 네놈!"
  },
  {
   "key": "e44f6aaec647",
   "speaker_korean": "비위그",
   "korean": "「⟦1⟧전송방해장치⟦2⟧를 부쉈다고\n우쭐대지 마라.\n⟦P⟧우리 군 ⟦3⟧전투함⟦4⟧이면,\n네놈들 모함을 격침하는 것쯤은\n식은 죽 먹기다.\n아무것도 달라지지 않는다!"
  },
  {
   "key": "12ce4b07e60c",
   "speaker_korean": "리베르",
   "korean": "「리더님,\n무사하십니까?!"
  },
  {
   "key": "f97dd0494763",
   "speaker_korean": "넬",
   "korean": "「…여러 가지 생각이 났었어,\n…여기 와서.\n그랬더니…,\n너희들 모습이… 보였으니까…."
  },
  {
   "key": "0a0d28429492",
   "speaker_korean": "넬",
   "korean": "「…마지막으로, 너희에게 도움이 되어서\n…다행이야.\n제대로… 보답 못 한 게\n있었으니까…."
  },
  {
   "key": "aad882ba2e66",
   "speaker_korean": "알벨",
   "korean": "「…어떻고 자시고도 없다…\n여긴 내 집… 아니냐….\n오랜만에… 돌아와 보니… 이 꼴이라니…."
  },
  {
   "key": "ec79a3e7c72c",
   "speaker_korean": "알벨",
   "korean": "「크헉… 네놈들은 내 사냥감…이다…\n다른 놈한테… 넘길 수는 없어…."
  },
  {
   "key": "8016129aebe9",
   "speaker_korean": "로저",
   "korean": "「마지막에… 도움이… 돼서…\n다행이잖아….\n한 번… 도움… 받은 적도 있고…."
  },
  {
   "key": "38e38b3e4507",
   "speaker_korean": "클리프",
   "korean": "「장난치지 마!\n야! 눈 떠!"
  },
  {
   "key": "86b12647335f",
   "speaker_korean": "클리프",
   "korean": "「이 바보 자식아!\n마지막이라는 말 하지 마!"
  },
  {
   "key": "386bfb05b893",
   "speaker_korean": "비위그",
   "korean": "「어떻게 된 거야!?\n왜 부대를 보내지 않는 거냐!"
  },
  {
   "key": "e17065ffa682",
   "speaker_korean": "비위그",
   "korean": "「…뭐라고?\n⟦1⟧아쿠아엘리⟦2⟧라고!?"
  },
  {
   "key": "9519c0b68bf5",
   "speaker_korean": "비위그",
   "korean": "「크윽, 일단 후퇴한다!\n⟦1⟧다스바누⟦2⟧, 수용해라!"
  },
  {
   "key": "e83808ffe1cf",
   "speaker_korean": "마리아",
   "korean": "「고마워.\n덕분에 살았어."
  },
  {
   "key": "02b5eac386ff",
   "speaker_korean": "리베르",
   "korean": "「아니에요,\n늦지 않아 다행입니다."
  },
  {
   "key": "c726ffb85c76",
   "speaker_korean": "마리아",
   "korean": "「현재 상황은 어떻게 된 거야?\n너희들이\n왔다는 건――――――"
  },
  {
   "key": "cb7e90d36995",
   "speaker_korean": "리베르",
   "korean": "「예.\n몇 분 전에 ⟦1⟧아쿠아엘리⟦2⟧가 도착해서,\n협력하여 반데인함과 교전 중입니다.\n제아무리 ⟦3⟧다스바누⟦4⟧라도,\n⟦5⟧아쿠아엘리⟦6⟧와 ⟦7⟧디플로⟦8⟧ 두 함을\n상대하기는 벅찰 겁니다."
  },
  {
   "key": "ae8f41044c3d",
   "speaker_korean": "소피아",
   "korean": "「너무해―――――"
  },
  {
   "key": "cddf5f347430",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧디플로⟦2⟧에 수용하자.\n거기라면 살릴 수 있어."
  },
  {
   "key": "cc041d6a99e2",
   "speaker_korean": "마리아",
   "korean": "「그래, 알고 있어."
  },
  {
   "key": "ee095a9bc7a9",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧디플로⟦2⟧,\n상황은 어떻게 됐어?"
  },
  {
   "key": "fbdea485152a",
   "speaker_korean": "마리에타",
   "korean": "『예, 방금,\n⟦1⟧아쿠아엘리⟦2⟧의 ⟦3⟧크리에이션 포⟦4⟧로\n⟦5⟧다스바누⟦6⟧를 격침시켰습니다!"
  },
  {
   "key": "d40228714aa4",
   "speaker_korean": "미라쥬",
   "korean": "『1분 후에\n전송 수용이 가능합니다."
  },
  {
   "key": "a0a133a23dd1",
   "speaker_korean": "미라쥬",
   "korean": "『…잠깐만 기다려 주세요.\n왜 그러죠, ⟦1⟧마리에타⟦2⟧?"
  },
  {
   "key": "15da9d826bdc",
   "speaker_korean": "마리에타",
   "korean": "『예. 격침 직전, ⟦1⟧다스바누⟦2⟧에서\n전송 반응을 확인했습니다.\n전송된 것이 무엇인지는 특정하지\n못했지만… 주의해 주세요."
  },
  {
   "key": "7137097e6dc5",
   "speaker_korean": "미라쥬",
   "korean": "『라고 합니다.\n부디 주의해 주세요."
  },
  {
   "key": "83ff13197fff",
   "speaker_korean": "마리아",
   "korean": "「알았어――――――"
  },
  {
   "key": "2f2768266081",
   "speaker_korean": "비위그",
   "korean": "「이용… 할 수 없다면,\n배제할 뿐이다!"
  },
  {
   "key": "e0655d2f6eed",
   "speaker_korean": "로키시",
   "korean": "「안 돼!"
  },
  {
   "key": "3cda055983da",
   "speaker_korean": "페이트",
   "korean": "「아버지!"
  },
  {
   "key": "d367449a52d9",
   "speaker_korean": "마리아",
   "korean": "「박사님!"
  },
  {
   "key": "51e41ad7ef92",
   "speaker_korean": "소피아",
   "korean": "「싫어어어어어어!!"
  },
  {
   "key": "30dd95a8114c",
   "speaker_korean": "로키시",
   "korean": "「⟦1⟧문베이스⟦2⟧의… 연구에…,\n데이터가… 있다…. 그걸…\n너희들이… 희망…이다…."
  },
  {
   "key": "f41ce620bca5",
   "speaker_korean": "페이트",
   "korean": "「아버지,\n말하지 마…."
  },
  {
   "key": "2b6960abafd1",
   "speaker_korean": "로키시",
   "korean": "「…크윽…."
  },
  {
   "key": "639a11e919d9",
   "speaker_korean": "비위그",
   "korean": "「하하, 방해만 해대니 그런 거다!\n꼴좋구나, 순순히 협력했으면\n좋았을 텐데 말이야!!"
  },
  {
   "key": "36838d669fd3",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧비위그⟦2⟧!"
  },
  {
   "key": "c174b8c3e13d",
   "speaker_korean": "페이트",
   "korean": "「아버지, 아버지!"
  },
  {
   "key": "f1b53690f5c5",
   "speaker_korean": "로키시",
   "korean": "「…미안하…다―――――"
  },
  {
   "key": "b37ade61b50d",
   "speaker_korean": "마리아",
   "korean": "「박사님…."
  },
  {
   "key": "fefccd071956",
   "speaker_korean": "페이트",
   "korean": "「거짓말이지, 아버지!"
  },
  {
   "key": "996ab13f3ab6",
   "speaker_korean": "페이트",
   "korean": "「으아아아아아아악!"
  },
  {
   "key": "32ecdb6c3c98",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧디플로⟦2⟧… 정리됐어.\n수용해."
  },
  {
   "key": "94e7f0a65b29",
   "speaker_korean": "미라쥬",
   "korean": "『알겠습니다.\n준비가 완료되는 대로,\n순차적으로 전송 수용하겠습니다."
  },
  {
   "key": "08318b44a76d",
   "speaker_korean": "미라쥬",
   "korean": "『예,\n⟦1⟧마리아⟦2⟧."
  },
  {
   "key": "5d4450adbb99",
   "speaker_korean": "넬",
   "korean": "「뭣!?"
  },
  {
   "key": "d12a23bd29a5",
   "speaker_korean": "넬",
   "korean": "「꺄아아아아아!"
  },
  {
   "key": "a317e70b075b",
   "speaker_korean": "로저",
   "korean": "「으아앗!?"
  },
  {
   "key": "a11f9a19e5e9",
   "speaker_korean": "비위그",
   "korean": "「하지만, 이걸로 끝이다.\n얌전히 그 꼬맹이를 이쪽으로 넘겨라."
  },
  {
   "key": "28a2120f3c60",
   "speaker_korean": "비위그",
   "korean": "「미리 말해두겠는데,\n저항해봐야 소용없다.\n아무리 쓰러뜨려봤자, 이쪽은\n얼마든지 보충이 가능하다.\n네놈들은 도망칠 수도\n없으니까 말이다!\n크핫핫핫핫하!"
  },
  {
   "key": "af9fc8b20378",
   "speaker_korean": "???",
   "korean": "「그건 이게\n있어서잖냐!"
  },
  {
   "key": "8fe784098e45",
   "speaker_korean": "???",
   "korean": "「그건 이게\n있어서겠지, 멍청아!"
  },
  {
   "key": "e29cfec1b50b",
   "speaker_korean": "???",
   "korean": "「그건 이게\n있어서잖아!"
  },
  {
   "key": "33d7e13337e9",
   "speaker_korean": "로키시",
   "korean": "「⟦1⟧페이트⟦2⟧…,\n⟦3⟧마리아⟦4⟧…,\n⟦5⟧소피아⟦6⟧…."
  }
 ]
}