 "batch_id": "batch_0042",
 "translations": [
  {
   "key": "3df1a3b77190",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「이 단말은 못 쓰나….\n⟦P⟧"
  },
  {
   "key": "30e1379a956d",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「여기서 좀 쉬었다 갈래?\n⟦P⟧아침부터 계~속\n게임만 했으니까\n피곤한 거지~.\n⟦P⟧"
  },
  {
   "key": "291564760788",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「다들 무사히\n도망쳤을까?\n⟦P⟧별일 없으면\n좋겠는데….\n⟦P⟧"
  },
  {
   "key": "9ed51b2e2a5e",
   "speaker_korean": "로크인 노인",
   "korean": "⟦1⟧「호오, 일부러 ⟦2⟧태양계⟦3⟧에서\n오셨습니까….\n⟦P⟧관광이신가요?\n뭐 어쨌든, 느긋하게\n쉬다 가시면 좋지요.\n⟦P⟧"
  },
  {
   "key": "74e8e3ad863c",
   "speaker_korean": null,
   "korean": "초등학생쯤 되는 아이가 좋아할 만한\n물건이 잔뜩 놓여 있다.\n⟦P⟧"
  },
  {
   "key": "fbec4742ac89",
   "speaker_korean": null,
   "korean": "수신 중이던 메시지가\n남아 있다.\n⟦P⟧"
  },
  {
   "key": "b6b81a31517b",
   "speaker_korean": null,
   "korean": "「할아버지께.\n셔틀이 늦어져서,\n조금만 더 기다려 줘.\n미안해요.  프리실라가\n⟦P⟧"
  },
  {
   "key": "324511c1c8ae",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(…… …….\n⟦P⟧"
  },
  {
   "key": "5255e186cb6f",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(저기 계신 할아버지가\n쓰고 있는 걸까?\n⟦P⟧"
  },
  {
   "key": "ca9cfe5ec8d0",
   "speaker_korean": null,
   "korean": "현재는 강제 이벤트 예정이므로\n메시지가 없습니다.\n⟦P⟧"
  },
  {
   "key": "885fb39fbc12",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「분명, ⟦2⟧트랜스포터⟦3⟧가\n놓여 있는 방으로\n가라고 했었지.\n⟦P⟧"
  },
  {
   "key": "dca5f4196c23",
   "speaker_korean": null,
   "korean": "플레이룸"
  },
  {
   "key": "7b62bde27a59",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『Fight Simulator System에 오신 것을\n환영합니다. 지금부터 Fight System의\n설정을 진행합니다.\n⟦P⟧"
  },
  {
   "key": "bcd05d64fbd7",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『엔트리 플레이어 1\n ⟦2⟧페이트・라인갓⟦3⟧\n사용 캐릭터\n⟦4⟧ 소드 마스터 아도니스・클라인⟦5⟧\n유저 레벨\n⟦6⟧ ＡＡＡ⟦7⟧\n엔트리 플레이어 2\n ⟦8⟧소피아・에스테드⟦9⟧\n사용 캐릭터\n⟦10⟧ 플레어 위치 세실리아・페르미나⟦11⟧\n유저 레벨\n⟦12⟧ H⟦13⟧\n배틀 필드\n⟦14⟧ 변경도시 리스티아⟦15⟧\n몬스터 레벨\n⟦16⟧ H⟦17⟧\n\n\n\n이상으로 설정을 종료합니다.\n이대로 괜찮으십니까?\n\n\n\n⟦P⟧"
  },
  {
   "key": "7cf7e0485d7c",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「ＯＫ.\n아무 문제 없어.\n⟦P⟧"
  },
  {
   "key": "24930ffa943d",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『알겠습니다.\n본 SimulatorSystem은,\n플레이어의 안전을 확보하기 위해,\n만일의 경우에는 강제로\n게임을 종료할 가능성이….\n⟦P⟧"
  },
  {
   "key": "fd1daeedfde1",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그건 알고 있어.\n시작해 줘.\n⟦P⟧"
  },
  {
   "key": "c6aecfb7f51d",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『그럼, 게임을 시작하겠습니다.\n⟦P⟧"
  },
  {
   "key": "2df7b42c668a",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「후우….\n지쳤어….\n⟦P⟧"
  },
  {
   "key": "2b0568aa2239",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그래도, 재밌었잖아?\n⟦P⟧"
  },
  {
   "key": "2498d5e6d4e5",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「으~음.\n그럭저럭, 이려나?\n⟦P⟧"
  },
  {
   "key": "d0c40f747a52",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그럼, 이쯤 하고\n밥이라도 먹으러 갈까.\n⟦2⟧소피아⟦3⟧도 지쳤잖아?\n⟦P⟧"
  },
  {
   "key": "c91d7062ca2c",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「응.\n이제 녹초야….\n⟦P⟧"
  },
  {
   "key": "153d755167c0",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「하하….\n운동 부족이라니까, ⟦2⟧소피아⟦3⟧는.\n⟦P⟧"
  },
  {
   "key": "1564b635a4e8",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「흥이다.\n어차피 난, 뚱뚱보라 이거지~.\n⟦P⟧"
  },
  {
   "key": "05dea29aa0f6",
   "speaker_korean": null,
   "korean": "⟦1⟧・좋아, 한 번 더 해보자."
  },
  {
   "key": "94f6dd247d4b",
   "speaker_korean": null,
   "korean": "⟦1⟧・이제 그만두자…."
  },
  {
   "key": "78b505943f12",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「무, 뭐야?!\n⟦P⟧"
  },
  {
   "key": "51140c188898",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『방금 Level 2의 진동을 감지했습니다.\n안전을 위해 시스템을 일시 중단합니다.\n양해 부탁드립니다.\n⟦P⟧"
  },
  {
   "key": "a525d383b7a2",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「꺄악!"
  },
  {
   "key": "20e5e97564f3",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「지진?\n⟦P⟧"
  },
  {
   "key": "d16e32ba3678",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(⟦2⟧하이다 4호성⟦3⟧은, 지각 변동이나\n항성 활동이 안정돼 있으니까,\n지진 같은 건 일어날 리 없는데….\n⟦P⟧"
  },
  {
   "key": "8f9febec04e6",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「컴퓨터!\n대체 무슨 일이 일어난 거야!?\n⟦P⟧"
  },
  {
   "key": "3e8b2ff23124",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『경계 경보입니다.\n현재, ⟦2⟧하이다 4호성⟦3⟧은 미확인\n항주함의 공격을 받고 있습니다.\n일반 시민 여러분은 신속히, 가까운\n콘솔에 표시되는 정보에 따라,\n피난을 시작해 주십시오.\n반복합니다.\n일반 시민 여러분은…."
  },
  {
   "key": "527296178ecf",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『현재, ″⟦2⟧제7 심우주 기지⟦3⟧″,\n및 ″하이다 3호성″, ″⟦4⟧하이다 4호성⟦5⟧″이\n미확인 함선의 공격을 받고 있습니다.\n⟦6⟧제7 심우주 기지⟦7⟧에서는 스크램블로\n대처하고 있습니다만 미확인 함선은\n복수로 존재하고 있어, ⟦8⟧하이다 4호성⟦9⟧까지\n구원을 도달시키지 못하고 있습니다.\n⟦P⟧"
  },
  {
   "key": "2bacccf56ebb",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「미확인 함선의\n공격이라고!?\n⟦P⟧"
  },
  {
   "key": "c65fe1526300",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『영상을 표시하겠습니다.\n⟦P⟧"
  },
  {
   "key": "a9778f02889a",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「뭐야, 이거….\n⟦P⟧"
  },
  {
   "key": "d5b1c87db6ca",
   "speaker_korean": "ＣＯＭ",
   "korean": "⟦1⟧『긴급 상황이므로, 모든 전송 장치는\n피난 터미널로 직결되어 있습니다.\n안내에 따라 피난을 시작해 주십시오.\n반복합니다.\n피난을…."
  },
  {
   "key": "0559b9a543c7",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(그런데, 어디 군대지?\n본 적 없는 타입인데….\n아버지랑 어머니는 무사하실까?\n⟦P⟧"
  },
  {
   "key": "4bb98090d97e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「가자.\n⟦P⟧"
  },
  {
   "key": "7c24afb193a8",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「에에~!\n아직도 더 해야 돼~?\n⟦P⟧"
  },
  {
   "key": "a87f544c70ea",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「어떡할래 ⟦2⟧소피아⟦3⟧?\n일단, 인스트….\n설명서도 한번 훑어볼까?\n⟦P⟧"
  },
  {
   "key": "9b855378add2",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「일단 봐 둬.\n안 그러면 즐길 수 없잖아.\n⟦P⟧"
  },
  {
   "key": "0d2ccbc9611b",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「괜찮아.\n기본은 아까랑 똑같다니까.\n⟦P⟧"
  },
  {
   "key": "48219525ffe5",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아무도 그런 말 안 했잖아.\n진짜 참….\n⟦P⟧"
  },
  {
   "key": "97e2ea252429",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「그럼, 당장 시작해 볼까.\n컴퓨터, 시작해 줘.\n⟦P⟧"
  },
  {
   "key": "e675b3794cc4",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「응.\n그럼, 그렇게 할게.\n⟦P⟧"
  },
  {
   "key": "85eee970e8c1",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「어떻게 할까….\n봐 두는 게 좋아?\n⟦P⟧"
  },
  {
   "key": "7ee2a1c831e3",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「하아….\n아직도 심장이 두근두근거려.\n요즘 운동을 별로 안 했나~?\n⟦P⟧"
  },
  {
   "key": "5a04ccca0711",
   "speaker_korean": null,
   "korean": "⟦1⟧・다이어트에는 딱 좋겠지."
  },
  {
   "key": "5566552f964a",
   "speaker_korean": null,
   "korean": "⟦1⟧・오늘은 이쯤에서 끝낼까."
  },
  {
   "key": "0bd71a97a2ab",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(꽤 지친 모양이네.\n이 게임, 겉보기 인상보다\n꽤 하드하니까 말이야….\n⟦P⟧"
  },
  {
   "key": "cd07fef9f00e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(오늘은 이쯤에서 끝낼까.\n⟦P⟧그래도, 완전 초짜를\n커버하면서 싸우는 것도\n의외로 재미있단 말이지.\n⟦P⟧그걸 알게 된 것만으로도\n충분하겠지.\n⟦P⟧"
  },
  {
   "key": "07ceddd85927",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「무슨 일이야, ⟦2⟧페이트⟦3⟧?\n⟦P⟧"
  },
  {
   "key": "f67b4e654ce2",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(다이어트에는 딱 좋겠지.\n조금쯤 가벼워지는 편이\n분명 좋을 거야.\n⟦P⟧"
  },
  {
   "key": "aac092188e06",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「에엥~….\n이거, 아직 더 계속되는 거야~?\n⟦P⟧"
  },
  {
   "key": "e28c8e84ff6f",
   "speaker_korean": null,
   "korean": "다만, 조금은\n만만찮을지도 모르지만….\n⟦P⟧"
  },
  {
   "key": "1c879f10c648",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「안심하라니까.\n이지 모드는 이걸로 마지막이야.\n⟦P⟧"
  },
  {
   "key": "93f7e707d3ed",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(으~음….\n조금만 더 ⟦2⟧소피아⟦3⟧가\n전술적으로 움직여 줬으면 좋았겠지만,\n⟦P⟧처음이기도 하고,\n뭐, 이 정도면 됐지.\n⟦P⟧"
  },
  {
   "key": "c3efc5b232c9",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「으, 응….\n⟦P⟧"
  },
  {
   "key": "ac1784c43263",
   "speaker_korean": "소피아",
   "korean": "⟦1⟧「그래?\n열심히 하겠지만, 져도 난 몰라.\n⟦P⟧"
  }
 ]
}