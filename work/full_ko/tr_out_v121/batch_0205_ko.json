{
 "batch_id": "batch_0205",
 "translations": [
  {
   "key": "6ff395f55fd3",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX3⟦2⟧를 손에 넣었다"
  },
  {
   "key": "a8f876d34c56",
   "speaker_korean": null,
   "korean": "⟦1⟧패럴라이 체크⟦2⟧를 손에 넣었다"
  },
  {
   "key": "a86bbc54c7de",
   "speaker_korean": null,
   "korean": "베크렐 광산 정련소 터"
  },
  {
   "key": "6e71eaa2a030",
   "speaker_korean": "페이트",
   "korean": "「정련소는 바로 저기다\n가서 상황을 보자"
  },
  {
   "key": "b834ed54dee6",
   "speaker_korean": null,
   "korean": "여섯째\n동굴 끝에 잠들고⟦G:e453d621⟧\n북녘 끝의 현자가\n지하에 옛 힘 봉인"
  },
  {
   "key": "2f1c9918a62f",
   "speaker_korean": null,
   "korean": "⟦1⟧데몬 크로스⟦2⟧를 손에 넣었다"
  },
  {
   "key": "2bf65ea5716c",
   "speaker_korean": null,
   "korean": "⟦1⟧23600폴⟦2⟧을 얻었다"
  },
  {
   "key": "96334165add6",
   "speaker_korean": "기술자",
   "korean": "「⟦1⟧구리⟦2⟧는 대부분 옮겼습니다\n이제 광산 입구에서 짐마차에\n싣기만 하면 됩니다\n이 앞에서 광산 입구로\n곧장 가실 수도 있습니다만…\n잠시 쉬시는 편이\n좋지 않을까요?"
  },
  {
   "key": "2d06fb097ffd",
   "speaker_korean": null,
   "korean": "⟦1⟧・잠시 쉰다"
  },
  {
   "key": "3f30e882ecf7",
   "speaker_korean": "꽤나 엉뚱한 여성 기술자",
   "korean": "「으~\n어두워서 잘 안 보여~"
  },
  {
   "key": "014d7a200bc0",
   "speaker_korean": "기술자",
   "korean": "「저도 곧 고향으로 돌아갈 겁니다\n하지만 그전에 이 근처를\n둘러보려고 남아 있는 거예요\n절대 값나가는 물건을\n뒤지는 게 아니니까요\n그나저나 쉬시겠습니까?"
  },
  {
   "key": "841e06bcf1ca",
   "speaker_korean": "시하츠 병사",
   "korean": "「안쪽에 있는 녀석은\n왜 안 돌아가는 걸까?"
  },
  {
   "key": "fba9b40d752d",
   "speaker_korean": "시하츠 병사",
   "korean": "「어두우니 발밑을\n조심하시게"
  },
  {
   "key": "305d66a7ca21",
   "speaker_korean": "고지식한 시하츠 병사",
   "korean": "「이 선로 끝에 정련소가 있습니다\n작업은 거의 끝나서\n이제 ⟦1⟧구리⟦2⟧를 옮기기만 하면 됩니다\n광차를 타고 출구까지\n가시겠습니까?"
  },
  {
   "key": "53c27b4376d2",
   "speaker_korean": "그렇게는 안 보이는 시하츠 공병",
   "korean": "「여기도 예전에는 ⟦1⟧구리⟦2⟧ 산지로\n활기가 넘쳤었는데…\n채굴량이 급격히 줄어들어서\n완전히 쇠퇴하고 말았다네"
  },
  {
   "key": "f195ba504129",
   "speaker_korean": "자칭 『사랑의 전사』 시하츠 여성 병사",
   "korean": "「작업은 순조롭습니다\n⟦1⟧파린 씨⟦2⟧와 ⟦3⟧타이네브 씨⟦4⟧는\n광산 입구에서\n⟦5⟧구리⟦6⟧를 싣고 있을 겁니다"
  },
  {
   "key": "1089c5dfb40c",
   "speaker_korean": null,
   "korean": "⟦1⟧・광차를 탄다"
  },
  {
   "key": "8b63fca608a4",
   "speaker_korean": null,
   "korean": "⟦1⟧・안 탄다"
  },
  {
   "key": "6e79aca0ebc7",
   "speaker_korean": "고지식한 시하츠 병사",
   "korean": "「지금까지 고지식하게 살아왔습니다만\n이곳의 맑은 공기와 고요함이\n어쩔 수 없이 마음에 스며들어\n일도 제쳐두고 여기 오게 됐습니다…\n전혀 상관없는 얘기지만\n광차를 타고 출구까지\n가시겠습니까?"
  },
  {
   "key": "e86663419b21",
   "speaker_korean": "그라츠",
   "korean": "⟦1⟧「지금 이 자리에 서 있음에 감사하거라\n목숨이 있다는 기적을 잊고 가벼이 여긴 자부터\n죽어 나가는 법\n전장이란 그런 곳이니라\n⟦P⟧"
  },
  {
   "key": "344788916534",
   "speaker_korean": null,
   "korean": "⟦1⟧13500폴⟦2⟧을 보여줄까요?\n⟦P⟧"
  },
  {
   "key": "3be4f304b1d1",
   "speaker_korean": null,
   "korean": "⟦1⟧13500폴⟦2⟧을 건넬까요?\n⟦P⟧"
  },
  {
   "key": "450d07e9285c",
   "speaker_korean": null,
   "korean": "⟦1⟧・시끄러운 영감이네…"
  },
  {
   "key": "6eaef5091944",
   "speaker_korean": "그라츠",
   "korean": "⟦1⟧「지옥의 심판도 정말 돈 나름이라는 겐가\n돈을 아끼려다 목숨을 버리는 어리석은 자가\n어찌나 많은지\n⟦P⟧"
  },
  {
   "key": "8cdc5b2810c1",
   "speaker_korean": "그라츠",
   "korean": "⟦1⟧「인생에는 돈으로 살 수 없는 것이\n있다는 걸 배우거라\n그걸 배우지 못한다면\n죽을 뿐이니라\n⟦P⟧"
  },
  {
   "key": "3f3d6fe5356a",
   "speaker_korean": null,
   "korean": "크리에이터 그라츠와 계약했습니다\n⟦P⟧"
  },
  {
   "key": "3c4df7250c0e",
   "speaker_korean": "그라츠",
   "korean": "⟦1⟧「좋다\n이 몸의 풍부한 경험과 지식을\n네게 조금 나눠 주마\n⟦P⟧"
  },
  {
   "key": "9dc5afb66675",
   "speaker_korean": "그라츠",
   "korean": "⟦1⟧「이 몸은 아직 한창때니라\n에잇!\n늙은이 취급하지 말거라\n⟦P⟧"
  },
  {
   "key": "b9fc34f510d5",
   "speaker_korean": null,
   "korean": "⟦1⟧배틀 스피어⟦2⟧를 손에 넣었다"
  },
  {
   "key": "acb6ba27c09f",
   "speaker_korean": "페이트",
   "korean": "「이제 ⟦1⟧구리⟦2⟧는 손에 넣었어\n서둘러 정련소에 가야겠다"
  },
  {
   "key": "5d3f300136e1",
   "speaker_korean": "넬",
   "korean": "「왔네"
  },
  {
   "key": "3fc2ac242a59",
   "speaker_korean": "페이트",
   "korean": "「그다지 캐낸 흔적이 없고…\n순도도 꽤 높아 보이는군\n⟦1⟧넬 씨⟦2⟧,\n이 근처부터 캐 가자"
  },
  {
   "key": "5ef0f9f6fb05",
   "speaker_korean": "넬",
   "korean": "「알았어"
  },
  {
   "key": "6d98b092059c",
   "speaker_korean": "넬",
   "korean": "「다들,\n이 근처를 채굴할게"
  },
  {
   "key": "cdea568cfaf2",
   "speaker_korean": "파린",
   "korean": "「네~"
  },
  {
   "key": "febf3163932b",
   "speaker_korean": "페이트",
   "korean": "「이 정도면\n문제없을 것 같아"
  },
  {
   "key": "32f3941616ae",
   "speaker_korean": "넬",
   "korean": "「좋아, 이걸 정련소까지 옮길게\n너희는 광차로 먼저 가"
  },
  {
   "key": "dd8d1e657770",
   "speaker_korean": "타이네브",
   "korean": "「알겠습니다\n조심하십시오"
  },
  {
   "key": "971387add2cb",
   "speaker_korean": "페이트",
   "korean": "「여기가 아무래도\n최심부인가 보네"
  },
  {
   "key": "dcaeca316ccf",
   "speaker_korean": "넬",
   "korean": "「그런 것 같네"
  },
  {
   "key": "c69171b059ba",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧타이네브 일행⟦2⟧이 올 때까지\n아직 시간이 걸릴 것 같네\n주변을 좀 조사해 보는 편이\n나을지도 몰라"
  },
  {
   "key": "820faf371bf2",
   "speaker_korean": "클리프",
   "korean": "「기다려\n뭔가 들리지 않냐?"
  },
  {
   "key": "b7edac6bc36c",
   "speaker_korean": "페이트",
   "korean": "「뭐지!?"
  },
  {
   "key": "00b933034895",
   "speaker_korean": "페이트",
   "korean": "「그럼, 조사를 계속하자"
  }
 ]
}