  },
  {
   "key": "3eb0c9f12159",
   "speaker_korean": null,
   "korean": "스킬"
  },
  {
   "key": "e4576bbd32fd",
   "speaker_korean": null,
   "korean": "배틀스킬을 설정합니다"
  },
  {
   "key": "6ce3e41607fc",
   "speaker_korean": null,
   "korean": "스테이터스 스킬의 SP를 분배합니다"
  },
  {
   "key": "9961321b9085",
   "speaker_korean": null,
   "korean": "택티컬스킬을 전투 중에 발동할지 설정합니다"
  },
  {
   "key": "b7fd0b67ac81",
   "speaker_korean": null,
   "korean": "문장술 사용 대상을 지정해 주세요"
  },
  {
   "key": "5a02490eeabe",
   "speaker_korean": null,
   "korean": "「문장술을 사용합니다」로 전투 중 사용 가능/불가능 전환도 할 수 있습니다"
  },
  {
   "key": "ff99b91151d6",
   "speaker_korean": null,
   "korean": "생명력"
  },
  {
   "key": "1a9f82eb3649",
   "speaker_korean": null,
   "korean": "정신력"
  },
  {
   "key": "9d5cca6db7fb",
   "speaker_korean": null,
   "korean": "공격술"
  },
  {
   "key": "876a278bd7df",
   "speaker_korean": null,
   "korean": "간파"
  },
  {
   "key": "7d364751c999",
   "speaker_korean": null,
   "korean": "습득"
  },
  {
   "key": "77a58cc1fd4e",
   "speaker_korean": null,
   "korean": "신"
  },
  {
   "key": "3b0a0ea5a923",
   "speaker_korean": null,
   "korean": "택티컬스킬"
  },
  {
   "key": "f5f30e0b22de",
   "speaker_korean": null,
   "korean": "숙련도"
  },
  {
   "key": "05098f62bccd",
   "speaker_korean": null,
   "korean": "발동 전환"
  },
  {
   "key": "708925e3b9ad",
   "speaker_korean": null,
   "korean": "상세 설정"
  },
  {
   "key": "24d72b717e50",
   "speaker_korean": null,
   "korean": "스킬을 종료합니다\n괜찮으시겠습니까?"
  },
  {
   "key": "feab5210ad39",
   "speaker_korean": null,
   "korean": "발동."
  },
  {
   "key": "547ed432c862",
   "speaker_korean": null,
   "korean": "소비MP"
  },
  {
   "key": "b0447c82d18c",
   "speaker_korean": null,
   "korean": "그래비테이션"
  },
  {
   "key": "fa6271be2349",
   "speaker_korean": null,
   "korean": "화염탄으로 적 공격하는 주문"
  },
  {
   "key": "b3db013bb7d4",
   "speaker_korean": null,
   "korean": "전자장을 발생시켜\n적을 불태우는 주문"
  },
  {
   "key": "adf7bc03d524",
   "speaker_korean": null,
   "korean": "뇌격으로 적 공격하는 주문"
  },
  {
   "key": "562fab23ff5b",
   "speaker_korean": null,
   "korean": "무수한 얼음조각을 날려\n적을 공격하는 주문"
  },
  {
   "key": "e8225f0c112b",
   "speaker_korean": null,
   "korean": "거대한 바위창을 발생시켜\n적을 공격하는 주문"
  },
  {
   "key": "45b55028ed2a",
   "speaker_korean": null,
   "korean": "마계의 사악한 아기 악마를 소환해\n적을 잡아먹는 주문"
  },
  {
   "key": "f836a95aab80",
   "speaker_korean": null,
   "korean": "불꽃 마신을 소환해\n적을 공격하는 주문"
  },
  {
   "key": "7215593022cc",
   "speaker_korean": null,
   "korean": "주위에 냉기를 발생시켜\n적을 얼리는 주문"
  },
  {
   "key": "6a3d32ad8546",
   "speaker_korean": null,
   "korean": "거대한 바위를 떨어뜨려\n적을 짓누르는 주문"
  },
  {
   "key": "0fc2e3cbfadb",
   "speaker_korean": null,
   "korean": "무수한 레이저 광선으로\n적을 공격하는 주문"
  },
  {
   "key": "adb830fa17a2",
   "speaker_korean": null,
   "korean": "초고온 폭염으로\n적을 매장하는 주문"
  },
  {
   "key": "9bbbda44c7d5",
   "speaker_korean": null,
   "korean": "뇌격을 일으키는 최강 단일 주문"
  },
  {
   "key": "b9c49a6883c3",
   "speaker_korean": null,
   "korean": "HP가 줄어든 적을 즉사시키는 주문"
  },
  {
   "key": "98376c77c4e4",
   "speaker_korean": null,
   "korean": "마계의 대제를 소환해\n적을 소멸시키는 주문"
  },
  {
   "key": "0dd5191bd231",
   "speaker_korean": null,
   "korean": "성스러운 십자가 결계를 발생시켜\n사악한 자를 정화하는 주문"
  },
  {
   "key": "b87aeb362c6b",
   "speaker_korean": null,
   "korean": "우주에서 무수한 운석을 소환해\n적을 무찌르는 주문"
  },
  {
   "key": "6f011b26dff2",
   "speaker_korean": null,
   "korean": "아군 한 명의 HP를 회복시키는 주문"
  },
  {
   "key": "6b87b30e9de1",
   "speaker_korean": null,
   "korean": "아군 한 명의 공격력을 올리는 주문"
  },
  {
   "key": "e6610807367e",
   "speaker_korean": null,
   "korean": "아군 한 명의 방어력을 올리는 주문"
  },
  {
   "key": "59bafb539f37",
   "speaker_korean": null,
   "korean": "아군 한 명의 공격·방어·명중·회피·\n마법 방어력을 올리는 주문"
  }
 ]
}