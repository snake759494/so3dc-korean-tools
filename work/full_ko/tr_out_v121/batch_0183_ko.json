{
 "batch_id": "batch_0183",
 "translations": [
  {
   "key": "4b6073e6e664",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧시술⟦2⟧?"
  },
  {
   "key": "32919dfcad17",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧아페리스교⟦2⟧에 전해지는 비술이야.\n몸에 특수한 문자를 새김으로써\n보통은 일어날 수 없는 현상을\n일으키는 기술이지―――."
  },
  {
   "key": "864d5d279b25",
   "speaker_korean": "넬",
   "korean": "「그걸 우리는 ⟦1⟧시술⟦2⟧이라고 부르지."
  },
  {
   "key": "db0eb72630a8",
   "speaker_korean": "클리프",
   "korean": "「쇠창살 부순 것도 그거냐?"
  },
  {
   "key": "92459d0ca04d",
   "speaker_korean": "넬",
   "korean": "「그래."
  },
  {
   "key": "98138e45b1b0",
   "speaker_korean": "페이트",
   "korean": "(문신 같은…특수한 문자?\n어디선가 비슷한 걸\n본 적이 있는 것 같은―――."
  },
  {
   "key": "4e12cc49991e",
   "speaker_korean": "클리프",
   "korean": "「어이, 이거 ⟦1⟧문장술⟦2⟧ 아니냐?"
  },
  {
   "key": "6fed1871447d",
   "speaker_korean": "타이네브",
   "korean": "「전부터 침공 시기를\n가늠하고 있었겠지요.\n⟦1⟧아리그리프⟦2⟧는 산맥에 둘러싸인 혹한의 땅.\n겨울이 되면 식량을 확보하는 것도\n힘겨운 땅입니다.\n우리 ⟦3⟧시하츠⟦4⟧의, ⟦5⟧아페리스⟦6⟧의 은혜 넘치는\n비옥한 대지를 노렸던 것으로 보입니다."
  },
  {
   "key": "4865d086d1a1",
   "speaker_korean": "클리프",
   "korean": "「침략 전쟁이라는 거군."
  },
  {
   "key": "62ddb6568deb",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧문장술⟦2⟧!?\n그렇구나, ⟦3⟧문장술⟦4⟧과 같은 거였어…."
  },
  {
   "key": "682391aec1ff",
   "speaker_korean": "클리프",
   "korean": "「그렇지?"
  },
  {
   "key": "f5906fac8260",
   "speaker_korean": "클리프",
   "korean": "「아니, 이쪽 얘기야.\n계속해봐."
  },
  {
   "key": "e0ef41f32021",
   "speaker_korean": "페이트",
   "korean": "「번개를 닮은…힘…."
  },
  {
   "key": "a39ce3a5b1e2",
   "speaker_korean": "넬",
   "korean": "「그래. 번개를 닮은 힘이지.\n아직 몇 가지 문제점이 있어서\n완전한 실용화까지는 이르지 못했지만."
  },
  {
   "key": "36eb112dbc91",
   "speaker_korean": "넬",
   "korean": "「그런 참에 ⟦1⟧타이네브 일행⟦2⟧한테서\n너희 얘기가 보고돼서 온 거지.\n시내에서 얻은 물체 파편과 함께.\n그걸 나라의 연구자에게 보냈더니\n굉장히 흥미를 보이더군."
  },
  {
   "key": "9d1efb072b3e",
   "speaker_korean": "넬",
   "korean": "「『파편에는 우리로선 이해할 수 없는\n기술이 쓰였다.\n무기 개발에 저들 협력을 얻는다면』\n이런 소리를 하더라고.\n…그래서 내가 나서게 된 거지."
  },
  {
   "key": "c33632f9d21f",
   "speaker_korean": "넬",
   "korean": "「제대로 맞혔어. 바로 그거야."
  },
  {
   "key": "e673bf798867",
   "speaker_korean": "클리프",
   "korean": "「어이, 그 기술을 좀 응용하면\n⟦1⟧통신기⟦2⟧를 만들 수 있지 않냐?"
  },
  {
   "key": "3b811eb76772",
   "speaker_korean": "페이트",
   "korean": "「무선식이라면 만들 수 있을지도.\n⟦1⟧영력⟦2⟧이라는 게 잘 이해는 안 가지만,\n아마 전기일 거라고 생각해….\n그럼 ⟦3⟧통신기⟦4⟧ 출력은 전기 나름이니까\n어떻게든 될지도 몰라…\n그렇지만…."
  },
  {
   "key": "23e0f67c81b9",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧넬 씨⟦2⟧, 저는 거절하겠습니다.\n협력은 할 수 없습니다."
  },
  {
   "key": "53b29902facf",
   "speaker_korean": "넬",
   "korean": "「거부는 인정 안 한다고 했을 텐데?"
  },
  {
   "key": "18f09ddb01a4",
   "speaker_korean": "페이트",
   "korean": "「무기를 만든다는 건\n그로 인해 많은 사람이 죽는다는\n뜻이잖아요?\n그런 걸, 저는 만들고 싶지 않아요."
  },
  {
   "key": "e5dbc4132497",
   "speaker_korean": "넬",
   "korean": "「네 사정은 이해하고 있는 셈이야.\n아버지를 구하려 서두르는 거잖아?"
  },
  {
   "key": "e3318df07638",
   "speaker_korean": "넬",
   "korean": "「지금 이 나라는 전쟁 상태야.\n무기가 있든 없든 사람은 죽어.\n아리그리프인도, 시하츠인도 마찬가지지.\n결국 이 전쟁을 빨리 끝내는 것이\n결과적으로 사망자를 줄이는 셈이지.\n그리고 그러기 위해선 신무기를 하루빨리\n완성시킬 필요가 있어."
  },
  {
   "key": "45e9d9592823",
   "speaker_korean": "클리프",
   "korean": "「꼭 어디 누구네 별 어느 나라가\n옛날에 하던 소리 같은데."
  },
  {
   "key": "d10a9a64ba41",
   "speaker_korean": "넬",
   "korean": "「협박이라 해도 상관없어.\n감옥에서도 말했지만, 협력을 거부한다면\n너희를 살려둘 순 없어.\n딱히 너한테 원한은 없지만,\n임무엔 사감을 안 섞어, 그게 내 일이야.\n…말 안 해도 알고 있겠지만,\n죽으면 아버지를 구할 수도 없잖아."
  },
  {
   "key": "abd666087e21",
   "speaker_korean": "넬",
   "korean": "「호오… 어지간한 자신감이네?"
  },
  {
   "key": "69c2d1a92c3f",
   "speaker_korean": "넬",
   "korean": "「그놈들이 본격적으로 고문해도\n똑같은 말을 할 수 있을는지 모르겠네?"
  },
  {
   "key": "9b457fd6bf46",
   "speaker_korean": "넬",
   "korean": "「우리에게 선택의 여지는 없어.\n솔직히 이대로라면 ⟦1⟧아리그리프⟦2⟧와의\n싸움은 힘겨워질 거야.\n인정하고 싶진 않지만, 그게 현실이지."
  },
  {
   "key": "9d7f6318b573",
   "speaker_korean": "클리프",
   "korean": "「자자, 그렇게 눈에 쌍심지 켜지 마.\n너도 말이야, 좀 진정해라."
  },
  {
   "key": "f3ad2797ed4b",
   "speaker_korean": "페이트",
   "korean": "「그렇다잖아요!"
  },
  {
   "key": "19b951fe5d87",
   "speaker_korean": "클리프",
   "korean": "「그렇다고 나발이고 없어.\n초조해해 봤자 좋을 거라곤\n하나도 없다고."
  },
  {
   "key": "4710855f68f3",
   "speaker_korean": "넬",
   "korean": "「하지만 지금 개발 중인 신무기만 완성되면\n충분히 그 상황을 타개할 수 있어.\n이용할 수 있는 건 뭐든 이용해.\n말 안 듣는 자를 힘으로 굴복시킴도\n마다하지 않아."
  },
  {
   "key": "d82cdc8849b1",
   "speaker_korean": "넬",
   "korean": "「아니, ⟦1⟧아페리스 신⟦2⟧은 물론 여왕 폐하도\n그런 건 바라지 않으셔.\n하지만 안 하면 나라가 망해…그렇다면―――."
  },
  {
   "key": "a8b86ff81f88",
   "speaker_korean": "페이트",
   "korean": "「그런 건 아니에요."
  },
  {
   "key": "da2cf23fec7e",
   "speaker_korean": "파린",
   "korean": "「히익!?"
  },
  {
   "key": "e916d0eed086",
   "speaker_korean": "넬",
   "korean": "「음?\n왜 그래, ⟦1⟧파린⟦2⟧?"
  },
  {
   "key": "e18cbe012078",
   "speaker_korean": "클리프",
   "korean": "「어떡할래? 할 거냐?"
  },
  {
   "key": "410b6aec5fe1",
   "speaker_korean": "타이네브",
   "korean": "「⟦1⟧넬 님⟦2⟧…."
  },
  {
   "key": "499dd8af50c5",
   "speaker_korean": "페이트",
   "korean": "「그런, 위험해요!"
  },
  {
   "key": "e5e5eb9a588d",
   "speaker_korean": "넬",
   "korean": "「왜 그래, ⟦1⟧타이네브⟦2⟧?"
  },
  {
   "key": "86f56234d02c",
   "speaker_korean": "타이네브",
   "korean": "「괜찮습니다."
  },
  {
   "key": "c2daa75963d0",
   "speaker_korean": "넬",
   "korean": "「그런 게 아니야.\n그런 게 아니지만서도……."
  },
  {
   "key": "80b4aca429e0",
   "speaker_korean": null,
   "korean": "너희가 특수한 기술과 지식을\n가지고 있다는 걸 지금까지 대화로\n알 수 있어.\n그러니 ⟦1⟧그리텐⟦2⟧의 기술자라는 것도\n아마 사실일 거야."
  },
  {
   "key": "1fa7d553a0ad",
   "speaker_korean": null,
   "korean": "근데 뭔가 좀 걸리는 게 있어.\n비상사태에도 놀라지 않는 배짱과\n몸가짐.\n게다가 일반인답지 않은 전투력까지.\n도무지 그냥 기술자로는 안 보이잖아?"
  },
  {
   "key": "22fea2117d99",
   "speaker_korean": null,
   "korean": "의문이 들어도 이상할 거 없는데.\n…아닌가?"
  },
  {
   "key": "97829e76fb87",
   "speaker_korean": "페이트",
   "korean": "「하지만…."
  },
  {
   "key": "1dbf75e798fb",
   "speaker_korean": "페이트",
   "korean": "「하지만 그런 대단한 기술이 있다면\n⟦1⟧아리그리프⟦2⟧에도…."
  },
  {
   "key": "f7b1545815e4",
   "speaker_korean": "넬",
   "korean": "「다만 ⟦1⟧시술⟦2⟧을 쓸 수 있는 자는\n한정돼 있어.\n사실 ⟦3⟧아리그리프⟦4⟧에 맞서려면\n인원이 압도적으로 부족해."
  },
  {
   "key": "44f89dec100c",
   "speaker_korean": "타이네브",
   "korean": "「당신들을 여기서 잃을 순\n없습니다!\n저희라면 괜찮으니까요!\n인원이 줄면 속도도 나고,\n괜찮습니다, 반드시 따돌리겠습니다.\n…그러니 어서!!"
  },
  {
   "key": "a1e57a42aec5",
   "speaker_korean": "타이네브",
   "korean": "「⟦1⟧넬 님⟦2⟧을 부탁드립니다."
  },
  {
   "key": "fe32e428e35d",
   "speaker_korean": "페이트",
   "korean": "「여러분도 무사히."
  },
  {
   "key": "1c102e1176c1",
   "speaker_korean": "타이네브",
   "korean": "「⟦1⟧아페리스⟦2⟧의 가호가 있기를!"
  },
  {
   "key": "d459ca9fd505",
   "speaker_korean": "클리프",
   "korean": "「구시렁댈 시간 없겠는데.\n가자!"
  },
  {
   "key": "ee1e7e279fce",
   "speaker_korean": "넬",
   "korean": "「부탁했어, ⟦1⟧타이네브⟦2⟧, ⟦3⟧파린⟦4⟧."
  },
  {
   "key": "207b19a7e759",
   "speaker_korean": "넬",
   "korean": "「가자, 너희들."
  },
  {
   "key": "6fdd642ca72f",
   "speaker_korean": "페이트",
   "korean": "「무모해요!\n⟦1⟧타이네브 씨네⟦2⟧\n만으로는 안 돼요!"
  },
  {
   "key": "0868bed0442d",
   "speaker_korean": "넬",
   "korean": "「따라잡혔다는 거야!?\n큭, 곧 ⟦1⟧칼사아⟦2⟧에 도착하는데!"
  },
  {
   "key": "350f74fa34ec",
   "speaker_korean": "타이네브",
   "korean": "「⟦1⟧넬 님 일행⟦2⟧은 내리셔서\n바위 그늘에 숨어 지나가시게 하세요.\n저희가 놈들을 유인하겠습니다."
  }
 ]
}