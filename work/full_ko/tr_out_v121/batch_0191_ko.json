{
 "batch_id": "batch_0191",
 "translations": [
  {
   "key": "d57daf880aef",
   "speaker_korean": "노키아",
   "korean": "「…U★…X××t…"
  },
  {
   "key": "d021b318ff1c",
   "speaker_korean": "페이트",
   "korean": "(그렇군… 번역기는 ⟦1⟧통신기⟦2⟧에\n내장되어 있었던 거였군…"
  },
  {
   "key": "4993e127f4b7",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧노키아⟦2⟧! 괜찮아!?"
  },
  {
   "key": "87413256ee33",
   "speaker_korean": "노키아",
   "korean": "「⟦1⟧페이트 씨⟦2⟧… 왜\n이런 데에…"
  },
  {
   "key": "6af630504205",
   "speaker_korean": "페이트",
   "korean": "「그건 내가 할 소리잖아.\n이런 곳에 혼자 오다니…"
  },
  {
   "key": "7d1b95c27bb4",
   "speaker_korean": "노키아",
   "korean": "「오르골의…\n부품을 되찾으려고… 생각해서…\n⟦1⟧페이트 씨⟦2⟧한테만\n폐를 끼칠 수는\n없으니까…"
  },
  {
   "key": "8e7b3d612d13",
   "speaker_korean": "페이트",
   "korean": "「바보! 무슨 무모한 짓을 하는 거야!"
  },
  {
   "key": "3d76cc40fc5f",
   "speaker_korean": "페이트",
   "korean": "「이봐, ⟦1⟧노키아⟦2⟧!?\n정신 차려, ⟦3⟧노키아⟦4⟧!!"
  },
  {
   "key": "c5e505b9cb75",
   "speaker_korean": "노키아",
   "korean": "「…도…망…쳐…"
  },
  {
   "key": "e94ae9a8ff7f",
   "speaker_korean": "페이트",
   "korean": "「이거 큰일이군… 서둘러야겠어…"
  },
  {
   "key": "de4ca26bc64e",
   "speaker_korean": "페이트",
   "korean": "「후회는 나중에 하자.\n일단 여기서 나가자."
  },
  {
   "key": "9e5b6a0c3ee0",
   "speaker_korean": "페이트",
   "korean": "「자, 가자."
  },
  {
   "key": "d8270ad233cf",
   "speaker_korean": "페이트",
   "korean": "「방금 그건 ⟦1⟧페이즈건⟦2⟧이군.\n네놈이 ⟦3⟧노턴⟦4⟧이냐?"
  },
  {
   "key": "fc0fb4c2033c",
   "speaker_korean": "노턴",
   "korean": "「예스, 오브 코스.\n내가 바로 ⟦1⟧노턴 님⟦2⟧이시다!\n음~ 그립군.\n생생한 지구어를 듣는 게\n몇 달 만인가."
  },
  {
   "key": "6afb59f24615",
   "speaker_korean": "페이트",
   "korean": "「넌 뭐 하는 놈이냐?\n이 별 사람은 아니지?"
  },
  {
   "key": "1ecfd7f3c36e",
   "speaker_korean": "노턴",
   "korean": "「⟦1⟧은하연방⟦2⟧에 속하지 않는\n⟦3⟧레제르브 별⟦4⟧ 사람이란다, 꼬마야."
  },
  {
   "key": "378a62739ad6",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧레제르브 별⟦2⟧…\n들어본 적 있어."
  },
  {
   "key": "5643ae72c649",
   "speaker_korean": "페이트",
   "korean": "「쾌락주의자들이 모이는 행성으로,\n⟦1⟧은하연방⟦2⟧에 속하는 것을\n계속 거부하고 있는 별이지.\n너 같은 녀석이\n왜 이런 곳에 있는 거지.\n여긴 ⟦3⟧미개발 행성⟦4⟧이란 말이다!"
  },
  {
   "key": "98987f5ec0f3",
   "speaker_korean": "노턴",
   "korean": "「간단해… 불행한 사고가 있었을 뿐이지.\n제아무리 ⟦1⟧레제르브⟦2⟧라도 너무했다더군.\n그래서 ⟦3⟧레제르브⟦4⟧의 유형 행성으로\n보내져서 평생 외롭게 살 뻔했지 뭐야."
  },
  {
   "key": "0413c3997acb",
   "speaker_korean": "노턴",
   "korean": "「그런데 말이지.\n내가 타고 있던 호송선에\n엔진 트러블이 일어나서\n이 별에 추락해버린 거야."
  },
  {
   "key": "62016cc6ff8f",
   "speaker_korean": "노턴",
   "korean": "「믿을 수 있겠냐?\n난 그냥 엔진 코드를\n뒤죽박죽으로 바꿔놨을 뿐인데 말이야."
  },
  {
   "key": "1c1274d505cc",
   "speaker_korean": "노턴",
   "korean": "「그랬더니 글쎄, 멍청한 조종사 놈들이\n엔진을 완전히 박살내버렸다니까."
  },
  {
   "key": "c6f22e1a07cf",
   "speaker_korean": "노턴",
   "korean": "「칵! 난 그저 엔진 트러블을\n틈타서 도망치려고\n생각했을 뿐인데 말이야.\n결국 이 별이 내 감옥이\n되어버렸다 이거지."
  },
  {
   "key": "a870388ab104",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧노턴⟦2⟧!"
  },
  {
   "key": "e95dbcf8afa8",
   "speaker_korean": "노턴",
   "korean": "「음~?"
  },
  {
   "key": "90a74a55593d",
   "speaker_korean": "노턴",
   "korean": "「⟦1⟧노턴 님⟦2⟧이라고 해야지!"
  },
  {
   "key": "7eaa40850dde",
   "speaker_korean": "페이트",
   "korean": "「너를 호송하던\n다른 사람들은 어떻게 된 거지?\n몇 명 있었을 텐데."
  },
  {
   "key": "9bc7bba45742",
   "speaker_korean": "노턴",
   "korean": "「아아, 그놈들 말이냐.\n안됐지만, 뒈져버렸어.\n구조 신호 따위를 보내려고 했으니까\n천벌이 내린 거겠지.\n…쿠구웅~ 하고 말이야."
  },
  {
   "key": "b9e6fa0e08da",
   "speaker_korean": "노턴",
   "korean": "「뭐, 떨어져버린 건 어쩔 수 없지.\n할 수 없으니까\n이 별에 내가, 나에 의한\n나를 위한 나라를 만들기로\n한 거란 말씀이야.\n두 유 언더스탠드?"
  },
  {
   "key": "735e6f864dde",
   "speaker_korean": "페이트",
   "korean": "「그런 하찮은 이유로\n⟦1⟧위플 마을⟦2⟧을 습격했다고\n말하는 거냐!"
  },
  {
   "key": "ccca885279de",
   "speaker_korean": "노턴",
   "korean": "「뭐, 그런 거지.\n머리 좋은 녀석은\n내가 좋아하거든.\n그리고 그 하찮은\n이유 때문에 너도 여기서\n죽게 되는 거야."
  },
  {
   "key": "c966309660ed",
   "speaker_korean": "노턴",
   "korean": "「네가 타고 있던 ⟦1⟧탈출 포드⟦2⟧의 부품은\n이 몸이 유용하게 써줄 테니\n안심하고 잠들어도 좋다고."
  },
  {
   "key": "4d946e4a87e2",
   "speaker_korean": "페이트",
   "korean": "「큭!"
  },
  {
   "key": "2510f8718829",
   "speaker_korean": "노턴",
   "korean": "「응?\n뭐야, 그건?"
  },
  {
   "key": "64feb34ccd05",
   "speaker_korean": "???",
   "korean": "「오, 있다 있어."
  },
  {
   "key": "49e8e209a786",
   "speaker_korean": "???",
   "korean": "「정말이지, 도중에 구조 신호가 끊겼을 때는\n어쩌나 싶었다고.\n쾅, 쾅 하고 큰 소리로\n위치를 알려주지 않았다면\n언제 찾았을지 모를 일이었지…"
  },
  {
   "key": "28a75c16362a",
   "speaker_korean": "노턴",
   "korean": "「뭐냐 네놈은!\n⟦1⟧은하연방⟦2⟧ 놈이냐!?"
  },
  {
   "key": "53412456bb66",
   "speaker_korean": "노턴",
   "korean": "「그럼\n정체가 뭐냔 말이다!"
  },
  {
   "key": "660ce5f54657",
   "speaker_korean": "노턴",
   "korean": "「⟦1⟧클⟦2⟧, ⟦3⟧클라우스트로인⟦4⟧이라고?!"
  },
  {
   "key": "8a3fc351c3cb",
   "speaker_korean": "클리프",
   "korean": "「미안하지만, 자세한 얘기는 생략하자고.\n이쪽도 좀 바빠서 말이야."
  },
  {
   "key": "29b1ea8eca66",
   "speaker_korean": "클리프",
   "korean": "「뭐, 자잘한 건 신경 쓰지 마.\n아무튼, 내가 지명한 건\n바로 너란 말이지."
  },
  {
   "key": "8b655334b34d",
   "speaker_korean": "노턴",
   "korean": "「우, 움직이지 마!\n움직이면 쏜다!!"
  },
  {
   "key": "5909427d70bf",
   "speaker_korean": "클리프",
   "korean": "「하? 누가?\n누굴 쏜다는 거야?"
  },
  {
   "key": "bec0ee6e70e5",
   "speaker_korean": "노턴",
   "korean": "「그런 말 해봤자 속아 넘어갈까 보냐!\n⟦1⟧클라우스트로인⟦2⟧이 여기 있을 리 없다!\n어차피 넌 군대의 앞잡이겠지.\n그래, 틀림없어!"
  },
  {
   "key": "badeb4268bf8",
   "speaker_korean": "클리프",
   "korean": "「저기 말이야… 난 친절하니까\n미리 알려주는 건데,\n우리 ⟦1⟧클라우스트로인⟦2⟧한테는\n그런 총 따위는 안 통한다고."
  },
  {
   "key": "186afa5b9d66",
   "speaker_korean": "클리프",
   "korean": "「모르는 거냐?"
  },
  {
   "key": "7837ae9dde00",
   "speaker_korean": "노턴",
   "korean": "「우, 시끄러!"
  },
  {
   "key": "9680a83864d5",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧노턴⟦2⟧에 대해서는\n이 별 사람들에게 맡기자.\n빨리 오르골 부품을 찾아서\n⟦3⟧위플 마을⟦4⟧로 돌아가야…"
  },
  {
   "key": "afffb92f9bae",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧노턴⟦2⟧에 대해서는 이 별 사람들에게\n맡기자.\n빨리 ⟦3⟧위플 마을⟦4⟧로 돌아가야…"
  },
  {
   "key": "3fc0d56c208c",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧통신기⟦2⟧의 배터리를\n과부하시키면\n혹시…\n하지만 이 ⟦3⟧통신기⟦4⟧를\n잃으면 난 이제…"
  },
  {
   "key": "bbead38b6b73",
   "speaker_korean": "노키아",
   "korean": "「⟦1⟧미나⟦2⟧……"
  },
  {
   "key": "76fcc8966d9b",
   "speaker_korean": "페이트",
   "korean": "「상처는… 별로 심하지\n않은 것 같군… 다행이다."
  },
  {
   "key": "b75b1f22fe3c",
   "speaker_korean": "???",
   "korean": "「꼼짝 마 !!!"
  },
  {
   "key": "786e0082e033",
   "speaker_korean": "???",
   "korean": "「죽고 싶지 않으면 움직이지 마.\n그러면 아주 조금은\n더 오래 살 수 있을 거다."
  },
  {
   "key": "009a8db5fbfc",
   "speaker_korean": "???",
   "korean": "「내가?\n하필이면 ⟦1⟧은하연방⟦2⟧의 군인이라고?\n센스 없는 농담은 그만둬."
  },
  {
   "key": "a2025bf485eb",
   "speaker_korean": "???",
   "korean": "「내 이름은 ⟦1⟧클리프・피터⟦2⟧.\n⟦3⟧쿼크⟦4⟧에 소속된 ⟦5⟧클라우스트로인⟦6⟧이야."
  },
  {
   "key": "14d10d0b8d57",
   "speaker_korean": "페이트",
   "korean": "「왜 내 이름을!?"
  },
  {
   "key": "b2fcdf56ff50",
   "speaker_korean": "클리프",
   "korean": "「저 안쪽 남자… 그 ⟦1⟧페이트⟦2⟧라는 ⟦3⟧지구인⟦4⟧을\n데리고 돌아갈 수만 있으면 돼.\n네가 여기서 뭘 하든\n불평할 생각은 없다고."
  },
  {
   "key": "c3644b5dea42",
   "speaker_korean": "페이트",
   "korean": "「너란 녀석은…"
  },
  {
   "key": "d4454ef51400",
   "speaker_korean": "페이트",
   "korean": "「그럼, 어머니는?\n⟦1⟧소피아⟦2⟧는\n어떻게 된 거야!?"
  },
  {
   "key": "e41d248e7e0d",
   "speaker_korean": "클리프",
   "korean": "「그 여자에 대해서는 나도 몰라.\n네 ⟦1⟧탈출 포드⟦2⟧를 추적하는 것만으로도\n벅찼으니까 말이야."
  },
  {
   "key": "6c6b9af7dd5d",
   "speaker_korean": "페이트",
   "korean": "「뭔가… 뭔가 없을까…?\n그래!!"
  },
  {
   "key": "bb7a6bb3f750",
   "speaker_korean": "노키아",
   "korean": "「⟦1⟧페이트 씨⟦2⟧… 여기는\n위험해… 빨리 도망쳐…\n그 녀석이… 와…"
  },
  {
   "key": "bcb5a9f6bcf2",
   "speaker_korean": "클리프",
   "korean": "「바보 같으니. 그러니까 말했잖아!\n귀찮지만 어쩔 수 없지. 간다!"
  }
 ]
}