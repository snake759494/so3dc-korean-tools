{
 "batch_id": "batch_0112",
 "translations": [
  {
   "key": "111a13ce6a2a",
   "speaker_korean": null,
   "korean": "시술병기 보관창고"
  },
  {
   "key": "775aee748398",
   "speaker_korean": null,
   "korean": "이번 주 관리 책임자\n\n\n항마사단 『불꽃』 이라이자 슈텐노 님\n⟦P⟧"
  },
  {
   "key": "06f8b3e65459",
   "speaker_korean": null,
   "korean": "이번 주 관리 책임자\n\n\n⟦1⟧광아사단 『빛』⟦2⟧ 반 녹스 님\n⟦P⟧"
  },
  {
   "key": "97e22ff073e0",
   "speaker_korean": null,
   "korean": "이번 주 관리 책임자\n\n\n허공사단 『바람』 크레센트 라 샤롬 님\n⟦P⟧"
  },
  {
   "key": "7270507ffe56",
   "speaker_korean": null,
   "korean": "⟦1⟧시술병기⟦2⟧는 국가 최고 기밀입니다.\n관리 당번을 맡은 자는 책임지고 제대로\n관리해 주십시오.\n⟦P⟧그것을 지키지 못하는 자에게는 스피큘\n72발 형벌입니다.\n명심해 주십시오.\n⟦3⟧항마사단 『불꽃』 단장 루주 루이즈\n⟦P⟧"
  },
  {
   "key": "97ca1f598791",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(미리 모아둔 전기를 이용해서\n많은 물을 끓이고,\n그 힘을 이용해서 탄환을 날리는 건가….\n⟦P⟧압력이 일정 이상이 되지 않으면\n쏠 수 없으니까, 연사가 안 되는 게\n단점이군.\n⟦P⟧"
  },
  {
   "key": "ae3f37fe08ca",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(발열 효율도 올라갔고,\n화로도 더 높은 압력을 버틸 수 있게\n되어 있군.\n⟦P⟧원래 탄환 자체에 ⟦2⟧문장⟦3⟧이 새겨져\n있었으니까 위력은 높아….\n이 정도 문명 수준의 세계에서 쓰기엔\n이걸로 충분하겠지.\n⟦P⟧"
  },
  {
   "key": "8d1f31740caa",
   "speaker_korean": null,
   "korean": "⟦1⟧얼럿 주얼⟦2⟧을 손에 넣었다."
  },
  {
   "key": "3a69a4088788",
   "speaker_korean": null,
   "korean": "⟦1⟧세이프티 주얼⟦2⟧을 손에 넣었다."
  },
  {
   "key": "7a457d9f9099",
   "speaker_korean": "시술사(남)",
   "korean": "⟦1⟧「⟦2⟧디온 군⟦3⟧이 죽고 나서,\n정말 힘들어요.\n⟦P⟧그가 하던 몫의 일까지 떠맡게\n됐는데, 그게 이렇게까지\n힘들 줄은 꿈에도 몰랐어요.\n⟦P⟧게다가 뭐니 뭐니 해도, 이제 주위는 완전히\n여자들뿐이고…\n눈치 보이는 정도가 아니에요.\n⟦P⟧"
  },
  {
   "key": "f38d0e3f73cf",
   "speaker_korean": "시술사(남)",
   "korean": "⟦1⟧「제가 ⟦2⟧디온 군⟦3⟧을 대신하는 건,\n도저히 안 될 것 같아요.\n⟦P⟧그가 혼자서 그렇게나 많은\n일을 해내고 있었을 줄은,\n생각도 못 했어요.\n⟦P⟧"
  },
  {
   "key": "32b8ec6eb5be",
   "speaker_korean": "시술사(남)",
   "korean": "⟦1⟧「지금 저는, ⟦2⟧시술⟦3⟧의 힘을 응용한\n새로운 구동 기관을 연구\n하고 있어요.\n⟦P⟧전쟁도 이제 끝났으니까,\n역시 무기 같은 게 아니라\n모두에게 도움이 되는 연구를\n하고 싶거든요.\n⟦P⟧"
  },
  {
   "key": "c3a664eacbc2",
   "speaker_korean": "시술사(남)",
   "korean": "⟦1⟧「제가 ⟦2⟧디온 군⟦3⟧을 대신하는 건\n도저히 안 되겠지만,\n⟦P⟧그래도 저는 저 나름대로\n사람들에게 도움이 되는 일을, 힘닿는 데까지\n해 나갈 생각이에요.\n⟦P⟧"
  },
  {
   "key": "431c78ac6f65",
   "speaker_korean": "시술사(남)",
   "korean": "⟦1⟧「우선 당장은, ⟦2⟧비오의 바람⟦3⟧에 대한\n대책을 강구해야겠네요.\n⟦P⟧지금까지의 연구로, 그 파동은\n쿠르츠라 불리는 ⟦4⟧시문⟦5⟧을 가까이 대면\n궤도가 바뀐다는 걸 알고 있어요.\n⟦P⟧이제 남은 건, 그로 인한 파동의 궤도 변화를\n능숙하게 제어할 수만 있게 되면,\n문제는 전부 해결될 텐데요…\n⟦P⟧"
  },
  {
   "key": "2159d10f4b70",
   "speaker_korean": null,
   "korean": "디온의 방"
  },
  {
   "key": "5746ab2df441",
   "speaker_korean": null,
   "korean": "시술사의 방"
  },
  {
   "key": "a4a261af7307",
   "speaker_korean": null,
   "korean": "『⟦1⟧시문⟦2⟧의 상호 간섭』『⟦3⟧시력⟦4⟧의 융합에 대해』\n『자기장 내에서의 ⟦5⟧영력⟦6⟧의 궤도 변화』…\n⟦P⟧"
  },
  {
   "key": "a3d7462ef17e",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(어려워 보이는 책들뿐이네….\n⟦P⟧"
  },
  {
   "key": "e9db60c552f7",
   "speaker_korean": null,
   "korean": "『⟦1⟧시문⟦2⟧의 형상해석』『⟦3⟧시력⟦4⟧의 발생이론』\n『남에게 미움받지 않는 사람이 되자』\n『최소한의 몸가짐』…\n⟦P⟧"
  },
  {
   "key": "1fec5b66b54f",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(고생하고 있으려나?\n⟦P⟧"
  },
  {
   "key": "1254afb40a44",
   "speaker_korean": null,
   "korean": "『너구리·꿩 두루마리』\n『기린 두루마리』…\n⟦P⟧"
  },
  {
   "key": "9edd05624009",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(⟦2⟧시술⟦3⟧ 두루마리인 것 같은데….\n역시 자세히는 모르겠네.\n⟦P⟧"
  },
  {
   "key": "f14250be4ca9",
   "speaker_korean": "디온",
   "korean": "⟦1⟧「아… 미……\n미안…\n⟦P⟧"
  },
  {
   "key": "864b2e9b7b74",
   "speaker_korean": "디온",
   "korean": "⟦1⟧「…… ……\n⟦P⟧"
  },
  {
   "key": "9c079b449ded",
   "speaker_korean": null,
   "korean": "『이론치 전집 전 12권』\n『초! 자연학 연표 1~4권』\n⟦P⟧"
  },
  {
   "key": "f25feca09ae5",
   "speaker_korean": "의사",
   "korean": "⟦1⟧「상처가 이 정도로 깊으면,\n아마도, 이제…\n⟦P⟧최선은 다하겠지만,\n각오만은 해\n두십시오.\n⟦P⟧"
  },
  {
   "key": "a0fd877e1b25",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧디온⟦2⟧!!"
  },
  {
   "key": "501401590491",
   "speaker_korean": "페이트",
   "korean": "「죄송합니다…\n그래서 어떻습니까, 선생님?"
  },
  {
   "key": "e6771d8e04fb",
   "speaker_korean": "의사",
   "korean": "「예, 지금은 조금 안정됐습니다만,\n매우 위험한 상태인 것은\n틀림없습니다.\n어떤 공격을 받았는지…\n신체 조직이 회복 불가능할 정도로\n파괴되어 있습니다.\n저희 지식으로는 도저히…"
  },
  {
   "key": "1a49433bcab7",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧디온⟦2⟧, 힘내!\n지금 ⟦3⟧아미나⟦4⟧를 데려올 테니까!!"
  },
  {
   "key": "391ec9e25b47",
   "speaker_korean": "의사",
   "korean": "「죄송합니다만, 조용히 해 주세요.\n지금 막 잠들었거든요."
  },
  {
   "key": "48759b6f4966",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧디온⟦2⟧… 콜록."
  },
  {
   "key": "c05c120df98d",
   "speaker_korean": "디온",
   "korean": "「⟦1⟧아미……나⟦2⟧…"
  },
  {
   "key": "7de171a544fe",
   "speaker_korean": "디온",
   "korean": "「미…안…\n약속…못 지켰…어…"
  },
  {
   "key": "27dcb57609e2",
   "speaker_korean": "디온",
   "korean": "「⟦1⟧넬…님⟦2⟧…"
  },
  {
   "key": "2ba0d45f5f63",
   "speaker_korean": "디온",
   "korean": "「나도…⟦1⟧아리그리프⟦2⟧에 있는… 너와…\n다시 만날 수 있도록…이라고…\n그러기…위해…서도…전쟁을…끝내…\n려…고…"
  },
  {
   "key": "2f3f3cf34cf3",
   "speaker_korean": "디온",
   "korean": "「전쟁…은…끝내지 못했지만…\n너를…만났으니까…소원…은…\n이루어진 거네…후후…"
  },
  {
   "key": "af76e19826d9",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧디온⟦2⟧…\n내 소원도, 그래."
  },
  {
   "key": "fec4c0c256a2",
   "speaker_korean": "페이트",
   "korean": "「그런… 거짓말이지, ⟦1⟧디온⟦2⟧!!"
  },
  {
   "key": "b9f43bae0667",
   "speaker_korean": "페이트",
   "korean": "「선생님!!"
  },
  {
   "key": "2b1db5ecd66b",
   "speaker_korean": "페이트",
   "korean": "「그런… 겨우 만났는데…\n이제부터라고 했는데…!!\n⟦1⟧아미나⟦2⟧, 미안해, 미안해.\n내가 정신 못 차려서… 내가!!"
  },
  {
   "key": "59cd6ed3a54d",
   "speaker_korean": "페이트",
   "korean": "「으아아아아아아앗!!"
  },
  {
   "key": "c123cb88e16c",
   "speaker_korean": "넬",
   "korean": "「이건가?"
  },
  {
   "key": "56f28b62d8a0",
   "speaker_korean": "디온",
   "korean": "「죄송합니다…\n그 상자…안에……"
  },
  {
   "key": "c5fa5db568a3",
   "speaker_korean": "아미나",
   "korean": "「괜찮아… 말하지 마…"
  },
  {
   "key": "0a0aa4f98f85",
   "speaker_korean": "디온",
   "korean": "「만나서…다행이야…"
  },
  {
   "key": "8102152df67f",
   "speaker_korean": "디온",
   "korean": "「⟦1⟧아미…나⟦2⟧……"
  },
  {
   "key": "5a2fac05bd11",
   "speaker_korean": "아미나",
   "korean": "「…응."
  },
  {
   "key": "3145b4920e5a",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧!?"
  },
  {
   "key": "5df5b3b1eca5",
   "speaker_korean": "페이트",
   "korean": "「…⟦1⟧아미나⟦2⟧?"
  },
  {
   "key": "bf2abff2e195",
   "speaker_korean": "페이트",
   "korean": "「거짓말이지?"
  }
 ]
}