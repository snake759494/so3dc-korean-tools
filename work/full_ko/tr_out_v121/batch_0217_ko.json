{
 "batch_id": "batch_0217",
 "translations": [
  {
   "key": "26d8ac35d31f",
   "speaker_korean": null,
   "korean": "⟦1⟧・트롤리 몬스터에서 내리기"
  },
  {
   "key": "8a1b8e03aadb",
   "speaker_korean": null,
   "korean": "⟦1⟧・안 내리기"
  },
  {
   "key": "cbba614ab854",
   "speaker_korean": "페이트",
   "korean": "이건… ⟦1⟧컬소어 산 동굴⟦2⟧에 있던\n⟦3⟧트롤리 몬스터⟦4⟧랑 닮았는데…\n혹시 또 탈 수 있으려나?"
  },
  {
   "key": "8c0834645973",
   "speaker_korean": null,
   "korean": "모젤의 고대 유적 지하수맥"
  },
  {
   "key": "3e98df2480ef",
   "speaker_korean": "페이트",
   "korean": "문이…\n그렇군, 이런 장치였나."
  },
  {
   "key": "cc1d7c23acc1",
   "speaker_korean": "페이트",
   "korean": "이건…!!"
  },
  {
   "key": "ee4d0f4bf694",
   "speaker_korean": "페이트",
   "korean": "후우…\n그럭저럭 해치웠군."
  },
  {
   "key": "ac6ac03dec90",
   "speaker_korean": "페이트",
   "korean": "이 앞에는 대체\n뭐가 있는 걸까…"
  },
  {
   "key": "e8f304c9b001",
   "speaker_korean": "페이트",
   "korean": "크리스탈이 드러나 있군.\n희미하게 무지개색으로 빛나고 있어…"
  },
  {
   "key": "6a0eb1cf7462",
   "speaker_korean": null,
   "korean": "⟦1⟧・트롤리 몬스터에 타기"
  },
  {
   "key": "c46e11228ee6",
   "speaker_korean": null,
   "korean": "⟦1⟧트래핑 카드 EX6⟦2⟧을 손에 넣었다"
  },
  {
   "key": "975f1fc1d636",
   "speaker_korean": null,
   "korean": "⟦1⟧스타 탈리스만⟦2⟧을 손에 넣었다"
  },
  {
   "key": "a7fe0e315658",
   "speaker_korean": null,
   "korean": "⟦1⟧160000폴⟦2⟧을 손에 넣었다"
  },
  {
   "key": "c51fb9cfcb58",
   "speaker_korean": null,
   "korean": "⟦1⟧생명의 반지⟦2⟧를 얻었다"
  },
  {
   "key": "3c5dd05f48da",
   "speaker_korean": null,
   "korean": "행성 스트림"
  },
  {
   "key": "c4ce89216723",
   "speaker_korean": "마리아",
   "korean": "예상대로 우글우글하네.\n다들 각오는 됐어?"
  },
  {
   "key": "c2b119214251",
   "speaker_korean": "페이트",
   "korean": "단숨에 ⟦1⟧타임 게이트⟦2⟧까지\n간다!!"
  },
  {
   "key": "42e0259ebd8c",
   "speaker_korean": "마리아",
   "korean": "그래!"
  },
  {
   "key": "ecb3164cb7f4",
   "speaker_korean": "클리프",
   "korean": "나한테 맡겨두라고!"
  },
  {
   "key": "9c754c3e5d9b",
   "speaker_korean": "넬",
   "korean": "좋아!"
  },
  {
   "key": "70713ecf4873",
   "speaker_korean": "알벨",
   "korean": "흥, 뒤처지지 마라."
  },
  {
   "key": "aebd5880d903",
   "speaker_korean": "로저",
   "korean": "오!\n화끈하게 날려버릴 거라고!"
  },
  {
   "key": "7bef19791168",
   "speaker_korean": "록시",
   "korean": "이 프로젝트는 ⟦1⟧우주력⟦2⟧ 752년에 실시한\n⟦3⟧행성 스트림⟦4⟧ 탐사 결과로,\n시작된 것입니다."
  },
  {
   "key": "8db0efbd01c0",
   "speaker_korean": null,
   "korean": "⟦1⟧행성 스트림⟦2⟧은 알려진 대로,\n시간을 오갈 수 있는\n타임머신 같은 존재인\n『⟦3⟧타임 게이트⟦4⟧』가 있는 미지의 별입니다."
  },
  {
   "key": "0f6b80d9f869",
   "speaker_korean": null,
   "korean": "752년 조사는 ⟦1⟧타임 게이트⟦2⟧를 포함해,\n⟦3⟧행성 스트림⟦4⟧ 전역 탐사가 목적이었습니다."
  },
  {
   "key": "25393af73c48",
   "speaker_korean": null,
   "korean": "⟦1⟧타임 게이트⟦2⟧는 나름의 의지가 있습니다."
  },
  {
   "key": "ad90c9423ead",
   "speaker_korean": null,
   "korean": "여기까지는 기존 연구로 알려졌지만,\n게이트를 대체 누가,\n무슨 목적으로 만들었는지에 대해\n답할 수 있는 연구자는 없었습니다."
  },
  {
   "key": "46b706517be8",
   "speaker_korean": null,
   "korean": "하지만 752년 조사를 통해,\n그것이 밝혀진 것입니다."
  },
  {
   "key": "28a04883dc6a",
   "speaker_korean": "클리프",
   "korean": "처음 듣는 얘기군.\n그런 게 밝혀졌으면,\n진작 대서특필됐을 텐데 말이지."
  },
  {
   "key": "420d4586494c",
   "speaker_korean": "클리프",
   "korean": "뭐야, 이건……"
  },
  {
   "key": "cbeafd2a3ed7",
   "speaker_korean": "마리아",
   "korean": "아까 그 지진 때문이겠지.\n꼴이 말이 아니네."
  },
  {
   "key": "fbfc956b9655",
   "speaker_korean": "소피아",
   "korean": "셔틀은 괜찮을까?"
  },
  {
   "key": "26af9e93096d",
   "speaker_korean": "페이트",
   "korean": "조심해서 나아가자.\n아까 그놈들이 또 나타날지도 몰라."
  },
  {
   "key": "89aedbc8e140",
   "speaker_korean": "소피아",
   "korean": "어…?"
  },
  {
   "key": "d76119248fba",
   "speaker_korean": "넬",
   "korean": "이거… 곤란하게 됐네."
  },
  {
   "key": "724801ffdf54",
   "speaker_korean": "로저",
   "korean": "이거 장난 아니잖냐…"
  },
  {
   "key": "25b16fbeac33",
   "speaker_korean": "알벨",
   "korean": "진짜냐… 장난치지 마라…"
  },
  {
   "key": "23bb5fb7f376",
   "speaker_korean": "페이트",
   "korean": "…통신은?"
  },
  {
   "key": "6d46b060e625",
   "speaker_korean": "마리아",
   "korean": "잠깐 기다려."
  },
  {
   "key": "5bfcdc0ead0f",
   "speaker_korean": "페이트",
   "korean": "젠장! 여기까지 와서!!"
  },
  {
   "key": "15db785c090c",
   "speaker_korean": "마리아",
   "korean": "뭔가… 들려!?"
  },
  {
   "key": "666e0cc543ad",
   "speaker_korean": "마리에타",
   "korean": "…더…마리…\n들리…나…요…"
  },
  {
   "key": "ad6a7771f034",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧마리에타⟦2⟧!?"
  },
  {
   "key": "2348b409990a",
   "speaker_korean": "마리에타",
   "korean": "…아! …다들…\n⟦1⟧마리아⟦2⟧…연결됐…어요!"
  },
  {
   "key": "9ceef644066f",
   "speaker_korean": "마리아",
   "korean": "⟦1⟧마리에타⟦2⟧!\n⟦3⟧디프로⟦4⟧, 들려?"
  },
  {
   "key": "9900b4801806",
   "speaker_korean": "마리에타",
   "korean": "들리…네요! …리더!!\n⟦1⟧미라쥬 씨⟦2⟧!!"
  },
  {
   "key": "17a577fdf76c",
   "speaker_korean": "클리프",
   "korean": "야야, 어쩔 건데?"
  },
  {
   "key": "345802a2a11f",
   "speaker_korean": "마리아",
   "korean": "그래. 그쪽도 무사한 모양이네."
  },
  {
   "key": "497357ee6ff9",
   "speaker_korean": "마리에타",
   "korean": "네!\n그래도 정말 힘들었다구요!!"
  },
  {
   "key": "4b591b7d9edf",
   "speaker_korean": "마리아",
   "korean": "자세한 얘기는 나중에 듣을게.\n서둘러서 데리러 와 줄래?"
  },
  {
   "key": "12dbaf0b1f1e",
   "speaker_korean": "미라쥬",
   "korean": "알겠습니다."
  },
  {
   "key": "42ac24542221",
   "speaker_korean": "미라쥬",
   "korean": "여러분, 무사하셨군요.\n걱정했어요."
  },
  {
   "key": "39db586d727e",
   "speaker_korean": "마리에타",
   "korean": "맞아요, ⟦1⟧아쿠아엘리⟦2⟧의 반응이\n사라져서, 무슨 일인가 했어요…"
  },
  {
   "key": "0417990ddafc",
   "speaker_korean": "마리에타",
   "korean": "네? 하지만 그쪽으로 향했을 때\n셔틀은 어떻게 된 거예요?"
  },
  {
   "key": "a44d2e52d0cd",
   "speaker_korean": "마리아",
   "korean": "이쪽도 이래저래 사정이 있었어.\n미안하지만, 시간이 별로 없어."
  },
  {
   "key": "78caeb3e9f85",
   "speaker_korean": "마리에타",
   "korean": "죄송해요!\n최고 속도로 가겠습니다!!"
  },
  {
   "key": "edbe48bf175f",
   "speaker_korean": "미라쥬",
   "korean": "그럼, 나중에…"
  },
  {
   "key": "e3220d97a4a9",
   "speaker_korean": "마리에타",
   "korean": "리더, 기다리게 해드렸네요!\n지금 바로 전송 수용하겠습니다!!"
  },
  {
   "key": "6ef12935c28c",
   "speaker_korean": "스프레",
   "korean": "혹시 쬐끔…\n위기였다거나 그런 거야?"
  }
 ]
}