{
 "batch_id": "batch_0143",
 "translations": [
  {
   "key": "ff4ca35acfe1",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「오로로~잉!\n⟦P⟧"
  },
  {
   "key": "a958b208cd1f",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「정밀 기계에 체액 좀\n뿌리지 말랬잖아!\n⟦P⟧"
  },
  {
   "key": "32874ffb33fb",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「저기, 그 육각렌치 좀 줘.\n⟦P⟧"
  },
  {
   "key": "2d901a620bb9",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「네네.\n⟦P⟧"
  },
  {
   "key": "d4bb4ea0b668",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「아, 미안.\n그 너트도.\n⟦P⟧"
  },
  {
   "key": "373595b88df9",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「이건가?\n⟦P⟧"
  },
  {
   "key": "38e3c81b6251",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「그럼, 슬슬 마무리\n작업으로 들어가지.\n⟦P⟧"
  },
  {
   "key": "dedc80de2200",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「오케이.\n화끈하게 해버려.\n⟦P⟧"
  },
  {
   "key": "54e732f9cce5",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「그럼!\n⟦P⟧"
  },
  {
   "key": "146fed752b87",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「왠지, 작업 속도가\n훨씬 빨라졌네.\n⟦P⟧"
  },
  {
   "key": "38637bf48b6f",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「혹시 말이야…\n처음부터 우리 둘이서만\n하는 게 낫지 않았을까?\n⟦P⟧"
  },
  {
   "key": "b3b5aec123a8",
   "speaker_korean": "메릴&바닐라",
   "korean": "⟦1⟧「…… …… …… ……\n⟦P⟧"
  },
  {
   "key": "0a758c8239a1",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「꽤 괜찮게 나온 것\n같은데, 어때?\n⟦P⟧"
  },
  {
   "key": "3e307b36d42f",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「호오…\n안쪽이 이렇게 생겼구나.\n⟦P⟧역시 구형이라\n모르는 부분도 많네.\n⟦P⟧"
  },
  {
   "key": "d976e774acfa",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「좀 오래된 타입이지만,\n그게 매력이라고 우기는\n사람도 있으니까.\n⟦P⟧완벽하게 수리해서\n그런 사람들한테 팔면,\n대체 얼마나 값이 붙을지.\n지금부터 기대되는군.\n⟦P⟧"
  },
  {
   "key": "2d1936d5a347",
   "speaker_korean": "발명왕 데지슨",
   "korean": "⟦1⟧「갑자기 팔 생각 따위\n하지 마라~!\n⟦P⟧"
  },
  {
   "key": "aa7df4dac981",
   "speaker_korean": "바닐라",
   "korean": "⟦1⟧「이제 완벽해.\n정말 설계도 그대로군.\n⟦P⟧"
  },
  {
   "key": "55c2f0a5a62a",
   "speaker_korean": "드라이브",
   "korean": "⟦1⟧「이건 여기서만 하는 얘긴데…\n형님 상대는 대충\n해주면 되는 거슈.\n⟦P⟧⟦2⟧로저⟦3⟧ 형님의\n제멋대로인 성격에 다 맞춰주다간\n지치는 거슈.\n⟦P⟧"
  },
  {
   "key": "99395ef08110",
   "speaker_korean": "멜토",
   "korean": "⟦1⟧「⟦2⟧페이트 공⟦3⟧은\n무엇 하나 신경 쓰실\n필요 없소이다.\n⟦P⟧이번 일은 모두, 그러니까…\n별들의 인연이 이끄는 대로\n움직이고 있는 것이오.\n⟦P⟧"
  },
  {
   "key": "df0fe2467309",
   "speaker_korean": "살인 셰프",
   "korean": "⟦1⟧「시시시, 뼈다 딱딱하네!\n더더, 잘 드는 식칼 원한다!\n⟦P⟧"
  },
  {
   "key": "ec4553072c4e",
   "speaker_korean": null,
   "korean": "⟦1⟧만능 식칼⟦2⟧을 보여주겠습니까?\n⟦P⟧"
  },
  {
   "key": "07656b9e8275",
   "speaker_korean": null,
   "korean": "⟦1⟧만능 식칼⟦2⟧을 건넬까요?\n⟦P⟧"
  },
  {
   "key": "7fb3db8882fe",
   "speaker_korean": null,
   "korean": "⟦1⟧・이걸 써 줘."
  },
  {
   "key": "bb6d467478a8",
   "speaker_korean": null,
   "korean": "⟦1⟧・위험해서 안 줄래."
  },
  {
   "key": "d3773445dd5e",
   "speaker_korean": "살인 셰프",
   "korean": "⟦1⟧「오우!\n너, 아주 좋은 식칼을 가지고 있네!\n내놔 내놔, 어서 내놔!\n⟦P⟧"
  },
  {
   "key": "4670268ff9f4",
   "speaker_korean": "살인 셰프",
   "korean": "⟦1⟧「원한다, 원한다!\n그거라면 뭐든 싹둑이다!\n⟦P⟧"
  },
  {
   "key": "ac34a6fc14b5",
   "speaker_korean": null,
   "korean": "크리에이터가 살인 셰프와 계약을 맺었다.\n⟦P⟧"
  },
  {
   "key": "01c2a83f5ce1",
   "speaker_korean": "살인 셰프",
   "korean": "⟦1⟧「이걸로 전부 다져버리겠네♪\n요리와 참극은 한 끗 차이다!\n시시시시…\n⟦P⟧"
  },
  {
   "key": "6888e9b294dd",
   "speaker_korean": "도로우그린의 요리사",
   "korean": "⟦1⟧「뼈다 딱딱하네, 야채 들러붙네.\n⟦2⟧인간⟦3⟧의 요리, 너무너무 어렵네.\n시시시시…\n⟦P⟧"
  },
  {
   "key": "14a3468bc508",
   "speaker_korean": "메릴",
   "korean": "⟦1⟧「좋아, 네 이름은 ⟦2⟧이자크⟦3⟧.\n⟦4⟧그리텐 왕국⟦5⟧의 말로 다정한 마음을 지닌\n강철의 기사라는 뜻이야.\n⟦P⟧"
  },
  {
   "key": "d4aa7725aece",
   "speaker_korean": null,
   "korean": "⟦1⟧태고의 서적1⟦2⟧을 손에 넣었다."
  },
  {
   "key": "0d52c9cb6729",
   "speaker_korean": null,
   "korean": "⟦1⟧태고의 서적2⟦2⟧를 손에 넣었다."
  },
  {
   "key": "5d82c6244894",
   "speaker_korean": null,
   "korean": "⟦1⟧태고의 서적3⟦2⟧을 손에 넣었다."
  },
  {
   "key": "8ce369c017fd",
   "speaker_korean": null,
   "korean": "⟦1⟧태고의 서적4⟦2⟧를 손에 넣었다."
  },
  {
   "key": "ad8d6718765a",
   "speaker_korean": null,
   "korean": "⟦1⟧태고의 서적5⟦2⟧를 손에 넣었다."
  },
  {
   "key": "cb87d54abcf9",
   "speaker_korean": null,
   "korean": "⟦1⟧태고의 서적6⟦2⟧을 손에 넣었다."
  },
  {
   "key": "4c2a52886755",
   "speaker_korean": null,
   "korean": "⟦1⟧태고의 서적7⟦2⟧을 손에 넣었다."
  },
  {
   "key": "576eed174487",
   "speaker_korean": "로저",
   "korean": "「으음…"
  },
  {
   "key": "257c5150e6cc",
   "speaker_korean": "클리프",
   "korean": "「여어."
  },
  {
   "key": "5bf81d44fd6b",
   "speaker_korean": "로저",
   "korean": "「오! 너희들!\n잘 왔잖아!!"
  },
  {
   "key": "49ae6ea4f8c3",
   "speaker_korean": "멜토",
   "korean": "「……흐음."
  },
  {
   "key": "4fa3ad173809",
   "speaker_korean": "드라이브",
   "korean": "「형님, 이 사람들은\n대체 누구인 거슈?"
  },
  {
   "key": "0d184ad48cee",
   "speaker_korean": "로저",
   "korean": "「오, 이놈들은 내 부하 후보다.\n뭐, 너희들 후배인 셈이잖아."
  },
  {
   "key": "699070d7a63f",
   "speaker_korean": "클리프",
   "korean": "「하?"
  },
  {
   "key": "c3481de6e80e",
   "speaker_korean": "멜토",
   "korean": "「…거짓말이겠구려."
  },
  {
   "key": "f858d6a5dfb9",
   "speaker_korean": "드라이브",
   "korean": "「형님… 진짜로는\n어떻게 된 거슈?"
  },
  {
   "key": "815a167dac3f",
   "speaker_korean": "로저",
   "korean": "「미안, 거짓말이잖아…\n이놈들한테는 저번의 그 사나이 승부를\n도와달라고 했었어."
  },
  {
   "key": "2ecaa8852094",
   "speaker_korean": "드라이브",
   "korean": "「허어, 그렇구먼.\n사실 좀 이상하다고 생각했었던 거슈.\n이 사람들, 유난히 강해 보였으니까 말이슈."
  },
  {
   "key": "065d522c070c",
   "speaker_korean": "페이트",
   "korean": "「나는 ⟦1⟧페이트 라인갓⟦2⟧이야.\n잘 부탁해."
  },
  {
   "key": "40cff122f340",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧마리아 트레이터⟦2⟧야."
  },
  {
   "key": "2350783cb071",
   "speaker_korean": "드라이브",
   "korean": "「반갑습니다, 처음 뵙는 거슈.\n저는 ⟦1⟧드라이브⟦2⟧라고 하는 거슈.\n⟦3⟧로저⟦4⟧ 형님의 첫째 부하인 거슈."
  },
  {
   "key": "2591ddab01ac",
   "speaker_korean": "멜토",
   "korean": "「⟦1⟧멜토⟦2⟧라 하오.\n운명이 ⟦3⟧로저 공⟦4⟧을 이끄는\n안내자이오.\n아니, 끝까지 말하지 마시오.\n나에게는 모든 것이 보이는 것이오."
  },
  {
   "key": "aac62a529da6",
   "speaker_korean": "드라이브",
   "korean": "「아아, 이 녀석은 쬐끔\n별을 읽는 힘이 있는 거슈.\n가끔 이상한 소리도 하지만\n신경 쓰지 말아 주는 거슈."
  },
  {
   "key": "2849d9958f2f",
   "speaker_korean": "페이트",
   "korean": "「호오… 별을 읽는 힘이라……"
  },
  {
   "key": "c47ecce68aee",
   "speaker_korean": "클리프",
   "korean": "「너희들, 대체 뭘 하고 있었던 거냐?"
  },
  {
   "key": "0290ebcd3d71",
   "speaker_korean": "로저",
   "korean": "「오! 완전 불타는 아이템을\n발견했잖아!"
  },
  {
   "key": "710b1c9dc0d1",
   "speaker_korean": "드라이브",
   "korean": "「찾아낸 건 형님이 아니라\n⟦1⟧샤로우그림족⟦2⟧의 게로로 씨\n인 거슈, 사실은…"
  },
  {
   "key": "e129c898cef6",
   "speaker_korean": "로저",
   "korean": "「이 등신아!\n말 안 하면 모르잖아!!"
  },
  {
   "key": "0d904f8baeda",
   "speaker_korean": "멜토",
   "korean": "「……이것이오."
  },
  {
   "key": "92d22b629959",
   "speaker_korean": "넬",
   "korean": "「책?"
  },
  {
   "key": "cb90a07292f4",
   "speaker_korean": "드라이브",
   "korean": "「그런 거슈."
  },
  {
   "key": "50a315f9bd72",
   "speaker_korean": "로저",
   "korean": "「호수 밑 유적에서 발굴된 수수께끼의 서적…\n완전 모험의 냄새가 나잖아!\n근데 무슨 뜻인지 잘 모르겠단 말이지."
  },
  {
   "key": "5c0d212a7cea",
   "speaker_korean": "페이트",
   "korean": "「의미를 모르겠다고?"
  },
  {
   "key": "39861b1d10ad",
   "speaker_korean": "드라이브",
   "korean": "「잘 모르는 글자로 쓰여 있어서\n⟦1⟧멜토⟦2⟧밖에 못 읽는 데다, 전부 제대로\n읽지는 못하는 거슈.\n어쩐지 장소를 나타내고 있다는 건\n알 것 같은 거슈."
  },
  {
   "key": "896ed6d164ae",
   "speaker_korean": "클리프",
   "korean": "「확실히 못 읽겠는데…\n뭐라고 쓰여 있는 거냐?"
  }
 ]
}