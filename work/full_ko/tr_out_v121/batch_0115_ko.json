{
 "batch_id": "batch_0115",
 "translations": [
  {
   "key": "e0b3c6d560b1",
   "speaker_korean": null,
   "korean": "인체에 미치는 ⟦1⟧시술⟦2⟧ 영향에 대해\n적혀 있다.\n⟦P⟧"
  },
  {
   "key": "ed64f4a6d4bf",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧(온몸의 혈자리를 그린 그림,\n같은 건가?\n⟦P⟧"
  },
  {
   "key": "f34721a79386",
   "speaker_korean": "에레나",
   "korean": "⟦1⟧「응… 미안.\n잠깐, 자고 올게.\n⟦P⟧뭔가…\n피곤해서 말이야.\n⟦P⟧"
  },
  {
   "key": "ac4fb1ac3d4f",
   "speaker_korean": "에레나",
   "korean": "⟦1⟧「있잖아…\n⟦P⟧그 애가 시끄럽게 구니까,\n여왕 폐하 허락을 받고서\n다시 와줘. 미안해.\n⟦P⟧"
  },
  {
   "key": "a99e9a615c0f",
   "speaker_korean": "넬",
   "korean": "「저분이 시하츠 제1시술병기개발부의\n부장을 맡고 계신 ⟦1⟧에레나 여사⟦2⟧야."
  },
  {
   "key": "fefadb5707c0",
   "speaker_korean": "클리프",
   "korean": "「⟦1⟧클리프 피터⟦2⟧다.\n잘 부탁한다."
  },
  {
   "key": "63c90287d28e",
   "speaker_korean": "페이트",
   "korean": "「처음 뵙겠습니다.\n⟦1⟧페이트 라인갓⟦2⟧입니다."
  },
  {
   "key": "cc7721a56639",
   "speaker_korean": "넬",
   "korean": "「하지만 지식만큼은 확실합니다."
  },
  {
   "key": "665de5ad730e",
   "speaker_korean": "에레나",
   "korean": "「보고서는 읽었어요.\n당신의 정보를 의심하지는 않아요.\n뭐니 뭐니 해도 이 나라에서는,\n아직도 그 금속 조각의 분석이\n이루어지지 않고 있으니까……"
  },
  {
   "key": "ec2fb87d8989",
   "speaker_korean": "디온",
   "korean": "「부르셨습니까, ⟦1⟧에레나 님⟦2⟧."
  },
  {
   "key": "7a361a4a9e07",
   "speaker_korean": "에레나",
   "korean": "「⟦1⟧디온⟦2⟧이구나.\n들어와도 돼."
  },
  {
   "key": "b84a02051d2a",
   "speaker_korean": "에레나",
   "korean": "「그런가 보네.\n큰 쪽이 ⟦1⟧클리프 씨⟦2⟧고,\n작은 쪽이 ⟦3⟧페이트 씨⟦4⟧래."
  },
  {
   "key": "85c1b5d63a99",
   "speaker_korean": "디온",
   "korean": "「처음 뵙겠습니다, ⟦1⟧디온⟦2⟧입니다.\n두 분 모두 박식한 분들이라고 들었습니다.\n부디 저희에게 지혜를 빌려주십시오."
  },
  {
   "key": "31893ba830d3",
   "speaker_korean": "에레나",
   "korean": "「이렇게 갑자기 미안한데,\n지금 연구 중인 ⟦1⟧시술 병기⟦2⟧ 좀 봐줄래요?\n구조 쪽에서 고민되는 부분이\n몇 군데 있는 것 같거든요."
  },
  {
   "key": "7e4fd394b495",
   "speaker_korean": "페이트",
   "korean": "「아, 예."
  },
  {
   "key": "0320ec2bc612",
   "speaker_korean": "에레나",
   "korean": "「⟦1⟧디온⟦2⟧… 안내해 드려.\n나는 지금 자리를 뜰 수가 없어서."
  },
  {
   "key": "b3c95802a3ec",
   "speaker_korean": "디온",
   "korean": "「알겠습니다.\n……이쪽으로 오시죠."
  },
  {
   "key": "9a06044f89f7",
   "speaker_korean": "디온",
   "korean": "「그런데 놀랐어요.\n좀 더 나이 드신 분일 거라고\n생각했었거든요."
  },
  {
   "key": "dc08030808ea",
   "speaker_korean": "페이트",
   "korean": "「아니, 자네야말로 그 나이에\n수석 연구원이라니 대단한 것 같은데."
  },
  {
   "key": "4cb0e8777348",
   "speaker_korean": "디온",
   "korean": "「별로 대단한 건 아니에요.\n저 같은 건 ⟦1⟧에레나 님⟦2⟧에 비하면\n아직 풋내기나 다름없는걸요."
  },
  {
   "key": "54173bb0ef66",
   "speaker_korean": "에레나",
   "korean": "「자자, 쓸데없는 얘기 그만하고,\n얼른 안내해 드리렴."
  },
  {
   "key": "c4182cafa26f",
   "speaker_korean": "디온",
   "korean": "「네, 넵! 죄송합니다!!"
  },
  {
   "key": "a6355c85aa45",
   "speaker_korean": "디온",
   "korean": "「혼나 버렸네요.\n가시죠. 이쪽입니다."
  },
  {
   "key": "c2dadc890735",
   "speaker_korean": "에레나",
   "korean": "「⟦1⟧시술 병기⟦2⟧ 개발을 지휘하고 있는\n⟦3⟧에레나 후라이야⟦4⟧예요."
  },
  {
   "key": "5300015a72a0",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧에레나 님⟦2⟧,\n이 두 사람이 보고드린 기술자입니다."
  },
  {
   "key": "34e4880a8436",
   "speaker_korean": "에레나",
   "korean": "「잘 부탁해요."
  },
  {
   "key": "40a7e44fc2f3",
   "speaker_korean": "에레나",
   "korean": "「……놀랐네.\n생각했던 것보다 훨씬 젊네."
  },
  {
   "key": "61b645836451",
   "speaker_korean": "디온",
   "korean": "「네, 실례하겠습니다."
  },
  {
   "key": "b25559b63b52",
   "speaker_korean": "에레나",
   "korean": "「이쪽은 시술 병기 개발 수석 연구원이자,\n제 오른팔이기도 한 ⟦1⟧디온⟦2⟧이에요."
  },
  {
   "key": "3f7b83051010",
   "speaker_korean": "디온",
   "korean": "「이분들이신가요?"
  },
  {
   "key": "688e0fc6218d",
   "speaker_korean": "에레나",
   "korean": "「이런… ⟦1⟧디온⟦2⟧."
  },
  {
   "key": "4697afc235e0",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧에레나 님⟦2⟧, 이 두 사람이 보고드린 기술자입니다."
  },
  {
   "key": "d1e7b076bde7",
   "speaker_korean": "에레나",
   "korean": "「놀랐네.\n생각했던 것보다 훨씬 젊네."
  },
  {
   "key": "fd74fd4f75f3",
   "speaker_korean": "에레나",
   "korean": "「보고서는 읽었어요.\n당신의 정보를 의심하지는 않아요."
  },
  {
   "key": "b3ccfa634e06",
   "speaker_korean": "에레나",
   "korean": "「뭐니 뭐니 해도 이 나라에서는,\n아직도 그 금속 조각의 분석이\n이루어지지 않고 있으니까……\n그들의 지식에 기댈 수밖에\n없는 거지, 뭐."
  },
  {
   "key": "473a59ff6427",
   "speaker_korean": "에레나",
   "korean": "「⟦1⟧디온⟦2⟧이구나. 들어와도 돼."
  },
  {
   "key": "f045f973dd8a",
   "speaker_korean": "디온",
   "korean": "「네. 실례하겠습니다."
  },
  {
   "key": "cfbd4f945655",
   "speaker_korean": "디온",
   "korean": "「처음 뵙겠습니다, ⟦1⟧디온⟦2⟧입니다."
  },
  {
   "key": "be3a95ac6c35",
   "speaker_korean": "디온",
   "korean": "「두 분 모두 박식한 분들이라고\n들었습니다.\n부디 저희에게 지혜를 빌려주십시오."
  },
  {
   "key": "6e5a553707ff",
   "speaker_korean": "에레나",
   "korean": "「⟦1⟧디온⟦2⟧, 안내해 드려.\n나는 지금 자리를 뜰 수가 없어서."
  },
  {
   "key": "44e462d77bf0",
   "speaker_korean": "디온",
   "korean": "「그런데, 놀랐어요.\n나이가 더 있으신 분일 줄 알았거든요."
  },
  {
   "key": "f1f9c38e1bad",
   "speaker_korean": "에레나",
   "korean": "「이런… ⟦1⟧디온⟦2⟧,\n자자, 쓸데없는 얘기 그만하고,\n얼른 안내해 드리렴."
  },
  {
   "key": "f4ea322bf93d",
   "speaker_korean": "디온",
   "korean": "「혼나 버렸네요.\n가시죠, 이쪽입니다."
  },
  {
   "key": "0e8b14b378ff",
   "speaker_korean": null,
   "korean": "⟦1⟧4700폴⟦2⟧을 얻었다."
  }
 ]
}