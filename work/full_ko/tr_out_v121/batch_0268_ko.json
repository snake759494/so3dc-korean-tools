  },
  {
   "key": "2ce454f705a0",
   "speaker_korean": null,
   "korean": "방어속성을 담은 책\n합성으로 무기에 부여할 수 있다\n물속성 공격 반감"
  },
  {
   "key": "2effbf3b6284",
   "speaker_korean": null,
   "korean": "방어속성을 담은 책\n합성으로 무기에 부여할 수 있다\n불속성 공격에 HP 회복"
  },
  {
   "key": "179d6bd524a3",
   "speaker_korean": null,
   "korean": "방어속성을 담은 책\n합성으로 무기에 부여할 수 있다\n불속성 공격 무효화"
  },
  {
   "key": "6ae247fe851c",
   "speaker_korean": null,
   "korean": "방어속성을 담은 책\n합성으로 무기에 부여할 수 있다\n불속성 공격 반감"
  },
  {
   "key": "6b22b3377d1d",
   "speaker_korean": null,
   "korean": "방어속성을 담은 책\n합성으로 무기에 부여할 수 있다\n풍속성 공격에 HP 회복"
  },
  {
   "key": "4a0ae9865b83",
   "speaker_korean": null,
   "korean": "방어속성을 담은 책\n합성으로 무기에 부여할 수 있다\n풍속성 공격 무효화"
  },
  {
   "key": "16c9b6db14e5",
   "speaker_korean": null,
   "korean": "공격속성을 담은 책\n합성으로 무기에 부여할 수 있다\n풍속성 공격 반감"
  },
  {
