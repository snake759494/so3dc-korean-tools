{
 "batch_id": "batch_0218",
 "translations": [
  {
   "key": "0c27c62c8bc6",
   "speaker_korean": "마리아",
   "korean": "「각성…한 거야?"
  },
  {
   "key": "f06021ebba1e",
   "speaker_korean": "페이트",
   "korean": "「그런 거겠지, 아마."
  },
  {
   "key": "8a67fd75e062",
   "speaker_korean": "페이트",
   "korean": "「이게…⟦1⟧타임게이트⟦2⟧군."
  },
  {
   "key": "84eee55ade0d",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧커넥션⟦2⟧의 문장유전자…\n공간을 잇고 길을 여는 건 너라고\n박사가 그랬었지."
  },
  {
   "key": "1af17c829b0c",
   "speaker_korean": "소피아",
   "korean": "「하지만, 나…그런 말을 들어도\n대체 어떻게 해야 할지…"
  },
  {
   "key": "e46b6fdba1f4",
   "speaker_korean": "클리프",
   "korean": "「그런가… 하긴 그렇겠지."
  },
  {
   "key": "6e0b124d5096",
   "speaker_korean": "소피아",
   "korean": "「미안해…"
  },
  {
   "key": "7904e54209fc",
   "speaker_korean": "페이트",
   "korean": "「무슨 소리야.\n네가 사과할 일이 아니잖아."
  },
  {
   "key": "e291a4fef5b4",
   "speaker_korean": "소피아",
   "korean": "「응. 근데…"
  },
  {
   "key": "b9390c91d062",
   "speaker_korean": "페이트",
   "korean": "「신경 쓰지 마."
  },
  {
   "key": "90d601749b40",
   "speaker_korean": "페이트",
   "korean": "「그녀는 아직 각성하지 않았어."
  },
  {
   "key": "6f7199f9324c",
   "speaker_korean": "마리아",
   "korean": "「알고 있어…미안."
  },
  {
   "key": "458a8494baff",
   "speaker_korean": "페이트",
   "korean": "「응…가만히 보고만 있어도\n소용없지.\n일단 게이트를 조사해 보자."
  },
  {
   "key": "b2c756eb2643",
   "speaker_korean": "소피아",
   "korean": "「나, 왠지, 머리가 아파…"
  },
  {
   "key": "ffd5e0cd36cb",
   "speaker_korean": "페이트",
   "korean": "「괜찮아?"
  },
  {
   "key": "2ee6c9152996",
   "speaker_korean": "소피아",
   "korean": "「응…미안해, 이런 때에."
  },
  {
   "key": "a3e9d4154ad2",
   "speaker_korean": "클리프",
   "korean": "「움직이는 거냐?"
  },
  {
   "key": "5b2e1af88ea1",
   "speaker_korean": "마리아",
   "korean": "「가만히 있어…\n여기까지는 정상적인 동작이니까."
  },
  {
   "key": "ff6da6e0ccf5",
   "speaker_korean": "페이트",
   "korean": "「뭐야!?"
  },
  {
   "key": "d70079c02372",
   "speaker_korean": "소피아",
   "korean": "「아…아…"
  },
  {
   "key": "155d8201e16b",
   "speaker_korean": "소피아",
   "korean": "「응…"
  },
  {
   "key": "042d070df0e3",
   "speaker_korean": "클리프",
   "korean": "「이건…"
  },
  {
   "key": "6b7346c2a6cc",
   "speaker_korean": "마리아",
   "korean": "「⟦1⟧타임게이트⟦2⟧가……"
  },
  {
   "key": "1e94533cc33a",
   "speaker_korean": "클리프",
   "korean": "「어이어이, 이게 뭐야?"
  },
  {
   "key": "e17e2a54eafd",
   "speaker_korean": "마리아",
   "korean": "「이게, ⟦1⟧FD 공간⟦2⟧…"
  },
  {
   "key": "d6ff3e8b8182",
   "speaker_korean": "클리프",
   "korean": "「어떻게 알아?"
  },
  {
   "key": "6ec511ab3f5d",
   "speaker_korean": "마리아",
   "korean": "「이유는 모르겠어…하지만, 느껴져.\n확실히 그래…이게 ⟦1⟧FD 공간⟦2⟧이야."
  },
  {
   "key": "f40e5a527ea9",
   "speaker_korean": "페이트",
   "korean": "「그래…나도 그렇게 생각해."
  },
  {
   "key": "e985081e1025",
   "speaker_korean": "소피아",
   "korean": "「몸속 깊은 곳의 무언가가\n그렇게 말하고 있어요."
  },
  {
   "key": "fd9cbc767976",
   "speaker_korean": "클리프",
   "korean": "「너희들이 그렇게 말하니\n분명 그런 거겠지."
  },
  {
   "key": "0c98aee1b7af",
   "speaker_korean": "마리아",
   "korean": "「이 안쪽에 창조왕이 있다는 거네."
  },
  {
   "key": "02a34fcfbffb",
   "speaker_korean": "페이트",
   "korean": "「근데, ⟦1⟧FD 공간⟦2⟧에서\n우리가 존재할 수 있는 걸까?"
  },
  {
   "key": "b071805abcc3",
   "speaker_korean": "소피아",
   "korean": "「그렇지.\n차원이 다르니까…"
  },
  {
   "key": "b2e79078d91c",
   "speaker_korean": "마리아",
   "korean": "「그건 솔직히 모르겠네.\n하지만, 박사들이 아무것도\n대처하지 않았다고는 생각하기 어렵잖아."
  },
  {
   "key": "43e220ebee85",
   "speaker_korean": "소피아",
   "korean": "「하지만, 만에 하나라는\n경우도 있잖아요?"
  },
  {
   "key": "3741dcba1e0a",
   "speaker_korean": "페이트",
   "korean": "「어떤 걸까…?"
  },
  {
   "key": "62939463029e",
   "speaker_korean": "클리프",
   "korean": "「뭐, 그런 거지.\n인간이란 과감함이 중요한 거라고."
  },
  {
   "key": "98bdff167a11",
   "speaker_korean": "페이트",
   "korean": "「그래…가자, 다들.\n이 앞에 쓰러뜨려야 할 창조왕이 있어!!"
  },
  {
   "key": "438ce6738f34",
   "speaker_korean": "넬",
   "korean": "「대체 뭐란 말이야…"
  },
  {
   "key": "dc47167fd335",
   "speaker_korean": "알벨",
   "korean": "「이건……"
  },
  {
   "key": "b4b8632c547f",
   "speaker_korean": "로저",
   "korean": "「우홋! 완전 대단하잖아!!"
  },
  {
   "key": "16861b4cfd48",
   "speaker_korean": "스프레",
   "korean": "「완전 놀랍다~!?"
  },
  {
   "key": "16f86ad8f9f2",
   "speaker_korean": "스프레",
   "korean": "「으으…\n생각해 봤자 소용없다니까!\n얼른 가자, 가자!"
  },
  {
   "key": "b03061b95b11",
   "speaker_korean": "로저",
   "korean": "「형들, 이제 와서 무슨 소리야.\n여기까지 와 놓고서."
  },
  {
   "key": "c495cee11e60",
   "speaker_korean": "알벨",
   "korean": "「여기까지 와서 망설여서 뭐 하냐, 멍청아.\n이제 와서 돌이킬 순 없어."
  },
  {
   "key": "4abf18054846",
   "speaker_korean": "넬",
   "korean": "「우리에겐 나아가는 것 말곤 선택지가 없잖아?\n그렇다면 최대한 저항해 보자고.\n그, 창조왕이라는 녀석한테 말이야."
  },
  {
   "key": "79275545dfe1",
   "speaker_korean": "넬",
   "korean": "「너희들이 그렇게 말한다면\n그게 정답이겠지."
  },
  {
   "key": "69bd686b2230",
   "speaker_korean": "알벨",
   "korean": "「흥. 부정할 이유는 없군."
  },
  {
   "key": "63d87e27a87b",
   "speaker_korean": "스프레",
   "korean": "「솔직히 잘 모르겠지만…\n다들 거짓말할 리 없잖아."
  },
  {
   "key": "f9bd391cbdcb",
   "speaker_korean": "넬",
   "korean": "「놀랐는걸."
  },
  {
   "key": "aea00f03726f",
   "speaker_korean": "알벨",
   "korean": "「기묘한 노릇이군."
  },
  {
   "key": "b67c2916cf1d",
   "speaker_korean": "로저",
   "korean": "「뭔가 이상한 곳이 비치고 있잖아!!"
  },
  {
   "key": "e2057f3b135e",
   "speaker_korean": "스프레",
   "korean": "「이상하네에…"
  },
  {
   "key": "f91f1b67dd18",
   "speaker_korean": "로저",
   "korean": "「몸속 깊은 곳의 뭔가? 음~"
  },
  {
   "key": "a2e5c7c2f983",
   "speaker_korean": "소피아",
   "korean": "「뭐…이거…나…왜…"
  },
  {
   "key": "5f786ec9310c",
   "speaker_korean": "소피아",
   "korean": "「손이…뜨거워…"
  },
  {
   "key": "e6bd0a916791",
   "speaker_korean": "페이트",
   "korean": "「왜 그래,\n⟦1⟧소피아⟦2⟧?"
  },
  {
   "key": "838fdc103a3b",
   "speaker_korean": "페이트",
   "korean": "「됐다니까…\n힘들면 바로 말해."
  },
  {
   "key": "1d239fb290ba",
   "speaker_korean": "소피아",
   "korean": "「⟦1⟧스트림⟦2⟧…이네.\n⟦P⟧"
  },
  {
   "key": "7c8f714e8707",
   "speaker_korean": "소피아",
   "korean": "「으, 응. 해볼게!"
  },
  {
   "key": "c14d987bb328",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧언인스톨러⟦2⟧, 부탁해!"
  },
  {
   "key": "668af322df0e",
   "speaker_korean": "클리프",
   "korean": "「큭! 끝까지 방해하는 놈들이라고!"
  }
 ]
}