{
 "batch_id": "batch_0199",
 "translations": [
  {
   "key": "c3251821c111",
   "speaker_korean": "클리프",
   "korean": "「아까 전투의\n여파에 휘말렸나 보군゜"
  },
  {
   "key": "2db00068da63",
   "speaker_korean": "클리프",
   "korean": "「…너희는\n여기 숨어 있어゜\n⟦P⟧내가 미끼가 돼서\n놈들을 맡을 테니까゜"
  },
  {
   "key": "0aae4d692323",
   "speaker_korean": "페이트",
   "korean": "「하지만, 너 혼자선…゜"
  },
  {
   "key": "ff28c03aeceb",
   "speaker_korean": "클리프",
   "korean": "「괜찮아゜\n그 정도 인원이라면 어떻게든 될 거야゜\n아가씨가 그런 상태면,\n제대로 도망칠 수 없잖아?"
  },
  {
   "key": "742de2af0adf",
   "speaker_korean": "반덴 병사",
   "korean": "「찾았다, 이쪽이다!"
  },
  {
   "key": "cd7a5c803859",
   "speaker_korean": "소피아",
   "korean": "「응, 괜찮아゜\n그냥 살짝 발을 헛디뎠을 뿐이야゜"
  },
  {
   "key": "ce7ebf1b09e9",
   "speaker_korean": "페이트",
   "korean": "「…다리, 보여줘゜"
  },
  {
   "key": "8fa949568f8c",
   "speaker_korean": "페이트",
   "korean": "「다쳤잖아!?"
  },
  {
   "key": "1b633cd73b5f",
   "speaker_korean": "페이트",
   "korean": "「무슨 일이야?"
  },
  {
   "key": "d119d1711f54",
   "speaker_korean": null,
   "korean": "⟦1⟧8000폴⟦2⟧을 얻었다゜"
  },
  {
   "key": "68b9910af01d",
   "speaker_korean": null,
   "korean": "⟦1⟧스틸 너클⟦2⟧을 얻었다゜"
  },
  {
   "key": "e86f2a8b1531",
   "speaker_korean": "클리프",
   "korean": "「쳇, 너무 뻔한 전개잖냐!"
  },
  {
   "key": "59ae7418496c",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧타이네브 씨⟦2⟧, ⟦3⟧파린 씨⟦4⟧!\n지금 구하겠습니다!"
  },
  {
   "key": "e7c37aaf8882",
   "speaker_korean": "타이네브",
   "korean": "「도망치세요… 매복이에요!"
  },
  {
   "key": "d8ec73533347",
   "speaker_korean": "파린",
   "korean": "「맞아요~゜\n기둥 그늘에 몇 명인가… 숨어 있어요~!!"
  },
  {
   "key": "01a79652cd1e",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧파린⟦2⟧!"
  },
  {
   "key": "c8fb3769c7f2",
   "speaker_korean": "파린",
   "korean": "「괜찮아요~゜\n…살짝 아프긴 하지만요゜"
  },
  {
   "key": "d93f013840a2",
   "speaker_korean": "타이네브",
   "korean": "「감사합니다゜"
  },
  {
   "key": "42cd7b42c00d",
   "speaker_korean": "타이네브",
   "korean": "「죄송합니다゜\n저희 때문에, 이런 위험한 곳까지゜"
  },
  {
   "key": "da3d481d00bd",
   "speaker_korean": "파린",
   "korean": "「죄송해요~…゜"
  },
  {
   "key": "6a025df76bb1",
   "speaker_korean": "넬",
   "korean": "「됐어゜\n그리고 고맙다는 인사는 쟤들한테 해゜"
  },
  {
   "key": "083a6b1a7f9a",
   "speaker_korean": "클리프",
   "korean": "「신경 쓰지 마゜\n별거 아니었어゜"
  },
  {
   "key": "5c4f700583b5",
   "speaker_korean": "클리프",
   "korean": "「그렇군… 볼일은 다 끝났다゜\n이런 칙칙한 곳,\n얼른 잘 있거라 하고 뜨자고゜"
  },
  {
   "key": "dc8228798ccf",
   "speaker_korean": "넬",
   "korean": "「그렇게는 안 될 모양이네゜"
  },
  {
   "key": "af1bbff0d92e",
   "speaker_korean": "셸비",
   "korean": "「너희들이냐? ⟦1⟧아리그리프⟦2⟧에 떨어진,\n의문의 물체를 타고 있었다는 녀석들이?"
  },
  {
   "key": "4e97bca53d2c",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧타이네브⟦2⟧!"
  },
  {
   "key": "02dbdb551d30",
   "speaker_korean": "클리프",
   "korean": "「음!?"
  },
  {
   "key": "e7a0388896a6",
   "speaker_korean": "클리프",
   "korean": "「그게 어쨌다는 거냐?"
  },
  {
   "key": "702e0957153a",
   "speaker_korean": "셸비",
   "korean": "「얌전히 투항하는 게 좋을 거다゜\n그럼 목숨만은 살려주지゜"
  },
  {
   "key": "7ca6fd301e23",
   "speaker_korean": "셸비",
   "korean": "「나는 ⟦1⟧셸비⟦2⟧… ⟦3⟧칠흑⟦4⟧의 부단장이다゜\n뭐, 조만간 직함은 단장으로\n바뀌겠지만 말이다゜\n내 관할에 든 걸 불운으로 알고 저주해라゜"
  },
  {
   "key": "89a34c7bea04",
   "speaker_korean": "넬",
   "korean": "「큭, 여기까지 와서\n⟦1⟧셸비⟦2⟧가 상대라니!"
  },
  {
   "key": "cee46b3c2f7e",
   "speaker_korean": "클리프",
   "korean": "「그러게゜\n목덜미가 살기로\n따끔거리는군゜"
  },
  {
   "key": "ea7a5cc8b6d7",
   "speaker_korean": "페이트",
   "korean": "「괜찮으세요?"
  },
  {
   "key": "0e666f71c29f",
   "speaker_korean": "페이트",
   "korean": "「그렇습니다゜\n그보다, 서둘러 여기서 탈출합시다゜"
  },
  {
   "key": "6c40ee4c6518",
   "speaker_korean": "페이트",
   "korean": "「넌 누구냐?"
  },
  {
   "key": "8655a99b7760",
   "speaker_korean": "페이트",
   "korean": "「강해?"
  },
  {
   "key": "8d3d590002c1",
   "speaker_korean": "넬",
   "korean": "「그래… 그는 ⟦1⟧칠흑⟦2⟧의 넘버2야゜\n허울로 자리를 맡고 있는 게 아니야゜"
  },
  {
   "key": "7f576987aee6",
   "speaker_korean": "클리프",
   "korean": "「확실히 그렇군゜\n그냥 자리지기치곤 빈틈이 없어…\n다른 놈들과는 차원이 다른 실력이겠지゜"
  },
  {
   "key": "d0cea0f9b3a2",
   "speaker_korean": "셸비",
   "korean": "「물론, 살려두는 건\n남자 둘뿐이다゜\n미끼인 여자들은 죽어줘야겠다゜"
  },
  {
   "key": "ba24f5677e29",
   "speaker_korean": "셸비",
   "korean": "「승부는 이미 정해졌다゜\n쓸데없는 발버둥은 그만둬라゜"
  },
  {
   "key": "a1d633280c7e",
   "speaker_korean": "클리프",
   "korean": "「쓸데없는지 아닌지는\n해봐야 알 거 아니냐!\n애초에, 네놈이 날 죽일 수 있겠냐?"
  },
  {
   "key": "a562efdf9cc4",
   "speaker_korean": "셸비",
   "korean": "「그 말, 그대로 돌려주도록 하지゜"
  },
  {
   "key": "68673e2d9473",
   "speaker_korean": "클리프",
   "korean": "「좋다!!"
  },
  {
   "key": "321c1d61a6bc",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧타이네브⟦2⟧, ⟦3⟧파린⟦4⟧,\n당신들은 물러나 있어゜"
  },
  {
   "key": "31b380a45f40",
   "speaker_korean": "페이트",
   "korean": "「온다!!"
  },
  {
   "key": "578c7f918e65",
   "speaker_korean": "넬",
   "korean": "「칫!"
  },
  {
   "key": "93b3dcd80bd5",
   "speaker_korean": "클리프",
   "korean": "「하, 입만 산 놈이었군゜"
  },
  {
   "key": "83229b39876d",
   "speaker_korean": "???",
   "korean": "「정말 그렇군゜"
  },
  {
   "key": "c4da4c33d9ef",
   "speaker_korean": "???",
   "korean": "「여기다゜"
  },
  {
   "key": "20e84b890f36",
   "speaker_korean": "???",
   "korean": "「뒤에서 이것저것 하나 했더니, 이런 거였나゜\n…흥, 시시하군゜\n맨날 잘난 척하더니,\n이런 놈들도 못 이기다니… 벌레는 벌레였군゜"
  },
  {
   "key": "a7ff907efc98",
   "speaker_korean": "넬",
   "korean": "「그 왼손의 건틀릿은…\n너, 설마 ⟦1⟧알벨 녹스⟦2⟧인가?"
  },
  {
   "key": "32d5b860a98f",
   "speaker_korean": "알벨",
   "korean": "「호오, 날 아나 보군゜"
  },
  {
   "key": "3a35b6594dfc",
   "speaker_korean": "페이트",
   "korean": "「그자는 대체 누구입니까?"
  },
  {
   "key": "438158cf3f76",
   "speaker_korean": "넬",
   "korean": "「카타나를 쓰게 하면\n⟦1⟧아리그리프⟦2⟧에서도 손꼽히는 기사야゜\n『⟦3⟧뒤틀린 알벨⟦4⟧』… ⟦5⟧칠흑 기사단⟦6⟧ 단장゜"
  },
  {
   "key": "ffe6a6d42531",
   "speaker_korean": "클리프",
   "korean": "「잘난 척 그만해, 네놈゜\n날려버릴 테다, 이 자식아゜"
  },
  {
   "key": "0f3ba242c086",
   "speaker_korean": "알벨",
   "korean": "「흥, 할 수도 없는 말은 하지 마라゜\n잠재력은 제법이다만, 아직 멀었어゜"
  }
 ]
}