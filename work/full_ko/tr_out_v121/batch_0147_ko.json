{
 "batch_id": "batch_0147",
 "translations": [
  {
   "key": "549dfc2753dc",
   "speaker_korean": "레자드",
   "korean": "「⟦1⟧베・리・온⟦2⟧!"
  },
  {
   "key": "555480833642",
   "speaker_korean": "베리온",
   "korean": "「그, 그치만…에"
  },
  {
   "key": "cecffcb38e87",
   "speaker_korean": "베리온",
   "korean": "「미, 미안해요…"
  },
  {
   "key": "c1009110bcc9",
   "speaker_korean": "레자드",
   "korean": "「'그치만'은 없습니다\n당신, 그런 말투를 쓰면\n제일 좋아하는 단팥도넛을\n두 번 다시 못 먹게\n만들어 버릴 거예요?"
  },
  {
   "key": "0291cb5e423f",
   "speaker_korean": "로저",
   "korean": "「너희들, 여전하네…"
  },
  {
   "key": "486c841ac19b",
   "speaker_korean": "루시오",
   "korean": "「뭐, 단팥도넛 따위\n아무래도 상관없어\n아무튼 조력자는 비겁하잖아\n그건 반칙이라고"
  },
  {
   "key": "02cf1267d33b",
   "speaker_korean": "로저",
   "korean": "「근데 말이지,\n거기엔 바다보다 깊은 이유가 있다고…"
  },
  {
   "key": "619b8df61f17",
   "speaker_korean": "루시오",
   "korean": "「그러니까, 네 반칙패야\n결국 내 승리라는 거지\n⟦1⟧레자드⟦2⟧?"
  },
  {
   "key": "6f583e89b68d",
   "speaker_korean": "레자드",
   "korean": "「역시…이쪽이 48승,\n바보 너구리가 47승,\n1504무승부로군요"
  },
  {
   "key": "9dcf0e507083",
   "speaker_korean": "루시오",
   "korean": "「하하핫! 어차피 바보 너구리 따위,\n나한텐 안 되는 거라고"
  },
  {
   "key": "9710387404d9",
   "speaker_korean": "레자드",
   "korean": "「알면 됐습니다"
  },
  {
   "key": "df9130003c6a",
   "speaker_korean": "로저",
   "korean": "「진짜 열받네…"
  },
  {
   "key": "fbee74257ce4",
   "speaker_korean": "로저",
   "korean": "「아앗, 형!?"
  },
  {
   "key": "04c20fb162ae",
   "speaker_korean": "루시오",
   "korean": "「너, 넌 누구야?"
  },
  {
   "key": "06fd08f2865a",
   "speaker_korean": "레자드",
   "korean": "「파란…머리?\n설마, 그 소문의!?"
  },
  {
   "key": "79c0d046da06",
   "speaker_korean": "페이트",
   "korean": "「잠깐 괜찮을까?"
  },
  {
   "key": "2cee1dbf26e6",
   "speaker_korean": "루시오",
   "korean": "「뭐, 뭐야?"
  },
  {
   "key": "a8ad78a712f2",
   "speaker_korean": "페이트",
   "korean": "「나는 지난번에,\n그에게 도움을 받았어"
  },
  {
   "key": "bbed37279bc2",
   "speaker_korean": "루시오",
   "korean": "「도움을 받았다고?"
  },
  {
   "key": "40c3016564ba",
   "speaker_korean": "루시오",
   "korean": "「……"
  },
  {
   "key": "2f7e9a1c9321",
   "speaker_korean": "페이트",
   "korean": "「이건 남자다운 행동이라고\n생각하는데 말이야?"
  },
  {
   "key": "23d99f6f1278",
   "speaker_korean": "루시오",
   "korean": "「뭐, 그렇다고도 하지"
  },
  {
   "key": "a26214f7534c",
   "speaker_korean": "페이트",
   "korean": "「확실히 그도 반칙을 했어\n하지만 남자다운 모습도 보였잖아\n그러니까, 지난번 승부는\n무효로 하는 게 어때?"
  },
  {
   "key": "6ebcd67f1e2e",
   "speaker_korean": "레자드",
   "korean": "「흥, 그런 건\n받아들여질 리가\n없지 않겠습니까"
  },
  {
   "key": "79a34a4093be",
   "speaker_korean": "루시오",
   "korean": "「알았어. 좋다고"
  },
  {
   "key": "9f8248b01f69",
   "speaker_korean": "레자드",
   "korean": "「안, 안 되잖아요, 형님\n그런 걸 인정해서는…"
  },
  {
   "key": "9e6639c55a73",
   "speaker_korean": "루시오",
   "korean": "「됐어\n곤란한 사람을 내팽개치고\n남자 대결이고 뭐고 없지"
  },
  {
   "key": "ac16e8890dc2",
   "speaker_korean": "루시오",
   "korean": "「단, 다음은 없어\n다음엔 어떤 이유가 있어도\n반칙은 반칙이니까"
  },
  {
   "key": "0a53e6195e58",
   "speaker_korean": "로저",
   "korean": "「오, 오우!"
  },
  {
   "key": "1c247bf12525",
   "speaker_korean": "레자드",
   "korean": "「쳇… 정말 우직한 남자로군요\n뻔히 보이는 승리를 놓치다니"
  },
  {
   "key": "ccabe26c951c",
   "speaker_korean": "베리온",
   "korean": "「그래야 ⟦1⟧루시오쨩⟦2⟧이지\n에헤헤"
  },
  {
   "key": "981dd493e6e5",
   "speaker_korean": "레자드",
   "korean": "「⟦1⟧베리온⟦2⟧,\n뭘 좋아하고 있는 겁니까…"
  },
  {
   "key": "fadd9ca7ce30",
   "speaker_korean": "베리온",
   "korean": "「에엣……"
  },
  {
   "key": "ee353d7c3ad0",
   "speaker_korean": "루시오",
   "korean": "「이봐, ⟦1⟧베리온⟦2⟧!\n나한테 쨩 붙여서 부르지 말라고\n몇 번을 말해야 알아듣는 거냐!!"
  },
  {
   "key": "8d7da6fc43e1",
   "speaker_korean": "베리온",
   "korean": "「그치만, ⟦1⟧루시오쨩⟦2⟧은\n⟦3⟧루시오쨩⟦4⟧이니까…아니야?"
  },
  {
   "key": "cb511ba4f771",
   "speaker_korean": "루시오",
   "korean": "「그러니까 말이다…"
  },
  {
   "key": "64be44b9c34b",
   "speaker_korean": "레자드",
   "korean": "「하아… 정말 한심하군요\n이러니까 제 완벽한 작전이\n매번 매번 매번 매번……"
  },
  {
   "key": "5c9917bde818",
   "speaker_korean": "로저",
   "korean": "「고맙다구"
  },
  {
   "key": "e7765b78c715",
   "speaker_korean": "페이트",
   "korean": "「어, 아 딱히 상관없어\n도움을 받은 건\n변함없는 사실이니까"
  },
  {
   "key": "3a2dfcfd4207",
   "speaker_korean": "로저",
   "korean": "「형, 진짜 좋은 녀석이네"
  },
  {
   "key": "8ec7db199ad5",
   "speaker_korean": "페이트",
   "korean": "「나랑 동료들은 ⟦1⟧더글러스 숲⟦2⟧에서\n쓰러진 여자아이를 찾고 있었거든\n그러던 중에, 그를 만난 거야\n우리 사정을 들은 그는 자기 승부조차\n돌아보지 않고, 우리를 돕겠다고\n말해줬어\n뭐, 우연히 도적단 두목과 마주쳐서\n돕는 모양새가 되긴 했지만…"
  }
 ]
}