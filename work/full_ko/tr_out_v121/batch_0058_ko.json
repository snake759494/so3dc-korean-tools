{
 "batch_id": "batch_0058",
 "translations": [
  {
   "key": "22047f2d2d17",
   "speaker_korean": "페이트",
   "korean": "「정말인가요, ⟦1⟧미라쥬 씨⟦2⟧?"
  },
  {
   "key": "70cc2959c142",
   "speaker_korean": "클리프",
   "korean": "「그야 그렇지… 소형정이라 해도\n여기보단 나은 설비가 있다고."
  },
  {
   "key": "d46bd0f55c9a",
   "speaker_korean": "미라쥬",
   "korean": "「하지만 착륙 때의 충격으로\n대부분의 기기가 파손되고 말았어요.\n게다가 여러분이 끌려간 뒤로,\n⟦1⟧이글⟦2⟧은 군이\n삼엄하게 경비하고 있어요.\n문은 잠가 두었으니\n안으로 들어갈 일은 없어요.\n하지만, 저희가 들어가려면\n아리그리프 군을\n배제해야만 하겠죠."
  },
  {
   "key": "c675f7900ca0",
   "speaker_korean": "클리프",
   "korean": "「그건 좀 골치 아프겠는데.\n왕도에서 날뛰었다간,\n⟦1⟧질풍⟦2⟧이 우글우글 몰려올 거 아니냐.\n게다가 ⟦3⟧알벨⟦4⟧ 녀석도\n가만있지 않을 테고 말이야."
  },
  {
   "key": "0e00cb8b1f0a",
   "speaker_korean": "페이트",
   "korean": "「하지만, 이대로면 ⟦1⟧아미나⟦2⟧는…\n시간이 없다고!!"
  },
  {
   "key": "d98c399aaec5",
   "speaker_korean": "클리프",
   "korean": "「그런 건 나도 알고 있어.\n하지만 말이다―――."
  },
  {
   "key": "70c6b6bbdaea",
   "speaker_korean": "넬",
   "korean": "「미안하게 됐어."
  },
  {
   "key": "4fb8d1560010",
   "speaker_korean": "넬",
   "korean": "「아무래도, 이쪽도 그리 느긋하게\n있을 수는 없게 된 모양이야.\n폐하께서 너희를 부르신다."
  },
  {
   "key": "be387c2fe870",
   "speaker_korean": "넬",
   "korean": "「자세한 건 성에서 들을 수 있을 거야.\n⟦1⟧아리그리프⟦2⟧의 침공이 시작된 모양이야.\n이미 ⟦3⟧아리아스⟦4⟧ 코앞까지 부대가 왔어.\n게다가 이번엔 아리그리프 삼군의 전 부대가\n작전에 참가하고 있다는 정보도 있고 말이야…."
  },
  {
   "key": "5d5bd48405b9",
   "speaker_korean": "클리프",
   "korean": "「무슨 일 있냐?"
  },
  {
   "key": "4621a3bff4f0",
   "speaker_korean": "클리프",
   "korean": "「이거 참, 원."
  },
  {
   "key": "bd9f30c89302",
   "speaker_korean": "넬",
   "korean": "「아마도, ⟦1⟧썬더 애로우⟦2⟧가 완성되기 전에\n우리를 쳐부수려는 속셈이겠지.\n작전 지휘관은 ⟦3⟧복스⟦4⟧인 모양이야."
  },
  {
   "key": "15d6366a6738",
   "speaker_korean": "페이트",
   "korean": "「단숨에 결판을 낼 셈인가?"
  },
  {
   "key": "8e98c0b52aa5",
   "speaker_korean": "넬",
   "korean": "「아마도.\n일단 지금까지 완성된\n병기를 가지고 ⟦1⟧디온⟦2⟧이 ⟦3⟧아리아스⟦4⟧로\n향하기로 되어 있긴 한데.\n그걸로 어디까지 버틸 수 있을지―――."
  },
  {
   "key": "4898a71354a9",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧디온⟦2⟧……?"
  },
  {
   "key": "63a3cb98b6b1",
   "speaker_korean": "페이트",
   "korean": "「그런 건 아무래도 좋아.\n그보다 왜 이렇게 무리한 거야!?"
  },
  {
   "key": "d804aa67a69a",
   "speaker_korean": "아미나",
   "korean": "「그건… 저… 말씀드렸었죠.\n저에게도 헤어진 소꿉친구가 있다고요.\n그 사람이 여기 있다고,\n아는 아저씨한테 들었어요."
  },
  {
   "key": "b62067d8d841",
   "speaker_korean": "페이트",
   "korean": "「여기?"
  },
  {
   "key": "7023d54ae0c3",
   "speaker_korean": "아미나",
   "korean": "「예… 왕도의 연구소에서\n일하고 있다고…."
  },
  {
   "key": "039d163ffc18",
   "speaker_korean": "페이트",
   "korean": "「분명, 네 소꿉친구가\n연구자라고 말하긴 했지만… 확실한 거야?\n그러니까, 연구소에 그가 있다는 거."
  },
  {
   "key": "2a53faa90cbd",
   "speaker_korean": "아미나",
   "korean": "「모르겠어요. …하지만…\n그 얘길 듣고 나니\n가만히 있을 수가 없어서…."
  },
  {
   "key": "1a7b0ed2755c",
   "speaker_korean": "클리프",
   "korean": "「그래서 혼자 여기까지\n왔다는 거냐."
  },
  {
   "key": "963dae99d7c1",
   "speaker_korean": "페이트",
   "korean": "「왕도의 연구소라….\n아세요?"
  },
  {
   "key": "702e1c836c98",
   "speaker_korean": "넬",
   "korean": "「⟦1⟧시랜드⟦2⟧에 연구소는 하나뿐이야.\n⟦3⟧엘레나 님⟦4⟧의 ⟦5⟧시술병기 연구소⟦6⟧뿐이지."
  },
  {
   "key": "83f6ea92319b",
   "speaker_korean": "페이트",
   "korean": "「그렇군요.\n그럼, 만난 적이 있을지도 모르겠네.\n⟦1⟧아미나⟦2⟧, 네 소꿉친구 이름은?"
  },
  {
   "key": "42032396557f",
   "speaker_korean": "아미나",
   "korean": "「예, ⟦1⟧디온⟦2⟧이라고 해요."
  },
  {
   "key": "35ec45434c51",
   "speaker_korean": "페이트",
   "korean": "「뭐라고!?\n그가 네 소꿉친구라는 거야?"
  },
  {
   "key": "21561b835f14",
   "speaker_korean": "아미나",
   "korean": "「아시는 거예요?\n그럼, ⟦1⟧디온⟦2⟧은…\n역시… 여기 있는 거군요.\n저…… 갈게요."
  },
  {
   "key": "46b1ee6799d9",
   "speaker_korean": "미라쥬",
   "korean": "「안 돼요, 당신은 환자예요.\n그런 무리를 하게 둘 순 없어요."
  },
  {
   "key": "5b1b515fdd05",
   "speaker_korean": "아미나",
   "korean": "「하지만―――."
  },
  {
   "key": "11f648eba2d9",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧, 그런 몸으론 무리야.\n내가 ⟦3⟧디온⟦4⟧을 여기로 데려올 테니까."
  },
  {
   "key": "302d1df15879",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧페이트 씨⟦2⟧…."
  },
  {
   "key": "297c7a8b6ac7",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧, 말 좀 들어… 응?\n또 쓰러지면 아무 소용 없잖아?"
  },
  {
   "key": "aacba094f78b",
   "speaker_korean": "아미나",
   "korean": "「예."
  },
  {
   "key": "3d8032ad87a1",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧미라쥬 씨⟦2⟧,\n그녀 곁에 있어 주시겠어요?"
  },
  {
   "key": "696b5d81d209",
   "speaker_korean": "미라쥬",
   "korean": "「예, 알겠어요."
  },
  {
   "key": "3f2942828544",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧디온⟦2⟧은\n아직 연구실에 있나요?"
  },
  {
   "key": "c908ce6171b1",
   "speaker_korean": "넬",
   "korean": "「그래… 지금은 ⟦1⟧아리아스⟦2⟧로 옮길\n⟦3⟧시술병기⟦4⟧ 준비를 하고 있을 거야."
  },
  {
   "key": "8a1b2942651f",
   "speaker_korean": "페이트",
   "korean": "「잠깐 다녀올게요."
  },
  {
   "key": "f1327ac30c45",
   "speaker_korean": "페이트",
   "korean": "「큭…."
  },
  {
   "key": "38cb538b138a",
   "speaker_korean": "아미나",
   "korean": "「어라… 어째서……?"
  },
  {
   "key": "ff6fcd1368c2",
   "speaker_korean": "클리프",
   "korean": "「그러니까 진정하라고."
  },
  {
   "key": "6d45cf8b199c",
   "speaker_korean": "페이트",
   "korean": "「⟦1⟧아미나⟦2⟧, 아직 누워 있어야지!!"
  },
  {
   "key": "37f91480da7e",
   "speaker_korean": "페이트",
   "korean": "「이 방이야.\n이 안에 ⟦1⟧아미나⟦2⟧가 있어."
  },
  {
   "key": "4f59c6ad9b4e",
   "speaker_korean": "디온",
   "korean": "「무슨 일이죠? 어서 들어가요."
  },
  {
   "key": "729b29c75d12",
   "speaker_korean": "페이트",
   "korean": "「그 전에 얘기해 둘게."
  },
  {
   "key": "0f0c539a8e14",
   "speaker_korean": "디온",
   "korean": "「네?"
  },
  {
   "key": "a9e1a8518d3d",
   "speaker_korean": "페이트",
   "korean": "「그녀는… 지금 중병으로 괴로워하고 있어.\n직접 너를 만나러 가지 못한 것도\n그 탓이야."
  },
  {
   "key": "c9949ca4c795",
   "speaker_korean": "페이트",
   "korean": "「지금 그녀를 버티게 하는 건 너야.\n너를 만날 날을 기대하며 힘내고 있어."
  },
  {
   "key": "fad6256ff007",
   "speaker_korean": "디온",
   "korean": "「알고 있어요.\n저도……\n들어가죠."
  },
  {
   "key": "5e86cf689142",
   "speaker_korean": "디온",
   "korean": "「⟦1⟧아미나⟦2⟧!!"
  },
  {
   "key": "2647b863c88c",
   "speaker_korean": "아미나",
   "korean": "「⟦1⟧디온⟦2⟧…?"
  },
  {
   "key": "702038c03e5f",
   "speaker_korean": "디온",
   "korean": "「그래, 나야,\n⟦1⟧디온⟦2⟧이야!\n아아, 이렇게 여위어서…."
  },
  {
   "key": "31a124b0f3f5",
   "speaker_korean": "아미나",
   "korean": "「기뻐요… ⟦1⟧디온⟦2⟧, ⟦3⟧디온⟦4⟧!!\n저, 저는요, 당신이 보고 싶어서,\n매일매일 ⟦5⟧천본화⟦6⟧에……!!"
  },
  {
   "key": "ecc9b11fef89",
   "speaker_korean": "디온",
   "korean": "「울지 마… 괜찮아.\n나는 여기 있으니까."
  }
 ]
}