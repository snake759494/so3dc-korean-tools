{
 "batch_id": "batch_0181",
 "translations": [
  {
   "key": "c603b035655f",
   "speaker_korean": "페이트",
   "korean": "「저건!?"
  },
  {
   "key": "fbac05feba7e",
   "speaker_korean": "소피아",
   "korean": "「아저씨, 아주머니!!"
  },
  {
   "key": "9e1b359673d0",
   "speaker_korean": "로키시",
   "korean": "「무사했구나, 둘 다."
  },
  {
   "key": "b7ec75a59583",
   "speaker_korean": "페이트",
   "korean": "「네, 아버지야말로."
  },
  {
   "key": "2ff6b90a3bff",
   "speaker_korean": "페이트",
   "korean": "「아버지, 이건 대체\n어떻게 된 일이에요?\n⟦1⟧아르디온⟦2⟧의 공격인가요?"
  },
  {
   "key": "e6cbebe3abec",
   "speaker_korean": "로키시",
   "korean": "「아니겠지.\n저 무장으로 봐선 아마도…"
  },
  {
   "key": "6cb9661a5d01",
   "speaker_korean": "페이트",
   "korean": "「아마도요?"
  },
  {
   "key": "6af6946471ea",
   "speaker_korean": "로키시",
   "korean": "「아니, 그건 됐다.\n우선은 피난이 먼저다.\n가자."
  },
  {
   "key": "7ae49be416b2",
   "speaker_korean": "남성 병사",
   "korean": "「기다려 주십시오."
  },
  {
   "key": "609e95abac74",
   "speaker_korean": "로키시",
   "korean": "「무슨 일인가?"
  },
  {
   "key": "74d88f6d271b",
   "speaker_korean": "남성 병사",
   "korean": "「지금 많은 사람들이\n안쪽 전송장치 앞에 줄 서 있습니다.\n죄송하지만 여러분도\n차례가 올 때까지 기다려 주십시오."
  },
  {
   "key": "02576d080309",
   "speaker_korean": "로키시",
   "korean": "「그런가, 그럼 어쩔 수 없군."
  },
  {
   "key": "c11f277aabd3",
   "speaker_korean": "남성 병사",
   "korean": "「젠장!\n벌써 여기까지 뚫렸단 말인가!?"
  },
  {
   "key": "d1db7f35138d",
   "speaker_korean": "남성 병사",
   "korean": "「간다! 당신들은 안쪽으로!!"
  },
  {
   "key": "c9756f33770e",
   "speaker_korean": "소피아",
   "korean": "「저기, 우리도 도망치자!!"
  },
  {
   "key": "61a5066e1062",
   "speaker_korean": "정체불명의 병사",
   "korean": "「찾았다!!"
  },
  {
   "key": "242ac6a87ccf",
   "speaker_korean": "료코",
   "korean": "「당신……"
  },
  {
   "key": "67eda83ea797",
   "speaker_korean": "로키시",
   "korean": "「아…역시 그런 건가."
  },
  {
   "key": "2c69aa4714ea",
   "speaker_korean": "로키시",
   "korean": "「너희들은 도망쳐!!"
  },
  {
   "key": "fe5b6d65c139",
   "speaker_korean": "페이트",
   "korean": "「앗, 아버지!?"
  },
  {
   "key": "a6ac8a28563b",
   "speaker_korean": "소피아",
   "korean": "「아저씨!?"
  },
  {
   "key": "0619ac9c066e",
   "speaker_korean": "로키시",
   "korean": "「됐으니까 도망쳐!!"
  },
  {
   "key": "72a901d056aa",
   "speaker_korean": "페이트",
   "korean": "「하지만!!"
  },
  {
   "key": "83d29fd35bda",
   "speaker_korean": "료코",
   "korean": "「빨리 가!!\n너는 ⟦1⟧소피아⟦2⟧를\n지키는 거야!!"
  },
  {
   "key": "29df7fef34ca",
   "speaker_korean": "로키시",
   "korean": "「그래, 빨리 도망쳐라!\n우리는 신경 쓰지 마라!!"
  },
  {
   "key": "38c5b97b45f4",
   "speaker_korean": "로키시",
   "korean": "「괜찮다.\n우리도 나중에 ⟦1⟧피난시설⟦2⟧로 갈 거다."
  },
  {
   "key": "6d807962fe72",
   "speaker_korean": "페이트",
   "korean": "「꼭이에요, 아버지."
  },
  {
   "key": "2a50e2e95139",
   "speaker_korean": "로키시",
   "korean": "「그래, 약속이다."
  },
  {
   "key": "bdfcb4cfe554",
   "speaker_korean": "페이트",
   "korean": "「가자, ⟦1⟧소피아⟦2⟧!!"
  },
  {
   "key": "fc386aec88e5",
   "speaker_korean": "정체불명의 병사",
   "korean": "「놓치지 마라! ⟦1⟧시저⟦2⟧를 사용해라!!"
  },
  {
   "key": "e2a371c3c5a6",
   "speaker_korean": "료코",
   "korean": "「다행이야. 걱정했잖니."
  },
  {
   "key": "4c434933ae29",
   "speaker_korean": "남성 병사",
   "korean": "「도망치십시오!!"
  },
  {
   "key": "4d96068b1b5a",
   "speaker_korean": "페이트",
   "korean": "「젠장!"
  },
  {
   "key": "89a90d5680a7",
   "speaker_korean": "소피아",
   "korean": "「…나, 무서워."
  },
  {
   "key": "f5af4faaf76c",
   "speaker_korean": "페이트",
   "korean": "「무, 뭐야!?"
  },
  {
   "key": "31658c48e742",
   "speaker_korean": "???",
   "korean": "「괜찮아? 다친 데는 없어?\n⟦1⟧페이트⟦2⟧,\n⟦3⟧소피아⟦4⟧."
  },
  {
   "key": "eb131a2ac0fc",
   "speaker_korean": "스프레",
   "korean": "「왠지 시끄럽길래\n궁금해서 와봤어.\n그랬더니 두 사람이 위기였지 뭐야…♪"
  },
  {
   "key": "fd05410b31bd",
   "speaker_korean": "페이트",
   "korean": "「괜찮아.\n내 뒤에 숨어 있어."
  },
  {
   "key": "5b7f74f057d5",
   "speaker_korean": "페이트",
   "korean": "(하지만…어떡하지?\n끝이 없잖아…응?"
  },
  {
   "key": "3ef19c0f93cb",
   "speaker_korean": "소피아",
   "korean": "「당신은…!?"
  },
  {
   "key": "da88b7c94ed7",
   "speaker_korean": "곤조라",
   "korean": "「아가씨!?"
  },
  {
   "key": "3676c1cdaf02",
   "speaker_korean": "스프레",
   "korean": "「왜, ⟦1⟧곤조라⟦2⟧… 뭐야!?"
  },
  {
   "key": "04a20fd1b266",
   "speaker_korean": "스프레",
   "korean": "「아~ 정말! 급한데 말이야!\n⟦1⟧곤조라⟦2⟧,\n그쪽도 한 마리는 부탁해!!\n가자, 두 사람 다!!"
  },
  {
   "key": "40bcef32a779",
   "speaker_korean": "페이트",
   "korean": "「고마워, 덕분에 살았어."
  },
  {
   "key": "daf9e2cd1740",
   "speaker_korean": "스프레",
   "korean": "「천만에♪\n그보다 빨리 도망치는 게 좋아.\n저 이상한 기계가\n계속 몰려오고 있으니까!"
  },
  {
   "key": "71afb09891ed",
   "speaker_korean": "페이트",
   "korean": "「엉망진창이라니…?\n아버지…어머니!!"
  },
  {
   "key": "7071050187c6",
   "speaker_korean": "스프레",
   "korean": "「뭐? 돌아간다니… 그쪽으로?"
  },
  {
   "key": "49f64474df2d",
   "speaker_korean": "페이트",
   "korean": "「저쪽에는 아버지랑 어머니가 있어!\n도우러 가야 해!!"
  },
  {
   "key": "d1a5dd03f44b",
   "speaker_korean": "페이트",
   "korean": "「두 사람 다, 비켜줘!!"
  },
  {
   "key": "7bc9addd73c3",
   "speaker_korean": "스프레",
   "korean": "「아잉, 정말!\n⟦1⟧곤조라⟦2⟧!!"
  },
  {
   "key": "b2cb46bab0de",
   "speaker_korean": "소피아",
   "korean": "「제발, ⟦1⟧페이트⟦2⟧를 말려줘!\n돌아간다고 말을 안 들어!!"
  },
  {
   "key": "88ba94170ba7",
   "speaker_korean": "스프레",
   "korean": "「그쪽은 벌써 엉망진창이\n돼버렸단 말이야.\n자, 서둘러! 서둘러!!"
  },
  {
   "key": "cbf2eca541d2",
   "speaker_korean": "스프레",
   "korean": "「아직 있는 거야!?"
  },
  {
   "key": "f13e8db55899",
   "speaker_korean": "스프레",
   "korean": "「후우…대충 이 정도려나♪"
  },
  {
   "key": "a9e93ddcc49c",
   "speaker_korean": "소피아",
   "korean": "「안 돼!\n그 애도 말했잖아,\n저쪽은 위험하다고!!"
  },
  {
   "key": "3b136082f494",
   "speaker_korean": "소피아",
   "korean": "「안 돼!\n위험해!!"
  },
  {
   "key": "1fdf1b319977",
   "speaker_korean": "스프레",
   "korean": "「안 된다니까!\n그쪽은 벌써 불바다란 말이야!!"
  },
  {
   "key": "dcb5d6fc48f2",
   "speaker_korean": "스프레",
   "korean": "「둘 다!\n위험하다고 했잖아~!!"
  },
  {
   "key": "6ac658690ded",
   "speaker_korean": "페이트",
   "korean": "「지나가게 해줘!!"
  },
  {
   "key": "bb87954239df",
   "speaker_korean": "스프레",
   "korean": "「이대로 여기 있으면\n다들 죽어버릴 거야!\n아무튼 지금은 도망치는 거야!!"
  },
  {
   "key": "cabc6f407a20",
   "speaker_korean": "페이트",
   "korean": "「놔! 놔달라고!!"
  },
  {
   "key": "5c4c2b411134",
   "speaker_korean": "소피아",
   "korean": "「자, 잠깐,\n⟦1⟧페이트⟦2⟧!?"
  },
  {
   "key": "1cf4480212aa",
   "speaker_korean": "소피아",
   "korean": "「맞아, 위험해!"
  }
 ]
}