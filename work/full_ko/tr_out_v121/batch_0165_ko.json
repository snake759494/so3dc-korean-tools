{
 "batch_id": "batch_0165",
 "translations": [
  {
   "key": "3af5692cbcd3",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「⟦2⟧리벨⟦3⟧이?\n그게 무슨 소리야?\n⟦P⟧"
  },
  {
   "key": "3a8473a27c84",
   "speaker_korean": "마리에타",
   "korean": "⟦1⟧「아, 그렇긴 하네.\n⟦P⟧"
  },
  {
   "key": "d1aa16396894",
   "speaker_korean": "스팅",
   "korean": "⟦1⟧「우리 ⟦2⟧쿼크⟦3⟧의 멤버들은\n기본적으로 그 이념에 공감해서\n활동에 참여하고 있는 거지만\n⟦P⟧⟦4⟧리벨⟦5⟧, 그 녀석한테는 말이야\n뭔가 다른 불순한 이유가 있는 것 같더군.\n너도 뭔가 짚이는 데가\n있는 거 아니야?\n⟦P⟧"
  },
  {
   "key": "3c4118d41cda",
   "speaker_korean": null,
   "korean": "뭐, 없는 건 아니지만 말이야.\n⟦P⟧"
  },
  {
   "key": "799f27af0d37",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「음~...\n⟦P⟧"
  },
  {
   "key": "5b8807086c80",
   "speaker_korean": null,
   "korean": "근데 그건 그 녀석 오해야.\n⟦P⟧애초에 나는\n⟦1⟧마리아⟦2⟧는커녕\n내 얘기조차 듣지\n못했다고.\n⟦P⟧"
  },
  {
   "key": "abd89450c7bb",
   "speaker_korean": "마리에타",
   "korean": "⟦1⟧「그런 논리가 ⟦2⟧리벨⟦3⟧한테\n통할 거라고 생각해?\n⟦P⟧"
  },
  {
   "key": "862ac0371024",
   "speaker_korean": "마리에타",
   "korean": "⟦1⟧「남자의 질투라는 건\n그냥 꼴사나울 뿐이라고\n생각하는데 말이야...\n⟦P⟧"
  },
  {
   "key": "9913ed1b9da9",
   "speaker_korean": null,
   "korean": "근데 그렇게 따지면\n여자들 질투도\n만만치 않다고 생각하는데.\n⟦P⟧"
  },
  {
   "key": "2a1b0f249b16",
   "speaker_korean": null,
   "korean": "하아...\n인간관계란 참 어려운 거라니까.\n진짜로.\n⟦P⟧"
  },
  {
   "key": "3748aa272ab9",
   "speaker_korean": "스팅",
   "korean": "⟦1⟧「겉에서 보면 쉬워 보이지만\n정답이 그리 쉽게 나오진 않지.\n⟦P⟧"
  },
  {
   "key": "4fb544a8cea3",
   "speaker_korean": null,
   "korean": "나는 그런 건 못 흉내 내겠다.\n너무 힘든 일이니까.\n⟦P⟧"
  },
  {
   "key": "7bb68a97500a",
   "speaker_korean": "마리에타",
   "korean": "⟦1⟧「근데 ⟦2⟧리벨⟦3⟧도 참\n어떻게 그렇게 계속\n쫓아다닐 수 있는 거지?\n⟦P⟧"
  },
  {
   "key": "464e8f214eb8",
   "speaker_korean": "마리에타",
   "korean": "⟦1⟧「다들 힘내.\n⟦P⟧"
  },
  {
   "key": "9b1b4c272e31",
   "speaker_korean": "스팅",
   "korean": "⟦1⟧「부탁한다.\n기대해도 되는 거지?\n⟦P⟧"
  },
  {
   "key": "b8e3c01f3c33",
   "speaker_korean": "스팅",
   "korean": "⟦1⟧「적어도 리더는 너한테\n일종의 친근감을 갖고 있었어.\n⟦P⟧아니, 공감이라고 하는 게\n맞을지도 모르겠군.\n⟦P⟧아무튼, 우리 리더한테는\n네가 특별한 존재였다는 거야.\n그거면 그 녀석한텐 충분했던 거지.\n⟦P⟧"
  },
  {
   "key": "7520bd527ac5",
   "speaker_korean": "마리에타",
   "korean": "⟦1⟧「막상 만나 보니까...\n오히려 귀여운 정도던데.\n⟦P⟧"
  },
  {
   "key": "280b222ff959",
   "speaker_korean": "스팅",
   "korean": "⟦1⟧「동감이야.\n그 녀석은 이치보다 먼저\n감으로 움직이는 타입이니까.\n⟦P⟧"
  },
  {
   "key": "4bc160ca4942",
   "speaker_korean": null,
   "korean": "그 녀석한테는 지금 와서\n사실관계 따위는 상관없어.\n⟦P⟧중요한 건 말이야, 우리 리더가\n너를 자신과 같은 처지의\n사람이라고 여겼다는 거야.\n⟦P⟧"
  },
  {
   "key": "dcc43fddc0fe",
   "speaker_korean": "페이트",
   "korean": "⟦1⟧「아...\n그게...\n⟦P⟧"
  },
  {
   "key": "c5e0510ddd91",
   "speaker_korean": "스팅",
   "korean": "⟦1⟧「뭐, 확실히 보고 있기에\n그리 유쾌한 건\n아니지.\n⟦P⟧"
  },
  {
   "key": "13df030d7e3b",
   "speaker_korean": "스팅",
   "korean": "⟦1⟧「뭐, 불같이 화를 낼 건\n확실하겠지.\n⟦P⟧"
  },
  {
   "key": "a1a2943771ab",
   "speaker_korean": "리벨",
   "korean": "⟦1⟧「난 너한테만큼은\n절대 안 질 거다!\n⟦P⟧"
  },
  {
   "key": "5727f2883bb1",
   "speaker_korean": "리벨",
   "korean": "⟦1⟧「네가 ⟦2⟧페이트⟦3⟧냐.\n네가 리더의...\n⟦P⟧잘 들어, 난 너한테만큼은\n절대 안 질 거다!\n⟦P⟧"
  },
  {
   "key": "65bf01b87d41",
   "speaker_korean": "리벨",
   "korean": "⟦1⟧「리더.\n⟦2⟧클리프⟦3⟧ 씨.\n그리고 ⟦4⟧페이트⟦5⟧ 일행도요.\n⟦P⟧무사히 돌아와 주세요.\n저, 곤란해지니까요.\n⟦P⟧"
  },
  {
   "key": "f88af7355552",
   "speaker_korean": "랭커",
   "korean": "⟦1⟧「뭔가 일이 꽤\n화려하게 됐구먼.\n⟦P⟧리더, 부탁하니까\n잘 좀 마무리해 주쇼.\n예전부터 배드엔딩은\n질색이라서 말이죠.\n⟦P⟧"
  },
  {
   "key": "30ae2ca18eec",
   "speaker_korean": "랭커",
   "korean": "⟦1⟧「모든 게 무사히 끝나도록\n월하미인 꽃에라도\n소원을 빌면서 기다리고 있죠.\n⟦P⟧"
  },
  {
   "key": "3423c58b679f",
   "speaker_korean": "랭커",
   "korean": "⟦1⟧「뭐, 편하게 갑시다.\n결과라는 건 어떻게든\n되기 마련이니까요.\n⟦P⟧"
  },
  {
   "key": "bf38694110ab",
   "speaker_korean": "쿼크 조직원(돌격대)",
   "korean": "⟦1⟧「무운을 빌겠습니다.\n⟦P⟧"
  },
  {
   "key": "f45f85522def",
   "speaker_korean": "쿼크 조직원(돌격대)",
   "korean": "⟦1⟧「저는 또 집 보는 겁니까?\n좀 봐주세요...\n⟦P⟧저희도 가끔은 화끈하게\n날뛰어 보고 싶다고요.\n⟦P⟧"
  },
  {
   "key": "815294a5d44d",
   "speaker_korean": "쿼크 조직원(돌격대)",
   "korean": "⟦1⟧「다음번엔 꼭 저를 써 주세요.\n부탁드렸습니다.\n⟦P⟧"
  },
  {
   "key": "4731d9da39cd",
   "speaker_korean": "마리아",
   "korean": "「다들 모였네.\n그럼, 가자."
  },
  {
   "key": "c9f051b53c2c",
   "speaker_korean": "클리프",
   "korean": "「뒷일은 부탁한다,\n⟦1⟧미라쥬⟦2⟧."
  },
  {
   "key": "832a4063adf8",
   "speaker_korean": "미라쥬",
   "korean": "「네."
  },
  {
   "key": "7cbbd1cf374f",
   "speaker_korean": "클리프",
   "korean": "「자, 그럼\n한번 해볼까!"
  },
  {
   "key": "cea36f00167f",
   "speaker_korean": "미라쥬",
   "korean": "「힘내세요.\n무사히 돌아오시길 바랄게요."
  },
  {
   "key": "cbc4a0d36a0a",
   "speaker_korean": "마리아",
   "korean": "「무슨 일이 생기면\n⟦1⟧디프로⟦2⟧ 자체 판단으로 움직여."
  },
  {
   "key": "8323878ad360",
   "speaker_korean": "미라쥬",
   "korean": "「알고 있어요."
  },
  {
   "key": "74b5f6ae63fe",
   "speaker_korean": "랭커",
   "korean": "「뭐, 아무 일도 없기를\n빌고 있습니다만."
  },
  {
   "key": "bfe6b8a8c9db",
   "speaker_korean": "마리아",
   "korean": "「나도 그렇게 생각해...\n그럼, 다녀올게."
  },
  {
   "key": "eb50a9d68e2d",
   "speaker_korean": "미라쥬",
   "korean": "「조심하세요..."
  },
  {
   "key": "14352014d12f",
   "speaker_korean": "클리프",
   "korean": "「오, 왔구나.\n준비는 다 끝났냐?"
  },
  {
   "key": "0dd26925b7df",
   "speaker_korean": null,
   "korean": "⟦1⟧・준비완료."
  },
  {
   "key": "e955b3b82cc7",
   "speaker_korean": null,
   "korean": "⟦1⟧・아직준비중."
  },
  {
   "key": "1717e759f0b5",
   "speaker_korean": "랭커",
   "korean": "「너희들, 리더들을\n잘 부탁한다."
  }
 ]
}